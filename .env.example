# Public runtime/site configuration (exposed to client by Astro)
PUBLIC_SITE_URL=https://www.adamboas.com
PUBLIC_CONTACT_EMAIL=anboas@gmail.com
PUBLIC_CONTACT_PHONE_E164=+13019042011
# Optional: override default FormSubmit endpoint (defaults to https://formsubmit.co/ajax/<PUBLIC_CONTACT_EMAIL>)
PUBLIC_CONTACT_FORM_ENDPOINT=

# Optional: host audio/media from external bucket/CDN
PUBLIC_MEDIA_BASE_URL=

# Build-time analytics data collectors (server-side scripts only)
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=www.adamboas.com
PLAUSIBLE_DATE_RANGE=30d
PLAUSIBLE_SITEMAP_INDEX_URL=https://www.adamboas.com/sitemap-index.xml

# Optional radar crawler/runtime script tuning
RADAR_UA_CONTACT_URL=
RADAR_BROWSER_FETCH_TIMEOUT=30
