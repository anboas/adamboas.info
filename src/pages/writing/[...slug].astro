---
import { getCollection, render } from 'astro:content';

type NavItem = { slug: string; title: string };
function navLink(label: string, item: NavItem | null) {
	if (!item) return null;
	return { label, href: `/writing/${item.slug}/`, title: item.title };
}

import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import PageViewsChip from '../../components/PageViewsChip.astro';
import { withBase } from '../../utils/withBase';
import fs from 'node:fs/promises';
import path from 'node:path';

async function tryReadGeneratedHtml(slug: string) {
	try {
		const p = path.join(process.cwd(), 'src', 'generated', 'papers', `${slug}.html`);
		return await fs.readFile(p, 'utf-8');
	} catch {
		return null;
	}
}

function applyBaseToGeneratedPaperHtml(html: string) {
	// Generated paper fragments may contain absolute-root URLs like /papers/...
	// That breaks on GitHub Pages project deployments (served from /<repo>/).
	const papersBase = withBase('/papers/');
	return html
		.replaceAll('src="/papers/', `src="${papersBase}`)
		.replaceAll('href="/papers/', `href="${papersBase}`);
}

function formatBytes(n: number) {
	if (!Number.isFinite(n) || n <= 0) return null;
	const kb = n / 1024;
	if (kb < 1024) return `${Math.round(kb)} KB`;
	const mb = kb / 1024;
	return `${mb.toFixed(1)} MB`;
}

async function pdfMeta(pdfPath: string) {
	try {
		const abs = path.join(process.cwd(), 'public', pdfPath.replace(/^\//, ''));
		const st = await fs.stat(abs);
		const buf = await fs.readFile(abs);
		const text = buf.toString('latin1');
		const pages = (text.match(/\/Type\s*\/Page\b/g) || []).length || null;
		return { size: formatBytes(st.size), pages };
	} catch {
		return { size: null, pages: null };
	}
}


export async function getStaticPaths() {
	const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
	const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

	return [
		...writing.map((w) => ({ params: { slug: w.id.split('/').pop() }, props: { kind: 'writing', id: w.id } })),
		...papers.map((p) => ({ params: { slug: p.id }, props: { kind: 'paper', id: p.id } })),
	];
}

const { kind, id } = Astro.props as { kind: 'writing' | 'paper'; id: string };

let title = 'Writing | Adam Boas';
let description: string | undefined;
let pageImage = '/og/default.png';
let contactHref = 'mailto:anboas@gmail.com?subject=Discussing%20your%20writing';

let paper: any = null;
let paperGeneratedHtml: string | null = null;
let pdfInfo: { size: string | null; pages: number | null } | null = null;
let PaperContent: any = null;

let writingPdfInfo: { size: string | null; pages: number | null } | null = null;
let writingItem: any = null;
let WritingContent: any = null;

const publishedWriting = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.map((w) => ({ slug: w.id.split('/').pop()!, id: w.id, title: w.data.title, tags: w.data.tags ?? [] }))
	.sort((a, b) => a.slug.localeCompare(b.slug));

const publishedPapers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.map((p) => ({ slug: p.id, id: p.id, title: p.data.title, tags: p.data.tags ?? [] }))
	.sort((a, b) => a.slug.localeCompare(b.slug));

const allNav = [...publishedWriting, ...publishedPapers];

function findNav(slug: string) {
	const i = allNav.findIndex((x) => x.slug === slug);
	const prev = i > 0 ? allNav[i - 1] : null;
	const next = i >= 0 && i + 1 < allNav.length ? allNav[i + 1] : null;
	return { prev, next };
}

function relatedByTags(slug: string, tags: string[]) {
	const tset = new Set(tags);
	const scored = allNav
		.filter((x) => x.slug !== slug)
		.map((x) => ({
			item: x,
			score: (x.tags ?? []).reduce((n: number, t: string) => n + (tset.has(t) ? 1 : 0), 0),
		}))
		.filter((x) => x.score > 0)
		.sort((a, b) => b.score - a.score)
		.slice(0, 5)
		.map((x) => x.item);
	return scored;
}

if (kind === 'paper') {
	const papers = await getCollection('papers');
	paper = papers.find((p) => p.id === id);
	if (!paper) throw new Error(`Paper not found: ${id}`);
	paperGeneratedHtml = await tryReadGeneratedHtml(paper.id);
	if (paperGeneratedHtml) paperGeneratedHtml = applyBaseToGeneratedPaperHtml(paperGeneratedHtml);
	({ Content: PaperContent } = await render(paper));
	title = `${paper.data.title} | Adam Boas`;
	description = paper.data.description;
	pageImage = '/og/paper.png';
	contactHref = `mailto:anboas@gmail.com?subject=${encodeURIComponent(`Paper discussion: ${paper.data.title}`)}`;
	if (paper.data.pdfPath) pdfInfo = await pdfMeta(paper.data.pdfPath);
} else {
	const writingItems = await getCollection('writing');
	writingItem = writingItems.find((w) => w.id === id);
	if (!writingItem) throw new Error(`Writing item not found: ${id}`);
	({ Content: WritingContent } = await render(writingItem));
	title = `${writingItem.data.title} | Adam Boas`;
	description = writingItem.data.summary;
	pageImage = writingItem.data.type === 'memo' ? '/og/memo.png' : '/og/note.png';
	contactHref = `mailto:anboas@gmail.com?subject=${encodeURIComponent(`${writingItem.data.type.toUpperCase()} discussion: ${writingItem.data.title}`)}`;
	if (writingItem.data.pdfPath) writingPdfInfo = await pdfMeta(writingItem.data.pdfPath);
}
---

<SiteLayout title={title} description={description} image={pageImage}>
	<StickyBrowseBar active="writing" />
	{kind === 'writing' ? (
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': writingItem.data.type === 'memo' ? 'Article' : 'BlogPosting',
				headline: writingItem.data.title,
				datePublished: writingItem.data.date.toISOString(),
				author: { '@type': 'Person', name: 'Adam Boas' },
				keywords: writingItem.data.tags ?? [],
				description: writingItem.data.summary ?? undefined,
			})}
		/>
	) : null}
	{kind === 'paper' ? (
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Report',
				headline: paper.data.title,
				datePublished: paper.data.date ? paper.data.date.toISOString() : undefined,
				author: { '@type': 'Person', name: 'Adam Boas' },
				description: paper.data.description ?? undefined,
			})}
		/>
	) : null}
	{kind === 'paper' ? (
		<article class="card p-8" data-paper-style="dossier" data-writing-type="paper">
			<header>
				<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
					<a class="text-sm text-slate-400 hover:text-slate-200" href={withBase('/writing/')}>
						← Writing
					</a>
					<div class="flex flex-wrap items-center gap-2">
						{paper.data.pdfPath && (
							<a
								class="group rounded-none border border-slate-700 bg-slate-950/40 px-3 py-1.5 text-sm font-semibold text-stone-100 hover:bg-slate-900"
								href={withBase(paper.data.pdfPath)}
								target="_blank"
								rel="noreferrer"
								data-track="Writing: Open PDF"
								data-track-props={JSON.stringify({ slug: paper.id, kind: 'paper' })}
							>
								<span>PDF</span>
								{pdfInfo && (
									<span class="ml-2 text-xs font-normal text-slate-300 group-hover:text-slate-200">
										{pdfInfo.pages ? `${pdfInfo.pages}p` : ''}{pdfInfo.pages && pdfInfo.size ? ' • ' : ''}{pdfInfo.size ? pdfInfo.size : ''}
									</span>
								)}
							</a>
						)}
						<button
							type="button"
							class="rounded-none border border-slate-700 bg-slate-950/40 px-3 py-1.5 text-sm font-semibold text-stone-100 hover:bg-slate-900"
							data-copy-link
							data-track="Writing: Copy Link"
						>
							Copy link
						</button>
						<a data-track="Contact: Paper CTA" class="rounded-none border border-slate-700 bg-slate-950/40 px-3 py-1.5 text-sm font-semibold text-stone-100 hover:bg-slate-900" href={contactHref}>Discuss this brief</a>
					</div>
				</div>
				<div class="mt-4 min-w-0">
					<h1 class="text-2xl font-semibold text-slate-50">{paper.data.title}</h1>
					{paper.data.description && <p class="mt-2 text-slate-300">{paper.data.description}</p>}
					{paper.data.date && (
						<div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-400">
							<span>{paper.data.date.toISOString().slice(0, 10)}</span>
							<PageViewsChip pathname={withBase(`/writing/${paper.id}/`)} />
						</div>
					)}
				</div>
			</header>

			<div class="paper-content prose prose-invert mt-8 max-w-none">
				{paperGeneratedHtml ? <div set:html={paperGeneratedHtml} /> : <PaperContent />}
			</div>

			{(() => {
				const { prev, next } = findNav(paper.id);
				const related = relatedByTags(paper.id, paper.data.tags ?? []);
				return (
					<>
						<div class="mt-10 flex flex-col gap-3 pt-6 md:flex-row md:justify-between">
							{prev ? <a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/writing/${prev.slug}/`)}>← {prev.title}</a> : <span />}
							{next ? <a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/writing/${next.slug}/`)}>{next.title} →</a> : <span />}
						</div>

						{related.length ? (
							<div class="mt-8">
								<h2 class="text-sm font-semibold text-slate-50">Related</h2>
								<ul class="mt-3 space-y-2 text-sm text-slate-300">
									{related.map((r) => (
										<li>
											<a class="hover:underline" href={withBase(`/writing/${r.slug}/`)}>{r.title}</a>
										</li>
									))}
								</ul>
							</div>
						) : null}
					</>
				);
			})()}
		</article>
	) : (
		<article class="card p-8" data-writing-type={writingItem.data.type} data-paper-style="dossier">
			<header>
				<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
					<a class="text-sm text-slate-400 hover:text-slate-200" href={withBase('/writing/')}>
						← Writing
					</a>
					<div class="flex flex-wrap items-center gap-2">
						{writingItem.data.pdfPath ? (
							<a
								class="group rounded-none border border-slate-700 bg-slate-950/40 px-3 py-1.5 text-sm font-semibold text-stone-100 hover:bg-slate-900"
								href={withBase(writingItem.data.pdfPath)}
								target="_blank"
								rel="noreferrer"
								data-track="Writing: Open PDF"
								data-track-props={JSON.stringify({ slug: writingItem.id.split('/').pop(), kind: writingItem.data.type })}
							>
								<span>PDF</span>
								{writingPdfInfo && (
									<span class="ml-2 text-xs font-normal text-slate-300 group-hover:text-slate-200">
										{writingPdfInfo.pages ? `${writingPdfInfo.pages}p` : ''}{writingPdfInfo.pages && writingPdfInfo.size ? ' • ' : ''}{writingPdfInfo.size ? writingPdfInfo.size : ''}
									</span>
								)}
							</a>
						) : null}
						<button
							type="button"
							class="rounded-none border border-slate-700 bg-slate-950/40 px-3 py-1.5 text-sm font-semibold text-stone-100 hover:bg-slate-900"
							data-copy-link
							data-track="Writing: Copy Link"
						>
							Copy link
						</button>
						<a data-track="Contact: Writing CTA" class="rounded-none border border-slate-700 bg-slate-950/40 px-3 py-1.5 text-sm font-semibold text-stone-100 hover:bg-slate-900" href={contactHref}>Discuss this brief</a>
					</div>
				</div>
				<div class="mt-4 min-w-0">
					<h1 class="text-2xl font-semibold text-slate-50">{writingItem.data.title}</h1>
					{writingItem.data.summary && <p class="mt-2 text-slate-300">{writingItem.data.summary}</p>}
					{writingItem.data.date && (
						<div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-400">
							<span>{writingItem.data.date.toISOString().slice(0, 10)}</span>
							<PageViewsChip pathname={withBase(`/writing/${writingItem.id.split('/').pop()}/`)} />
						</div>
					)}
				</div>
			</header>

			<div class="paper-content prose prose-invert mt-8 max-w-none">
				<WritingContent />
			</div>

			{(() => {
				const slug = writingItem.id.split('/').pop();
				const { prev, next } = findNav(slug);
				const related = relatedByTags(slug, writingItem.data.tags ?? []);
				return (
					<>
						<div class="mt-10 flex flex-col gap-3 pt-6 md:flex-row md:justify-between">
							{prev ? <a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/writing/${prev.slug}/`)}>← {prev.title}</a> : <span />}
							{next ? <a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/writing/${next.slug}/`)}>{next.title} →</a> : <span />}
						</div>

						{related.length ? (
							<div class="mt-8">
								<h2 class="text-sm font-semibold text-slate-50">Related</h2>
								<ul class="mt-3 space-y-2 text-sm text-slate-300">
									{related.map((r) => (
										<li>
											<a class="hover:underline" href={withBase(`/writing/${r.slug}/`)}>{r.title}</a>
										</li>
									))}
								</ul>
							</div>
						) : null}
					</>
				);
			})()}
		</article>
	)}
</SiteLayout>
