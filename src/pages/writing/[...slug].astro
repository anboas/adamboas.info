---
import { getCollection, render } from 'astro:content';

type NavItem = { slug: string; title: string };
function navLink(label: string, item: NavItem | null) {
	if (!item) return null;
	return { label, href: `/writing/${item.slug}/`, title: item.title };
}

import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import PageViewsChip from '../../components/PageViewsChip.astro';
import { withBase } from '../../utils/withBase';
import fs from 'node:fs/promises';
import path from 'node:path';

async function tryReadGeneratedHtml(kind: 'papers' | 'memos', slug: string) {
	try {
		const p = path.join(process.cwd(), 'src', 'generated', kind, `${slug}.html`);
		return await fs.readFile(p, 'utf-8');
	} catch {
		return null;
	}
}

function applyBaseToGeneratedPaperHtml(html: string) {
	// Generated paper fragments may contain absolute-root URLs like /papers/...
	// That breaks on GitHub Pages project deployments (served from /<repo>/).
	const papersBase = withBase('/papers/');
	let normalized = html
		.replaceAll('src="/papers/', `src="${papersBase}`)
		.replaceAll('href="/papers/', `href="${papersBase}`)
		// Ensure generated paper images have alt text (empty alt for decorative/non-captioned figures).
		.replace(/<img(?![^>]*\balt=)([^>]*?)>/gi, '<img$1 alt="">');

	// Some ingested paper fragments include a leading unnumbered executive-summary block
	// and then a second in-body Executive Summary section.
	// Keep the in-body section and drop the leading duplicate block.
	const execSummaryMatches = normalized.match(/id="executive-summary"/gi) ?? [];
	if (execSummaryMatches.length > 1) {
		normalized = normalized.replace(
			/^\s*<h2\s+class="unnumbered"\s+id="executive-summary"[\s\S]*?(?=<h2\b)/i,
			'',
		);
	}

	return normalized;
}

function applyBaseToGeneratedMemoHtml(html: string) {
	const memosBase = withBase('/memos/');
	let normalized = html
		.replaceAll('href="/memos/', `href="${memosBase}`)
		.replaceAll('src="/memos/', `src="${memosBase}`)
		// Defensive cleanup for standalone-pandoc leftovers in legacy artifacts.
		.replace(/^\s*<h1[^>]*class="title"[^>]*>[\s\S]*?<\/h1>\s*<\/header>\s*/i, '');
	return normalized;
}

function formatBytes(n: number) {
	if (!Number.isFinite(n) || n <= 0) return null;
	const kb = n / 1024;
	if (kb < 1024) return `${Math.round(kb)} KB`;
	const mb = kb / 1024;
	return `${mb.toFixed(1)} MB`;
}

async function pdfMeta(pdfPath: string) {
	try {
		const abs = path.join(process.cwd(), 'public', pdfPath.replace(/^\//, ''));
		const st = await fs.stat(abs);
		const buf = await fs.readFile(abs);
		const text = buf.toString('latin1');
		const pages = (text.match(/\/Type\s*\/Page\b/g) || []).length || null;
		return { size: formatBytes(st.size), pages };
	} catch {
		return { size: null, pages: null };
	}
}


export async function getStaticPaths() {
	const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
	const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

	return [
		...writing.map((w) => ({ params: { slug: w.id.split('/').pop() }, props: { kind: 'writing', id: w.id } })),
		...papers.map((p) => ({ params: { slug: p.id }, props: { kind: 'paper', id: p.id } })),
	];
}

const { kind, id } = Astro.props as { kind: 'writing' | 'paper'; id: string };

let title = 'Writing | Adam Boas';
let description: string | undefined;
let pageImage = '/og/default.png';
let contactHref = 'mailto:anboas@gmail.com?subject=Discussing%20your%20writing';

const absoluteUrl = (pathname: string) => new URL(withBase(pathname), Astro.site).toString();
let currentSlugForSchema = '';
let currentTitleForSchema = '';

let paper: any = null;
let paperGeneratedHtml: string | null = null;
let pdfInfo: { size: string | null; pages: number | null } | null = null;
let PaperContent: any = null;

let writingPdfInfo: { size: string | null; pages: number | null } | null = null;
let writingItem: any = null;
let WritingContent: any = null;
let memoGeneratedHtml: string | null = null;

const publishedWriting = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.map((w) => ({ slug: w.id.split('/').pop()!, id: w.id, title: w.data.title, tags: w.data.tags ?? [] }))
	.sort((a, b) => a.slug.localeCompare(b.slug));

const publishedPapers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.map((p) => ({ slug: p.id, id: p.id, title: p.data.title, tags: p.data.tags ?? [] }))
	.sort((a, b) => a.slug.localeCompare(b.slug));

const allNav = [...publishedWriting, ...publishedPapers];

function findNav(slug: string) {
	const i = allNav.findIndex((x) => x.slug === slug);
	const prev = i > 0 ? allNav[i - 1] : null;
	const next = i >= 0 && i + 1 < allNav.length ? allNav[i + 1] : null;
	return { prev, next };
}

function relatedByTags(slug: string, tags: string[]) {
	const tset = new Set(tags);
	const scored = allNav
		.filter((x) => x.slug !== slug)
		.map((x) => ({
			item: x,
			score: (x.tags ?? []).reduce((n: number, t: string) => n + (tset.has(t) ? 1 : 0), 0),
		}))
		.filter((x) => x.score > 0)
		.sort((a, b) => b.score - a.score)
		.slice(0, 5)
		.map((x) => x.item);
	return scored;
}

if (kind === 'paper') {
	const papers = await getCollection('papers');
	paper = papers.find((p) => p.id === id);
	if (!paper) throw new Error(`Paper not found: ${id}`);
	paperGeneratedHtml = await tryReadGeneratedHtml('papers', paper.id);
	if (paperGeneratedHtml) paperGeneratedHtml = applyBaseToGeneratedPaperHtml(paperGeneratedHtml);
	({ Content: PaperContent } = await render(paper));
	title = `${paper.data.title} | Adam Boas`;
	description = paper.data.description;
	pageImage = `/og/writing/${paper.id}.png`;
	contactHref = `mailto:anboas@gmail.com?subject=${encodeURIComponent(`Paper discussion: ${paper.data.title}`)}`;
	currentSlugForSchema = paper.id;
	currentTitleForSchema = paper.data.title;
	if (paper.data.pdfPath) pdfInfo = await pdfMeta(paper.data.pdfPath);
} else {
	const writingItems = await getCollection('writing');
	writingItem = writingItems.find((w) => w.id === id);
	if (!writingItem) throw new Error(`Writing item not found: ${id}`);
	({ Content: WritingContent } = await render(writingItem));
	title = `${writingItem.data.title} | Adam Boas`;
	description = writingItem.data.summary;
	pageImage = `/og/writing/${writingItem.id.split('/').pop()}.png`;
	contactHref = `mailto:anboas@gmail.com?subject=${encodeURIComponent(`${writingItem.data.type.toUpperCase()} discussion: ${writingItem.data.title}`)}`;
	currentSlugForSchema = writingItem.id.split('/').pop() ?? '';
	currentTitleForSchema = writingItem.data.title;
	if (writingItem.data.type === 'memo') {
		memoGeneratedHtml = await tryReadGeneratedHtml('memos', currentSlugForSchema);
		if (memoGeneratedHtml) memoGeneratedHtml = applyBaseToGeneratedMemoHtml(memoGeneratedHtml);
	}
	if (writingItem.data.pdfPath) writingPdfInfo = await pdfMeta(writingItem.data.pdfPath);
}

const currentUrl = absoluteUrl(`/writing/${currentSlugForSchema}/`);
const homeUrl = absoluteUrl('/');
const writingUrl = absoluteUrl('/writing/');
---

<SiteLayout title={title} description={description} image={pageImage}>
	<StickyBrowseBar active="writing" />
	{kind === 'writing' ? (
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': writingItem.data.type === 'memo' ? 'Article' : 'BlogPosting',
				headline: writingItem.data.title,
				url: currentUrl,
				mainEntityOfPage: { '@type': 'WebPage', '@id': currentUrl },
				datePublished: writingItem.data.date.toISOString(),
				author: { '@type': 'Person', name: 'Adam Boas' },
				keywords: writingItem.data.tags ?? [],
				description: writingItem.data.summary ?? undefined,
			})}
		/>
	) : null}
	{kind === 'paper' ? (
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Report',
				headline: paper.data.title,
				url: currentUrl,
				mainEntityOfPage: { '@type': 'WebPage', '@id': currentUrl },
				datePublished: paper.data.date ? paper.data.date.toISOString() : undefined,
				author: { '@type': 'Person', name: 'Adam Boas' },
				description: paper.data.description ?? undefined,
			})}
		/>
	) : null}
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
				{ '@type': 'ListItem', position: 2, name: 'Writing', item: writingUrl },
				{ '@type': 'ListItem', position: 3, name: currentTitleForSchema, item: currentUrl },
			],
		})}
	/>
	{kind === 'paper' ? (
		<>
			<div class="writing-actions-bar mb-2 flex items-center gap-2 overflow-x-auto whitespace-nowrap md:mb-3 md:flex-row md:items-center md:justify-between md:overflow-visible md:whitespace-normal">
				<a class="shrink-0 text-xs text-slate-400 hover:text-slate-200 md:text-sm" href={withBase('/writing/')}>
					← Writing
				</a>
				<div class="flex flex-nowrap items-center gap-2 md:flex-wrap">
					{paper.data.pdfPath && (
						<a
							class="group rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100 hover:bg-slate-900 md:px-3 md:text-sm"
							href={withBase(paper.data.pdfPath)}
							target="_blank"
							rel="noreferrer"
							data-track="Writing: Open PDF"
							data-track-props={JSON.stringify({ slug: paper.id, kind: 'paper' })}
						>
							<span>📄 PDF</span>
							{pdfInfo && (
								<span class="ml-2 hidden text-xs font-normal text-slate-300 group-hover:text-slate-200 sm:inline">
									{pdfInfo.pages ? `${pdfInfo.pages}p` : ''}{pdfInfo.pages && pdfInfo.size ? ' • ' : ''}{pdfInfo.size ? pdfInfo.size : ''}
								</span>
							)}
						</a>
					)}
					<button
						type="button"
						class="rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100 hover:bg-slate-900 md:px-3 md:text-sm"
						data-copy-link
						data-track="Writing: Copy Link"
					>
						🔗 Copy
					</button>
					<a data-track="Contact: Paper CTA" class="rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100 hover:bg-slate-900 md:px-3 md:text-sm" href={contactHref}>💬 Discuss</a>
					<span class="hidden items-center rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100 md:inline-flex md:px-3 md:text-sm" data-writing-progress-label>0% read</span>
				</div>
			</div>
			<div class="writing-mobile-progress">
				<span class="inline-flex items-center rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100" data-writing-progress-label>0% read</span>
			</div>
			<div class="writing-detail-shell">
		<article class="card p-5 md:p-8" data-paper-style="dossier" data-writing-type="paper">
			<header>
				<div class="mt-4 min-w-0">
					<h1 class="text-2xl font-semibold text-slate-50">{paper.data.title}</h1>
					{paper.data.description && <p class="mt-2 text-slate-300">{paper.data.description}</p>}
					{paper.data.date && (
						<div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-400">
							<span>{paper.data.date.toISOString().slice(0, 10)}</span>
							<PageViewsChip pathname={withBase(`/writing/${paper.id}/`)} />
						</div>
					)}
				</div>
			</header>

			<div class="paper-content prose prose-invert mt-8 max-w-none">
				{paperGeneratedHtml ? <div set:html={paperGeneratedHtml} /> : <PaperContent />}
			</div>

			{(() => {
				const { prev, next } = findNav(paper.id);
				const related = relatedByTags(paper.id, paper.data.tags ?? []);
				return (
					<>
						<div class="mt-10 flex flex-col gap-3 pt-6 md:flex-row md:justify-between">
							{prev ? <a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/writing/${prev.slug}/`)}>← {prev.title}</a> : <span />}
							{next ? <a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/writing/${next.slug}/`)}>{next.title} →</a> : <span />}
						</div>

						{related.length ? (
							<div class="mt-8">
								<h2 class="text-sm font-semibold text-slate-50">Related</h2>
								<ul class="mt-3 space-y-2 text-sm text-slate-300">
									{related.map((r) => (
										<li>
											<a class="hover:underline" href={withBase(`/writing/${r.slug}/`)}>{r.title}</a>
										</li>
									))}
								</ul>
							</div>
						) : null}
					</>
				);
			})()}
		</article>
			<aside class="writing-toc card hidden 2xl:block" data-writing-toc hidden>
				<div class="writing-toc-inner">
					<div class="writing-toc-title">On this page</div>
					<nav aria-label="On this page">
						<ul data-writing-toc-list></ul>
					</nav>
				</div>
			</aside>
		</div>
		</>
	) : (
		<>
			<div class="writing-actions-bar mb-2 flex items-center gap-2 overflow-x-auto whitespace-nowrap md:mb-3 md:flex-row md:items-center md:justify-between md:overflow-visible md:whitespace-normal">
				<a class="shrink-0 text-xs text-slate-400 hover:text-slate-200 md:text-sm" href={withBase('/writing/')}>
					← Writing
				</a>
				<div class="flex flex-nowrap items-center gap-2 md:flex-wrap">
					{writingItem.data.pdfPath ? (
						<a
							class="group rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100 hover:bg-slate-900 md:px-3 md:text-sm"
							href={withBase(writingItem.data.pdfPath)}
							target="_blank"
							rel="noreferrer"
							data-track="Writing: Open PDF"
							data-track-props={JSON.stringify({ slug: writingItem.id.split('/').pop(), kind: writingItem.data.type })}
						>
							<span>📄 PDF</span>
							{writingPdfInfo && (
								<span class="ml-2 hidden text-xs font-normal text-slate-300 group-hover:text-slate-200 sm:inline">
									{writingPdfInfo.pages ? `${writingPdfInfo.pages}p` : ''}{writingPdfInfo.pages && writingPdfInfo.size ? ' • ' : ''}{writingPdfInfo.size ? writingPdfInfo.size : ''}
								</span>
							)}
						</a>
					) : null}
					<button
						type="button"
						class="rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100 hover:bg-slate-900 md:px-3 md:text-sm"
						data-copy-link
						data-track="Writing: Copy Link"
					>
						🔗 Copy
					</button>
					<a data-track="Contact: Writing CTA" class="rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100 hover:bg-slate-900 md:px-3 md:text-sm" href={contactHref}>💬 Discuss</a>
					<span class="hidden items-center rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100 md:inline-flex md:px-3 md:text-sm" data-writing-progress-label>0% read</span>
				</div>
			</div>
			<div class="writing-mobile-progress">
				<span class="inline-flex items-center rounded-none border border-slate-700 bg-slate-950/40 px-2.5 py-1.5 text-xs font-semibold text-stone-100" data-writing-progress-label>0% read</span>
			</div>
			<div class="writing-detail-shell">
		<article class="card p-5 md:p-8" data-writing-type={writingItem.data.type} data-paper-style="dossier">
			<header>
				<div class="mt-4 min-w-0">
					<h1 class="text-2xl font-semibold text-slate-50">{writingItem.data.title}</h1>
					{writingItem.data.summary && <p class="mt-2 text-slate-300">{writingItem.data.summary}</p>}
					{writingItem.data.date && (
						<div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-400">
							<span>{writingItem.data.date.toISOString().slice(0, 10)}</span>
							<PageViewsChip pathname={withBase(`/writing/${writingItem.id.split('/').pop()}/`)} />
						</div>
					)}
				</div>
			</header>

			<div class="paper-content prose prose-invert mt-8 max-w-none">
				{memoGeneratedHtml ? <div set:html={memoGeneratedHtml} /> : <WritingContent />}
			</div>

			{(() => {
				const slug = writingItem.id.split('/').pop();
				const { prev, next } = findNav(slug);
				const related = relatedByTags(slug, writingItem.data.tags ?? []);
				return (
					<>
						<div class="mt-10 flex flex-col gap-3 pt-6 md:flex-row md:justify-between">
							{prev ? <a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/writing/${prev.slug}/`)}>← {prev.title}</a> : <span />}
							{next ? <a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/writing/${next.slug}/`)}>{next.title} →</a> : <span />}
						</div>

						{related.length ? (
							<div class="mt-8">
								<h2 class="text-sm font-semibold text-slate-50">Related</h2>
								<ul class="mt-3 space-y-2 text-sm text-slate-300">
									{related.map((r) => (
										<li>
											<a class="hover:underline" href={withBase(`/writing/${r.slug}/`)}>{r.title}</a>
										</li>
									))}
								</ul>
							</div>
						) : null}
					</>
				);
			})()}
		</article>
			<aside class="writing-toc card hidden 2xl:block" data-writing-toc hidden>
				<div class="writing-toc-inner">
					<div class="writing-toc-title">On this page</div>
					<nav aria-label="On this page">
						<ul data-writing-toc-list></ul>
					</nav>
				</div>
			</aside>
		</div>
		</>
	)}

	<script is:inline>
		(() => {
			const content = document.querySelector('.paper-content');
			if (!content) return;

			const progressLabels = Array.from(document.querySelectorAll('[data-writing-progress-label]'));
			if (progressLabels.length) {
				const getScrollTop = () => Math.max(
					window.scrollY || 0,
					document.documentElement?.scrollTop || 0,
					document.body?.scrollTop || 0,
				);

				let lastPct = -1;
				const updateReadingProgress = () => {
					const scrollTop = getScrollTop();
					const contentRect = content.getBoundingClientRect();
					const contentTop = scrollTop + contentRect.top;
					const contentHeight = content.scrollHeight;
					const viewportHeight = Math.max(1, window.innerHeight || 1);
					const numerator = scrollTop - contentTop + viewportHeight * 0.2;
					const denominator = Math.max(1, contentHeight - viewportHeight * 0.45);
					const ratio = Math.max(0, Math.min(1, numerator / denominator));
					const pct = Math.round(ratio * 100);
					if (pct === lastPct) return;
					lastPct = pct;
					for (const progressLabel of progressLabels) {
						progressLabel.textContent = `${pct}% read`;
					}
				};

				let progressTicking = false;
				const onProgressScroll = () => {
					if (progressTicking) return;
					progressTicking = true;
					window.requestAnimationFrame(() => {
						updateReadingProgress();
						progressTicking = false;
					});
				};

				updateReadingProgress();
				window.addEventListener('scroll', onProgressScroll, { passive: true });
				document.addEventListener('scroll', onProgressScroll, { passive: true, capture: true });
				window.addEventListener('resize', onProgressScroll, { passive: true });
			}

			for (const table of content.querySelectorAll('table')) {
				if (table.closest('.table-wrap')) continue;
				const wrap = document.createElement('div');
				wrap.className = 'table-wrap';
				table.parentNode?.insertBefore(wrap, table);
				wrap.appendChild(table);
			}

			const lightbox = document.createElement('div');
			lightbox.className = 'image-lightbox';
			lightbox.setAttribute('hidden', '');
			lightbox.innerHTML = `
				<button type="button" class="image-lightbox-close" aria-label="Close image preview">×</button>
				<img alt="" class="image-lightbox-img" />
				<p class="image-lightbox-caption"></p>
			`;
			document.body.appendChild(lightbox);
			const lightboxImg = lightbox.querySelector('.image-lightbox-img');
			const lightboxCaption = lightbox.querySelector('.image-lightbox-caption');
			const closeBtn = lightbox.querySelector('.image-lightbox-close');

			const closeLightbox = () => {
				lightbox.setAttribute('hidden', '');
				document.body.classList.remove('lightbox-open');
			};
			const openLightbox = (src, alt) => {
				if (!src || !lightboxImg) return;
				lightboxImg.src = src;
				lightboxImg.alt = alt || '';
				if (lightboxCaption) lightboxCaption.textContent = alt || '';
				lightbox.removeAttribute('hidden');
				document.body.classList.add('lightbox-open');
			};

			closeBtn?.addEventListener('click', closeLightbox);
			lightbox.addEventListener('click', (event) => {
				if (event.target === lightbox) closeLightbox();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && !lightbox.hasAttribute('hidden')) closeLightbox();
			});

			for (const img of content.querySelectorAll('figure img, p > img')) {
				const src = img.getAttribute('src') || img.currentSrc;
				if (!src) continue;
				img.classList.add('zoomable-image');
				img.setAttribute('tabindex', '0');
				img.setAttribute('role', 'button');
				img.setAttribute('aria-label', 'Open image preview');
				img.addEventListener('click', () => openLightbox(src, img.getAttribute('alt') || ''));
				img.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						openLightbox(src, img.getAttribute('alt') || '');
					}
				});

				const figure = img.closest('figure');
				if (figure && !figure.querySelector('.figure-open-link')) {
					const link = document.createElement('a');
					link.className = 'figure-open-link';
					link.href = src;
					link.target = '_blank';
					link.rel = 'noreferrer';
					link.textContent = 'Open full image';
					figure.appendChild(link);
				}
			}

			const toc = document.querySelector('[data-writing-toc]');
			const tocList = toc?.querySelector('[data-writing-toc-list]');
			if (!toc || !tocList) return;

			const slugify = (text) =>
				text
					.toLowerCase()
					.replace(/[^a-z0-9\s-]/g, '')
					.trim()
					.replace(/\s+/g, '-')
					.replace(/-+/g, '-');

			const idCounts = new Map();
			const headings = [...content.querySelectorAll('h2, h3')].filter((h) => h.textContent?.trim());
			for (const h of headings) {
				if (!h.id) {
					const base = slugify(h.textContent || 'section') || 'section';
					const n = (idCounts.get(base) || 0) + 1;
					idCounts.set(base, n);
					h.id = n === 1 ? base : `${base}-${n}`;
				}
			}

			if (headings.length < 3) {
				toc.setAttribute('hidden', '');
				return;
			}

			const links = [];
			for (const h of headings) {
				const li = document.createElement('li');
				li.className = h.tagName === 'H3' ? 'toc-level-3' : 'toc-level-2';
				const a = document.createElement('a');
				a.href = `#${h.id}`;
				a.textContent = h.textContent?.trim() || '';
				li.appendChild(a);
				tocList.appendChild(li);
				links.push({ heading: h, link: a });
			}

			toc.removeAttribute('hidden');

			const positionTocRail = () => {
				const article = content.closest('.writing-detail-shell')?.querySelector('article.card');
				if (!article) return;
				const articleRect = article.getBoundingClientRect();
				const gap = 18;
				const rightInset = 22;
				const minWidth = 172;
				const desiredLeft = articleRect.right + gap;
				const maxLeft = window.innerWidth - rightInset - minWidth;
				const left = Math.max(8, Math.min(desiredLeft, maxLeft));
				toc.style.left = `${Math.round(left)}px`;
				toc.style.right = `${rightInset}px`;
				toc.style.width = 'auto';
			};

			positionTocRail();

			let activeHeading = null;
			let activeLink = null;

			const setActive = (heading) => {
				if (!heading) return;
				if (activeHeading === heading) return;
				activeHeading = heading;
				for (const { heading: h, link } of links) {
					if (h === heading) {
						link.setAttribute('data-active', 'true');
						activeLink = link;
					} else {
						link.removeAttribute('data-active');
					}
				}

				if (activeLink && toc) {
					const targetTop = activeLink.offsetTop - toc.clientHeight * 0.34;
					const maxTop = Math.max(0, toc.scrollHeight - toc.clientHeight);
					const clampedTop = Math.max(0, Math.min(maxTop, targetTop));
					if (Math.abs(toc.scrollTop - clampedTop) > 8) {
						toc.scrollTo({ top: clampedTop, behavior: 'auto' });
					}
				}
			};

			const findCurrentByPosition = () => {
				const actionBar = document.querySelector('.writing-actions-bar');
				const actionOffset = actionBar ? actionBar.getBoundingClientRect().height : 0;
				const threshold = Math.max(90, actionOffset + 28);
				let current = links[0]?.heading || null;
				for (const { heading } of links) {
					if (heading.getBoundingClientRect().top <= threshold) current = heading;
					else break;
				}
				return current;
			};

			let ticking = false;
			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(() => {
					setActive(findCurrentByPosition());
					ticking = false;
				});
			};

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver((entries) => {
					const visible = entries
						.filter((e) => e.isIntersecting)
						.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
					if (visible.length) setActive(visible[0].target);
				}, { root: null, rootMargin: '-18% 0px -70% 0px', threshold: [0, 0.2, 0.6] });
				for (const { heading } of links) observer.observe(heading);
			}

			setActive(findCurrentByPosition());
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', () => {
				positionTocRail();
				onScroll();
			}, { passive: true });
		})();
	</script>
	<script type="module" src={withBase('/scripts/codeblock-tools.js')}></script>
	<script type="module" src={withBase('/scripts/copy-link.js')}></script>
</SiteLayout>
