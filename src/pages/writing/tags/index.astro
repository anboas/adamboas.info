---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { withBase } from '../../../utils/withBase';

const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

const counts = new Map();
for (const w of writing) {
	for (const t of w.data.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1);
}
for (const p of papers) {
	for (const t of p.data.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1);
}

const tags = [...counts.entries()]
	.sort((a, b) => b[1] - a[1])
	.map(([tag, count]) => ({ tag, count }));
---

<SiteLayout title="Writing Tags | Adam Boas" description="Topics across notes, memos, and papers.">
	<h1 class="text-2xl font-semibold text-slate-50">Writing Tags</h1>
	<p class="mt-2 text-slate-300">Topics across notes, memos, and papers.</p>

	{tags.length ? (
		<ul class="mt-8 flex flex-wrap gap-2">
			{tags.map((t) => (
				<li>
					<a
						class="rounded-full border border-slate-800 bg-slate-950/40 px-3 py-1 text-sm text-slate-200 hover:bg-slate-900"
						href={withBase(`/writing/tags/${t.tag}/`)}
					>
						{t.tag} <span class="text-slate-400">({t.count})</span>
					</a>
				</li>
			))}
		</ul>
	) : (
		<p class="mt-8 text-slate-300">No tags yet.</p>
	)}
</SiteLayout>
