---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../../components/StickyBrowseBar.astro';
import SurfaceHeader from '../../../components/SurfaceHeader.astro';
import { withBase } from '../../../utils/withBase';
import { buildCanonicalTagGroups, slugifyTag } from '../../../utils/tags';

export async function getStaticPaths() {
	const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
	const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');
	const tags = new Set<string>();
	for (const w of writing) for (const t of w.data.tags ?? []) tags.add(t);
	for (const p of papers) for (const t of p.data.tags ?? []) tags.add(t);

	const groups = buildCanonicalTagGroups(tags);
	return groups.map((group) => ({
		params: { tag: group.slug },
		props: { tag: group.label, slug: group.slug, aliases: group.aliases },
	}));
}

const { tag, slug, aliases } = Astro.props as { tag: string; slug: string; aliases: string[] };
const canonicalHref = withBase(`/writing/tags/${slug}/`);
const homeUrl = new URL(withBase('/'), Astro.site).toString();
const writingUrl = new URL(withBase('/writing/'), Astro.site).toString();
const tagUrl = new URL(canonicalHref, Astro.site).toString();

const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

const tagAliases = new Set(aliases);

const items = [
	...writing
		.filter((w) => (w.data.tags ?? []).some((entry) => tagAliases.has(entry) || slugifyTag(entry) === slug))
		.map((w) => ({
			slug: w.id.split('/').pop(),
			type: w.data.type,
			title: w.data.title,
			description: w.data.summary,
			date: w.data.date,
		})),
	...papers
		.filter((p) => (p.data.tags ?? []).some((entry) => tagAliases.has(entry) || slugifyTag(entry) === slug))
		.map((p) => ({
			slug: p.id,
			type: 'paper',
			title: p.data.title,
			description: p.data.description,
			date: p.data.date,
		})),
]
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0));

const fmtDate = (date: Date | undefined) =>
	date
		? date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
		: '';
---

<SiteLayout title={`Writing Tag: ${tag} | Adam Boas`} description={`Writing tagged ${tag}.`} canonicalHref={canonicalHref}>
	<StickyBrowseBar active="writing" />
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
				{ '@type': 'ListItem', position: 2, name: 'Writing', item: writingUrl },
				{ '@type': 'ListItem', position: 3, name: `Tag: ${tag}`, item: tagUrl },
			],
		})}
	/>
	<SurfaceHeader
		eyebrow="Tag view"
		title={`Tag: ${tag}`}
		description={`${items.length} item(s)`}
	>
		<a slot="actions" class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase('/writing/tags/')}>All tags ↗</a>
	</SurfaceHeader>

	<div class="mt-4 grid gap-4 md:mt-5">
		{items.map((w) => (
			<a class="card block p-5 hover:border-slate-700" href={withBase(`/writing/${w.slug}/`)}>
				<div class="flex items-baseline justify-between gap-4">
					<div class="min-w-0">
						<div class="flex items-baseline gap-2">
							<span class="rounded-none border border-slate-700 bg-slate-950/40 px-2 py-0.5 text-[10px] uppercase tracking-wide text-slate-300">
								{w.type}
							</span>
							<h2 class="truncate text-base font-semibold text-slate-50">{w.title}</h2>
						</div>
						{w.description && <p class="mt-2 text-sm text-slate-300">{w.description}</p>}
					</div>
					{w.date && <span class="shrink-0 text-xs text-slate-400">{fmtDate(w.date)}</span>}
				</div>
			</a>
		))}
	</div>
</SiteLayout>
