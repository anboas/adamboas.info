---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { withBase } from '../../../utils/withBase';

export async function getStaticPaths() {
	const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
	const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');
	const tags = new Set<string>();
	for (const w of writing) for (const t of w.data.tags ?? []) tags.add(t);
	for (const p of papers) for (const t of p.data.tags ?? []) tags.add(t);

	// Encode tags into URL-safe slugs (spaces, etc.)
	return [...tags].map((tag) => ({ params: { tag: encodeURIComponent(tag) }, props: { tag } }));
}

const { tag } = Astro.props as { tag: string };

const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

const items = [
	...writing
		.filter((w) => (w.data.tags ?? []).includes(tag))
		.map((w) => ({
			slug: w.id.split('/').pop(),
			type: w.data.type,
			title: w.data.title,
			description: w.data.summary,
			date: w.data.date,
		})),
	...papers
		.filter((p) => (p.data.tags ?? []).includes(tag))
		.map((p) => ({
			slug: p.id,
			type: 'paper',
			title: p.data.title,
			description: p.data.description,
			date: p.data.date,
		})),
]
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0));
---

<SiteLayout title={`Writing Tag: ${tag} | Adam Boas`} description={`Writing tagged ${tag}.`}>
	<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
		<div>
			<h1 class="text-2xl font-semibold text-slate-50">Tag: {tag}</h1>
			<p class="mt-2 text-slate-300">{items.length} item(s)</p>
		</div>
		<a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase('/writing/tags/')}>All tags →</a>
	</div>

	<div class="mt-8 grid gap-4">
		{items.map((w) => (
			<a class="card block p-5 hover:border-slate-700" href={withBase(`/writing/${w.slug}/`)}>
				<div class="flex items-baseline justify-between gap-4">
					<div class="min-w-0">
						<div class="flex items-baseline gap-2">
							<span class="rounded-none border border-slate-700 bg-slate-950/40 px-2 py-0.5 text-[10px] uppercase tracking-wide text-slate-300">
								{w.type}
							</span>
							<h2 class="truncate text-base font-semibold text-slate-50">{w.title}</h2>
						</div>
						{w.description && <p class="mt-2 text-sm text-slate-300">{w.description}</p>}
					</div>
					{w.date && <span class="shrink-0 text-xs text-slate-400">{w.date.toISOString().slice(0, 10)}</span>}
				</div>
			</a>
		))}
	</div>
</SiteLayout>
