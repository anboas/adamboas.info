---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
import writingIndexJs from '../../scripts/writing-index.js?raw';

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));

const items = [
	...writing.map((w) => {
		const slug = w.id.split('/').pop();
		return {
			slug,
			type: w.data.type,
			title: w.data.title,
			description: w.data.summary,
			tags: w.data.tags ?? [],
			date: w.data.date,
		};
	}),
	...papers.map((p) => ({
		slug: p.id,
		type: 'paper',
		title: p.data.title,
		description: p.data.description,
		tags: p.data.tags ?? [],
		date: p.data.date,
	})),
]
	.filter((x) => !!x.slug)
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0));
---

<SiteLayout title="Writing | Adam Boas" description="Notes, memos, and papers." image="/og/writing.png">
	<StickyBrowseBar active="writing" />
	<div data-writing-index>
		<h1 class="text-2xl font-semibold text-slate-50">Writing</h1>
		<div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-slate-300">
			<span class="text-slate-400">Key:</span>
			<span class="writing-key-pill writing-type-pill writing-type-paper rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-wide" data-tooltip="Long-form architecture + reference work" title="Long-form architecture + reference work" tabindex="0">paper</span>
			<span class="writing-key-pill writing-type-pill writing-type-note rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-wide" data-tooltip="Short synthesis and research snapshots" title="Short synthesis and research snapshots" tabindex="0">note</span>
			<span class="writing-key-pill writing-type-pill writing-type-memo rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-wide" data-tooltip="Focused briefs and decision-ready analysis" title="Focused briefs and decision-ready analysis" tabindex="0">memo</span>
		</div>

		<div class="mt-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">

			<div class="grid grid-cols-1 gap-2 md:flex md:items-center">
				<label class="sr-only" for="writing-type">Writing type</label>
				<select id="writing-type" data-writing-type class="w-full rounded-none border border-slate-800 bg-slate-950/40 px-3 py-2 text-sm text-slate-200 md:w-auto">
					<option value="all">All</option>
					<option value="note">Notes</option>
					<option value="memo">Memos</option>
					<option value="paper">Papers</option>
				</select>
				<div class="flex flex-wrap items-center gap-2">
					<label class="sr-only" for="writing-search">Search writing</label>
					<input id="writing-search" data-writing-search class="w-full rounded-none border border-slate-800 bg-slate-950/40 px-3 py-2 text-sm text-slate-200 md:w-72" placeholder="Search title/tags" />
					<button type="button" data-writing-clear class="shrink-0 rounded-none border border-slate-800 bg-slate-950/40 px-3 py-2 text-sm text-slate-200 hover:bg-slate-900">Clear</button>
					<a class="shrink-0 text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase('/writing/tags/')}>Browse tags →</a>
				</div>
			</div>
		</div>

		<div class="mt-3 flex flex-wrap gap-2 text-xs" data-writing-chips></div>
		<script type="module" set:html={writingIndexJs}></script>

		<div class="mt-8 grid gap-4">
			{items.map((w) => (
				<a
					data-writing-card
					data-type={w.type}
					data-title={w.title}
					data-tags={w.tags.join(' ')}
					class="card block overflow-hidden p-5 hover:border-slate-700"
					href={withBase(`/writing/${w.slug}/`)}
				>
					<div class="flex items-baseline justify-between gap-4">
						<div class="min-w-0">
							<div class="flex min-w-0 items-baseline gap-2">
								<span class={`writing-type-pill writing-type-${w.type} rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-wide`}>
									{w.type}
								</span>
								<h2 class="min-w-0 truncate text-base font-semibold text-slate-50">{w.title}</h2>
							</div>
							{w.description && <p class="clamp-3 mt-2 text-sm text-slate-300">{w.description}</p>}
							{w.tags?.length ? (
								<ul class="mt-3 flex flex-wrap gap-2">
									{w.tags.map((t) => (
										<li>
															<button
																type="button"
																data-writing-tag={t}
																class="rounded-full border border-slate-800 px-2 py-0.5 text-[11px] text-slate-300 hover:bg-slate-900"
															>
																{t}
															</button>
														</li>
									))}
								</ul>
							) : null}
						</div>
						{w.date && <span class="shrink-0 text-xs text-slate-400">{w.date.toISOString().slice(0, 10)}</span>}
					</div>
				</a>
			))}
		</div>

		<p class="mt-6 hidden text-sm text-slate-400" data-writing-empty>
			No results. Try clearing filters.
		</p>
	</div>
</SiteLayout>
