---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../components/SurfacePageHeader.astro';
import { withBase } from '../../utils/withBase';
import FilterShell from '../../components/ui/FilterShell.astro';
import SearchControl from '../../components/ui/SearchControl.astro';
import writingIndexJs from '../../scripts/writing-index.js?raw';

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));

const items = [
	...writing.map((w) => {
		const slug = w.id.split('/').pop();
		return {
			slug,
			type: w.data.type,
			title: w.data.title,
			description: w.data.summary,
			tags: w.data.tags ?? [],
			date: w.data.date,
			hasAudio: Boolean(w.data.audioPath),
		};
	}),
	...papers.map((p) => ({
		slug: p.id,
		type: 'paper',
		title: p.data.title,
		description: p.data.description,
		tags: p.data.tags ?? [],
		date: p.data.date,
		hasAudio: Boolean(p.data.audioPath),
	})),
]
	.filter((x) => !!x.slug)
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0));

const fmtDate = (date: Date | undefined) =>
	date ? date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---

<SiteLayout
	title="Writing on AI Autonomy, Governance, and Modernization | Adam Boas"
	description="Published notes, memos, and papers on AI autonomy, governance, cybersecurity, DevSecOps, and software modernization."
	image="/og/writing.png"
>
	<div data-writing-index>
		<SurfacePageHeader
			stickyActive="writing"
			eyebrow="Published Work"
			title="Writing"
			description="Notes, memos, and papers on defense technology, software modernization, AI governance, and mission systems."
		/>

		<section class="agent-only card mt-3 p-3 text-xs text-slate-300" aria-label="Agent extraction hints">
			<p class="font-semibold text-slate-100">Agent extraction mode active</p>
			<ul class="mt-2 space-y-1">
				<li>
					Canonical corpus endpoint: <a class="underline" href={withBase('/writing/manifest.json')}
						>/writing/manifest.json</a
					>
				</li>
				<li>Use <code>?view=agent</code> on detail pages for lower-noise parsing.</li>
				<li>Prefer publication timestamps from manifest over DOM ordering.</li>
			</ul>
		</section>

		<FilterShell class="writing-index-controls mt-4 p-2.5 md:mt-5 md:p-3">
			<div class="control-shell-row flex flex-wrap items-center gap-2 md:gap-3">
				<div
					class="flex flex-wrap items-center gap-2 text-xs text-slate-300"
					role="group"
					aria-label="Filter writing by type"
				>
					<button
						type="button"
						data-writing-set-all
						aria-pressed="true"
						class="writing-key-pill inline-flex h-11 items-center rounded-full border px-3 py-0 text-[10px] uppercase tracking-wide sm:h-8"
						data-tooltip="Show all writing types"
						title="Show all writing types">all</button
					>
					<button
						type="button"
						data-writing-type-toggle="paper"
						aria-pressed="true"
						class="writing-key-pill writing-type-toggle writing-type-pill writing-type-paper inline-flex h-11 items-center rounded-full border px-3 py-0 text-[10px] uppercase tracking-wide sm:h-8"
						data-tooltip="Long-form architecture + reference work"
						title="Long-form architecture + reference work">paper</button
					>
					<button
						type="button"
						data-writing-type-toggle="note"
						aria-pressed="true"
						class="writing-key-pill writing-type-toggle writing-type-pill writing-type-note inline-flex h-11 items-center rounded-full border px-3 py-0 text-[10px] uppercase tracking-wide sm:h-8"
						data-tooltip="Short synthesis and research snapshots"
						title="Short synthesis and research snapshots">note</button
					>
					<button
						type="button"
						data-writing-type-toggle="memo"
						aria-pressed="true"
						class="writing-key-pill writing-type-toggle writing-type-pill writing-type-memo inline-flex h-11 items-center rounded-full border px-3 py-0 text-[10px] uppercase tracking-wide sm:h-8"
						data-tooltip="Focused briefs and decision-ready analysis"
						title="Focused briefs and decision-ready analysis">memo</button
					>
				</div>

				<div class="flex w-full flex-wrap items-center gap-2 md:ml-auto md:w-auto">
					<div class="w-full sm:w-auto">
						<SearchControl
							id="writing-search"
							label="Search writing"
							data-writing-search
							data-global-search
							class="h-11 w-full rounded-none border border-slate-800 bg-slate-950 px-2.5 text-sm text-slate-200 sm:h-8 sm:w-64"
							placeholder="Search writing..."
						/>
					</div>
					<label class="sr-only" for="writing-sort">Sort writing</label>
					<select
						id="writing-sort"
						data-writing-sort
						class="h-11 shrink-0 rounded-none border border-slate-800 bg-slate-950 px-2.5 text-sm text-slate-200 sm:h-8"
					>
						<option value="newest">Newest</option>
						<option value="oldest">Oldest</option>
						<option value="title">Title A-Z</option>
					</select>
					<button
						type="button"
						data-writing-clear
						disabled
						class="h-11 shrink-0 rounded-none border border-slate-800 bg-slate-950 px-2.5 text-sm text-slate-200 hover:bg-slate-900 sm:h-8"
						>Clear</button
					>
					<a class="ui-link-btn h-11 px-2.5 text-sm sm:h-8" href={withBase('/writing/tags/')}>Tags</a>
				</div>
			</div>

			<div class="writing-active-strip mt-2 hidden flex-wrap gap-2 text-xs" data-writing-chips aria-live="polite"></div>
		</FilterShell>
		<script type="module" set:html={writingIndexJs} />

		<div class="mt-6 flex flex-wrap items-end justify-between gap-2 md:mt-7">
			<h2 class="section-title">All Writing</h2>
			<p class="text-xs text-slate-400" data-writing-result-count aria-live="polite" aria-atomic="true">
				{items.length} published items
			</p>
		</div>

		<div class="mt-6 grid gap-4 md:mt-7" data-writing-list>
			{
				items.map((w) => (
					<a
						data-writing-card
						data-type={w.type}
						data-title={w.title}
						data-tags={w.tags.join(' ')}
						data-date-ms={w.date?.valueOf?.() ?? 0}
						class="card block overflow-hidden p-5 hover:border-slate-700"
						href={withBase(`/writing/${w.slug}/`)}
					>
						<div class="flex items-center justify-between gap-4">
							<div class="flex items-center gap-2">
								<span
									class={`writing-type-pill writing-type-${w.type} rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-wide`}
								>
									{w.type}
								</span>
								{w.hasAudio ? (
									<span
										class="shrink-0 rounded-full border border-emerald-700/70 bg-emerald-950/40 px-1.5 py-0 text-[10px] text-emerald-200"
										title="Audio or podcast available"
										aria-label="Audio available"
									>
										🎧
									</span>
								) : null}
							</div>
							{w.date && <span class="shrink-0 text-xs text-slate-400">{fmtDate(w.date)}</span>}
						</div>
						<h2 data-writing-card-title class="clamp-2 mt-2 break-words text-base font-bold leading-snug text-slate-50">
							{w.title}
						</h2>
						{w.description && (
							<p data-writing-card-description class="clamp-3 mt-2 text-sm text-slate-300">
								{w.description}
							</p>
						)}
					</a>
				))
			}
		</div>

		<div class="mt-4 hidden flex flex-wrap items-center justify-between gap-2 md:flex-nowrap" data-writing-pagination>
			<p class="text-xs text-slate-400" data-writing-pagination-status></p>
			<div class="flex w-full items-center justify-between gap-3 sm:w-auto sm:justify-start sm:gap-2">
				<button
					type="button"
					data-writing-page-first
					class="hidden items-center justify-center rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-xs text-slate-200 hover:bg-slate-900 disabled:opacity-50 disabled:hover:bg-slate-950 sm:inline-flex"
					>First</button
				>
				<button
					type="button"
					data-writing-page-prev
					class="min-h-11 rounded-none border border-slate-800 bg-slate-950 px-4 py-1.5 text-xs text-slate-200 hover:bg-slate-900 disabled:opacity-50 disabled:hover:bg-slate-950 sm:min-h-0 sm:px-2.5"
					>Prev</button
				>
				<span class="text-xs text-slate-300" data-writing-page-label>Page 1 of 1</span>
				<button
					type="button"
					data-writing-page-next
					class="min-h-11 rounded-none border border-slate-800 bg-slate-950 px-4 py-1.5 text-xs text-slate-200 hover:bg-slate-900 disabled:opacity-50 disabled:hover:bg-slate-950 sm:min-h-0 sm:px-2.5"
					>Next</button
				>
				<button
					type="button"
					data-writing-page-last
					class="hidden items-center justify-center rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-xs text-slate-200 hover:bg-slate-900 disabled:opacity-50 disabled:hover:bg-slate-950 sm:inline-flex"
					>Last</button
				>
			</div>
		</div>

		<p class="mt-6 hidden text-sm text-slate-400" data-writing-empty>No results. Try clearing filters.</p>
	</div>
</SiteLayout>

<style>
	.writing-active-strip {
		position: sticky;
		top: 0.5rem;
		z-index: 12;
		min-height: 0;
		padding-top: 0.1rem;
	}
</style>
