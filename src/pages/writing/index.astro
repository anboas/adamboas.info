---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const notes = writing.filter((w) => w.data.type === 'note');
const memos = writing.filter((w) => w.data.type === 'memo');

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));
---

<SiteLayout title="Writing | Adam Boas" description="Notes, memos, and papers.">
	<StickyBrowseBar active="writing" />
	<div data-writing-index>
		<h1 class="text-2xl font-semibold text-slate-50">Writing</h1>
		<p class="mt-2 text-slate-300">Notes (short-form), memos (briefs), and papers (whitepapers).</p>

		<div class="mt-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
			<div class="flex flex-wrap gap-2 text-sm">
				<a class="rounded-none border border-slate-800 bg-slate-950/40 px-3 py-1 text-slate-200 hover:bg-slate-900" href={withBase('/writing/')}>All</a>
				<a class="rounded-none border border-slate-800 bg-slate-950/40 px-3 py-1 text-slate-200 hover:bg-slate-900" href={withBase('/writing/?type=note')}>Notes</a>
				<a class="rounded-none border border-slate-800 bg-slate-950/40 px-3 py-1 text-slate-200 hover:bg-slate-900" href={withBase('/writing/?type=memo')}>Memos</a>
				<a class="rounded-none border border-slate-800 bg-slate-950/40 px-3 py-1 text-slate-200 hover:bg-slate-900" href={withBase('/writing/?type=paper')}>Papers</a>
			</div>

			<div class="flex flex-col gap-2 md:flex-row md:items-center">
				<select data-writing-type class="rounded-none border border-slate-800 bg-slate-950/40 px-3 py-2 text-sm text-slate-200">
					<option value="all">All</option>
					<option value="note">Notes</option>
					<option value="memo">Memos</option>
					<option value="paper">Papers</option>
				</select>
				<input data-writing-search class="w-full rounded-none border border-slate-800 bg-slate-950/40 px-3 py-2 text-sm text-slate-200 md:w-72" placeholder="Search title/tags" />
			</div>
		</div>

		<script type="module" src={new URL('scripts/writing-index.js', Astro.site)}></script>

		<p class="mt-4 text-sm text-slate-400">
			<a class="font-semibold text-stone-100 hover:text-stone-50" href={withBase('/writing/tags/')}>Browse tags →</a>
		</p>

	{notes.length ? (
		<section class="mt-10" data-type-section="note">
			<h2 class="text-xl font-semibold text-slate-50">Notes</h2>
			<div class="mt-6 grid gap-4">
				{notes.map((w) => {
					const slug = w.id.split('/').pop();
					return (
						<a data-writing-card data-type="note" data-title={w.data.title} data-tags={(w.data.tags ?? []).join(' ')} class="card block p-5 hover:border-slate-700" href={withBase(`/writing/${slug}/`)}>
							<div class="flex items-baseline justify-between gap-4">
								<div class="flex min-w-0 items-baseline gap-2">
									<span class="rounded-full border border-slate-800 px-2 py-0.5 text-[10px] uppercase tracking-wide text-slate-300">Note</span>
									<h3 class="truncate text-base font-semibold text-slate-50">{w.data.title}</h3>
								</div>
								<span class="shrink-0 text-xs text-slate-400">{w.data.date.toISOString().slice(0, 10)}</span>
							</div>
							{w.data.summary && <p class="mt-2 text-sm text-slate-300">{w.data.summary}</p>}
							{w.data.tags?.length ? (
								<ul class="mt-3 flex flex-wrap gap-2">
									{w.data.tags.map((t) => (
										<li class="rounded-full border border-slate-800 px-2 py-0.5 text-[11px] text-slate-300">{t}</li>
									))}
								</ul>
							) : null}
						</a>
					);
				})}
			</div>
		</section>
	) : null}

	{memos.length ? (
		<section class="mt-10" data-type-section="memo">
			<h2 class="text-xl font-semibold text-slate-50">Memos</h2>
			<div class="mt-6 grid gap-4">
				{memos.map((w) => {
					const slug = w.id.split('/').pop();
					return (
						<a data-writing-card data-type="memo" data-title={w.data.title} data-tags={(w.data.tags ?? []).join(' ')} class="card block p-5 hover:border-slate-700" href={withBase(`/writing/${slug}/`)}>
							<div class="flex items-baseline justify-between gap-4">
								<div class="flex min-w-0 items-baseline gap-2">
									<span class="rounded-full border border-slate-800 px-2 py-0.5 text-[10px] uppercase tracking-wide text-slate-300">Memo</span>
									<h3 class="truncate text-base font-semibold text-slate-50">{w.data.title}</h3>
								</div>
								<span class="shrink-0 text-xs text-slate-400">{w.data.date.toISOString().slice(0, 10)}</span>
							</div>
							{w.data.summary && <p class="mt-2 text-sm text-slate-300">{w.data.summary}</p>}
							{w.data.tags?.length ? (
								<ul class="mt-3 flex flex-wrap gap-2">
									{w.data.tags.map((t) => (
										<li class="rounded-full border border-slate-800 px-2 py-0.5 text-[11px] text-slate-300">{t}</li>
									))}
								</ul>
							) : null}
						</a>
					);
				})}
			</div>
		</section>
	) : null}

	<section class="mt-10" data-type-section="paper">
		<h2 class="text-xl font-semibold text-slate-50">Papers</h2>
		<p class="mt-2 text-slate-300">Whitepapers and working docs.</p>
		<div class="mt-6 grid gap-6">
			{papers.map((p) => (
				<a data-writing-card data-type="paper" data-title={p.data.title} data-tags={(p.data.tags ?? []).join(' ')} class="card block p-6 hover:border-slate-700" href={withBase(`/writing/${p.id}/`)}>
					<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
						<h3 class="text-lg font-semibold text-slate-50">{p.data.title}</h3>
						{p.data.date && <span class="text-sm text-slate-400">{p.data.date.toISOString().slice(0, 10)}</span>}
					</div>
					{p.data.description && <p class="mt-3 text-sm text-slate-300">{p.data.description}</p>}
					{p.data.tags?.length ? (
						<ul class="mt-4 flex flex-wrap gap-2">
							{p.data.tags.map((t) => (
								<li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1 text-xs text-slate-200">{t}</li>
							))}
						</ul>
					) : null}
				</a>
			))}
		</div>
	</section>
</SiteLayout>
