---
import SiteLayout from '../layouts/SiteLayout.astro';
import SurfacePageHeader from '../components/SurfacePageHeader.astro';
import { withBase } from '../utils/withBase';
import { radarEventsSeed } from '../data/radar/events';
import sofweekIntel from '../data/radar/intel/sofweek-intel.json';
import feedCrawlReport from '../data/radar/feed-crawl-report-latest.json';
import opportunitiesDrift from '../data/radar/events-candidates-sam-opportunities-drift-latest.json';

const samIntelOverrides: Record<string, any> = {
	'radar-sofweek-2026': sofweekIntel,
};

function samIntel(event: (typeof radarEventsSeed)[number]) {
	return samIntelOverrides[event.id] ?? event.ontology.acquisition?.samIntelligence ?? null;
}

const lastCollectedAt =
	radarEventsSeed
		.map((event) => samIntel(event)?.collectedAt as string | undefined)
		.filter(Boolean)
		.sort()
		.at(-1) ?? null;

const feedSummary = (feedCrawlReport?.summary ?? {}) as Record<string, number>;
const feedGeneratedAt =
	typeof (feedCrawlReport as any)?.generatedAt === 'string' ? (feedCrawlReport as any).generatedAt : null;

const driftLatest = (opportunitiesDrift ?? {}) as any;
const driftGeneratedAt = typeof driftLatest.generated_at === 'string' ? driftLatest.generated_at : null;
const driftDeltas = (driftLatest.deltas ?? {}) as Record<string, number>;

const nowMs = Date.now();

type FreshnessTone = 'ok' | 'warn' | 'bad' | 'muted';
type FreshnessState = {
	label: 'Fresh' | 'Lagging' | 'Stale' | 'Unknown';
	tone: FreshnessTone;
	detail: string;
};

function ageHours(value: string | null) {
	if (!value) return null;
	const parsed = new Date(value);
	if (Number.isNaN(parsed.getTime())) return null;
	return Math.max(0, (nowMs - parsed.getTime()) / (1000 * 60 * 60));
}

function relativeAgeLabel(hours: number | null) {
	if (hours === null) return 'age unavailable';
	if (hours < 1) return 'updated <1h ago';
	if (hours < 24) return `updated ${Math.round(hours)}h ago`;
	const days = Math.round((hours / 24) * 10) / 10;
	return `updated ${days}d ago`;
}

function freshnessState(hours: number | null, warnHours: number, staleHours: number): FreshnessState {
	if (hours === null) return { label: 'Unknown', tone: 'muted', detail: 'missing timestamp' };
	if (hours <= warnHours) return { label: 'Fresh', tone: 'ok', detail: relativeAgeLabel(hours) };
	if (hours <= staleHours) return { label: 'Lagging', tone: 'warn', detail: relativeAgeLabel(hours) };
	return { label: 'Stale', tone: 'bad', detail: relativeAgeLabel(hours) };
}

const feedFreshness = freshnessState(ageHours(feedGeneratedAt), 18, 36);
const samFreshness = freshnessState(ageHours(lastCollectedAt), 24, 48);
const driftFreshness = freshnessState(ageHours(driftGeneratedAt), 24, 48);

const staleSignals = [feedFreshness, samFreshness, driftFreshness].filter((x) => x.label === 'Stale').length;
const laggingSignals = [feedFreshness, samFreshness, driftFreshness].filter((x) => x.label === 'Lagging').length;

function fmtDate(value: string | null) {
	if (!value) return '—';
	const parsed = new Date(value);
	if (Number.isNaN(parsed.getTime())) return '—';
	return parsed.toLocaleString(undefined, {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		hour: '2-digit',
		minute: '2-digit',
	});
}

function signed(value: number) {
	if (!Number.isFinite(value)) return '0';
	if (value > 0) return `+${Math.round(value)}`;
	return String(Math.round(value));
}
---

<SiteLayout title="Status | Adam Boas" description="Deployment + data pipeline status for adamboas.com" noindex={true}>
	<SurfacePageHeader
		stickyActive="home"
		eyebrow="Operations"
		title="Operations Status"
		description="Live deployment signal and data-pipeline freshness for events and opportunities."
	>
		<a
			slot="actions"
			class="ui-link-btn"
			href="https://github.com/anboas/adamboas.info/actions/workflows/deploy-dev-pages.yml"
			target="_blank"
			rel="noreferrer">Open deploy workflow</a
		>
	</SurfacePageHeader>

	<section class="mt-3">
		<div class="status-health-banner" data-state={staleSignals > 0 ? 'bad' : laggingSignals > 0 ? 'warn' : 'ok'}>
			<p class="status-health-banner-title">Pipeline health</p>
			<p class="status-health-banner-copy">
				{
					staleSignals > 0
						? `${staleSignals} stale signal${staleSignals > 1 ? 's' : ''} detected. Priority: refresh pipeline runs.`
						: laggingSignals > 0
							? `${laggingSignals} signal${laggingSignals > 1 ? 's are' : ' is'} lagging. Monitor next scheduled runs.`
							: 'All monitored signals are fresh.'
				}
			</p>
		</div>
	</section>

	<section class="mt-4 grid gap-4 lg:grid-cols-3">
		<article class="card p-4 status-card lg:col-span-1">
			<h2 class="status-title">Deploy</h2>
			<p class="status-copy">Main branch GitHub Actions status.</p>
			<a
				class="status-badge-wrap"
				href="https://github.com/anboas/adamboas.info/actions/workflows/deploy-dev-pages.yml"
				target="_blank"
				rel="noreferrer"
			>
				<img
					src="https://github.com/anboas/adamboas.info/actions/workflows/deploy-dev-pages.yml/badge.svg?branch=main"
					alt="Deploy status badge"
					loading="lazy"
					decoding="async"
					class="h-5 w-auto"
				/>
			</a>
		</article>

		<article class="card p-4 status-card lg:col-span-2">
			<h2 class="status-title">Feed crawl</h2>
			<p class="status-copy">Last full source-crawl snapshot and source health counts.</p>
			<div class="status-health-row">
				<span class="status-pill" data-tone={feedFreshness.tone}>{feedFreshness.label}</span>
				<span class="status-health-detail">{feedFreshness.detail}</span>
			</div>
			<div class="status-grid mt-3">
				<div class="status-kpi"><span>Generated</span><strong>{fmtDate(feedGeneratedAt)}</strong></div>
				<div class="status-kpi">
					<span>Sources ok</span><strong>{Number(feedSummary.ok ?? 0)} / {Number(feedSummary.total ?? 0)}</strong>
				</div>
				<div class="status-kpi"><span>Blocked</span><strong>{Number(feedSummary.blocked ?? 0)}</strong></div>
				<div class="status-kpi"><span>Failed</span><strong>{Number(feedSummary.failed ?? 0)}</strong></div>
			</div>
			<div class="mt-3 flex flex-wrap gap-2 text-xs">
				<a
					class="ui-link-btn"
					href="https://github.com/anboas/adamboas.info/blob/main/src/data/radar/feed-crawl-report-latest.md"
					target="_blank"
					rel="noreferrer">Open feed crawl report</a
				>
			</div>
		</article>
	</section>

	<section class="mt-4 grid gap-4 lg:grid-cols-2">
		<article class="card p-4 status-card">
			<h2 class="status-title">SAM opportunities</h2>
			<p class="status-copy">Freshness of opportunity enrichment inputs.</p>
			<div class="status-health-row">
				<span class="status-pill" data-tone={samFreshness.tone}>SAM {samFreshness.label}</span>
				<span class="status-health-detail">{samFreshness.detail}</span>
			</div>
			<div class="status-health-row mt-1">
				<span class="status-pill" data-tone={driftFreshness.tone}>Drift {driftFreshness.label}</span>
				<span class="status-health-detail">{driftFreshness.detail}</span>
			</div>
			<div class="status-grid mt-3">
				<div class="status-kpi"><span>Last collected</span><strong>{fmtDate(lastCollectedAt)}</strong></div>
				<div class="status-kpi"><span>Drift refreshed</span><strong>{fmtDate(driftGeneratedAt)}</strong></div>
				<div class="status-kpi">
					<span>Δ high confidence</span><strong>{signed(Number(driftDeltas.high_confidence ?? 0))}</strong>
				</div>
				<div class="status-kpi">
					<span>Δ 3P errors</span><strong>{signed(Number(driftDeltas.us_errors ?? 0))}</strong>
				</div>
			</div>
			<div class="mt-3 flex flex-wrap gap-2 text-xs">
				<a
					class="ui-link-btn"
					href="https://github.com/anboas/adamboas.info/blob/main/src/data/radar/events-candidates-sam-opportunities-drift-latest.md"
					target="_blank"
					rel="noreferrer">Open drift report</a
				>
				<a class="ui-link-btn" href={withBase('/opportunities/')}>Open opportunities</a>
			</div>
		</article>

		<article class="card p-4 status-card">
			<h2 class="status-title">Quick routes</h2>
			<p class="status-copy">Jump straight to the working surfaces.</p>
			<ul class="status-list mt-3">
				<li><a href={withBase('/events/')}>Events</a></li>
				<li><a href={withBase('/opportunities/')}>Opportunities</a></li>
				<li><a href={withBase('/status/site-analytics/')}>Sitemap traffic analytics</a></li>
				<li><a href={withBase('/changes/')}>Release changelog</a></li>
				<li><a href={withBase('/contact/')}>Contact intake</a></li>
			</ul>
		</article>
	</section>
</SiteLayout>

<style>
	.status-card {
		border: 1px solid rgba(51, 65, 85, 0.85);
		background: rgba(2, 6, 23, 0.9);
	}
	.status-health-banner {
		display: grid;
		gap: 0.25rem;
		border: 1px solid rgba(51, 65, 85, 0.85);
		padding: 0.7rem 0.8rem;
		background: rgba(2, 6, 23, 0.84);
	}
	.status-health-banner[data-state='ok'] {
		border-color: rgba(16, 185, 129, 0.4);
		background: rgba(2, 32, 24, 0.4);
	}
	.status-health-banner[data-state='warn'] {
		border-color: rgba(245, 158, 11, 0.45);
		background: rgba(52, 34, 2, 0.38);
	}
	.status-health-banner[data-state='bad'] {
		border-color: rgba(244, 63, 94, 0.45);
		background: rgba(55, 12, 20, 0.42);
	}
	.status-health-banner-title {
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(203, 213, 225, 0.95);
		font-weight: 600;
	}
	.status-health-banner-copy {
		font-size: 0.86rem;
		color: rgba(226, 232, 240, 0.98);
	}
	.status-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: rgba(241, 245, 249, 0.98);
	}
	.status-copy {
		margin-top: 0.25rem;
		font-size: 0.8rem;
		color: rgba(148, 163, 184, 0.98);
	}
	.status-health-row {
		margin-top: 0.5rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
	}
	.status-pill {
		display: inline-flex;
		align-items: center;
		border: 1px solid rgba(71, 85, 105, 0.9);
		padding: 0.15rem 0.5rem;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(226, 232, 240, 0.96);
		background: rgba(15, 23, 42, 0.72);
	}
	.status-pill[data-tone='ok'] {
		border-color: rgba(16, 185, 129, 0.5);
		background: rgba(4, 120, 87, 0.18);
		color: rgba(167, 243, 208, 0.98);
	}
	.status-pill[data-tone='warn'] {
		border-color: rgba(245, 158, 11, 0.5);
		background: rgba(120, 53, 15, 0.22);
		color: rgba(253, 230, 138, 0.98);
	}
	.status-pill[data-tone='bad'] {
		border-color: rgba(244, 63, 94, 0.52);
		background: rgba(159, 18, 57, 0.24);
		color: rgba(254, 205, 211, 0.98);
	}
	.status-pill[data-tone='muted'] {
		border-color: rgba(71, 85, 105, 0.9);
		background: rgba(15, 23, 42, 0.72);
		color: rgba(203, 213, 225, 0.95);
	}
	.status-health-detail {
		font-size: 0.74rem;
		color: rgba(148, 163, 184, 0.95);
	}
	.status-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.status-kpi {
		border: 1px solid rgba(51, 65, 85, 0.85);
		background: rgba(2, 6, 23, 0.75);
		padding: 0.5rem 0.55rem;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.status-kpi span {
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(148, 163, 184, 0.94);
	}
	.status-kpi strong {
		font-size: 0.85rem;
		line-height: 1.25;
		color: rgba(226, 232, 240, 0.98);
		overflow-wrap: anywhere;
	}
	/* action links use global ui-link-btn classes */
	.status-badge-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 0.8rem;
		border: 1px solid rgba(51, 65, 85, 0.84);
		background: rgba(2, 6, 23, 0.72);
		padding: 0.45rem 0.5rem;
	}
	.status-list {
		display: grid;
		gap: 0.45rem;
		font-size: 0.86rem;
	}
	.status-list a {
		color: rgba(191, 219, 254, 0.97);
	}
	.status-list a:hover {
		color: rgba(224, 242, 254, 0.99);
	}
	@media (max-width: 760px) {
		.status-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
