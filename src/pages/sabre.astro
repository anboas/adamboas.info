---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../utils/withBase';
import {
	budgetRollup,
	firstThirtyDays,
	growthPlays,
	opportunityAssessment,
	sabreUpdatedAt,
	serviceLanes,
	sources,
	workSources,
} from '../data/sabre';

const title = 'Sabre Growth Intelligence | Adam Boas';
const description =
	'A concise, action-forward growth strategy brief for Sabre Systems: market terrain, priority customers, Sabre fit, productized offers, and first-30-days operating plan.';
const maxBook = Math.max(...budgetRollup.books.map((book) => book.valueB));
const maxOrg = Math.max(...budgetRollup.orgs.map((org) => org.valueB));
const heatmapMax = Math.max(
	...budgetRollup.heatmap.flatMap((row) => [row.oAndM, row.procurement, row.rdte, row.milpers, row.milcon]),
);
const heatKeys = [
	{ key: 'oAndM', label: 'O&M' },
	{ key: 'procurement', label: 'Procurement' },
	{ key: 'rdte', label: 'RDT&E' },
	{ key: 'milpers', label: 'MILPERS' },
	{ key: 'milcon', label: 'MILCON' },
] as const;

const strategyCards = [
	{
		label: 'Strategy',
		title: 'Build a growth architecture function',
		body: 'Operate between account insight, technical solutioning, partner leverage, contract path, and delivery feedback. Do not become a deck factory.',
	},
	{
		label: 'Market',
		title: 'Prioritize buyers with pain, money, and channel',
		body: 'The best targets have a named mission friction, budget owner, buying path, and a reason Sabre can credibly move faster than incumbents.',
	},
	{
		label: 'Offer',
		title: 'Productize the Sabre + partner wedge',
		body: 'Turn broad capability into named modernization plays: agentic software, digital engineering, cATO evidence, test acceleration, and workflow modernization.',
	},
	{
		label: 'Proof',
		title: 'Use delivery evidence to create the next pursuit',
		body: 'Every pilot should produce metrics, artifacts, CPARS-quality proof, a follow-on path, and reusable language for the next customer.',
	},
];

const marketRealities = [
	{
		title: 'Demand is broad. Buyer-ready demand is narrow.',
		meaning:
			'Every service says AI, software, data, cyber, autonomy, and digital engineering matter. Strategy means finding the few places where pain, authority, and funding align.',
		move: 'Score signals by mission pain, money path, vehicle, Sabre right-to-win, partner leverage, and follow-on scale.',
	},
	{
		title: 'The money is split across experiments, operations, and programs.',
		meaning:
			'RDT&E starts experiments, O&M scales enterprise services and sustainment, and procurement turns modernization into durable platform spend.',
		move: 'Match each offer to the color of money before shaping the capture story.',
	},
	{
		title: 'AI only matters when attached to a hard workflow.',
		meaning:
			'Customers will buy outcomes: backlog burn-down, test evidence, ATO speed, data products, readiness insight, and lower integration drag.',
		move: 'Lead with measurable cycle-time or decision-quality improvement, then explain the AI.',
	},
	{
		title: 'Product companies need a federal integration wrapper.',
		meaning:
			'Vendors bring tools; Sabre can bring mission context, secure adoption, RMF evidence, test, sustainment, and customer trust.',
		move: 'Make Cognition/Devin the first partner proof, then repeat the pattern with data, cloud, cyber, and mission-tech firms.',
	},
];

const customerPriorities = [
	{
		lane: serviceLanes[0],
		priority: '1',
		strategy: 'Primary wedge',
		why: 'EWAAC gives Sabre a concrete Air Force foothold, and the DAF modernization agenda is rich in weapons integration, digital engineering, test, software, and data needs.',
		firstQuestion: 'Which Eglin or DAF workflows are painful, funded, and measurable enough for a 60-90 day pilot?',
		firstMove:
			'Take three offers to Denver: EWAAC digital engineering acceleration, Devin-backed software throughput, and test/evidence automation.',
	},
	{
		lane: serviceLanes[3],
		priority: '2',
		strategy: 'Scale field',
		why: 'DISA, DLA, DHA, CDAO, MDA, and other Defense-Wide buyers sit on enterprise pain where software, data, cyber, workflow, and compliance converge.',
		firstQuestion:
			'Where does an enterprise buyer have a slow workflow, a data bottleneck, or an authorization drag that Sabre can shrink quickly?',
		firstMove:
			'Pick one Fourth Estate lighthouse account and shape a pilot around secure modernization plus measurable cycle-time reduction.',
	},
	{
		lane: serviceLanes[2],
		priority: '3',
		strategy: 'Proof base',
		why: 'NAVAIR and Navy work prove Sabre can perform in mission systems, but the growth move is to turn that proof into reusable Navy/Marine digital-thread and sustainment offers.',
		firstQuestion:
			'Which NAVAIR lessons can open NAVSEA, NIWC, PEO Digital, unmanned, shipyard, or Marine Corps conversations?',
		firstMove: 'Harvest NAVAIR/NDD patterns into portable offer language and account-specific proof artifacts.',
	},
	{
		lane: serviceLanes[1],
		priority: '4',
		strategy: 'APG expansion',
		why: 'Army C5ISR, tactical network, EW, cyber, lab, and depot modernization are natural extensions if Sabre avoids generic staffing language.',
		firstQuestion:
			'Where do APG/C5ISR relationships expose modernization friction that can be shaped into funded technical work?',
		firstMove:
			'Map existing Sabre access at APG, then select two pursuits with buyer, vehicle, partner, and first proof defined.',
	},
];

const proofMoves = [
	{
		proof: '$499M NAWCAD SED award',
		means: 'Sabre has mission-systems credibility in complex Navy aviation environments.',
		strategy:
			'Translate that into digital-thread, test, data, software, and cyber offers for adjacent Navy/Marine buyers.',
	},
	{
		proof: 'Prime position on EWAAC',
		means: 'Sabre has a practical entry point into Air Force armament and rapid acquisition work.',
		strategy: 'Use EWAAC as the first Air Force growth operating lane, not just a contract logo.',
	},
	{
		proof: 'APG / C5ISR presence',
		means:
			'Sabre can credibly enter Army technical conversations around communications, cyber, integration, and lab modernization.',
		strategy: 'Package APG access into C5ISR modernization pursuits with clear technical discriminators.',
	},
	{
		proof: 'Cognition / Devin relationship',
		means: 'Adam can bring a live commercial wedge into Sabre, but only if it is wrapped for federal adoption.',
		strategy:
			'Make Sabre the SI wrapper: security, RMF evidence, evaluation, human review, deployment, and sustainment.',
	},
];
---

<SiteLayout title={title} description={description}>
	<a id="page-top" class="block" aria-hidden="true"></a>

	<section class="sabre-hero">
		<div>
			<p class="sabre-kicker">Sabre Systems growth strategy</p>
			<h1>Where to play, who matters, and what to sell first</h1>
			<p class="sabre-lede">
				The growth strategy is to turn Sabre's mission-systems credibility into a repeatable modernization operating
				model: identify funded friction, shape a practical technical offer, bring the right partner, and convert early
				proof into durable pipeline.
			</p>
		</div>
		<div class="hero-metrics" aria-label="Strategic priorities">
			<div>
				<span>DAF</span>
				<p>Primary wedge through EWAAC, Eglin, weapons, test, software, and data modernization.</p>
			</div>
			<div>
				<span>4E</span>
				<p>Enterprise scale through DISA, DLA, DHA, CDAO, MDA, cyber, data, and workflow pain.</p>
			</div>
			<div>
				<span>NAVAIR</span>
				<p>Proof base to translate into adjacent Navy, Marine Corps, Army, and joint modernization plays.</p>
			</div>
		</div>
	</section>

	<nav class="sabre-nav" aria-label="Sabre page sections">
		<a href="#strategy">Strategy</a>
		<a href="#market">Market</a>
		<a href="#customers">Customers</a>
		<a href="#fit">Sabre Fit</a>
		<a href="#offers">Offers</a>
		<a href="#first30">First 30 Days</a>
		<a href="#evidence">Evidence</a>
		<a href="#sources">Sources</a>
	</nav>

	<section id="strategy" class="sabre-section two-col">
		<div>
			<p class="section-eyebrow">Operating thesis</p>
			<h2>Sabre should become the integrator that converts mission friction into funded modernization.</h2>
			<p>
				Adam's role should not be "AI guy" or generic business development. It should be growth architecture:
				translating customer pain into a technical, contractual, and partner-backed path that Sabre can win and deliver.
			</p>
			<div class="strategy-callout">
				<strong>Strategy in one sentence:</strong> use NAVAIR and APG as proof, Air Force as the near-term wedge, Fourth Estate
				as the scale field, and Cognition/Devin as the first partner-led modernization offer.
			</div>
		</div>
		<div class="thesis-grid">
			{
				strategyCards.map((card) => (
					<div>
						<strong>{card.label}</strong>
						<h3>{card.title}</h3>
						<span>{card.body}</span>
					</div>
				))
			}
		</div>
	</section>

	<section id="market" class="sabre-section">
		<div class="section-heading">
			<div>
				<p class="section-eyebrow">Industry and market</p>
				<h2>The market is not short on priorities. It is short on conversion paths.</h2>
			</div>
			<p>
				The defense market is saturated with modernization language. The edge is finding where customer urgency, budget
				authority, acquisition channel, and Sabre delivery credibility overlap.
			</p>
		</div>
		<div class="market-grid">
			{
				marketRealities.map((reality) => (
					<article>
						<h3>{reality.title}</h3>
						<p>{reality.meaning}</p>
						<div class="first-action">{reality.move}</div>
					</article>
				))
			}
		</div>
	</section>

	<section id="customers" class="sabre-section">
		<div class="section-heading">
			<div>
				<p class="section-eyebrow">Clients and customers</p>
				<h2>Priority account strategy</h2>
			</div>
			<p>
				Start with the accounts where Sabre has access or a credible wedge. Expand only when the pain, money, and
				contract path are visible.
			</p>
		</div>
		<div class="priority-list">
			{
				customerPriorities.map((target) => (
					<article class="priority-card">
						<div class="priority-rank">{target.priority}</div>
						<div>
							<p>{target.strategy}</p>
							<h3>{target.lane.name}</h3>
						</div>
						<div>
							<h4>Why it matters</h4>
							<p>{target.why}</p>
						</div>
						<div>
							<h4>First question</h4>
							<p>{target.firstQuestion}</p>
						</div>
						<div class="first-action">{target.firstMove}</div>
					</article>
				))
			}
		</div>
	</section>

	<section id="fit" class="sabre-section">
		<div class="section-heading">
			<div>
				<p class="section-eyebrow">Sabre alignment</p>
				<h2>Turn current proof into the next growth motion</h2>
			</div>
			<p>
				Sabre's advantage is not one capability label. It is the ability to combine mission engineering, secure
				software, data, cyber, contracts, and delivery in environments where pure product companies struggle.
			</p>
		</div>
		<div class="proof-grid">
			{
				proofMoves.map((item) => (
					<article>
						<h3>{item.proof}</h3>
						<p>{item.means}</p>
						<div class="first-action">{item.strategy}</div>
					</article>
				))
			}
		</div>
	</section>

	<section id="offers" class="sabre-section">
		<div class="section-heading">
			<div>
				<p class="section-eyebrow">Value-forward offers</p>
				<h2>Six plays to make Sabre easier to buy</h2>
			</div>
			<p>
				Lead with named outcomes. Customers should understand what improves, who owns it, and how the first proof works.
			</p>
		</div>
		<div class="play-grid">
			{
				growthPlays.map((play, index) => (
					<article class="play-card compact">
						<div class="play-index">{String(index + 1).padStart(2, '0')}</div>
						<h3>{play.name}</h3>
						<p>{play.fit}</p>
						<div class="proof">
							<strong>First proof:</strong> {play.firstProof}
						</div>
						<div class="mini-label">Likely buyers</div>
						<div class="chip-cloud">
							{play.buyers.slice(0, 5).map((buyer) => (
								<span>{buyer}</span>
							))}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section id="first30" class="sabre-section">
		<div class="section-heading">
			<div>
				<p class="section-eyebrow">Execution</p>
				<h2>First 30 days at Sabre</h2>
			</div>
			<p>
				The outcome is not a deck. The outcome is a qualified growth machine with one Air Force lighthouse, one Fourth
				Estate lighthouse, and one Devin-backed pilot path.
			</p>
		</div>
		<div class="timeline">
			{
				firstThirtyDays.map((phase) => (
					<article>
						<span>{phase.window}</span>
						<h3>{phase.name}</h3>
						<ul>
							{phase.actions.map((action) => (
								<li>{action}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</section>

	<section id="evidence" class="sabre-section">
		<div class="section-heading">
			<div>
				<p class="section-eyebrow">Supporting evidence</p>
				<h2>Budget, work sources, and pursuit discipline</h2>
			</div>
			<p>
				Updated {sabreUpdatedAt}. Budget figures are extracted from official FY2027 display files and rounded to
				billions.
			</p>
		</div>

		<div class="evidence-summary">
			<div>
				<span>${budgetRollup.totalFy2027B.toLocaleString()}B</span>
				<p>FY2027 extracted major-book signal</p>
			</div>
			<div>
				<span>{budgetRollup.books.length}</span>
				<p>appropriation views parsed</p>
			</div>
			<div>
				<span>{serviceLanes.length}</span>
				<p>growth theaters</p>
			</div>
		</div>

		<div class="budget-layout">
			<div class="budget-card">
				<h3>Color of Money</h3>
				<div class="bar-stack">
					{
						budgetRollup.books.map((book) => (
							<div class="bar-row">
								<div class="bar-label">
									<span>{book.code}</span>
									<small>{book.name}</small>
								</div>
								<div class="bar-track">
									<div style={`width:${(book.valueB / maxBook) * 100}%`} />
								</div>
								<strong>${book.valueB.toFixed(1)}B</strong>
								<p>{book.signal}</p>
							</div>
						))
					}
				</div>
			</div>
			<div class="budget-card">
				<h3>Buyer Mass</h3>
				<div class="org-list">
					{
						budgetRollup.orgs.map((org) => (
							<div class="org-row">
								<span>{org.name}</span>
								<div>
									<i style={`width:${(org.valueB / maxOrg) * 100}%`} />
								</div>
								<strong>${org.valueB.toFixed(1)}B</strong>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<div class="heatmap-card">
			<h3>Service x Appropriation Heatmap</h3>
			<div class="heatmap">
				<div class="heat-head"></div>
				{heatKeys.map((key) => <div class="heat-head">{key.label}</div>)}
				{
					budgetRollup.heatmap.map((row) => (
						<>
							<div class="heat-lane">{row.lane}</div>
							{heatKeys.map((key) => {
								const value = row[key.key];
								const level = Math.max(0.08, value / heatmapMax);
								return (
									<div class="heat-cell" style={`--level:${level}`}>
										<span>${value.toFixed(1)}B</span>
									</div>
								);
							})}
						</>
					))
				}
			</div>
		</div>

		<div class="line-grid">
			{
				budgetRollup.topLines.map((line) => (
					<article>
						<p>{line.book}</p>
						<h3>{line.buyer}</h3>
						<strong>${line.valueB.toFixed(1)}B</strong>
						<span>{line.line}</span>
						<small>{line.growth}</small>
					</article>
				))
			}
		</div>

		<div class="section-heading evidence-heading">
			<div>
				<p class="section-eyebrow">Sources of work</p>
				<h2>Where work appears before it looks like a normal RFP</h2>
			</div>
			<p>Use these channels to test whether an attractive idea has a real buying path.</p>
		</div>
		<div class="source-grid">
			{
				workSources.slice(0, 4).map((source) => (
					<article class="source-card">
						<div class="source-title">
							<div>
								<p>{source.type}</p>
								<h3>{source.name}</h3>
							</div>
							<span>{source.speed}</span>
						</div>
						<h4>Best for</h4>
						<p>{source.bestFor}</p>
						<h4>Watch</h4>
						<div class="chip-cloud">
							{source.whereToWatch.map((item) => (
								<span>{item}</span>
							))}
						</div>
						<div class="first-action">{source.sabreAction}</div>
						<div class="risk-note">{source.risk}</div>
					</article>
				))
			}
		</div>

		<div class="section-heading evidence-heading">
			<div>
				<p class="section-eyebrow">Pursuit discipline</p>
				<h2>Questions every pursuit must answer</h2>
			</div>
			<p>Good strategy is mostly saying no until the evidence is strong enough to say yes.</p>
		</div>
		<div class="gate-grid">
			{
				opportunityAssessment.gates.map((gate, index) => (
					<article>
						<div class="chain-index">{String(index + 1).padStart(2, '0')}</div>
						<h3>{gate.name}</h3>
						<p>{gate.question}</p>
						<div class="chip-cloud muted">
							{gate.evidence.map((item) => (
								<span>{item}</span>
							))}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section id="sources" class="sabre-section">
		<div class="section-heading">
			<div>
				<p class="section-eyebrow">Source trail</p>
				<h2>Primary source anchors</h2>
			</div>
			<p>Budget numbers on this page are derived from official FY2027 display files and rounded to billions.</p>
		</div>
		<div class="sources-grid">
			{
				sources.map((source) => (
					<a href={source.url} target="_blank" rel="noreferrer">
						<span>{source.label}</span>
						<small>{source.url.replace('https://', '')}</small>
					</a>
				))
			}
		</div>
		<div class="mt-5">
			<a class="ui-link-btn" href={withBase('/')}>&lt;- Back to Adam Boas</a>
		</div>
	</section>
</SiteLayout>

<style>
	.sabre-hero,
	.sabre-section,
	.sabre-nav {
		border: 1px solid rgba(51, 65, 85, 0.9);
		background: rgb(2, 6, 23);
	}

	.sabre-hero {
		display: grid;
		gap: 1.25rem;
		padding: 1.5rem;
		grid-template-columns: minmax(0, 1fr);
	}

	.sabre-kicker,
	.section-eyebrow {
		color: rgb(45, 212, 191);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.sabre-hero h1,
	.sabre-section h2 {
		margin-top: 0.45rem;
		color: rgb(248, 250, 252);
		font-size: clamp(1.8rem, 3vw, 3.8rem);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.02;
	}

	.sabre-lede,
	.sabre-section p,
	.section-heading > p {
		color: rgb(203, 213, 225);
		line-height: 1.65;
	}

	.sabre-lede {
		margin-top: 1rem;
		max-width: 62rem;
		font-size: 1rem;
	}

	.hero-metrics {
		display: grid;
		gap: 0.65rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.hero-metrics div,
	.thesis-grid div,
	.market-grid article,
	.priority-card,
	.proof-grid article,
	.evidence-summary div,
	.budget-card,
	.heatmap-card,
	.line-grid article,
	.finance-chain article,
	.source-card,
	.gate-grid article,
	.score-panel,
	.service-card,
	.play-card,
	.network-map article,
	.timeline article,
	.sources-grid a {
		border: 1px solid rgba(51, 65, 85, 0.9);
		background: rgb(15, 23, 42);
	}

	.hero-metrics div {
		min-height: 7rem;
		padding: 0.85rem;
	}

	.hero-metrics span {
		display: block;
		color: rgb(212, 165, 116);
		font-size: 1.55rem;
		font-weight: 800;
		line-height: 1;
	}

	.hero-metrics p {
		margin-top: 0.65rem;
		color: rgb(148, 163, 184);
		font-size: 0.72rem;
		line-height: 1.35;
	}

	.sabre-nav {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.75rem;
		padding: 0.65rem;
	}

	.sabre-nav a {
		border: 1px solid rgba(71, 85, 105, 0.8);
		padding: 0.42rem 0.6rem;
		color: rgb(226, 232, 240);
		font-size: 0.72rem;
		font-weight: 700;
		text-decoration: none;
	}

	.sabre-section {
		margin-top: 0.75rem;
		padding: 1rem;
	}

	.two-col,
	.budget-layout {
		display: grid;
		gap: 1rem;
	}

	.thesis-grid {
		display: grid;
		gap: 0.65rem;
	}

	.thesis-grid div {
		padding: 0.85rem;
	}

	.thesis-grid strong {
		display: block;
		color: rgb(212, 165, 116);
		font-size: 0.72rem;
		text-transform: uppercase;
	}

	.thesis-grid span {
		display: block;
		margin-top: 0.4rem;
		color: rgb(226, 232, 240);
		font-size: 0.84rem;
		line-height: 1.5;
	}

	.thesis-grid h3,
	.market-grid h3,
	.priority-card h3,
	.proof-grid h3 {
		margin-top: 0.45rem;
		color: rgb(248, 250, 252);
		font-size: 0.96rem;
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.2;
	}

	.strategy-callout {
		margin-top: 1rem;
		border-left: 3px solid rgb(45, 212, 191);
		padding: 0.8rem 0.9rem;
