---
import SiteLayout from '../layouts/SiteLayout.astro';
import StickyBrowseBar from '../components/StickyBrowseBar.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/withBase';

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.map((w) => ({
		slug: w.id.split('/').pop(),
		type: w.data.type,
		title: w.data.title,
		date: w.data.date,
	}))
	.filter((x) => !!x.slug);

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.map((p) => ({
		slug: p.id,
		type: 'paper',
		title: p.data.title,
		date: p.data.date,
	}));

const latest = [...writing, ...papers]
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0))
	.slice(0, 4);
---

<SiteLayout title="404 | Adam Boas" description="Page not found.">
	<StickyBrowseBar active="home" />

	<section class="card p-8">
		<p class="text-xs font-semibold uppercase tracking-wide text-slate-400">404</p>
		<h1 class="mt-2 text-3xl font-semibold text-slate-50">Page not found</h1>
		<p class="mt-3 max-w-2xl text-slate-300">
			That URL doesn’t exist here. Use one of the paths below to get back on track.
		</p>

		<div class="mt-6 flex flex-wrap gap-3">
			<a href={withBase('/')} class="rounded-none border border-slate-700 bg-slate-900/40 px-4 py-2 text-sm font-semibold text-slate-100 hover:bg-slate-900">Home</a>
			<a href={withBase('/writing/')} class="rounded-none border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-100 hover:bg-slate-900">Writing</a>
			<a href={withBase('/experience/')} class="rounded-none border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-100 hover:bg-slate-900">Experience</a>
			<a href={withBase('/education/')} class="rounded-none border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-100 hover:bg-slate-900">Education</a>
		</div>
	</section>

	<section class="mt-6 card p-6">
		<h2 class="section-title">Latest Writing</h2>
		{latest.length ? (
			<ul class="mt-4 space-y-3">
				{latest.map((item) => (
					<li>
						<a class="text-sm text-slate-100 hover:text-stone-100" href={withBase(`/writing/${item.slug}/`)}>
							<span class={`writing-type-pill writing-type-${item.type} mr-2 rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-wide`}>{item.type}</span>
							{item.title}
						</a>
					</li>
				))}
			</ul>
		) : (
			<p class="mt-4 text-sm text-slate-300">No published writing items yet.</p>
		)}
	</section>
</SiteLayout>
