	<section class="mt-6">
		<a class="text-sm text-slate-300 hover:text-slate-100" href={withBase('/writing/')}>
			← Back to writing
		</a>
	</section>
</SiteLayout>

<script is:inline define:vars={{ events: enriched }}>
	const EVENT_DATA = events;
	const KEY = 'adamboas.radar.view.v1';

	const el = {
		q: document.getElementById('radar-q'),
		branch: document.getElementById('radar-branch'),
		type: document.getElementById('radar-type'),
		status: document.getElementById('radar-status'),
		sort: document.getElementById('radar-sort'),
		list: document.getElementById('radar-list'),
		map: document.getElementById('radar-map'),
		count: document.getElementById('radar-count'),
		briefOut: document.getElementById('radar-brief-output'),
		save: document.getElementById('radar-save'),
		load: document.getElementById('radar-load'),
		share: document.getElementById('radar-share'),
		reset: document.getElementById('radar-reset'),
		brief: document.getElementById('radar-brief'),
	};

	function parseDate(d) {
		return d ? new Date(d).getTime() : null;
	}

	function stateFromUI() {
		return {
			q: el.q.value.trim(),
			branch: el.branch.value,
			type: el.type.value,
			status: el.status.value,
			sort: el.sort.value,
		};
	}

	function applyState(state) {
		el.q.value = state.q || '';
		el.branch.value = state.branch || '';
		el.type.value = state.type || '';
		el.status.value = state.status || '';
		el.sort.value = state.sort || 'score';
	}

	function toQueryString(state) {
		const params = new URLSearchParams();
		Object.entries(state).forEach(([k, v]) => {
			if (v) params.set(k, String(v));
		});
		return params.toString();
	}

	function loadFromUrl() {
		const params = new URLSearchParams(window.location.search);
		applyState({
			q: params.get('q') || '',
			branch: params.get('branch') || '',
			type: params.get('type') || '',
			status: params.get('status') || '',
			sort: params.get('sort') || 'score',
		});
	}

	function getFiltered() {
		const state = stateFromUI();
		const q = state.q.toLowerCase();
		const filtered = EVENT_DATA.filter((event) => {
			if (state.branch && event.branch !== state.branch) return false;
			if (state.type && event.type !== state.type) return false;
			if (state.status && event.status !== state.status) return false;
			if (!q) return true;
			const hay = `${event.title} ${event.branch} ${event.type} ${event.city} ${event.state || ''} ${event.status}`.toLowerCase();
			return hay.includes(q);
		});

		if (state.sort === 'date') {
			filtered.sort((a, b) => {
				const da = parseDate(a.startDate);
				const db = parseDate(b.startDate);
				if (da === null && db === null) return b.score - a.score;
				if (da === null) return 1;
				if (db === null) return -1;
				return da - db;
			});
		} else if (state.sort === 'signal') {
			const s = { High: 3, Medium: 2, Low: 1 };
			filtered.sort((a, b) => (s[b.signal] - s[a.signal]) || (b.score - a.score));
		} else {
			filtered.sort((a, b) => b.score - a.score || (parseDate(a.startDate) ?? 9e15) - (parseDate(b.startDate) ?? 9e15));
		}

		const qs = toQueryString(state);
		const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
		history.replaceState(null, '', url);
		return filtered;
	}

	function fmtDate(event) {
		if (!event.startDate) return 'Date pending';
		const d = new Date(event.startDate);
		return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
	}

	function locationLabel(event) {
		return event.state ? `${event.city}, ${event.state}` : event.city;
	}

	function mapProjection(lat, lng) {
		const minLng = -125;
		const maxLng = 10;
		const minLat = 24;
		const maxLat = 55;
		const x = ((lng - minLng) / (maxLng - minLng)) * 100;
		const y = ((maxLat - lat) / (maxLat - minLat)) * 100;
		return { x: Math.min(98, Math.max(2, x)), y: Math.min(96, Math.max(4, y)) };
	}

	function scoreTone(score) {
		if (score >= 85) return 'high';
		if (score >= 65) return 'mid';
		return 'low';
	}

	function renderMap(items) {
		el.map.innerHTML = '';
		for (const event of items) {
			const p = mapProjection(event.lat, event.lng);
			const marker = document.createElement('button');
			marker.type = 'button';
			marker.className = `radar-marker radar-marker-${scoreTone(event.score)}`;
			marker.style.left = `${p.x}%`;
			marker.style.top = `${p.y}%`;
			marker.setAttribute('aria-label', `${event.title}, ${locationLabel(event)}`);
			marker.title = `${event.title}\n${locationLabel(event)}\nScore ${event.score}`;
			marker.addEventListener('click', () => {
				const row = document.querySelector(`[data-event-row="${event.id}"]`);
				if (row) row.scrollIntoView({ behavior: 'smooth', block: 'center' });
			});
			el.map.appendChild(marker);
		}
	}

	function renderList(items) {
		el.list.innerHTML = '';
		if (!items.length) {
			const li = document.createElement('li');
			li.className = 'rounded-none border border-slate-800 bg-slate-950/50 p-4 text-sm text-slate-300';
			li.textContent = 'No opportunities match current filters.';
			el.list.appendChild(li);
			return;
		}

		for (const event of items) {
			const li = document.createElement('li');
			li.className = 'rounded-none border border-slate-800 bg-slate-950/50 p-4';
			li.dataset.eventRow = event.id;
			li.innerHTML = `
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div class="min-w-0">
						<p class="text-xs uppercase tracking-wide text-slate-400">${event.branch} · ${event.type} · ${event.status}</p>
						<h3 class="mt-1 text-sm font-semibold text-slate-50 sm:text-base">${event.title}</h3>
						<p class="mt-1 text-xs text-slate-300">${locationLabel(event)} · ${fmtDate(event)}</p>
					</div>
					<div class="rounded-none border border-slate-700 px-3 py-1 text-sm font-semibold text-slate-100">Score ${event.score}</div>
				</div>
			`;
			el.list.appendChild(li);
		}
	}

	function render() {
		const items = getFiltered();
		renderMap(items);
		renderList(items);
		el.count.textContent = `${items.length} item${items.length === 1 ? '' : 's'} shown`;
	}

	function saveView() {
		localStorage.setItem(KEY, JSON.stringify(stateFromUI()));
	}

	function loadView() {
		const raw = localStorage.getItem(KEY);
		if (!raw) return;
		try {
			const state = JSON.parse(raw);
			applyState(state);
			render();
		} catch {
			/* ignore bad saved state */
		}
	}

	async function copyShare() {
		await navigator.clipboard.writeText(window.location.href);
		el.share.textContent = 'Copied';
		setTimeout(() => (el.share.textContent = 'Copy share link'), 1200);
	}

	async function buildBrief() {
		const top = getFiltered().slice(0, 5);
		if (!top.length) {
			el.briefOut.classList.remove('hidden');
			el.briefOut.textContent = 'No items selected.';
			return;
		}
		const lines = [
			'# Radar Brief Draft',
			'',
			`Generated: ${new Date().toLocaleString()}`,
			'',
			'## Top Opportunities',
			'',
			...top.map((event, i) => `${i + 1}. ${event.title} (${event.branch}, score ${event.score}) - ${fmtDate(event)} - ${locationLabel(event)}`),
			'',
			'## Why these',
			'- Highest weighted score under current filter state',
			'- Prioritized for near-term dates and lower execution effort',
		];
		const body = lines.join('\n');
		el.briefOut.classList.remove('hidden');
		el.briefOut.textContent = body;
		await navigator.clipboard.writeText(body);
	}

	const watched = [el.q, el.branch, el.type, el.status, el.sort];
	watched.forEach((node) => node.addEventListener('input', render));
	el.save.addEventListener('click', saveView);
	el.load.addEventListener('click', loadView);
	el.share.addEventListener('click', copyShare);
	el.reset.addEventListener('click', () => {
		applyState({ q: '', branch: '', type: '', status: '', sort: 'score' });
		render();
	});
	el.brief.addEventListener('click', buildBrief);

	loadFromUrl();
	render();
</script>

<style>
