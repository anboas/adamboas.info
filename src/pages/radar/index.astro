			repeating-linear-gradient(0deg, rgba(100, 116, 139, 0.12), rgba(100, 116, 139, 0.12) 1px, transparent 1px, transparent 28px),
			repeating-linear-gradient(90deg, rgba(100, 116, 139, 0.12), rgba(100, 116, 139, 0.12) 1px, transparent 1px, transparent 28px),
			rgba(2, 6, 23, 0.85);
		overflow: hidden;
	}
