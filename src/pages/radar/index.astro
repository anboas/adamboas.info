	title: string;
	startDate: string | null;
	endDate?: string | null;
	city: string;
	state?: string;
	country: string;
	lat: number;
	lng: number;
	branch: string;
	type: 'Conference' | 'Workshop' | 'Summit' | 'Hackathon' | 'Exercise';
	status: 'Upcoming' | 'Projected' | 'Needs Date' | 'Past';
	signal: 'High' | 'Medium' | 'Low';
	effort: 'Low' | 'Medium' | 'High';
	url?: string;
}

