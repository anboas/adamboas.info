function daysUntil(dateStr: string | null) {
	if (!dateStr) return null;
	const ms = new Date(dateStr).getTime() - Date.now();
	return Math.round(ms / 86_400_000);
}

function computeScore(event: RadarEvent) {
	let score = 0;
	score += event.signal === 'High' ? 45 : event.signal === 'Medium' ? 28 : 12;
	score += event.effort === 'Low' ? 18 : event.effort === 'Medium' ? 10 : 2;
	score += event.status === 'Upcoming' ? 16 : event.status === 'Projected' ? 10 : event.status === 'Needs Date' ? 4 : 0;
	score += event.branch === 'Joint' ? 10 : event.branch === 'Army' || event.branch === 'Air Force' || event.branch === 'Navy' ? 6 : 3;

	const d = daysUntil(event.startDate);
	if (d !== null && d >= 0) {
		if (d <= 14) score += 16;
		else if (d <= 45) score += 10;
		else if (d <= 90) score += 5;
	}

	return Math.max(1, Math.min(100, score));
}

const enriched = radarEvents.map((e) => ({ ...e, score: computeScore(e) }));
const branches = [...new Set(enriched.map((e) => e.branch))].sort();
const types = [...new Set(enriched.map((e) => e.type))].sort();
const statuses = ['Upcoming', 'Projected', 'Needs Date', 'Past'] as const;

const upcomingCount = enriched.filter((e) => e.status === 'Upcoming').length;
const highSignalCount = enriched.filter((e) => e.signal === 'High').length;
const needsDateCount = enriched.filter((e) => e.status === 'Needs Date').length;
const topScore = Math.max(...enriched.map((e) => e.score));
---

<SiteLayout title="Radar | Adam Boas" description="Opportunity radar prototype with map, scoring, filters, and brief generation." canonicalHref="https://www.adamboas.com/radar/">
	<StickyBrowseBar active="radar" />

	<section class="card p-6 sm:p-8">
		<p class="text-xs uppercase tracking-wide text-slate-400">Prototype</p>
		<h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">Operations Radar</h1>
		<p class="mt-3 max-w-3xl text-sm text-slate-300 sm:text-base">
			A decision-oriented radar page: map + list + scoring + saved views. This is built to prioritize what matters now, not just display an event list.
		</p>

		<div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
			<div class="radar-stat">
				<span class="radar-stat-label">Upcoming</span>
				<strong class="radar-stat-value">{upcomingCount}</strong>
			</div>
			<div class="radar-stat">
				<span class="radar-stat-label">High signal</span>
				<strong class="radar-stat-value">{highSignalCount}</strong>
			</div>
			<div class="radar-stat">
				<span class="radar-stat-label">Needs date</span>
				<strong class="radar-stat-value">{needsDateCount}</strong>
			</div>
			<div class="radar-stat">
				<span class="radar-stat-label">Top score</span>
				<strong class="radar-stat-value">{topScore}</strong>
			</div>
		</div>
	</section>

	<section class="mt-6 grid gap-6 xl:grid-cols-[320px,1fr]">
		<aside class="card p-5">
			<h2 class="section-title">Filters</h2>
			<div class="mt-4 space-y-4 text-sm">
				<label class="block">
					<span class="mb-1 block text-slate-300">Search</span>
					<input id="radar-q" class="radar-input" type="search" placeholder="autonomy, governance, branch..." />
				</label>

				<label class="block">
					<span class="mb-1 block text-slate-300">Branch</span>
					<select id="radar-branch" class="radar-input">
						<option value="">All branches</option>
						{branches.map((b) => <option value={b}>{b}</option>)}
					</select>
				</label>

				<label class="block">
					<span class="mb-1 block text-slate-300">Type</span>
					<select id="radar-type" class="radar-input">
						<option value="">All types</option>
						{types.map((t) => <option value={t}>{t}</option>)}
					</select>
				</label>

				<label class="block">
					<span class="mb-1 block text-slate-300">Status</span>
					<select id="radar-status" class="radar-input">
						<option value="">All statuses</option>
						{statuses.map((s) => <option value={s}>{s}</option>)}
					</select>
				</label>

				<label class="block">
					<span class="mb-1 block text-slate-300">Sort</span>
					<select id="radar-sort" class="radar-input">
						<option value="score">Highest score</option>
						<option value="date">Soonest date</option>
						<option value="signal">Signal first</option>
					</select>
				</label>

				<div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-1">
					<button id="radar-save" class="radar-btn" type="button">Save view</button>
					<button id="radar-load" class="radar-btn" type="button">Load saved view</button>
					<button id="radar-share" class="radar-btn" type="button">Copy share link</button>
					<button id="radar-reset" class="radar-btn" type="button">Reset filters</button>
				</div>
			</div>
		</aside>

		<div class="space-y-6">
			<section class="card p-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="section-title">Map view</h2>
					<p id="radar-count" class="text-xs text-slate-400"></p>
				</div>
				<div id="radar-map" class="radar-map" aria-label="Radar map"></div>
			</section>

			<section class="card p-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="section-title">Ranked opportunities</h2>
					<button id="radar-brief" class="radar-btn" type="button">Build brief draft</button>
				</div>
				<ul id="radar-list" class="space-y-3"></ul>
				<pre id="radar-brief-output" class="radar-brief-output hidden"></pre>
			</section>
		</div>
