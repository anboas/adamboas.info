---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
import { radarEventsSeed } from '../../data/radar/events';
import { scoreEvents, scoringLegend } from '../../data/radar/scoring';

const events = scoreEvents(radarEventsSeed);
const legend = scoringLegend();

const branches = [...new Set(events.map((e) => e.branch))].sort();
const types = [...new Set(events.map((e) => e.type))].sort();
const statuses = ['Upcoming', 'Projected', 'Needs Date', 'Past'] as const;

const summaryStats = {
	total: events.length,
	upcoming: events.filter((e) => e.status === 'Upcoming').length,
	highSignal: events.filter((e) => e.signal === 'High').length,
	needsDate: events.filter((e) => e.status === 'Needs Date').length,
	topScore: Math.max(...events.map((e) => e.score.total)),
	themes: new Set(events.flatMap((e) => e.ontology.themes)).size,
};

function fmtDate(date: string | null) {
	if (!date) return 'Date pending';
	return new Date(date).toLocaleDateString(undefined, {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
}

function fmtDateRange(start: string | null, end: string | null | undefined) {
	if (!start) return 'Date pending';
	if (!end) return fmtDate(start);
	return `${fmtDate(start)} - ${fmtDate(end)}`;
}

function locationLabel(event: (typeof events)[number]) {
	return event.location.state ? `${event.location.city}, ${event.location.state}` : event.location.city;
}

function costLabel(event: (typeof events)[number]) {
	const range = event.ontology.logistics.estimatedCostUsd;
	if (!range) return 'Unknown';
	if (range.max === 0) return '$0';
	return `$${range.min.toLocaleString()} - $${range.max.toLocaleString()}`;
}

function sourceConfidenceBand(event: (typeof events)[number]) {
	const confidence = event.ontology.provenance.map((p) => p.confidence);
	if (confidence.includes('High')) return 'high';
	if (confidence.includes('Medium')) return 'medium';
	return 'low';
}

function scoreTone(score: number) {
	if (score >= 80) return 'high';
	if (score >= 60) return 'mid';
	return 'low';
}

const MAP_W = 1000;
const MAP_H = 540;

function mapProjection(lat: number, lng: number) {
	const minLng = -130;
	const maxLng = 20;
	const minLat = 22;
	const maxLat = 56;
	const x = ((lng - minLng) / (maxLng - minLng)) * MAP_W;
	const y = ((maxLat - lat) / (maxLat - minLat)) * MAP_H;
	return { x: Math.min(MAP_W - 14, Math.max(14, x)), y: Math.min(MAP_H - 14, Math.max(14, y)) };
}
---

<SiteLayout
	title="Radar | Adam Boas"
	description="In-depth operations radar prototype with ontology-rich metadata, weighted scoring, and expandable intelligence cards."
	canonicalHref="https://www.adamboas.com/radar/"
>
	<StickyBrowseBar active="radar" />

	<section class="card p-6 sm:p-8">
		<p class="text-xs uppercase tracking-[0.14em] text-slate-400">Prototype · Radar V2.0</p>
		<h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">Operations Radar</h1>
		<p class="mt-3 max-w-4xl text-sm text-slate-300 sm:text-base">
			Ontology-rich opportunity radar for events, partner touchpoints, and decision windows. Compact by default, deep metadata and provenance on expand.
		</p>

		<div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-6">
			<div class="radar-stat"><span>Items</span><strong>{summaryStats.total}</strong></div>
			<div class="radar-stat"><span>Upcoming</span><strong>{summaryStats.upcoming}</strong></div>
			<div class="radar-stat"><span>High signal</span><strong>{summaryStats.highSignal}</strong></div>
			<div class="radar-stat"><span>Needs date</span><strong>{summaryStats.needsDate}</strong></div>
			<div class="radar-stat"><span>Ontology themes</span><strong>{summaryStats.themes}</strong></div>
			<div class="radar-stat"><span>Top score</span><strong>{summaryStats.topScore}</strong></div>
		</div>
	</section>

	<section class="mt-6 grid gap-6 xl:grid-cols-[340px,1fr]">
		<aside class="space-y-6">
			<details id="radar-filter-panel" class="card p-5" open>
				<summary class="radar-summary radar-summary-primary">Filters + ranking</summary>
				<div class="mt-4 space-y-4 text-sm">
					<label class="block">
						<span class="mb-1 block text-slate-300">Search</span>
						<input id="radar-q" class="radar-input" type="search" placeholder="theme, stakeholder, city..." />
					</label>
					<label class="block">
						<span class="mb-1 block text-slate-300">Branch</span>
						<select id="radar-branch" class="radar-input">
							<option value="">All branches</option>
							{branches.map((branch) => <option value={branch}>{branch}</option>)}
						</select>
					</label>
					<label class="block">
						<span class="mb-1 block text-slate-300">Type</span>
						<select id="radar-type" class="radar-input">
							<option value="">All types</option>
							{types.map((type) => <option value={type}>{type}</option>)}
						</select>
					</label>
					<label class="block">
						<span class="mb-1 block text-slate-300">Status</span>
						<select id="radar-status" class="radar-input">
							<option value="">All statuses</option>
							{statuses.map((status) => <option value={status}>{status}</option>)}
						</select>
					</label>
					<label class="block">
						<span class="mb-1 block text-slate-300">Sort</span>
						<select id="radar-sort" class="radar-input">
							<option value="score">Highest score</option>
							<option value="date">Soonest date</option>
							<option value="signal">Signal first</option>
							<option value="meta">Metadata completeness</option>
						</select>
					</label>
					<label class="block">
						<span class="mb-1 block text-slate-300">Minimum score: <strong id="radar-min-score-label">0</strong></span>
						<input id="radar-min-score" class="w-full accent-cyan-500" type="range" min="0" max="100" step="1" value="0" />
					</label>
					<div class="grid gap-2 sm:grid-cols-2">
						<label class="radar-check">
							<input id="radar-high-only" type="checkbox" />
							<span>High signal only</span>
						</label>
						<label class="radar-check">
							<input id="radar-upcoming-only" type="checkbox" />
							<span>Upcoming only</span>
						</label>
						<label class="radar-check sm:col-span-2">
							<input id="radar-verified-only" type="checkbox" />
							<span>Verified sources only (high confidence)</span>
						</label>
					</div>
					<div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-1">
						<button class="radar-btn" type="button" data-preset="near-term">Preset: near-term</button>
						<button class="radar-btn" type="button" data-preset="high-confidence">Preset: high confidence</button>
						<button class="radar-btn" type="button" data-preset="needs-dates">Preset: needs dates</button>
					</div>
					<div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-1">
						<button id="radar-save" class="radar-btn" type="button">Save view</button>
						<button id="radar-load" class="radar-btn" type="button">Load saved view</button>
						<button id="radar-share" class="radar-btn" type="button">Copy share link</button>
						<button id="radar-reset" class="radar-btn" type="button">Reset</button>
					</div>
				</div>
			</details>

			<details class="card p-5">
				<summary class="radar-summary">Scoring key (collapsed by default)</summary>
				<div class="mt-4 space-y-4 text-sm text-slate-300">
					<p class="text-xs text-slate-400">Score formula = signal + effort + status + branch fit + date proximity + source confidence + metadata completeness - travel burden</p>
					<div class="grid gap-3">
						<div class="radar-key-block">
							<strong>Signal</strong>
							<ul>
								<li>High: +{legend.signalWeight.High}</li>
								<li>Medium: +{legend.signalWeight.Medium}</li>
								<li>Low: +{legend.signalWeight.Low}</li>
							</ul>
						</div>
						<div class="radar-key-block">
							<strong>Effort</strong>
							<ul>
								<li>Low: +{legend.effortWeight.Low}</li>
								<li>Medium: +{legend.effortWeight.Medium}</li>
								<li>High: +{legend.effortWeight.High}</li>
							</ul>
						</div>
						<div class="radar-key-block">
							<strong>Status</strong>
							<ul>
								<li>Upcoming: +{legend.statusWeight.Upcoming}</li>
								<li>Projected: +{legend.statusWeight.Projected}</li>
								<li>Needs date: +{legend.statusWeight['Needs Date']}</li>
								<li>Past: +{legend.statusWeight.Past}</li>
							</ul>
						</div>
						<div class="radar-key-block">
							<strong>Date proximity</strong>
							<ul>
								<li>≤14 days: +{legend.dateProximity.in14}</li>
								<li>≤30 days: +{legend.dateProximity.in30}</li>
								<li>≤60 days: +{legend.dateProximity.in60}</li>
								<li>≤120 days: +{legend.dateProximity.in120}</li>
								<li>Past date: {legend.dateProximity.past}</li>
							</ul>
						</div>
					</div>
				</div>
			</details>

			<details class="card p-5">
				<summary class="radar-summary">Automation discovery plan (planning only)</summary>
				<div class="mt-4 space-y-3 text-sm text-slate-300">
					<p class="text-xs uppercase tracking-[0.12em] text-slate-400">No automation implemented yet</p>
					<p>Design target: nightly source ingestion, AI-assisted extraction, and confidence-scored dedupe into this ontology.</p>
					<div class="radar-key-block">
						<strong>Priority source families</strong>
						<ul>
							<li>Official event calendars (AUSA, AFCEA, Navy League, service pages)</li>
							<li>Government event indexes and acquisition notices</li>
							<li>Conference aggregators with military/federal vertical tags</li>
							<li>Newsletter/community lists for early signals (low confidence lane)</li>
						</ul>
					</div>
					<div class="radar-key-block">
						<strong>Planned AI pipeline</strong>
						<ol>
							<li>Ingest + normalize source pages</li>
							<li>Extract event entities (title/date/location/links/CFP)</li>
							<li>Entity resolution + dedupe against existing graph</li>
							<li>Assign provenance + confidence and mark verification needs</li>
							<li>Human-review queue before publish to production radar</li>
						</ol>
					</div>
				</div>
			</details>
		</aside>

		<div class="radar-main-col">
			<section class="card p-4 radar-toolbar">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div class="space-y-2">
						<p id="radar-count" class="text-xs text-slate-400"></p>
						<div id="radar-filter-chips" class="radar-filter-chips"></div>
					</div>
					<div class="flex flex-wrap gap-2">
						<button id="radar-toggle-map" class="radar-btn radar-btn-tight" type="button">Hide map</button>
						<button id="radar-toggle-compact" class="radar-btn radar-btn-tight" type="button">Compact mode</button>
						<button id="radar-clear-pins" class="radar-btn radar-btn-tight" type="button">Clear pinned</button>
					</div>
				</div>
			</section>

			<section id="radar-map-section" class="card p-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="section-title">Map view</h2>
					<p class="text-xs text-slate-500">Click a marker to jump to card</p>
				</div>
				<div id="radar-map" class="radar-map" aria-label="Radar map">
					<svg class="radar-map-svg" viewBox={`0 0 ${MAP_W} ${MAP_H}`} preserveAspectRatio="none" role="img" aria-label="North America and Europe theater map">
						<rect x="0" y="0" width={MAP_W} height={MAP_H} fill="rgb(2,6,23)"></rect>
						<g class="radar-map-land">
							<path d="M70 110 L120 85 L210 88 L250 128 L285 170 L276 218 L240 252 L194 260 L160 286 L112 292 L74 270 L52 226 L50 176 Z"></path>
							<path d="M314 235 L360 218 L386 234 L382 270 L340 286 L308 266 Z"></path>
							<path d="M620 144 L660 130 L708 138 L760 156 L772 188 L736 206 L690 204 L648 188 Z"></path>
							<path d="M688 214 L726 220 L748 250 L734 282 L708 292 L680 270 L672 238 Z"></path>
						</g>
						
						<g class="radar-map-points">
							{events.map((event) => {
								const p = mapProjection(event.location.lat, event.location.lng);
								const tone = scoreTone(event.score.total);
								return (
									<g
										class={`radar-map-marker radar-map-marker-${tone}`}
										data-map-marker
										data-id={event.id}
										data-title={event.title}
										tabindex="0"
										role="button"
										aria-label={`${event.title}, score ${event.score.total}`}
										transform={`translate(${p.x}, ${p.y})`}
									>
										<title>{event.title} · Score {event.score.total}</title>
										<circle class="radar-map-marker-halo" cx="0" cy="0" r="11"></circle>
										<circle class="radar-map-marker-core" cx="0" cy="0" r="6"></circle>
									</g>
								);
							})}
						</g>
					</svg>
				</div>
			</section>

			<section id="radar-list-section" class="card p-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="section-title">Opportunities</h2>
					<button id="radar-brief" class="radar-btn" type="button">Build brief draft</button>
				</div>
				<div id="radar-empty" class="hidden rounded-none border border-slate-800 bg-slate-950/60 p-4 text-sm text-slate-300">
					No events match the current filter state.
				</div>
				<div id="radar-list" class="space-y-3 radar-list">
					{events.map((event) => (
						<article
							id={event.id}
							class="radar-card"
							data-event-card
							data-id={event.id}
							data-score={event.score.total}
							data-meta={event.score.metaCompleteness}
							data-date={event.startDate ?? ''}
							data-status={event.status}
							data-type={event.type}
							data-branch={event.branch}
							data-signal={event.signal}
							data-confidence={sourceConfidenceBand(event)}
							data-title={event.title}
							data-lat={event.location.lat}
							data-lng={event.location.lng}
							data-search={`${event.title} ${event.description} ${event.branch} ${event.type} ${event.status} ${event.location.city} ${event.location.state ?? ''} ${event.ontology.themes.join(' ')} ${event.ontology.stakeholders.join(' ')} ${event.ontology.keywords.join(' ')} ${event.ontology.provenance.map((p) => `${p.type} ${p.confidence}`).join(' ')}`.toLowerCase()}
						>
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div class="min-w-0 flex-1">
									<p class="text-[11px] uppercase tracking-[0.1em] text-slate-400">{event.branch} · {event.type} · {event.status}</p>
									<h3 class="mt-1 text-base font-semibold text-slate-50">{event.title}</h3>
									<p class="mt-1 text-sm text-slate-300 radar-desc">{event.description}</p>
									<p class="mt-2 text-xs text-slate-400 radar-meta">{locationLabel(event)} · {fmtDateRange(event.startDate, event.endDate)}</p>
								</div>
								<div class="flex items-center gap-2">
									<div class="radar-score-chip">Score {event.score.total}</div>
									<button class="radar-pin-btn" type="button" data-pin-btn data-id={event.id}>Pin</button>
								</div>
							</div>

							<div class="mt-3 flex flex-wrap gap-2 radar-theme-row">
								{event.ontology.themes.slice(0, 4).map((theme) => <span class="radar-pill">{theme}</span>)}
							</div>

							<details class="mt-3 radar-details">
								<summary>Expand ontology + metadata</summary>
								<div class="mt-3 grid gap-4 lg:grid-cols-2">
									<div>
										<p class="radar-section-label">Capability areas</p>
										<ul class="radar-listing">{event.ontology.capabilityAreas.map((item) => <li>{item}</li>)}</ul>
									</div>
									<div>
										<p class="radar-section-label">Mission threads</p>
										<ul class="radar-listing">{event.ontology.missionThreads.map((item) => <li>{item}</li>)}</ul>
									</div>
									<div>
										<p class="radar-section-label">Stakeholders</p>
										<ul class="radar-listing">{event.ontology.stakeholders.map((item) => <li>{item}</li>)}</ul>
									</div>
									<div>
										<p class="radar-section-label">Decision windows</p>
										<ul class="radar-listing">
											<li><strong>Discovery:</strong> {event.ontology.decisionWindows.discovery}</li>
											<li><strong>Prep:</strong> {event.ontology.decisionWindows.prep}</li>
											<li><strong>Execution:</strong> {event.ontology.decisionWindows.execution}</li>
										</ul>
									</div>
								</div>

								<div class="mt-4 grid gap-4 lg:grid-cols-2">
									<div>
										<p class="radar-section-label">Links</p>
										<ul class="radar-listing">
											{event.ontology.links.official ? <li><a href={event.ontology.links.official} target="_blank" rel="noreferrer">Official page</a></li> : null}
											{event.ontology.links.registration ? <li><a href={event.ontology.links.registration} target="_blank" rel="noreferrer">Registration</a></li> : null}
											{event.ontology.links.callForPapers ? <li><a href={event.ontology.links.callForPapers} target="_blank" rel="noreferrer">Call for papers</a></li> : null}
											{event.ontology.links.agenda ? <li><a href={event.ontology.links.agenda} target="_blank" rel="noreferrer">Agenda</a></li> : null}
										</ul>
									</div>
									<div>
										<p class="radar-section-label">Logistics</p>
										<ul class="radar-listing">
											<li><strong>Format:</strong> {event.ontology.logistics.format}</li>
											<li><strong>Estimated cost:</strong> {costLabel(event)}</li>
											<li><strong>Travel burden (DC):</strong> {event.ontology.logistics.travelBurdenFromDc}</li>
											{event.location.venue ? <li><strong>Venue:</strong> {event.location.venue}</li> : null}
										</ul>
									</div>
								</div>

								<div class="mt-4">
									<p class="radar-section-label">Score breakdown</p>
									<ul class="radar-listing radar-score-list">
										<li><span>Signal</span><strong>{event.score.signal}</strong></li>
										<li><span>Effort</span><strong>{event.score.effort}</strong></li>
										<li><span>Status</span><strong>{event.score.status}</strong></li>
										<li><span>Branch fit</span><strong>{event.score.branchFit}</strong></li>
										<li><span>Date proximity</span><strong>{event.score.dateProximity}</strong></li>
										<li><span>Source confidence</span><strong>{event.score.sourceConfidence}</strong></li>
										<li><span>Metadata completeness</span><strong>{event.score.metaCompleteness}</strong></li>
										<li><span>Travel penalty</span><strong>{event.score.travelPenalty}</strong></li>
										<li class="radar-total"><span>Total</span><strong>{event.score.total}</strong></li>
									</ul>
								</div>

								<div class="mt-4">
									<p class="radar-section-label">Provenance</p>
									<ul class="radar-listing">
										{event.ontology.provenance.map((source) => (
											<li>
												<a href={source.url} target="_blank" rel="noreferrer">{source.name}</a>
												<span class="text-slate-500"> · {source.type}, {source.confidence} confidence, verified {source.lastVerified}</span>
											</li>
										))}
									</ul>
									{event.ontology.notes ? <p class="mt-2 text-xs text-slate-400">{event.ontology.notes}</p> : null}
								</div>
							</details>
						</article>
					))}
				</div>

				<div id="radar-pinned" class="radar-pinned hidden">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h3 class="text-sm font-semibold text-slate-100">Pinned shortlist</h3>
						<button id="radar-compare" class="radar-btn radar-btn-tight" type="button">Copy compare brief</button>
					</div>
					<ul id="radar-pinned-list" class="mt-2 space-y-2"></ul>
				</div>

				<pre id="radar-brief-output" class="radar-brief-output hidden"></pre>
			</section>
		</div>
	</section>

	<section class="mt-6">
		<a class="text-sm text-slate-300 hover:text-slate-100" href={withBase('/writing/')}>← Back to writing</a>
	</section>
</SiteLayout>

<script is:inline>
	const KEY = 'adamboas.radar.view.v4';
	const PIN_KEY = 'adamboas.radar.pins.v1';

	const controls = {
		q: document.getElementById('radar-q'),
		branch: document.getElementById('radar-branch'),
		type: document.getElementById('radar-type'),
		status: document.getElementById('radar-status'),
		sort: document.getElementById('radar-sort'),
		minScore: document.getElementById('radar-min-score'),
		minScoreLabel: document.getElementById('radar-min-score-label'),
		highOnly: document.getElementById('radar-high-only'),
		upcomingOnly: document.getElementById('radar-upcoming-only'),
		verifiedOnly: document.getElementById('radar-verified-only'),
		toggleMap: document.getElementById('radar-toggle-map'),
		toggleCompact: document.getElementById('radar-toggle-compact'),
		clearPins: document.getElementById('radar-clear-pins'),
		save: document.getElementById('radar-save'),
		load: document.getElementById('radar-load'),
		share: document.getElementById('radar-share'),
		reset: document.getElementById('radar-reset'),
		brief: document.getElementById('radar-brief'),
		compare: document.getElementById('radar-compare'),
	};

	const list = document.getElementById('radar-list');
	const count = document.getElementById('radar-count');
	const empty = document.getElementById('radar-empty');
	const map = document.getElementById('radar-map');
	const mapSection = document.getElementById('radar-map-section');
	const filterPanel = document.getElementById('radar-filter-panel');
	const filterChips = document.getElementById('radar-filter-chips');
	const briefOutput = document.getElementById('radar-brief-output');
	const pinnedPanel = document.getElementById('radar-pinned');
	const pinnedList = document.getElementById('radar-pinned-list');

	const cards = Array.from(document.querySelectorAll('[data-event-card]'));
	const mapMarkers = Array.from(map.querySelectorAll('[data-map-marker]'));
	const pinButtons = Array.from(document.querySelectorAll('[data-pin-btn]'));
	const presetButtons = Array.from(document.querySelectorAll('[data-preset]'));

	let compactMode = false;
	let mapVisible = true;
	let pinned = loadPins();

	if (window.matchMedia('(max-width: 767px)').matches && filterPanel) filterPanel.open = false;

	function parseDate(value) {
		if (!value) return null;
		const ms = new Date(value).getTime();
		return Number.isNaN(ms) ? null : ms;
	}

	function loadPins() {
		try {
			const raw = localStorage.getItem(PIN_KEY);
			const ids = raw ? JSON.parse(raw) : [];
			return new Set(Array.isArray(ids) ? ids : []);
		} catch {
			return new Set();
		}
	}

	function savePins() {
		localStorage.setItem(PIN_KEY, JSON.stringify(Array.from(pinned)));
	}

	function scoreTone(score) {
		if (score >= 80) return 'high';
		if (score >= 60) return 'mid';
		return 'low';
	}

	for (const card of cards) {
		const score = Number(card.dataset.score || '0');
		card.classList.add(`radar-tone-${scoreTone(score)}`);
	}

	for (const marker of mapMarkers) {
		const go = () => {
			const card = cards.find((c) => c.dataset.id === marker.dataset.id);
			if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
		};
		marker.addEventListener('click', go);
		marker.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				go();
			}
		});
	}

	function stateFromUI() {
		return {
			q: controls.q.value.trim(),
			branch: controls.branch.value,
			type: controls.type.value,
			status: controls.status.value,
			sort: controls.sort.value,
			min: Number(controls.minScore.value || 0),
			high: controls.highOnly.checked,
			upcoming: controls.upcomingOnly.checked,
			verified: controls.verifiedOnly.checked,
		};
	}

	function applyState(state) {
		controls.q.value = state.q || '';
		controls.branch.value = state.branch || '';
		controls.type.value = state.type || '';
		controls.status.value = state.status || '';
		controls.sort.value = state.sort || 'score';
		controls.minScore.value = String(state.min || 0);
		controls.minScoreLabel.textContent = String(state.min || 0);
		controls.highOnly.checked = Boolean(state.high);
		controls.upcomingOnly.checked = Boolean(state.upcoming);
		controls.verifiedOnly.checked = Boolean(state.verified);
	}

	function toQuery(state) {
		const params = new URLSearchParams();
		if (state.q) params.set('q', state.q);
		if (state.branch) params.set('branch', state.branch);
		if (state.type) params.set('type', state.type);
		if (state.status) params.set('status', state.status);
		if (state.sort && state.sort !== 'score') params.set('sort', state.sort);
		if (state.min > 0) params.set('min', String(state.min));
		if (state.high) params.set('high', '1');
		if (state.upcoming) params.set('upcoming', '1');
		if (state.verified) params.set('verified', '1');
		return params.toString();
	}

	function applyUrlState() {
		const params = new URLSearchParams(window.location.search);
		applyState({
			q: params.get('q') || '',
			branch: params.get('branch') || '',
			type: params.get('type') || '',
			status: params.get('status') || '',
			sort: params.get('sort') || 'score',
			min: Number(params.get('min') || 0),
			high: params.get('high') === '1',
			upcoming: params.get('upcoming') === '1',
			verified: params.get('verified') === '1',
		});
	}

	function getVisibleCards() {
		const state = stateFromUI();
		const q = state.q.toLowerCase();
		const visible = cards.filter((card) => {
			if (state.branch && card.dataset.branch !== state.branch) return false;
			if (state.type && card.dataset.type !== state.type) return false;
			if (state.status && card.dataset.status !== state.status) return false;
			if (state.high && card.dataset.signal !== 'High') return false;
			if (state.upcoming && card.dataset.status !== 'Upcoming') return false;
			if (state.verified && card.dataset.confidence !== 'high') return false;
			if (Number(card.dataset.score || '0') < state.min) return false;
			if (!q) return true;
			return (card.dataset.search || '').includes(q);
		});

		if (state.sort === 'date') {
			visible.sort((a, b) => {
				const da = parseDate(a.dataset.date || '');
				const db = parseDate(b.dataset.date || '');
				if (da === null && db === null) return Number(b.dataset.score) - Number(a.dataset.score);
				if (da === null) return 1;
				if (db === null) return -1;
				return da - db;
			});
		} else if (state.sort === 'signal') {
			const rank = { High: 3, Medium: 2, Low: 1 };
			visible.sort((a, b) => (rank[b.dataset.signal] - rank[a.dataset.signal]) || (Number(b.dataset.score) - Number(a.dataset.score)));
		} else if (state.sort === 'meta') {
			visible.sort((a, b) => Number(b.dataset.meta) - Number(a.dataset.meta) || Number(b.dataset.score) - Number(a.dataset.score));
		} else {
			visible.sort((a, b) => Number(b.dataset.score) - Number(a.dataset.score));
		}

		return { visible, state };
	}

	function renderFilterChips(state) {
		const chips = [];
		if (state.q) chips.push(`Search: ${state.q}`);
		if (state.branch) chips.push(`Branch: ${state.branch}`);
		if (state.type) chips.push(`Type: ${state.type}`);
		if (state.status) chips.push(`Status: ${state.status}`);
		if (state.min > 0) chips.push(`Min score: ${state.min}`);
		if (state.high) chips.push('High signal');
		if (state.upcoming) chips.push('Upcoming only');
		if (state.verified) chips.push('Verified only');
		if (!chips.length) chips.push('No active filters');
		filterChips.innerHTML = chips.map((chip) => `<span class="radar-chip">${chip}</span>`).join('');
	}

	function renderPinned() {
		const entries = Array.from(pinned)
			.map((id) => cards.find((c) => c.dataset.id === id))
			.filter(Boolean)
			.sort((a, b) => Number(b.dataset.score) - Number(a.dataset.score));

		for (const btn of pinButtons) {
			const id = btn.dataset.id;
			const isPinned = pinned.has(id);
			btn.classList.toggle('is-pinned', isPinned);
			btn.textContent = isPinned ? 'Pinned' : 'Pin';
		}

		if (!entries.length) {
			pinnedPanel.classList.add('hidden');
			pinnedList.innerHTML = '';
			return;
		}

		pinnedPanel.classList.remove('hidden');
		pinnedList.innerHTML = entries
			.map((card) => {
				const title = card.dataset.title || card.querySelector('h3')?.textContent || 'Untitled';
				const score = card.dataset.score;
				const meta = card.querySelector('.radar-meta')?.textContent || '';
				return `<li class="radar-pinned-item"><span>${title}</span><span class="text-slate-400">${meta} · score ${score}</span></li>`;
			})
			.join('');
	}

	function renderMap(visibleCards) {
		const cardsForMap = visibleCards.length ? visibleCards : cards;
		const visibleIds = new Set(cardsForMap.map((card) => card.dataset.id));
		for (const marker of mapMarkers) {
			const show = mapVisible && visibleIds.has(marker.dataset.id);
			marker.classList.toggle('hidden', !show);
			marker.setAttribute('aria-hidden', show ? 'false' : 'true');
		}
	}

	function render() {
		const { visible, state } = getVisibleCards();
		for (const card of cards) card.classList.add('hidden');
		for (const card of visible) {
			card.classList.remove('hidden');
			list.appendChild(card);
		}

		list.classList.toggle('is-compact', compactMode);
		mapSection.classList.toggle('hidden', !mapVisible);
		controls.toggleMap.textContent = mapVisible ? 'Hide map' : 'Show map';
		controls.toggleCompact.textContent = compactMode ? 'Detailed mode' : 'Compact mode';
		controls.minScoreLabel.textContent = String(state.min);

		empty.classList.toggle('hidden', visible.length > 0);
		count.textContent = `${visible.length} of ${cards.length} items shown · ${pinned.size} pinned`;
		renderFilterChips(state);
		renderMap(visible);
		renderPinned();

		const query = toQuery(state);
		const href = query ? `${window.location.pathname}?${query}` : window.location.pathname;
		history.replaceState(null, '', href);
	}

	function saveView() {
		localStorage.setItem(KEY, JSON.stringify(stateFromUI()));
	}

	function loadView() {
		const raw = localStorage.getItem(KEY);
		if (!raw) return;
		try {
			const state = JSON.parse(raw);
			applyState(state);
			render();
		} catch {
			/* ignore */
		}
	}

	async function copyShare() {
		await navigator.clipboard.writeText(window.location.href);
		controls.share.textContent = 'Copied';
		setTimeout(() => (controls.share.textContent = 'Copy share link'), 1200);
	}

	async function buildBrief() {
		const { visible } = getVisibleCards();
		const top = visible.slice(0, 6).map((card, i) => {
			const title = card.querySelector('h3')?.textContent?.trim() || 'Untitled';
			const meta = card.querySelector('.radar-meta')?.textContent?.trim() || '';
			const score = card.dataset.score;
			return `${i + 1}. ${title} (score ${score}) - ${meta}`;
		});

		const text = ['# Radar Brief Draft', '', `Generated: ${new Date().toLocaleString()}`, '', '## Prioritized opportunities', '', ...top, '', '## Notes', '- Auto-generated from current filter state', '- Review provenance confidence before external use'].join('\n');
		briefOutput.classList.remove('hidden');
		briefOutput.textContent = text;
		await navigator.clipboard.writeText(text);
	}

	async function copyCompareBrief() {
		const entries = Array.from(pinned)
			.map((id) => cards.find((c) => c.dataset.id === id))
			.filter(Boolean)
			.sort((a, b) => Number(b.dataset.score) - Number(a.dataset.score));

		if (!entries.length) return;
		const lines = ['# Radar Compare Brief', '', `Generated: ${new Date().toLocaleString()}`, ''];
		entries.forEach((card, i) => {
			const title = card.dataset.title || card.querySelector('h3')?.textContent || 'Untitled';
			const meta = card.querySelector('.radar-meta')?.textContent || '';
			lines.push(`${i + 1}. ${title} (score ${card.dataset.score}) - ${meta}`);
		});
		const text = lines.join('\n');
		briefOutput.classList.remove('hidden');
		briefOutput.textContent = text;
		await navigator.clipboard.writeText(text);
	}

	function applyPreset(name) {
		if (name === 'near-term') {
			applyState({ q: '', branch: '', type: '', status: 'Upcoming', sort: 'date', min: 55, high: false, upcoming: true, verified: false });
		} else if (name === 'high-confidence') {
			applyState({ q: '', branch: '', type: '', status: '', sort: 'score', min: 60, high: false, upcoming: false, verified: true });
		} else if (name === 'needs-dates') {
			applyState({ q: '', branch: '', type: '', status: 'Needs Date', sort: 'meta', min: 0, high: false, upcoming: false, verified: false });
		}
		render();
	}

	function togglePin(id) {
		if (!id) return;
		if (pinned.has(id)) pinned.delete(id);
		else pinned.add(id);
		savePins();
		renderPinned();
	}

	[controls.q, controls.branch, controls.type, controls.status, controls.sort, controls.minScore].forEach((node) => node.addEventListener('input', render));
	[controls.highOnly, controls.upcomingOnly, controls.verifiedOnly].forEach((node) => node.addEventListener('change', render));
	controls.save.addEventListener('click', saveView);
	controls.load.addEventListener('click', loadView);
	controls.share.addEventListener('click', copyShare);
	controls.reset.addEventListener('click', () => {
		applyState({ q: '', branch: '', type: '', status: '', sort: 'score', min: 0, high: false, upcoming: false, verified: false });
		render();
	});
	controls.brief.addEventListener('click', buildBrief);
	controls.compare.addEventListener('click', copyCompareBrief);
	controls.toggleMap.addEventListener('click', () => {
		mapVisible = !mapVisible;
		render();
	});
	controls.toggleCompact.addEventListener('click', () => {
		compactMode = !compactMode;
		render();
	});
	controls.clearPins.addEventListener('click', () => {
		pinned = new Set();
		savePins();
		renderPinned();
		render();
	});

	for (const btn of presetButtons) {
		btn.addEventListener('click', () => applyPreset(btn.dataset.preset));
	}

	for (const btn of pinButtons) {
		btn.addEventListener('click', () => togglePin(btn.dataset.id));
	}

	document.addEventListener('keydown', (event) => {
		if (event.target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(event.target.tagName)) return;
		if (event.key === '/') {
			event.preventDefault();
			controls.q.focus();
			controls.q.select();
		}
		if (event.key.toLowerCase() === 'm') {
			mapVisible = !mapVisible;
			render();
		}
		if (event.key.toLowerCase() === 'c') {
			compactMode = !compactMode;
			render();
		}
	});

	applyUrlState();
	render();
</script>

