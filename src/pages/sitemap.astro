---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../utils/withBase';

type WritingItem = {
	title: string;
	type: 'paper' | 'memo' | 'note';
	date: Date | null;
	pageHref: string;
	pdfHref: string | null;
};

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.map((w) => ({
		title: w.data.title,
		type: w.data.type,
		date: w.data.date ?? null,
		pageHref: `/writing/${w.id.split('/').pop()}/`,
		pdfHref: w.data.pdfPath ?? null,
	} satisfies WritingItem));

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.map((p) => ({
		title: p.data.title,
		type: 'paper' as const,
		date: p.data.date ?? null,
		pageHref: `/writing/${p.id}/`,
		pdfHref: p.data.pdfPath ?? null,
	} satisfies WritingItem));

const publishedWriting = [...papers, ...writing].sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0));
---

<SiteLayout
	title="Sitemap | Adam Boas"
	description="Human-readable sitemap for adamboas.com pages and published writing."
	canonicalHref="https://www.adamboas.com/sitemap/"
>
	<section class="mt-2 space-y-4">
		<div class="card control-shell p-4 sm:p-5 md:p-6">
			<h1 class="text-2xl font-semibold tracking-tight text-slate-50 sm:text-3xl">Sitemap</h1>
			<p class="mt-2 text-sm text-slate-300">Human-readable map of key pages, plus direct PDF links under published writing.</p>

			<div class="mt-4 border border-slate-800 bg-slate-950/40 p-4">
				<h2 class="section-title">Site Pages</h2>
				<ul class="mt-3 space-y-1.5 text-sm text-slate-300">
					<li><a class="hover:text-slate-100" href={withBase('/')}>Home</a></li>
					<li><a class="hover:text-slate-100" href={withBase('/writing/')}>Writing</a></li>
					<li><a class="hover:text-slate-100" href={withBase('/events/')}>Events</a></li>
					<li><a class="hover:text-slate-100" href={withBase('/events/sources/')}>Event Sources</a></li>
					<li><a class="hover:text-slate-100" href={withBase('/changes/')}>Changes</a></li>
					<li><a class="hover:text-slate-100" href={withBase('/license/')}>License</a></li>
					<li><a class="hover:text-slate-100" href={withBase('/rss.xml')}>RSS</a></li>
					<li><a class="hover:text-slate-100" href={withBase('/sitemap-index.xml')}>XML sitemap</a></li>
				</ul>
			</div>
		</div>

		<div class="card control-shell p-4 sm:p-5 md:p-6">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<h2 class="section-title">Published Writing</h2>
				<p class="text-xs text-slate-400">{publishedWriting.length} items</p>
			</div>

			<ul class="mt-4 space-y-2">
				{publishedWriting.map((item) => (
					<li class="border border-slate-800 bg-slate-950/40 p-3 sm:p-4">
						<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
							<div class="min-w-0">
								<p class="sitemap-item-title text-sm font-semibold text-slate-100">{item.title}</p>
								<p class="mt-1 text-xs uppercase tracking-wide text-slate-400">
									{item.type}
									{item.date ? ` · ${item.date.toISOString().slice(0, 10)}` : ''}
								</p>
							</div>
							<div class="flex shrink-0 flex-wrap items-center gap-3 text-sm">
								<a class="font-semibold text-stone-100 hover:text-stone-50" href={withBase(item.pageHref)}>Page →</a>
								{item.pdfHref && <a class="font-semibold text-stone-100 hover:text-stone-50" href={withBase(item.pdfHref)}>PDF ↗</a>}
							</div>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>
</SiteLayout>

<style>
	.section-title {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.2;
		color: rgb(248, 250, 252);
		border-left: 3px solid rgba(0, 196, 196, 0.55);
		padding-left: 0.65rem;
	}

	.sitemap-item-title {
		overflow-wrap: anywhere;
		word-break: break-word;
	}
</style>
