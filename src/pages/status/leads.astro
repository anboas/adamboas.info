---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
import plausibleFunnel from '../../generated/plausible-funnel.json';

type FunnelSnapshot = {
	meta?: {
		generatedAt?: string | null;
		siteId?: string | null;
		dateRange?: string | null;
		note?: string | null;
		triedSiteIds?: string[];
	};
	eventTotals?: Record<string, number>;
	byPage?: Record<string, Record<string, number>>;
};

const snapshot = (plausibleFunnel ?? {}) as FunnelSnapshot;
const meta = snapshot.meta ?? {};
const eventTotals = snapshot.eventTotals ?? {};
const byPage = snapshot.byPage ?? {};

const funnelOrder = [
	{ key: 'Contact: Intake Click', label: 'Intake CTA clicks' },
	{ key: 'Contact Form: View', label: 'Form views' },
	{ key: 'Contact Form: Start', label: 'Form starts' },
	{ key: 'Contact Form: Submit', label: 'Form submits' },
	{ key: 'Contact Form: Success', label: 'Successful sends' },
] as const;

function n(value: unknown) {
	const parsed = Number(value ?? 0);
	return Number.isFinite(parsed) ? parsed : 0;
}

function pct(part: number, whole: number) {
	if (!whole) return '—';
	return `${Math.round((part / whole) * 100)}%`;
}

const funnel = funnelOrder.map((stage, index) => {
	const count = n(eventTotals[stage.key]);
	const prev = index > 0 ? n(eventTotals[funnelOrder[index - 1].key]) : null;
	return {
		...stage,
		count,
		stepRate: prev === null ? '—' : pct(count, prev),
	};
});

const totals = {
	intake: n(eventTotals['Contact: Intake Click']),
	view: n(eventTotals['Contact Form: View']),
	start: n(eventTotals['Contact Form: Start']),
	submit: n(eventTotals['Contact Form: Submit']),
	success: n(eventTotals['Contact Form: Success']),
	error: n(eventTotals['Contact Form: Error']),
	email: n(eventTotals['Contact: Email Click']),
};

const snapshotGeneratedAt = meta.generatedAt ? new Date(meta.generatedAt).toLocaleString() : '—';
const snapshotSite = meta.siteId || '—';
const snapshotRange = meta.dateRange || '30d';
const snapshotNote = meta.note || '—';

const pageRows = Object.entries(byPage)
	.map(([page, events]) => {
		const row = {
			page,
			intake: n(events['Contact: Intake Click']),
			view: n(events['Contact Form: View']),
			start: n(events['Contact Form: Start']),
			submit: n(events['Contact Form: Submit']),
			success: n(events['Contact Form: Success']),
			error: n(events['Contact Form: Error']),
			email: n(events['Contact: Email Click']),
		};
		return {
			...row,
			total: row.intake + row.view + row.start + row.submit + row.success + row.error + row.email,
		};
	})
	.filter((row) => row.total > 0)
	.sort((a, b) => b.submit - a.submit || b.success - a.success || b.intake - a.intake || a.page.localeCompare(b.page))
	.slice(0, 25);
---

<SiteLayout title="Lead Funnel | Status | Adam Boas" description="Plausible event-funnel metrics for contact conversion across key pages.">
	<StickyBrowseBar active="home" />

	<section class="card control-shell p-5">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h1 class="section-title">Lead Funnel Analytics</h1>
				<p class="mt-2 text-sm text-slate-300">Contact conversion visibility: CTA click -> form view/start -> submit -> success.</p>
			</div>
			<div class="flex flex-wrap gap-2">
				<a class="lead-link" href={withBase('/status/')}>Back to status</a>
				<a class="lead-link" href="https://plausible.io/anboas.github.io/adamboas.info" target="_blank" rel="noreferrer">Open Plausible</a>
			</div>
		</div>
		<div class="lead-meta mt-3">
			<span class="lead-meta-pill">Site: {snapshotSite}</span>
			<span class="lead-meta-pill">Window: {snapshotRange}</span>
			<span class="lead-meta-pill">Generated: {snapshotGeneratedAt}</span>
			<span class="lead-meta-pill">Note: {snapshotNote}</span>
		</div>
	</section>

	<section class="mt-4 grid gap-4 lg:grid-cols-5">
		{funnel.map((stage) => (
			<article class="card p-4 lead-stage-card">
				<p class="lead-stage-label">{stage.label}</p>
				<p class="lead-stage-value">{stage.count}</p>
				<p class="lead-stage-rate">Step conversion: {stage.stepRate}</p>
			</article>
		))}
	</section>

	<section class="mt-4 grid gap-4 lg:grid-cols-4">
		<article class="card p-4 lead-stage-card">
			<p class="lead-stage-label">CTA -> Submit</p>
			<p class="lead-stage-value">{pct(totals.submit, totals.intake)}</p>
		</article>
		<article class="card p-4 lead-stage-card">
			<p class="lead-stage-label">Submit -> Success</p>
			<p class="lead-stage-value">{pct(totals.success, totals.submit)}</p>
		</article>
		<article class="card p-4 lead-stage-card">
			<p class="lead-stage-label">Fallback email clicks</p>
			<p class="lead-stage-value">{totals.email}</p>
		</article>
		<article class="card p-4 lead-stage-card">
			<p class="lead-stage-label">Form errors</p>
			<p class="lead-stage-value">{totals.error}</p>
		</article>
	</section>

	<section class="card control-shell mt-4 p-4">
		<div class="flex flex-wrap items-end justify-between gap-2">
			<h2 class="section-title">By page</h2>
			<p class="text-xs text-slate-400">Top pages with contact events ({pageRows.length})</p>
		</div>
		{pageRows.length ? (
			<div class="lead-table-wrap mt-3">
				<table class="lead-table">
					<thead>
						<tr>
							<th>Page</th>
							<th>CTA</th>
							<th>View</th>
							<th>Start</th>
							<th>Submit</th>
							<th>Success</th>
							<th>Error</th>
							<th>Email</th>
							<th>Submit rate</th>
						</tr>
					</thead>
					<tbody>
						{pageRows.map((row) => (
							<tr>
								<td>{row.page}</td>
								<td>{row.intake}</td>
								<td>{row.view}</td>
								<td>{row.start}</td>
								<td>{row.submit}</td>
								<td>{row.success}</td>
								<td>{row.error}</td>
								<td>{row.email}</td>
								<td>{pct(row.submit, row.intake)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		) : (
			<p class="mt-3 text-sm text-slate-300">No contact-event rows yet. Once Plausible snapshots include event data, this table auto-populates.</p>
		)}
	</section>
</SiteLayout>

<style>
	.lead-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.42rem;
	}
	.lead-meta-pill {
		display: inline-flex;
		align-items: center;
		height: 1.55rem;
		padding: 0 0.55rem;
		border: 1px solid rgba(71, 85, 105, 0.82);
		background: rgba(2, 6, 23, 0.85);
		font-size: 0.67rem;
		color: rgba(203, 213, 225, 0.96);
	}
	.lead-stage-card {
		border: 1px solid rgba(51, 65, 85, 0.84);
		background: rgba(2, 6, 23, 0.84);
	}
	.lead-stage-label {
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(148, 163, 184, 0.94);
	}
	.lead-stage-value {
		margin-top: 0.34rem;
		font-size: 1.28rem;
		line-height: 1.1;
		font-weight: 700;
		color: rgba(240, 253, 250, 0.98);
	}
	.lead-stage-rate {
		margin-top: 0.3rem;
		font-size: 0.72rem;
		color: rgba(125, 211, 252, 0.95);
	}
	.lead-link {
		display: inline-flex;
		align-items: center;
		height: 1.8rem;
		padding: 0 0.65rem;
		border: 1px solid rgba(71, 85, 105, 0.82);
		background: rgba(2, 6, 23, 0.82);
		font-size: 0.72rem;
		color: rgba(226, 232, 240, 0.95);
		text-decoration: none;
	}
	.lead-link:hover {
		border-color: rgba(125, 211, 252, 0.65);
	}
	.lead-table-wrap {
		overflow: auto;
		border: 1px solid rgba(51, 65, 85, 0.75);
		background: rgba(2, 6, 23, 0.7);
	}
	.lead-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.76rem;
	}
	.lead-table th,
	.lead-table td {
		padding: 0.42rem 0.45rem;
		border-bottom: 1px solid rgba(51, 65, 85, 0.6);
		text-align: left;
		white-space: nowrap;
	}
	.lead-table th {
		position: sticky;
		top: 0;
		z-index: 1;
		background: rgba(15, 23, 42, 0.95);
		color: rgba(226, 232, 240, 0.95);
		font-size: 0.63rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.lead-table td {
		color: rgba(203, 213, 225, 0.96);
	}
</style>
