---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
import sitemapAnalytics from '../../generated/plausible-sitemap-analytics.json';

type TrendWindow = {
	range: string;
	label?: string;
	pageviews?: number | null;
	perDay?: number | null;
	status?: string;
};

type Snapshot = {
	meta?: {
		generatedAt?: string | null;
		siteId?: string | null;
		dateRange?: string | null;
		note?: string | null;
		triedSiteIds?: string[];
		sitemapIndexUrl?: string | null;
		sitemapLoadError?: string | null;
		sitemapFiles?: string[];
	};
	summary?: {
		totalSitemapPages?: number;
		pagesWithViews?: number;
		coveragePct?: number;
		totalPageviewsOnSitemap?: number;
		totalTrackedPaths?: number;
		trackedOffSitemapCount?: number;
	};
	rows?: {
		topSitemap?: Array<{ path: string; pageviews: number }>;
		zeroViewSitemap?: Array<{ path: string; pageviews: number }>;
		offSitemap?: Array<{ path: string; pageviews: number }>;
		invalidTrackedPaths?: Array<{ path: string; pageviews: number }>;
	};
	insights?: {
		paretoTop?: Array<{ rank: number; path: string; pageviews: number; sharePct: number; cumulativePct: number }>;
		sectionHeatmap?: Array<{
			section: string;
			totalRoutes: number;
			routesWithViews: number;
			totalViews: number;
			coveragePct: number;
			viewsSharePct: number;
			intensity: number;
		}>;
		offSitemapRisk?: Array<{ path: string; pageviews: number; sharePct: number; riskScore: number; tier: string }>;
	};
	trends?: {
		mode?: string;
		note?: string | null;
		windows?: TrendWindow[];
		momentum?: {
			last7vsPrev23Pct?: number | null;
			last30vsPrev60Pct?: number | null;
		};
	};
};

const snapshot = (sitemapAnalytics ?? {}) as Snapshot;
const meta = snapshot.meta ?? {};
const summary = snapshot.summary ?? {};
const rows = snapshot.rows ?? {};
const insights = snapshot.insights ?? {};
const trends = snapshot.trends ?? {};

function n(value: unknown) {
	const parsed = Number(value ?? 0);
	return Number.isFinite(parsed) ? parsed : 0;
}

function fmtDate(value?: string | null) {
	if (!value) return '—';
	const d = new Date(value);
	if (Number.isNaN(d.getTime())) return '—';
	return d.toLocaleString(undefined, {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		hour: '2-digit',
		minute: '2-digit',
	});
}

function fmtPct(value: unknown) {
	const v = Number(value);
	if (!Number.isFinite(v)) return '—';
	if (v > 0) return `+${v.toFixed(1)}%`;
	return `${v.toFixed(1)}%`;
}

const kpi = {
	totalSitemapPages: n(summary.totalSitemapPages),
	pagesWithViews: n(summary.pagesWithViews),
	coveragePct: n(summary.coveragePct),
	totalPageviewsOnSitemap: n(summary.totalPageviewsOnSitemap),
	totalTrackedPaths: n(summary.totalTrackedPaths),
};

const invalidRows = Array.isArray(rows.invalidTrackedPaths) ? rows.invalidTrackedPaths.slice(0, 80) : [];

const paretoRows = Array.isArray(insights.paretoTop) ? insights.paretoTop.slice(0, 20) : [];
const sectionRows = Array.isArray(insights.sectionHeatmap) ? insights.sectionHeatmap.slice(0, 24) : [];

const zeroViewCount = Math.max(kpi.totalSitemapPages - kpi.pagesWithViews, 0);
const coverageRows = [
	{ label: 'With views', value: kpi.pagesWithViews, tone: 'ok' },
	{ label: 'Zero-view', value: zeroViewCount, tone: 'quiet' },
].map((row) => ({
	...row,
	pct: kpi.totalSitemapPages ? Number(((row.value / kpi.totalSitemapPages) * 100).toFixed(1)) : 0,
}));

const trendWindowsRaw = Array.isArray(trends.windows) ? trends.windows : [];
const trendWindows = ['7d', '30d', '90d'].map((range) => {
	const found = trendWindowsRaw.find((w) => String(w?.range || '').toLowerCase() === range);
	return {
		range,
		label: found?.label || range,
		pageviews: found?.pageviews ?? null,
		perDay: found?.perDay ?? null,
		status: found?.status || 'missing',
	};
});
const trendValues = trendWindows.map((w) => (typeof w.pageviews === 'number' ? w.pageviews : 0));
const trendMax = trendValues.reduce((max, value) => Math.max(max, value), 0);
const trendLine = trendWindows.map((w, idx) => {
	const x = trendWindows.length > 1 ? (idx / (trendWindows.length - 1)) * 100 : 50;
	const y = trendMax && typeof w.pageviews === 'number' ? 100 - (w.pageviews / trendMax) * 100 : 100;
	return {
		...w,
		x: Number(x.toFixed(2)),
		y: Number(y.toFixed(2)),
	};
});
const trendPolyline = trendLine.map((p) => `${p.x},${p.y}`).join(' ');
const trendHasData = trendLine.some((p) => typeof p.pageviews === 'number' && p.pageviews > 0);
const trendArea = trendHasData ? `${trendPolyline} 100,100 0,100` : '';

const paretoMax = paretoRows.reduce((max, row) => Math.max(max, n(row.pageviews)), 0);
---

<SiteLayout title="Site Analytics | Status | Adam Boas" description="Sitemap coverage and route-level traffic analytics from Plausible snapshots." noindex={true}>
	<StickyBrowseBar active="home" />

	<section class="card control-shell p-5">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h1 class="section-title">Site Analytics Dashboard</h1>
				<p class="mt-2 text-sm text-slate-300">Plausible traffic mapped to sitemap routes for coverage and routing intelligence.</p>
			</div>
			<div class="flex flex-wrap gap-2">
				<a class="ui-link-btn" href={withBase('/status/')}>Back to status</a>
				<a class="ui-link-btn" href={meta.sitemapIndexUrl || 'https://www.adamboas.com/sitemap-index.xml'} target="_blank" rel="noreferrer">Open sitemap</a>
				<a class="ui-link-btn" href="https://plausible.io/" target="_blank" rel="noreferrer">Open Plausible</a>
			</div>
		</div>

		<div class="status-meta mt-3">
			<span class="ui-pill wrap-anywhere">Site: {meta.siteId || '—'}</span>
			<span class="ui-pill">Window: {meta.dateRange || '30d'}</span>
			<span class="ui-pill wrap-anywhere">Generated: {fmtDate(meta.generatedAt)}</span>
			<span class="ui-pill wrap-anywhere">Mode: {trends.mode || 'snapshot'}</span>
		</div>
		<p class="mt-2 text-xs text-slate-400">{trends.note || meta.note || '—'}</p>
		{meta.sitemapLoadError ? <p class="mt-2 text-xs text-amber-300">Sitemap load warning: {meta.sitemapLoadError}</p> : null}
	</section>

	<section class="mt-4 grid gap-4 lg:grid-cols-3">
		<article class="card p-4 status-card">
			<p class="status-kpi-label">Sitemap pages</p>
			<p class="status-kpi-value">{kpi.totalSitemapPages}</p>
		</article>
		<article class="card p-4 status-card">
			<p class="status-kpi-label">Pages with views</p>
			<p class="status-kpi-value">{kpi.pagesWithViews}</p>
			<p class="status-kpi-sub">Coverage: {kpi.coveragePct}%</p>
		</article>
		<article class="card p-4 status-card">
			<p class="status-kpi-label">Views on sitemap routes</p>
			<p class="status-kpi-value">{kpi.totalPageviewsOnSitemap.toLocaleString()}</p>
		</article>
	</section>

	<section class="mt-4 grid gap-4 lg:grid-cols-2">
		<article class="card p-4 status-card">
			<p class="status-kpi-label">Tracked Plausible paths</p>
			<p class="status-kpi-value">{kpi.totalTrackedPaths}</p>
		</article>
		<article class="card p-4 status-card">
			<p class="status-kpi-label">Invalid tracked rows</p>
			<p class="status-kpi-value">{invalidRows.length}</p>
		</article>
	</section>

	<section class="mt-4 grid gap-4 lg:grid-cols-2">
		<article class="card control-shell p-4">
			<div class="flex flex-wrap items-end justify-between gap-2">
				<h2 class="section-title">Trend line chart</h2>
				<p class="text-xs text-slate-400">7d / 30d / 90d totals</p>
			</div>
			<div class="trend-line-wrap mt-3" aria-hidden="true">
				<svg viewBox="0 0 100 100" class="trend-line-svg" preserveAspectRatio="none">
					<path d="M0,100 L100,100" class="trend-axis" />
					<path d="M0,66 L100,66" class="trend-gridline" />
					<path d="M0,33 L100,33" class="trend-gridline" />
					{trendHasData ? <polygon points={trendArea} class="trend-area" /> : null}
					{trendHasData ? <polyline points={trendPolyline} class="trend-line" /> : null}
					{trendLine.map((point) => (
						<circle cx={point.x} cy={point.y} r="1.8" class:list={['trend-dot', typeof point.pageviews === 'number' ? 'trend-dot-live' : 'trend-dot-empty']} />
					))}
				</svg>
				<div class="trend-label-row">
					{trendLine.map((point) => (
						<span>{point.label}</span>
					))}
				</div>
			</div>
			<div class="trend-grid mt-3">
				{trendLine.map((w) => (
					<div class="trend-card">
						<p class="trend-label">{w.label}</p>
						<p class="trend-value">{typeof w.pageviews === 'number' ? w.pageviews.toLocaleString() : '—'}</p>
						<p class="trend-sub">{typeof w.perDay === 'number' ? `${w.perDay.toFixed(2)}/day` : 'n/a'}</p>
					</div>
				))}
			</div>
			<div class="trend-momentum mt-3">
				<span class="ui-pill wrap-anywhere">7d momentum: {fmtPct(trends.momentum?.last7vsPrev23Pct)}</span>
				<span class="ui-pill wrap-anywhere">30d momentum: {fmtPct(trends.momentum?.last30vsPrev60Pct)}</span>
			</div>
		</article>

		<article class="card control-shell p-4">
			<div class="flex flex-wrap items-end justify-between gap-2">
				<h2 class="section-title">Coverage graph</h2>
				<p class="text-xs text-slate-400">Viewed vs zero-view split</p>
			</div>
			<div class="coverage-stack mt-3">
				{coverageRows.map((row) => (
					<div class="coverage-row">
						<div class="coverage-row-head">
							<span>{row.label}</span>
							<strong>{row.value.toLocaleString()} · {row.pct}%</strong>
						</div>
						<div class="coverage-track" aria-hidden="true">
							<div class:list={['coverage-fill', row.tone === 'ok' ? 'coverage-fill-ok' : 'coverage-fill-quiet']} style={`width:${Math.max(row.pct, row.value > 0 ? 1 : 0)}%`}></div>
						</div>
					</div>
				))}
			</div>
		</article>
	</section>

	<section class="mt-4 grid gap-4 lg:grid-cols-2">
		<article class="card control-shell p-4">
			<div class="flex flex-wrap items-end justify-between gap-2">
				<h2 class="section-title">Pareto chart (top routes)</h2>
				<p class="text-xs text-slate-400">Share + cumulative contribution</p>
			</div>
			{paretoRows.length ? (
				<div class="pareto-stack mt-3">
					{paretoRows.map((row) => (
						<div class="pareto-row">
							<div class="pareto-head">
								<span>{row.path}</span>
								<strong>{n(row.pageviews).toLocaleString()} · {n(row.sharePct).toFixed(1)}%</strong>
							</div>
							<div class="pareto-track" aria-hidden="true">
								<div class="pareto-fill" style={`width:${paretoMax ? Math.max((n(row.pageviews) / paretoMax) * 100, 1) : 0}%`}></div>
								<div class="pareto-marker" style={`left:${Math.min(Math.max(n(row.cumulativePct), 1), 100)}%`}></div>
							</div>
							<p class="pareto-meta">Cumulative: {n(row.cumulativePct).toFixed(1)}%</p>
						</div>
					))}
				</div>
			) : (
				<p class="mt-3 text-sm text-slate-300">No Pareto rows available in this snapshot.</p>
			)}
		</article>

		<article class="card control-shell p-4">
			<div class="flex flex-wrap items-end justify-between gap-2">
				<h2 class="section-title">Section heatmap</h2>
				<p class="text-xs text-slate-400">Coverage + traffic by route family</p>
			</div>
			{sectionRows.length ? (
				<div class="heatmap-grid mt-3">
					{sectionRows.map((row) => (
						<article class="heat-cell" style={`--heat:${Math.max(n(row.intensity), 0)};`}>
							<p class="heat-title">/{row.section}</p>
							<p class="heat-kpi">{n(row.totalViews).toLocaleString()} views</p>
							<p class="heat-sub">{n(row.routesWithViews)}/{n(row.totalRoutes)} routes active · {n(row.coveragePct).toFixed(1)}%</p>
						</article>
					))}
				</div>
			) : (
				<p class="mt-3 text-sm text-slate-300">No section heatmap data yet.</p>
			)}
		</article>
	</section>


	{invalidRows.length ? (
		<section class="card control-shell mt-4 p-4">
			<div class="flex flex-wrap items-end justify-between gap-2">
				<h2 class="section-title">Invalid tracked paths</h2>
				<p class="text-xs text-slate-400">Rows dropped during normalization</p>
			</div>
			<div class="table-wrap mt-3">
				<table class="status-table">
					<thead>
						<tr>
							<th>Raw path</th>
							<th>Pageviews</th>
						</tr>
					</thead>
					<tbody>
						{invalidRows.map((row) => (
							<tr>
								<td>{row.path}</td>
								<td>{n(row.pageviews).toLocaleString()}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	) : null}
</SiteLayout>

<style>
	.status-card {
		border: 1px solid rgba(51, 65, 85, 0.85);
		background: rgba(2, 6, 23, 0.9);
	}
	.status-kpi-label {
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(148, 163, 184, 0.94);
	}
	.status-kpi-value {
		margin-top: 0.3rem;
		font-size: 1.35rem;
		line-height: 1.1;
		font-weight: 700;
		color: rgba(240, 253, 250, 0.98);
	}
	.status-kpi-sub {
		margin-top: 0.3rem;
		font-size: 0.74rem;
		color: rgba(125, 211, 252, 0.95);
	}
	.status-meta,
	.trend-momentum {
		display: flex;
		flex-wrap: wrap;
		gap: 0.42rem;
	}
	.trend-line-wrap {
		border: 1px solid rgba(51, 65, 85, 0.72);
		background: rgba(2, 6, 23, 0.82);
		padding: 0.45rem 0.55rem 0.4rem;
	}
	.trend-line-svg {
		display: block;
		width: 100%;
		height: 6.8rem;
	}
	.trend-axis {
		stroke: rgba(71, 85, 105, 0.95);
		stroke-width: 1;
		fill: none;
	}
	.trend-gridline {
		stroke: rgba(51, 65, 85, 0.9);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
		fill: none;
	}
	.trend-area {
		fill: rgba(59, 130, 246, 0.22);
	}
	.trend-line {
		stroke: rgba(96, 165, 250, 0.98);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
		fill: none;
	}
	.trend-dot {
		stroke: rgba(2, 6, 23, 0.96);
		stroke-width: 1;
	}
	.trend-dot-live {
		fill: rgba(56, 189, 248, 0.98);
	}
	.trend-dot-empty {
		fill: rgba(71, 85, 105, 0.92);
	}
	.trend-label-row {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.35rem;
		margin-top: 0.2rem;
		font-size: 0.64rem;
		text-align: center;
		color: rgba(148, 163, 184, 0.95);
	}
	.trend-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.55rem;
	}
	.trend-card {
		border: 1px solid rgba(51, 65, 85, 0.76);
		background: rgba(2, 6, 23, 0.76);
		padding: 0.42rem;
	}
	.trend-label {
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: rgba(148, 163, 184, 0.95);
	}
	.trend-value {
		margin-top: 0.22rem;
		font-size: 1rem;
		font-weight: 700;
		color: rgba(226, 232, 240, 0.97);
	}
	.trend-sub {
		font-size: 0.7rem;
		color: rgba(125, 211, 252, 0.95);
	}
	.coverage-stack,
	.pareto-stack {
		display: grid;
		gap: 0.5rem;
	}
	.coverage-row,
	.pareto-row {
		display: grid;
		gap: 0.22rem;
	}
	.coverage-row-head,
	.pareto-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: rgba(226, 232, 240, 0.95);
	}
	.coverage-row-head span,
	.pareto-head span {
		overflow-wrap: anywhere;
		color: rgba(203, 213, 225, 0.95);
	}
	.coverage-row-head strong,
	.pareto-head strong {
		color: rgba(125, 211, 252, 0.96);
		white-space: nowrap;
		font-weight: 600;
	}
	.coverage-track,
	.pareto-track {
		height: 0.52rem;
		border-radius: 999px;
		background: rgba(15, 23, 42, 0.96);
		border: 1px solid rgba(51, 65, 85, 0.72);
		overflow: hidden;
		position: relative;
	}
	.coverage-fill,
	.pareto-fill {
		height: 100%;
	}
	.coverage-fill-ok {
		background: rgba(45, 212, 191, 0.95);
	}
	.coverage-fill-quiet {
		background: rgba(71, 85, 105, 0.9);
	}
	.pareto-fill {
		background: rgba(56, 189, 248, 0.95);
	}
	.pareto-marker {
		position: absolute;
		top: -1px;
		bottom: -1px;
		width: 2px;
		background: rgba(251, 191, 36, 0.95);
	}
	.pareto-meta {
		font-size: 0.68rem;
		color: rgba(148, 163, 184, 0.95);
	}
	.heatmap-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem;
	}
	.heat-cell {
		border: 1px solid rgba(51, 65, 85, 0.75);
		background: rgba(30, 64, 175, calc(0.12 + (var(--heat) / 100) * 0.35));
		padding: 0.45rem;
	}
	.heat-title {
		font-size: 0.72rem;
		font-weight: 700;
		color: rgba(226, 232, 240, 0.98);
		overflow-wrap: anywhere;
	}
	.heat-kpi {
		margin-top: 0.2rem;
		font-size: 0.86rem;
		color: rgba(224, 242, 254, 0.96);
	}
	.heat-sub {
		margin-top: 0.12rem;
		font-size: 0.67rem;
		color: rgba(186, 230, 253, 0.95);
	}
	.table-wrap {
		overflow: auto;
		border: 1px solid rgba(51, 65, 85, 0.75);
		background: rgba(2, 6, 23, 0.7);
	}
	.status-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.76rem;
	}
	.status-table th,
	.status-table td {
		padding: 0.42rem 0.45rem;
		border-bottom: 1px solid rgba(51, 65, 85, 0.6);
		text-align: left;
		white-space: nowrap;
	}
	.status-table th:first-child,
	.status-table td:first-child {
		white-space: normal;
		overflow-wrap: anywhere;
		min-width: 14rem;
	}
	.status-table th {
		position: sticky;
		top: 0;
		z-index: 1;
		background: rgba(15, 23, 42, 0.95);
		color: rgba(226, 232, 240, 0.95);
		font-size: 0.63rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.status-table td {
		color: rgba(203, 213, 225, 0.96);
	}
	@media (max-width: 940px) {
		.heatmap-grid,
		.trend-grid,
		.trend-label-row {
			grid-template-columns: 1fr;
		}
	}
</style>
