---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { education } from '../../data/resume';
import { withBase } from '../../utils/withBase';
---

<SiteLayout title="Education | Adam Boas" description="Education and credentials." noindex={true}>
	<StickyBrowseBar active="education" />
	<section class="card control-shell p-5">
		<h1 class="section-title">Education</h1>
		<p class="mt-2 text-sm text-slate-300">Credentials and formal education.</p>
	</section>

	<section class="card mt-4 bg-slate-950/40 p-6 md:mt-5">
		<ul class="space-y-3 text-sm text-slate-300">
			{education.map((c) => (
				<li class="flex flex-col gap-1 border-b border-slate-800 pb-3 md:flex-row md:items-baseline md:justify-between">
					<span class="text-slate-50">
						<a class="hover:underline" href={withBase(`/education/${c.slug}/`)}>{c.name}</a>
					</span>
					<span class="text-slate-400">{c.issuer}{c.year ? ` • ${c.year}` : ''}</span>
				</li>
			))}
		</ul>
	</section>
</SiteLayout>
