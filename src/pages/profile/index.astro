---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../components/SurfacePageHeader.astro';
import { RESUME_CLEARANCE, experience, education } from '../../data/resume';
import SpeakingEventsSection from '../../components/SpeakingEventsSection.astro';
import { withBase } from '../../utils/withBase';

const profileModalData = {
	experience: Object.fromEntries(
		experience.map((item) => [
			item.slug,
			{
				title: `${item.company} · ${item.title}`,
				meta: item.period,
				body: item.summary,
			},
		]),
	),
	education: Object.fromEntries(
		education.map((item) => [
			item.slug,
			{
				title: item.name,
				meta: `${item.issuer}${item.year ? ` · ${item.year}` : ''}`,
				body: item.issuer,
			},
		]),
	),
};
---

<SiteLayout
	title="Profile | Adam Boas"
	description="Career background, speaking engagements, and credentials for Adam Boas."
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'ProfilePage',
			name: 'Adam Boas Profile',
			url: 'https://www.adamboas.com/profile/',
			description: 'Career background, speaking engagements, and credentials for Adam Boas.',
			mainEntity: {
				'@type': 'Person',
				name: 'Adam Boas',
				jobTitle: 'Solutions Architect',
			},
		})}
	/>
	<SurfacePageHeader stickyActive="profile" eyebrow="Background" title="Profile">
		<div slot="actions" class="flex flex-col items-start gap-1 text-xs text-slate-400 md:items-end">
			<a href={withBase('/files/adam-boas-resume.pdf')} class="text-sm font-semibold text-stone-100 hover:text-stone-50"
				>Resume PDF ↗</a
			>
			<span class="uppercase tracking-wide">Clearance: {RESUME_CLEARANCE}</span>
		</div>
	</SurfacePageHeader>

	<div id="speaking">
		<SpeakingEventsSection title="Speaking" showHeader={true} />
	</div>

	<section class="card mt-4 p-4 md:mt-5">
		<div class="mb-3 flex items-center justify-between gap-2">
			<h2 class="section-title">Experience</h2>
		</div>
		<div class="hidden overflow-hidden md:block">
			<table class="w-full border-collapse text-sm">
				<thead class="bg-slate-950/60">
					<tr>
						<th class="px-4 py-3 text-left font-semibold text-slate-200">Company</th>
						<th class="px-4 py-3 text-left font-semibold text-slate-200">Role</th>
						<th class="px-4 py-3 text-right font-semibold text-slate-200">Period</th>
					</tr>
				</thead>
				<tbody>
					{
						experience.map((r) => (
							<tr class="border-t border-slate-800 even:bg-slate-950/20">
								<td class="px-4 py-3 text-slate-100">
									<button
										type="button"
										class="profile-modal-trigger hover:underline"
										data-profile-modal-open
										data-profile-modal-kind="experience"
										data-profile-modal-id={r.slug}
									>
										{r.company}
									</button>
								</td>
								<td class="px-4 py-3 text-slate-300">
									<button
										type="button"
										class="profile-modal-trigger text-left hover:underline"
										data-profile-modal-open
										data-profile-modal-kind="experience"
										data-profile-modal-id={r.slug}
									>
										{r.title}
									</button>
								</td>
								<td class="px-4 py-3 text-right text-slate-400">{r.period}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<div class="grid gap-3 md:hidden">
			{
				experience.map((r) => (
					<button
						type="button"
						class="min-w-0 border border-slate-800 bg-slate-950/40 p-3 text-left hover:border-slate-700"
						data-profile-modal-open
						data-profile-modal-kind="experience"
						data-profile-modal-id={r.slug}
					>
						<div class="flex min-w-0 items-baseline justify-between gap-3">
							<h3 class="min-w-0 truncate text-sm font-semibold text-slate-100">{r.company}</h3>
							<span class="shrink-0 text-xs text-slate-400">{r.period}</span>
						</div>
						<p class="mt-1 break-words text-sm text-slate-300 [overflow-wrap:anywhere]">{r.title}</p>
					</button>
				))
			}
		</div>
	</section>

	<section class="card mt-4 p-4 md:mt-5">
		<div class="mb-3 flex items-center justify-between gap-2">
			<h2 class="section-title">Education & Certifications</h2>
		</div>
		<div class="hidden overflow-hidden md:block">
			<table class="w-full border-collapse text-sm">
				<thead class="bg-slate-950/60">
					<tr>
						<th class="px-4 py-3 text-left font-semibold text-slate-200">Institution</th>
						<th class="px-4 py-3 text-left font-semibold text-slate-200">Credential</th>
						<th class="px-4 py-3 text-right font-semibold text-slate-200">Year</th>
					</tr>
				</thead>
				<tbody>
					{
						education.map((e) => (
							<tr class="border-t border-slate-800 even:bg-slate-950/20">
								<td class="px-4 py-3 text-slate-100">
									<button
										type="button"
										class="profile-modal-trigger hover:underline"
										data-profile-modal-open
										data-profile-modal-kind="education"
										data-profile-modal-id={e.slug}
									>
										{e.issuer}
									</button>
								</td>
								<td class="px-4 py-3 text-slate-300">
									<button
										type="button"
										class="profile-modal-trigger text-left hover:underline"
										data-profile-modal-open
										data-profile-modal-kind="education"
										data-profile-modal-id={e.slug}
									>
										{e.name}
									</button>
								</td>
								<td class="px-4 py-3 text-right text-slate-400">{e.year ?? '—'}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<div class="grid gap-3 md:hidden">
			{
				education.map((e) => (
					<button
						type="button"
						class="min-w-0 border border-slate-800 bg-slate-950/40 p-3 text-left hover:border-slate-700"
						data-profile-modal-open
						data-profile-modal-kind="education"
						data-profile-modal-id={e.slug}
					>
						<div class="flex min-w-0 items-baseline justify-between gap-3">
							<h3 class="min-w-0 truncate text-sm font-semibold text-slate-100">{e.issuer}</h3>
							<span class="shrink-0 text-xs text-slate-400">{e.year ?? '—'}</span>
						</div>
						<p class="mt-1 break-words text-sm text-slate-300 [overflow-wrap:anywhere]">{e.name}</p>
					</button>
				))
			}
		</div>
	</section>

	<div id="profile-modal" class="profile-modal" hidden>
		<button type="button" class="profile-modal-overlay" data-profile-modal-close aria-label="Close detail modal"
		></button>
		<article class="profile-modal-panel" role="dialog" aria-modal="true" aria-labelledby="profile-modal-title">
			<div class="profile-modal-head">
				<p id="profile-modal-meta" class="profile-modal-meta"></p>
				<h3 id="profile-modal-title" class="profile-modal-title"></h3>
				<button type="button" class="profile-modal-close" data-profile-modal-close aria-label="Close">✕</button>
			</div>
			<p id="profile-modal-body" class="profile-modal-body"></p>
		</article>
	</div>

	<script type="application/json" id="profile-modal-data" set:html={JSON.stringify(profileModalData)} />
	<script>
		import { createModalController } from '../../scripts/ui/modal-controller';

		(() => {
			const root = document.getElementById('profile-modal');
			if (!root) return;
			const panel = root.querySelector('.profile-modal-panel');
			const dataEl = document.getElementById('profile-modal-data');
			if (!dataEl || !panel) return;
			const dataset = JSON.parse(dataEl.textContent || '{}');
			const titleEl = document.getElementById('profile-modal-title');
			const metaEl = document.getElementById('profile-modal-meta');
			const bodyEl = document.getElementById('profile-modal-body');
			const closeNodes = root.querySelectorAll('[data-profile-modal-close]');
			const openNodes = document.querySelectorAll('[data-profile-modal-open]');

			const modal = createModalController({
				root,
				panel,
				closeNodes,
				swipeToClose: true,
			});

			const openModal = (kind, id, source) => {
				const group = dataset?.[kind];
				const entry = group?.[id];
				if (!entry || !titleEl || !metaEl || !bodyEl) return;
				titleEl.textContent = entry.title || '';
				metaEl.textContent = entry.meta || '';
				bodyEl.textContent = entry.body || '';
				modal.open(source, root.querySelector('.profile-modal-close'));
			};

			openNodes.forEach((node) => {
				node.addEventListener('click', () => {
					const trigger = node;
					const kind = trigger.dataset.profileModalKind || '';
					const id = trigger.dataset.profileModalId || '';
					openModal(kind, id, trigger);
				});
			});
		})();
	</script>
</SiteLayout>

<style>
	.profile-modal-trigger {
		background: transparent;
		border: 0;
		padding: 0;
		color: inherit;
		cursor: pointer;
		font: inherit;
	}
	.profile-modal {
		position: fixed;
		inset: 0;
		z-index: 70;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	.profile-modal-overlay {
		position: absolute;
		inset: 0;
		border: 0;
		background: rgba(2, 6, 23, 0.78);
		opacity: 0;
		transition: opacity 140ms ease;
	}
	.profile-modal-panel {
		position: relative;
		width: min(42rem, 100%);
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgb(2, 6, 23);
		padding: 1rem;
		box-shadow: 0 24px 80px rgba(2, 6, 23, 0.55);
		opacity: 0;
		transform: translateY(6px) scale(0.992);
		transition:
			opacity 140ms ease,
			transform 170ms ease;
	}
	.profile-modal.is-open .profile-modal-overlay {
		opacity: 1;
	}
	.profile-modal.is-open .profile-modal-panel {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	.profile-modal-head {
		position: relative;
		padding-right: 2.45rem;
	}
	.profile-modal-meta {
		font-size: 0.68rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: rgba(148, 163, 184, 0.96);
	}
	.profile-modal-title {
		margin-top: 0.45rem;
		font-size: 1.05rem;
		line-height: 1.35;
		font-weight: 600;
		color: rgba(248, 250, 252, 0.99);
	}
	.profile-modal-close {
		position: absolute;
		top: 0;
		right: 0;
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgb(2, 6, 23);
		color: rgba(226, 232, 240, 0.98);
		width: 2rem;
		height: 2rem;
		cursor: pointer;
	}
	.profile-modal-body {
		margin-top: 0.75rem;
		font-size: 0.92rem;
		line-height: 1.62;
		color: rgba(203, 213, 225, 0.97);
	}
</style>
