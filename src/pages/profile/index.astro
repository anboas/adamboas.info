---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { RESUME_CLEARANCE, experience, education } from '../../data/resume';
import { withBase } from '../../utils/withBase';
---

<SiteLayout title="Profile | Adam Boas" description="Experience and education in one place.">
	<StickyBrowseBar active="profile" />
	<section class="card control-shell p-5">
		<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
			<h1 class="section-title">Profile</h1>
			<div class="flex flex-col items-start gap-1">
				<a href={withBase('/files/adam-boas-resume.pdf')} class="text-sm font-semibold text-stone-100 hover:text-stone-50">Latest resume PDF →</a>
				<span class="text-[11px] uppercase tracking-wide text-slate-400">Clearance: {RESUME_CLEARANCE}</span>
			</div>
		</div>
		<p class="mt-2 text-sm text-slate-300">Speaking, experience, and education are consolidated here for faster profile scanning.</p>
	</section>

	<section id="speaking" class="card mt-4 p-4 md:mt-5">
		<div class="mb-3 flex items-center justify-between gap-2">
			<h2 class="section-title">Speaking</h2>
			<a class="text-xs text-slate-300 hover:text-slate-100" href={withBase('/speaking/')}>Legacy speaking page →</a>
		</div>
		<div class="grid gap-4 md:grid-cols-2">
			<div class="border border-slate-800 bg-slate-950/40 p-3">
				<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Upcoming</h3>
				<p class="mt-2 text-sm text-slate-400">No upcoming public speaking events listed yet.</p>
			</div>
			<div class="border border-slate-800 bg-slate-950/40 p-3">
				<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Past engagements</h3>
				<p class="mt-2 text-sm text-slate-400">Archive section ready for talk history, links, and recordings.</p>
			</div>
		</div>
		<div class="mt-3 border border-slate-800 bg-slate-950/40 p-3">
			<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Speaking topics</h3>
			<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-300">
				<li>Agent systems and delegated authority</li>
				<li>AI governance and policy-as-code</li>
				<li>Defense/autonomy capability delivery</li>
			</ul>
		</div>
	</section>

	<section class="card mt-4 p-4 md:mt-5">
		<div class="mb-3 flex items-center justify-between gap-2">
			<h2 class="section-title">Experience</h2>
			<a class="text-xs text-slate-300 hover:text-slate-100" href={withBase('/experience/')}>Full experience page →</a>
		</div>
		<div class="hidden overflow-hidden md:block">
			<table class="w-full border-collapse text-sm">
				<thead class="bg-slate-950/60">
					<tr>
						<th class="px-4 py-3 text-left font-semibold text-slate-200">Company</th>
						<th class="px-4 py-3 text-left font-semibold text-slate-200">Role</th>
						<th class="px-4 py-3 text-right font-semibold text-slate-200">Period</th>
					</tr>
				</thead>
				<tbody>
					{experience.map((r) => (
						<tr class="border-t border-slate-800 even:bg-slate-950/20">
							<td class="px-4 py-3 text-slate-100"><a class="hover:underline" href={withBase(`/experience/${r.slug}/`)}>{r.company}</a></td>
							<td class="px-4 py-3 text-slate-300">{r.title}</td>
							<td class="px-4 py-3 text-right text-slate-400">{r.period}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<div class="grid gap-3 md:hidden">
			{experience.map((r) => (
				<a class="border border-slate-800 bg-slate-950/40 p-3 hover:border-slate-700" href={withBase(`/experience/${r.slug}/`)}>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="truncate text-sm font-semibold text-slate-100">{r.company}</h3>
						<span class="shrink-0 text-xs text-slate-400">{r.period}</span>
					</div>
					<p class="mt-1 text-sm text-slate-300">{r.title}</p>
				</a>
			))}
		</div>
	</section>

	<section class="card mt-4 p-4 md:mt-5">
		<div class="mb-3 flex items-center justify-between gap-2">
			<h2 class="section-title">Education & Certifications</h2>
			<a class="text-xs text-slate-300 hover:text-slate-100" href={withBase('/education/')}>Full education page →</a>
		</div>
		<div class="hidden overflow-hidden md:block">
			<table class="w-full border-collapse text-sm">
				<thead class="bg-slate-950/60">
					<tr>
						<th class="px-4 py-3 text-left font-semibold text-slate-200">Institution</th>
						<th class="px-4 py-3 text-left font-semibold text-slate-200">Credential</th>
						<th class="px-4 py-3 text-right font-semibold text-slate-200">Year</th>
					</tr>
				</thead>
				<tbody>
					{education.map((e) => (
						<tr class="border-t border-slate-800 even:bg-slate-950/20">
							<td class="px-4 py-3 text-slate-100"><a class="hover:underline" href={withBase(`/education/${e.slug}/`)}>{e.issuer}</a></td>
							<td class="px-4 py-3 text-slate-300">{e.name}</td>
							<td class="px-4 py-3 text-right text-slate-400">{e.year ?? '—'}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<div class="grid gap-3 md:hidden">
			{education.map((e) => (
				<a class="border border-slate-800 bg-slate-950/40 p-3 hover:border-slate-700" href={withBase(`/education/${e.slug}/`)}>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="truncate text-sm font-semibold text-slate-100">{e.issuer}</h3>
						<span class="shrink-0 text-xs text-slate-400">{e.year ?? '—'}</span>
					</div>
					<p class="mt-1 text-sm text-slate-300">{e.name}</p>
				</a>
			))}
		</div>
	</section>
</SiteLayout>
