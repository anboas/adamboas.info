---
import SiteLayout from '../layouts/SiteLayout.astro';
// sticky browse intentionally omitted on /changes (Changes link is footer-only)
import changeNotesJs from '../scripts/change-notes.js?raw';

type ChangeGroup = {
	kind: 'Added' | 'Changed' | 'Improved' | 'Fixed';
	items: string[];
};

type Release = {
	version: string;
	date: string;
	title: string;
	summary: string;
	impact: string;
	tags: string[];
	groups: ChangeGroup[];
	current?: boolean;
};

const releases: Release[] = [
	{
		version: 'v1.5.0',
		date: '2026-02-16',
		title: 'Change Notes 2.0 + global keyboard shortcuts',
		summary: 'Upgraded release notes into a filterable capability log and added site-wide keyboard navigation.',
		impact: 'Faster wayfinding and faster release comprehension with less click friction.',
		current: true,
		tags: ['changes', 'navigation', 'ux', 'productivity'],
		groups: [
			{
				kind: 'Added',
				items: [
					'Global shortcut system: / (focus search), ? (shortcut panel), and g then h/w/e/c (jump navigation).',
					'Keyboard shortcuts overlay with click-to-navigate quick actions.',
					'Change Notes filter model with tag toggles, query search, and URL-persisted state.',
				],
			},
			{
				kind: 'Changed',
				items: [
					'Restructured release entries around capability outcomes instead of implementation churn.',
					'Promoted Changes into desktop and mobile navigation surfaces for first-class discoverability.',
				],
			},
			{
				kind: 'Improved',
				items: [
					'Sticky filter shell keeps controls in reach while scanning long release history.',
					'Added active-filter chips and release counts for clearer scan state.',
				],
			},
			{
				kind: 'Fixed',
				items: ['Shortcut handling now avoids input/textarea/contenteditable contexts to prevent typing conflicts.'],
			},
		],
	},
	{
		version: 'v1.4.0',
		date: '2026-02-16',
		title: 'Events-first navigation + public change tracking',
		summary: 'Shifted the site from Radar framing to Events framing and launched public release notes.',
		impact: 'Cleaner information architecture and clearer trust surface for shipped capability changes.',
		tags: ['events', 'navigation', 'docs'],
		groups: [
			{
				kind: 'Added',
				items: [
					'Public, versioned Change Notes page at /changes/.',
					'Direct footer access to Changes for persistent release visibility.',
				],
			},
			{
				kind: 'Changed',
				items: [
					'Replaced /radar with /events as the primary event-intelligence route.',
					'Relabeled global navigation surfaces from Radar to Events.',
				],
			},
			{
				kind: 'Improved',
				items: [
					'Kept event-centric controls compact: search, branch/type/status filters, upcoming/verified/past toggles.',
					'Map-card linkage and event-link exposure stay optimized for scan-speed operations.',
				],
			},
			{ kind: 'Fixed', items: [] },
		],
	},
	{
		version: 'v1.3.0',
		date: '2026-02-16',
		title: 'Long-form reading ergonomics',
		summary: 'Improved long-page readability and reduced friction in writing detail navigation.',
		impact: 'Higher reading throughput with less orientation loss in dense technical content.',
		tags: ['writing', 'ux', 'navigation'],
		groups: [
			{
				kind: 'Added',
				items: [
					'Right-rail TOC for long pages on very large screens with active-section tracking.',
					'Sticky writing detail actions (PDF, copy link, discuss) for persistent utility access.',
				],
			},
			{
				kind: 'Changed',
				items: ['Restored full reading-pane width while keeping TOC external to text column.'],
			},
			{
				kind: 'Improved',
				items: [
					'Intent-only TOC scrollbar, smoother TOC auto-scroll, and wide-screen clipping hardening.',
					'Image lightbox behavior and table wrappers with sticky headers for technical artifacts.',
				],
			},
			{ kind: 'Fixed', items: [] },
		],
	},
	{
		version: 'v1.2.0',
		date: '2026-02-13',
		title: 'Events simplification + scan speed',
		summary: 'Simplified event decisions around urgency, clarity, and fewer multi-step controls.',
		impact: 'Faster shortlist decisions and reduced operator overhead per review cycle.',
		tags: ['events', 'filters', 'ux', 'data'],
		groups: [
			{
				kind: 'Added',
				items: [
					'Hide-past default with explicit reveal control.',
					'Source-priority ingestion and dedupe pass for larger event inventory coverage.',
				],
			},
			{
				kind: 'Changed',
				items: ['Moved to date-driven urgency (days-until) as primary prioritization signal.'],
			},
			{
				kind: 'Improved',
				items: [
					'Flattened filters and moved sorting into list header for lower interaction cost.',
					'Standardized event terminology and map/card metadata behaviors.',
				],
			},
			{ kind: 'Fixed', items: [] },
		],
	},
	{
		version: 'v1.1.0',
		date: '2026-02-12',
		title: 'Writing controls baseline + legal surface',
		summary: 'Established reusable writing controls and persistent site utility surfaces.',
		impact: 'More consistent discovery and better legal/transparency posture across the site.',
		tags: ['writing', 'filters', 'navigation', 'legal'],
		groups: [
			{
				kind: 'Added',
				items: [
					'Compact writing controls shell with searchable tags and fast clear/reset.',
					'Clickable writing type pills (paper/note/memo) for include/exclude filtering.',
					'Dedicated legal and license pages linked from persistent footer surface.',
				],
			},
			{
				kind: 'Changed',
				items: ['Unified sticky browse behavior across mobile sections.'],
			},
			{ kind: 'Improved', items: [] },
			{ kind: 'Fixed', items: [] },
		],
	},
];

const current = releases.find((r) => r.current) ?? releases[0];
const allTags = [...new Set(releases.flatMap((r) => r.tags))].sort();

function releaseSearchText(release: Release) {
	return [
		release.version,
		release.title,
		release.summary,
		release.impact,
		release.tags.join(' '),
		...release.groups.flatMap((group) => [group.kind, ...group.items]),
	]
		.join(' ')
		.toLowerCase();
}
---

<SiteLayout
	title="Change Notes | Adam Boas"
	description="Public, versioned website capability updates for adamboas.com."
	canonicalHref="https://www.adamboas.com/changes/"
>
	<!-- StickyBrowseBar omitted on this page by preference: Changes link should live in footer only. -->

	<section data-change-notes class="space-y-4">
		<header class="card p-5">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div>
					<h1 class="text-2xl font-semibold text-slate-50 sm:text-3xl">Change Notes</h1>
					<p class="mt-2 text-sm text-slate-300">
						Public release tracker focused on shipped website capabilities and user-facing outcomes.
					</p>
				</div>
				<div class="flex flex-wrap gap-2 text-xs">
					<span class="rounded-none border border-emerald-700/70 bg-emerald-900/20 px-2 py-1 text-emerald-200">Current: {current.version}</span>
					<span class="rounded-none border border-slate-700 px-2 py-1 text-slate-300">Released {current.date}</span>
				</div>
			</div>
			<div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-300">
				<span class="kbd">/</span><span>search</span>
				<span class="kbd">g</span><span>then</span><span class="kbd">c</span><span>changes</span>
				<span class="kbd">?</span><span>shortcuts</span>
			</div>
		</header>

		<section class="card changes-filter-bar p-3">
			<div class="flex flex-wrap items-center gap-2">
				<input
					id="changes-search"
					data-change-search
					data-global-search
					type="search"
					placeholder="Search releases, capabilities, outcomes..."
					class="min-w-[16rem] flex-1 rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-200"
				/>
				<button type="button" data-change-clear class="rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-200 hover:bg-slate-900">Clear</button>
			</div>
			<div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Filter change notes by capability tags">
				{allTags.map((tag) => (
					<button type="button" data-change-tag={tag} aria-pressed="false" class="change-tag-pill rounded-full border px-2.5 py-1 text-xs lowercase tracking-wide text-slate-200">
						{tag}
					</button>
				))}
			</div>
			<div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400">
				<div data-change-active class="flex flex-wrap gap-2"></div>
				<p data-change-count></p>
			</div>
		</section>

		<div class="space-y-4">
			{releases.map((release) => (
				<article
					class="card p-5"
					data-release-card
					data-tags={release.tags.join(',')}
					data-search={releaseSearchText(release)}
					id={release.version.toLowerCase()}
				>
					<div class="flex flex-wrap items-center gap-2 text-xs">
						<span class={`rounded-none border px-2 py-1 ${release.current ? 'border-emerald-700/70 bg-emerald-900/20 text-emerald-200' : 'border-slate-700 text-slate-300'}`}>
							{release.version}
						</span>
						<span class="text-slate-400">{release.date}</span>
						{release.tags.map((tag) => <span class="release-tag rounded-full border border-slate-700 px-2 py-0.5 text-[10px] lowercase text-slate-300">{tag}</span>)}
					</div>
					<h2 class="mt-2 text-xl font-semibold text-slate-50">{release.title}</h2>
					<p class="mt-1 text-sm text-slate-300">{release.summary}</p>
					<p class="mt-3 border-l-2 border-teal-700/70 pl-3 text-sm text-slate-200"><strong>Why it matters:</strong> {release.impact}</p>

					<div class="mt-4 grid gap-4 md:grid-cols-2">
						{release.groups
							.filter((group) => group.items.length)
							.map((group) => (
								<section class="change-group" data-kind={group.kind.toLowerCase()}>
									<h3 class="change-group-heading">{group.kind}</h3>
									<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-200">
										{group.items.map((item) => <li>{item}</li>)}
									</ul>
								</section>
							))}
					</div>
				</article>
			))}
		</div>

		<p class="card hidden p-4 text-sm text-slate-300" data-change-empty>
			No releases match your current filters.
		</p>
	</section>

	<script type="module" set:html={changeNotesJs}></script>
</SiteLayout>
