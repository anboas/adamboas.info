const current = releases.find((r) => r.current) ?? releases[0];
const allTags = [...new Set(releases.flatMap((r) => r.tags))].sort();

function releaseSearchText(release: Release) {
	return [
		release.version,
		release.title,
		release.summary,
		release.impact,
		release.tags.join(' '),
		...release.groups.flatMap((group) => [group.kind, ...group.items]),
	]
		.join(' ')
		.toLowerCase();
}
---

<SiteLayout
	title="Change Notes | Adam Boas"
	description="Public, versioned website capability updates for adamboas.com."
	canonicalHref="https://www.adamboas.com/changes/"
>
	<!-- StickyBrowseBar omitted on this page by preference: Changes link should live in footer only. -->

	<section data-change-notes class="space-y-4">
		<header class="card p-5">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div>
					<h1 class="text-2xl font-semibold text-slate-50 sm:text-3xl">Change Notes</h1>
					<p class="mt-2 text-sm text-slate-300">
						Public release tracker focused on shipped website capabilities and user-facing outcomes.
					</p>
				</div>
				<div class="flex flex-wrap gap-2 text-xs">
					<span class="rounded-none border border-emerald-700/70 bg-emerald-900/20 px-2 py-1 text-emerald-200">Current: {current.version}</span>
					<span class="rounded-none border border-slate-700 px-2 py-1 text-slate-300">Released {current.date}</span>
				</div>
			</div>
			<div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-300">
				<span class="kbd">/</span><span>search</span>
				<span class="kbd">g</span><span>then</span><span class="kbd">c</span><span>changes</span>
				<span class="kbd">?</span><span>shortcuts</span>
			</div>
		</header>

		<section class="card changes-filter-bar p-3">
			<div class="flex flex-wrap items-center gap-2">
				<input
					id="changes-search"
					data-change-search
					data-global-search
					type="search"
					placeholder="Search releases, capabilities, outcomes..."
					class="min-w-[16rem] flex-1 rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-200"
				/>
				<button type="button" data-change-clear class="rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-200 hover:bg-slate-900">Clear</button>
			</div>
			<div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Filter change notes by capability tags">
				{allTags.map((tag) => (
					<button type="button" data-change-tag={tag} aria-pressed="false" class="change-tag-pill rounded-full border px-2.5 py-1 text-xs lowercase tracking-wide text-slate-200">
						{tag}
					</button>
				))}
			</div>
			<div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400">
				<div data-change-active class="flex flex-wrap gap-2"></div>
				<p data-change-count></p>
			</div>
		</section>

		<div class="space-y-4">
			{releases.map((release) => (
				<article
					class="card p-5"
					data-release-card
					data-tags={release.tags.join(',')}
					data-search={releaseSearchText(release)}
					id={release.version.toLowerCase()}
				>
					<div class="flex flex-wrap items-center gap-2 text-xs">
						<span class={`rounded-none border px-2 py-1 ${release.current ? 'border-emerald-700/70 bg-emerald-900/20 text-emerald-200' : 'border-slate-700 text-slate-300'}`}>
							{release.version}
						</span>
						<span class="text-slate-400">{release.date}</span>
						{release.tags.map((tag) => <span class="release-tag rounded-full border border-slate-700 px-2 py-0.5 text-[10px] lowercase text-slate-300">{tag}</span>)}
					</div>
					<h2 class="mt-2 text-xl font-semibold text-slate-50">{release.title}</h2>
					<p class="mt-1 text-sm text-slate-300">{release.summary}</p>
					<p class="mt-3 border-l-2 border-teal-700/70 pl-3 text-sm text-slate-200"><strong>Why it matters:</strong> {release.impact}</p>

					<div class="mt-4 grid gap-4 md:grid-cols-2">
						{release.groups
							.filter((group) => group.items.length)
							.map((group) => (
								<section class="change-group" data-kind={group.kind.toLowerCase()}>
									<h3 class="change-group-heading">{group.kind}</h3>
									<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-200">
										{group.items.map((item) => <li>{item}</li>)}
									</ul>
								</section>
							))}
					</div>
				</article>
			))}
		</div>

		<p class="card hidden p-4 text-sm text-slate-300" data-change-empty>
			No releases match your current filters.
		</p>
	</section>

	<script type="module" set:html={changeNotesJs}></script>
</SiteLayout>
