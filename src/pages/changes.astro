---
import SiteLayout from '../layouts/SiteLayout.astro';
// sticky browse intentionally omitted on /changes (Changes link is footer-only)
import changeNotesJs from '../scripts/change-notes.js?raw';

type ChangeGroup = {
	kind: 'Added' | 'Changed' | 'Improved' | 'Fixed';
	items: string[];
};

