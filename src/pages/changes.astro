			},
			{
				kind: 'Improved',
				items: [
					'Intent-only TOC scrollbar, smoother TOC auto-scroll, and wide-screen clipping hardening.',
					'Image lightbox behavior and table wrappers with sticky headers for technical artifacts.',
				],
			},
			{ kind: 'Fixed', items: [] },
		],
	},
	{
		version: 'v1.2.0',
		date: '2026-02-13',
		title: 'Events simplification + scan speed',
		summary: 'Simplified event decisions around urgency, clarity, and fewer multi-step controls.',
		impact: 'Faster shortlist decisions and reduced operator overhead per review cycle.',
		tags: ['events', 'filters', 'ux', 'data'],
		groups: [
			{
				kind: 'Added',
				items: [
					'Hide-past default with explicit reveal control.',
					'Source-priority ingestion and dedupe pass for larger event inventory coverage.',
				],
			},
			{
