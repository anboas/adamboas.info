const current = releases.find((r) => r.current) ?? releases[0];

const topicGroups: TopicGroup[] = [
	{ key: 'writing', label: 'Writing' },
	{ key: 'events', label: 'Events' },
	{ key: 'ux', label: 'UX' },
	{ key: 'platform', label: 'Platform' },
	{ key: 'other', label: 'Other' },
];

function topicGroupForTag(rawTag: string): TopicGroup['key'] {
	const tag = rawTag.toLowerCase();
	if (/(writing|paper|memo|note|pdf|latex|toc)/.test(tag)) return 'writing';
	if (/(event|radar|conference|sam|source|legitimacy|acquisition)/.test(tag)) return 'events';
	if (/(ux|mobile|desktop|readability|spacing|overflow|visual|pagination|footer|toc)/.test(tag)) return 'ux';
	if (/(build|ci|deploy|workflow|linkcheck|a11y|test|release|metadata|automation|pipeline|infra)/.test(tag)) return 'platform';
	return 'other';
}

const releaseTopics = releases.map((release) => {
	const groups = [...new Set(release.tags.map((tag) => topicGroupForTag(tag)))];
	return {
		release,
		groups,
	};
});

const allTags = [...new Set(releases.flatMap((r) => r.tags))].sort();
const topicCounts = topicGroups.map((group) => ({
	...group,
	count: releaseTopics.filter((item) => item.groups.includes(group.key)).length,
}));

function releaseSearchText(release: Release) {
	return [
		release.version,
		release.title,
		release.summary,
		release.impact,
		release.tags.join(' '),
		...release.groups.flatMap((group) => [group.kind, ...group.items]),
	]
		.join(' ')
		.toLowerCase();
}
---

<SiteLayout
	title="Change Notes | Adam Boas"
	description="Public, versioned website capability updates for adamboas.com."
	canonicalHref="https://www.adamboas.com/changes/"
>
	<!-- StickyBrowseBar omitted on this page by preference: Changes link should live in footer only. -->

	<section data-change-notes class="space-y-4">
		<header class="card p-5">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div>
					<h1 class="text-2xl font-semibold text-slate-50 sm:text-3xl">Change Notes</h1>
					<p class="mt-2 text-sm text-slate-300">
						Public release tracker focused on shipped website capabilities and user-facing outcomes.
					</p>
				</div>
				<div class="flex flex-wrap gap-2 text-xs">
					<span class="rounded-none border border-emerald-700/70 bg-emerald-900/20 px-2 py-1 text-emerald-200">Current: {current.version}</span>
					<span class="rounded-none border border-slate-700 px-2 py-1 text-slate-300">Released {current.date}</span>
				</div>
			</div>
			<div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-300">
				<span class="kbd">/</span><span>search</span>
				<span class="kbd">g</span><span>then</span><span class="kbd">c</span><span>changes</span>
				<span class="kbd">?</span><span>shortcuts</span>
			</div>
		</header>

		<section class="card control-shell changes-filter-bar p-3" data-change-filter-bar>
			<div class="control-shell-row flex flex-wrap items-center gap-2">
				<input
					id="changes-search"
					data-change-search
					data-global-search
					type="search"
					placeholder="Search releases, capabilities, outcomes (fuzzy supported)..."
					class="min-w-0 flex-1 rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-200 sm:min-w-[16rem]"
				/>
				<button type="button" data-change-clear class="rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-xs text-slate-200 hover:bg-slate-900 sm:text-sm">Clear</button>
			</div>
			<div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Filter change notes by topic groups">
				{topicCounts
					.filter((group) => group.count > 0)
					.map((group) => (
						<button
							type="button"
							data-change-group={group.key}
							aria-pressed="false"
							class="change-group-pill rounded-none border px-2.5 py-1 text-xs tracking-wide text-slate-200"
						>
							{group.label} <span class="text-slate-400">({group.count})</span>
						</button>
					))}
			</div>
			<details class="mt-2">
				<summary class="cursor-pointer text-xs text-slate-300">Fine-grained tags ({allTags.length})</summary>
				<div class="changes-tag-grid mt-2 flex flex-wrap gap-2" role="group" aria-label="Filter change notes by capability tags">
					{allTags.map((tag) => (
						<button type="button" data-change-tag={tag} aria-pressed="false" class="change-tag-pill rounded-full border px-2.5 py-1 text-xs lowercase tracking-wide text-slate-200">
							{tag}
						</button>
					))}
				</div>
			</details>
			<div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-300">
				<div data-change-active class="flex flex-wrap gap-2"></div>
				<p data-change-count></p>
			</div>
		</section>

		<section class="card control-shell changes-mini-filter-bar hidden" data-change-mini-bar aria-hidden="true">
			<div class="changes-mini-inner">
				<input
					data-change-search
					type="search"
					placeholder="Search changes..."
					aria-label="Search change notes"
					class="min-w-0 flex-1 rounded-none border border-slate-800 bg-slate-950 px-2 py-1 text-xs text-slate-200"
				/>
				<div class="flex flex-wrap items-center gap-1" role="group" aria-label="Quick topic filters">
					{topicCounts
						.filter((group) => group.count > 0)
						.map((group) => (
							<button
								type="button"
								data-change-group={group.key}
								aria-pressed="false"
								class="change-group-pill rounded-none border px-2 py-0.5 text-[11px] tracking-wide text-slate-200"
							>
								{group.label}
							</button>
						))}
				</div>
				<button
					type="button"
					data-change-clear
					class="rounded-none border border-slate-700 bg-slate-950 px-2 py-1 text-[11px] text-slate-200 hover:bg-slate-900"
				>
					Reset
				</button>
			</div>
		</section>

		<div class="changes-list-shell space-y-4" data-change-list-shell>
			<div class="changes-list-skeleton" data-change-skeleton aria-hidden="true">
				<div class="changes-skeleton-card"></div>
				<div class="changes-skeleton-card"></div>
			</div>
			<div class="space-y-4" data-change-list>
			{releaseTopics.map(({ release, groups }) => (
				<article
					class="card p-5"
					data-release-card
					data-version={release.version}
					data-tags={release.tags.join(',')}
					data-groups={groups.join(',')}
					data-search={releaseSearchText(release)}
					id={release.version.toLowerCase()}
				>
					<div class="flex flex-wrap items-center gap-2 text-xs">
						<span class={`rounded-none border px-2 py-1 ${release.current ? 'border-emerald-700/70 bg-emerald-900/20 text-emerald-200' : 'border-slate-700 text-slate-300'}`}>
							{release.version}
						</span>
						<span class="text-slate-300">{release.date}</span>
						<span class="change-new-pill hidden" data-release-new>New</span>
						{release.tags.map((tag) => <span class="release-tag rounded-full border border-slate-700 px-2 py-0.5 text-[10px] lowercase text-slate-300">{tag}</span>)}
					</div>
					<h2 class="mt-2 text-xl font-semibold text-slate-50">{release.title}</h2>
					<p class="mt-1 text-sm text-slate-300">{release.summary}</p>
					<p class="mt-3 border-l-2 border-teal-700/70 pl-3 text-sm text-slate-200"><strong>Why it matters:</strong> {release.impact}</p>

					<div class="mt-4 grid gap-4 md:grid-cols-2">
						{release.groups
							.filter((group) => group.items.length)
							.map((group) => (
								<section class="change-group" data-kind={group.kind.toLowerCase()}>
									<h3 class="change-group-heading">{group.kind}</h3>
									<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-200">
										{group.items.map((item) => <li>{item}</li>)}
									</ul>
								</section>
							))}
					</div>
				</article>
			))}
		</div>

		<div class="mt-4 hidden flex flex-wrap items-center justify-between gap-2 md:flex-nowrap" data-change-pagination>
			<p class="text-xs text-slate-300" data-change-pagination-status></p>
			<div class="flex items-center gap-2">
				<button type="button" data-change-page-first class="rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-xs text-slate-200 hover:bg-slate-900 disabled:opacity-50 disabled:hover:bg-slate-950">First</button>
				<button type="button" data-change-page-prev class="rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-xs text-slate-200 hover:bg-slate-900 disabled:opacity-50 disabled:hover:bg-slate-950">Prev</button>
				<span class="text-xs text-slate-300" data-change-page-label>Page 1 of 1</span>
				<button type="button" data-change-page-next class="rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-xs text-slate-200 hover:bg-slate-900 disabled:opacity-50 disabled:hover:bg-slate-950">Next</button>
				<button type="button" data-change-page-last class="rounded-none border border-slate-800 bg-slate-950 px-2.5 py-1.5 text-xs text-slate-200 hover:bg-slate-900 disabled:opacity-50 disabled:hover:bg-slate-950">Last</button>
			</div>
		</div>

		<p class="card hidden p-4 text-sm text-slate-200" data-change-empty>
			No releases match these filters. Try clearing search/tags/groups.
			<button type="button" data-change-clear class="ml-2 rounded-none border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 hover:bg-slate-900">Clear filters</button>
		</p>
		</div>
	</section>

	<script type="module" set:html={changeNotesJs}></script>
</SiteLayout>
