---
import SiteLayout from '../layouts/SiteLayout.astro';
import StickyBrowseBar from '../components/StickyBrowseBar.astro';

type Release = {
	version: string;
	date: string;
	title: string;
	summary: string;
	groups: { heading: string; items: string[] }[];
	current?: boolean;
};

const releases: Release[] = [
	{
		version: 'v1.4.0',
		date: '2026-02-16',
		title: 'Events-first navigation + public change tracking',
		summary: 'Shifted the site from Radar framing to Events framing and added a public release log.',
		current: true,
		groups: [
			{
				heading: 'Events capability surface',
				items: [
					'Replaced /radar with /events as the primary DoW Event Tracker route (no legacy route retained).',
					'Updated site navigation labels from Radar to Events across top nav and sticky browse surfaces.',
					'Kept event-centric controls: search, branch/type/status filtering, upcoming/verified/past toggles, and date-first sorting.',
				],
			},
			{
				heading: 'Map + card workflow',
				items: [
					'Event cards and map markers remain linked for quick focus and context switching.',
					'Color-coded event types carry through cards and map popups for scan-fast classification.',
					'Direct event links are available from cards and map popups when official URLs exist.',
				],
			},
			{
				heading: 'Site transparency',
				items: [
					'Added this public, versioned Change Notes page at /changes/.',
					'Added a persistent Changes link in the global footer.',
				],
			},
		],
	},
	{
		version: 'v1.3.0',
		date: '2026-02-16',
		title: 'Long-form reading ergonomics',
		summary: 'Improved on-page navigation and reading flow for long technical pages.',
		groups: [
			{
				heading: 'TOC sidebar',
				items: [
					'Added a right-rail table of contents for long pages on very large screens.',
					'Active section highlighting follows reading position and auto-scrolls inside the TOC pane.',
					'TOC scrollbar appears on hover/focus intent, with edge-clipping fixes for ultra-wide layouts.',
				],
			},
			{
				heading: 'Reading surface',
				items: [
					'Restored full reading-pane width while keeping the TOC outside the main text column.',
					'Added sticky action controls at top of writing detail pages (PDF, copy link, discuss).',
				],
			},
			{
				heading: 'Content usability',
				items: [
					'Added image lightbox support and “Open full image” links for figures.',
					'Improved table behavior with wrappers and sticky headers for large tables.',
				],
			},
		],
	},
	{
		version: 'v1.2.0',
		date: '2026-02-13',
		title: 'Event tracker simplification + scan speed',
		summary: 'Simplified event operations around urgency, clarity, and fewer clicks.',
		groups: [
			{
				heading: 'Prioritization model',
				items: [
					'Moved to date-driven urgency (“days until”) as the primary prioritization signal.',
					'Hide-past default introduced with explicit “show past” control.',
				],
			},
			{
				heading: 'Control simplification',
				items: [
					'Removed pin/preset workflows to keep the interface focused on active decision flow.',
					'Flattened filter controls and placed sorting directly with the event list for faster scanning.',
				],
			},
			{
				heading: 'Data scale + hygiene',
				items: [
					'Expanded event inventory with source-priority ingestion and duplicate cleanup.',
					'Standardized event terminology and card/map metadata patterns.',
				],
			},
		],
	},
	{
		version: 'v1.1.0',
		date: '2026-02-12',
		title: 'Writing index controls + site chrome baseline',
		summary: 'Established reusable control patterns for discovery and navigation.',
		groups: [
			{
				heading: 'Writing discovery controls',
				items: [
					'Added compact control shell for writing index filtering and search.',
					'Introduced clickable type pills (Paper/Note/Memo) for fast include/exclude filtering.',
					'Integrated tag search workflows with clear/reset affordances.',
				],
			},
			{
				heading: 'Sticky navigation surfaces',
				items: [
					'Implemented sticky browse bars to keep key navigation/actions in reach on smaller screens.',
					'Maintained consistent global header/footer navigation across sections.',
				],
			},
			{
				heading: 'Footer + legal surface',
				items: [
					'Added dedicated legal/license pages and linked them in the global footer.',
					'Footer now acts as a persistent utility area for feed, writing, profile, license, and updates.',
				],
			},
		],
	},
];

const current = releases.find((r) => r.current) ?? releases[0];
---

<SiteLayout
	title="Change Notes | Adam Boas"
	description="Public release notes and grouped change history for adamboas.com."
	canonicalHref="https://www.adamboas.com/changes/"
>
	<StickyBrowseBar active="writing" />
	<section class="space-y-5">
		<header class="card p-5">
			<h1 class="text-2xl font-semibold text-slate-50 sm:text-3xl">Change Notes</h1>
			<p class="mt-2 text-sm text-slate-300">
				Public release tracker for website features and capabilities. This log groups related work into versioned releases.
			</p>
			<div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
				<span class="rounded-none border border-emerald-700/70 bg-emerald-900/20 px-2 py-1 text-emerald-200">Current: {current.version}</span>
				<span class="rounded-none border border-slate-700 px-2 py-1 text-slate-300">Released {current.date}</span>
				<span class="rounded-none border border-slate-700 px-2 py-1 text-slate-300">{current.title}</span>
			</div>
		</header>

		<div class="space-y-4">
			{releases.map((release) => (
				<article class="card p-5" id={release.version.toLowerCase()}>
					<div class="flex flex-wrap items-center gap-2 text-xs">
						<span class={`rounded-none border px-2 py-1 ${release.current ? 'border-emerald-700/70 bg-emerald-900/20 text-emerald-200' : 'border-slate-700 text-slate-300'}`}>
							{release.version}
						</span>
						<span class="text-slate-400">{release.date}</span>
					</div>
					<h2 class="mt-2 text-xl font-semibold text-slate-50">{release.title}</h2>
					<p class="mt-1 text-sm text-slate-300">{release.summary}</p>

					<div class="mt-4 grid gap-4 md:grid-cols-2">
						{release.groups.map((group) => (
							<section>
								<h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">{group.heading}</h3>
								<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-200">
									{group.items.map((item) => <li>{item}</li>)}
								</ul>
							</section>
						))}
					</div>
				</article>
			))}
		</div>
	</section>
</SiteLayout>
