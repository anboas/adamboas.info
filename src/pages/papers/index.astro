---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));
---

<SiteLayout title="Papers | Adam Boas" description="Whitepapers and publications.">
	<h1 class="text-2xl font-semibold text-slate-50">Papers</h1>
	<p class="mt-2 text-slate-300">Long-form writing, published as full pages (with optional PDFs).</p>

	<div class="mt-8 grid gap-6">
		{papers.map((p) => (
			<a class="card block p-6 hover:border-slate-700" href={`/papers/${p.id}/`}>
				<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
					<h2 class="text-lg font-semibold text-slate-50">{p.data.title}</h2>
					{p.data.date && <span class="text-sm text-slate-400">{p.data.date.toISOString().slice(0, 10)}</span>}
				</div>
				{p.data.description && <p class="mt-3 text-sm text-slate-300">{p.data.description}</p>}
				{p.data.tags?.length ? (
					<ul class="mt-4 flex flex-wrap gap-2">
						{p.data.tags.map((t) => (
							<li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1 text-xs text-slate-200">{t}</li>
						))}
					</ul>
				) : null}
			</a>
		))}
	</div>
</SiteLayout>
