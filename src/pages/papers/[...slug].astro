---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
	const papers = await getCollection('papers');
	return papers.map((paper) => ({
		params: { slug: paper.id },
		props: { paper },
	}));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
---

<SiteLayout title={`${paper.data.title} | Adam Boas`} description={paper.data.description}>
	<article class="card p-8">
		<header>
			<h1 class="text-2xl font-semibold text-slate-50">{paper.data.title}</h1>
			{paper.data.description && <p class="mt-2 text-slate-300">{paper.data.description}</p>}
			{paper.data.date && <p class="mt-2 text-sm text-slate-400">{paper.data.date.toISOString().slice(0, 10)}</p>}

			{paper.data.pdfPath && (
				<div class="mt-4 flex flex-wrap items-center gap-3">
					<a class="rounded-xl bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-400" href={paper.data.pdfPath} target="_blank" rel="noreferrer">
						Download PDF
					</a>
					<a class="rounded-xl border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-100 hover:bg-slate-900" href={paper.data.pdfPath} target="_blank" rel="noreferrer">
						Open PDF
					</a>
				</div>
			)}
		</header>

		<div class="prose prose-invert mt-8 max-w-none prose-a:text-cyan-300 prose-a:no-underline hover:prose-a:text-cyan-200">
			<Content />
		</div>

		{paper.data.pdfPath && (
			<div class="mt-10">
				<h2 class="text-lg font-semibold text-slate-50">PDF</h2>
				<div class="mt-3 overflow-hidden rounded-2xl border border-slate-800">
					<iframe class="h-[75vh] w-full" src={paper.data.pdfPath} title="PDF"></iframe>
				</div>
			</div>
		)}
	</article>
</SiteLayout>
