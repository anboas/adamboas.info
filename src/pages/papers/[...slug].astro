---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/withBase';

export async function getStaticPaths() {
	const papers = await getCollection('papers');
	return papers.map((paper) => ({
		params: { slug: paper.id },
		props: { paper },
	}));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
---

<SiteLayout title={`${paper.data.title} | Adam Boas`} description={paper.data.description}>
	<article class="card p-8">
		<header>
			<h1 class="text-2xl font-semibold text-slate-50">{paper.data.title}</h1>
			{paper.data.description && <p class="mt-2 text-slate-300">{paper.data.description}</p>}
			{paper.data.date && <p class="mt-2 text-sm text-slate-400">{paper.data.date.toISOString().slice(0, 10)}</p>}

			{paper.data.pdfPath && (
				<div class="mt-4 flex flex-wrap items-center gap-3">
					<a
						class="rounded-none border border-slate-700 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-stone-200"
						href={withBase(paper.data.pdfPath)}
						target="_blank"
						rel="noreferrer"
					>
						Download PDF
					</a>
				</div>
			)}
		</header>

		<div class="prose prose-invert mt-8 max-w-none prose-a:text-stone-200 prose-a:no-underline hover:prose-a:text-stone-50">
			<Content />
		</div>

		{paper.data.pdfPath && (
			<div class="mt-10">
				<div class="overflow-hidden rounded-none border border-slate-800">
					<iframe class="h-[75vh] w-full" src={withBase(paper.data.pdfPath)} title="PDF"></iframe>
				</div>
			</div>
		)}
	</article>
</SiteLayout>
