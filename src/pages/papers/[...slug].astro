---
// Back-compat: /papers/<slug> → /writing/<slug>
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/withBase';

export async function getStaticPaths() {
	const papers = (await getCollection('papers')).filter((paper) => paper.data.status === 'published');
	return papers.map((paper) => ({
		params: { slug: paper.id },
		props: { slug: paper.id },
	}));
}

const { slug } = Astro.props;
---

<SiteLayout title="Writing | Adam Boas" description="Redirecting…" canonicalHref={`/writing/${slug}/`}>
	<meta http-equiv="refresh" content={`0; url=${withBase(`/writing/${slug}/`)}`} />
	<p class="text-slate-300">Redirecting to <a href={withBase(`/writing/${slug}/`)}>{`/writing/${slug}/`}</a>…</p>
</SiteLayout>
