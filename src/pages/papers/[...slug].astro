---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/withBase';
import fs from 'node:fs/promises';
import path from 'node:path';

async function tryReadGeneratedHtml(slug) {
	try {
		const p = path.join(process.cwd(), 'src', 'generated', 'papers', `${slug}.html`);
		return await fs.readFile(p, 'utf-8');
	} catch {
		return null;
	}
}

export async function getStaticPaths() {
	const papers = await getCollection('papers');
	return papers.map((paper) => ({
		params: { slug: paper.id },
		props: { paper },
	}));
}

const { paper } = Astro.props;
const generatedHtml = await tryReadGeneratedHtml(paper.id);
const { Content } = await render(paper);
---

<SiteLayout title={`${paper.data.title} | Adam Boas`} description={paper.data.description}>
	<article class="card p-8" data-paper-style="academic">
		<header class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold text-slate-50">{paper.data.title}</h1>
				{paper.data.description && <p class="mt-2 text-slate-300">{paper.data.description}</p>}
				{paper.data.date && <p class="mt-2 text-sm text-slate-400">{paper.data.date.toISOString().slice(0, 10)}</p>}
			</div>

			<div class="flex shrink-0 flex-wrap items-center gap-2">
				<div class="inline-flex overflow-hidden rounded-none border border-slate-800">
					<button type="button" class="paper-toggle px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-slate-900" data-style="academic">Academic</button>
					<button type="button" class="paper-toggle border-l border-slate-800 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-slate-900" data-style="dossier">Dossier</button>
				</div>

				{paper.data.pdfPath && (
					<a
						class="rounded-none border border-slate-700 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-stone-200"
						href={withBase(paper.data.pdfPath)}
						target="_blank"
						rel="noreferrer"
					>
						Download PDF
					</a>
				)}
			</div>
		</header>

		<script is:inline>
			(() => {
				const STORAGE_KEY = 'paperStyle';
				const root = document.currentScript?.closest('article');
				if (!root) return;

				const apply = (style) => {
					root.setAttribute('data-paper-style', style);
					try { localStorage.setItem(STORAGE_KEY, style); } catch {}
				};

				let saved;
				try { saved = localStorage.getItem(STORAGE_KEY); } catch {}
				if (saved === 'academic' || saved === 'dossier') apply(saved);

				root.querySelectorAll('.paper-toggle').forEach((btn) => {
					btn.addEventListener('click', () => apply(btn.dataset.style));
				});
			})();
		</script>

		<div class="paper-content prose prose-invert mt-8 max-w-none">
			{generatedHtml ? (
				<div set:html={generatedHtml} />
			) : (
				<Content />
			)}
		</div>

		{paper.data.pdfPath && (
			<div class="mt-10">
				<div class="overflow-hidden rounded-none border border-slate-800">
					<iframe class="h-[75vh] w-full" src={withBase(paper.data.pdfPath)} title="PDF"></iframe>
				</div>
			</div>
		)}
	</article>
</SiteLayout>
