---
import SiteLayout from '../layouts/SiteLayout.astro';

// Certifications sourced from the legacy site (adamboas.info)
const certs = [
	{ issuer: 'Amazon Web Services', name: 'AWS Certified Cloud Practitioner' },
	{ issuer: 'Amazon Web Services', name: 'AWS Certified Solutions Architect - Associate' },
	{ issuer: 'HP Enterprise (HPE)', name: 'HP ASE - FORTIFY V1' },
	{ issuer: 'ScrumAlliance', name: 'CERTIFIED SCRUMMASTER' },
];
---

<SiteLayout title="Credentials | Adam Boas" description="Certifications.">
	<h1 class="text-2xl font-semibold text-slate-50">Credentials</h1>
	<p class="mt-2 text-slate-300">Certifications.</p>

	<section class="card mt-8 p-6">
		<h2 class="section-title">Certifications</h2>
		<ul class="mt-4 space-y-3 text-sm text-slate-300">
			{certs.map((c) => (
				<li class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
					<span class="text-slate-50">{c.name}</span>
					<span class="text-slate-400">{c.issuer}</span>
				</li>
			))}
		</ul>
	</section>
</SiteLayout>
