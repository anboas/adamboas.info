---
import SiteLayout from '../layouts/SiteLayout.astro';

// TODO: fill with your real certs
const certs = [
	{ issuer: 'AWS', name: 'AWS Certified Solutions Architect', year: 'YYYY' },
	{ issuer: 'ScrumAlliance', name: 'CSM', year: 'YYYY' },
];

const proficiencies = [
	'Cloud architecture',
	'Infrastructure as Code',
	'CI/CD',
	'Observability',
	'Governance + risk controls',
];
---

<SiteLayout title="Credentials | Adam Boas" description="Certifications, proficiencies, and highlights.">
	<h1 class="text-2xl font-semibold text-slate-50">Credentials</h1>
	<p class="mt-2 text-slate-300">Certifications and core proficiencies.</p>

	<div class="mt-8 grid gap-6 md:grid-cols-2">
		<section class="card p-6">
			<h2 class="section-title">Certifications</h2>
			<ul class="mt-4 space-y-3 text-sm text-slate-300">
				{certs.map((c) => (
					<li class="flex items-baseline justify-between gap-4">
						<span><span class="text-slate-50">{c.name}</span> <span class="text-slate-400">({c.issuer})</span></span>
						<span class="text-slate-400">{c.year}</span>
					</li>
				))}
			</ul>
		</section>

		<section class="card p-6">
			<h2 class="section-title">Proficiencies</h2>
			<ul class="mt-4 flex flex-wrap gap-2">
				{proficiencies.map((p) => (
					<li class="rounded-full border border-slate-700 bg-slate-900/60 px-3 py-1 text-xs text-slate-200">{p}</li>
				))}
			</ul>
		</section>
	</div>
</SiteLayout>
