---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../components/SurfacePageHeader.astro';
import { withBase } from '../../utils/withBase';

const researchItems = [
	{
		title: 'NIWC PAC',
		href: withBase('/research/niwc-pac/'),
		description:
			'Public-source org atlas for NIWC Pacific, Code 53 / Code 532, Application Arsenal, and adjacent acquisition/program interfaces.',
		kicker: 'Organization / Application Arsenal',
		stats: ['145 roster rows', '4 SVG charts', '2 data tables'],
		updated: 'Updated 2 Sep 2026',
	},
	{
		title: 'CGCYBER IOM',
		href: withBase('/research/cgcyber-iom/'),
		description:
			'Public-source capture atlas for Coast Guard Cyber Command Integrated Operations Management, contract seams, competitors, and source-backed evidence.',
		kicker: 'Opportunity / contract ecosystem',
		stats: ['39 org rows', '3 SVG charts', '4 data tables'],
		updated: 'Updated 2 Sep 2026',
	},
];
---

<SiteLayout title="Research" description="Private research workspace for Adam Boas." noindex={true} nofollow={true}>
	<SurfacePageHeader
		stickyActive="none"
		eyebrow="Private research"
		title="Research"
		description="Non-indexed working area for structured research artifacts."
	/>

	<div class="research-notice mt-3 border border-teal-400/20 bg-teal-950/20 p-3 text-xs leading-5 text-slate-300">
		<span class="font-semibold text-teal-100">Hidden research index.</span>
		These pages are excluded from robots and sitemap output and are not linked from the public navigation. They are still
		public URLs if shared.
	</div>

	<section class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3" aria-label="Research folders">
		{
			researchItems.map((item) => (
				<a
					href={item.href}
					class="research-card group block border border-slate-800 bg-slate-950/95 p-4 no-underline hover:border-teal-400/55"
				>
					<div class="flex items-start justify-between gap-3">
						<div class="min-w-0">
							<p class="text-[0.68rem] uppercase tracking-[0.14em] text-teal-200/80">{item.kicker}</p>
							<h2 class="mt-1 text-lg font-semibold text-slate-50">{item.title}</h2>
							<p class="mt-2 text-sm leading-6 text-slate-300">{item.description}</p>
						</div>
						<span class="shrink-0 border border-teal-400/35 px-2 py-1 text-xs text-teal-100">Open</span>
					</div>
					<div class="mt-4 flex flex-wrap gap-2">
						{item.stats.map((stat) => (
							<span class="ui-pill">{stat}</span>
						))}
					</div>
					<div class="mt-4 border-t border-slate-800 pt-3 text-xs text-slate-500">{item.updated}</div>
				</a>
			))
		}
	</section>
</SiteLayout>

<style>
	.research-notice,
	.research-card,
	.research-card span {
		border-radius: 0;
	}

	.research-card {
		box-shadow: inset 3px 0 0 rgba(45, 212, 191, 0.22);
		transition:
			border-color 160ms ease,
			background-color 160ms ease,
			box-shadow 160ms ease;
	}

	.research-card:hover {
		background: rgb(3 10 25);
		box-shadow: inset 3px 0 0 rgba(45, 212, 191, 0.82);
	}
</style>
