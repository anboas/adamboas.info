---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../../components/SurfacePageHeader.astro';
import { withBase } from '../../../utils/withBase';
import researchScriptUrl from '../../../scripts/research-niwc-pac.js?url';

const assetBase = '/research/niwc-pac/';
const charts = [
	{
		id: 'internal',
		label: 'Internal Structure',
		src: withBase(`${assetBase}internal-public-structure.svg`),
		description: 'Command, staff offices, departments, business portfolios, public interfaces, and deep-code nodes.',
		focusX: 0.74,
		focusY: 0.14,
	},
	{
		id: 'aa',
		label: 'Code 53 / 532 / AA',
		src: withBase(`${assetBase}code53-code532-aa-focus.svg`),
		description: 'Application Arsenal drilldown through Code 53, Code 532 / 53200, Navy Digital Ecosystem, and OSA.',
		focusX: 0.48,
		focusY: 0.16,
	},
	{
		id: 'overlay',
		label: 'Acquisition Overlay',
		src: withBase(`${assetBase}acquisition-program-overlay.svg`),
		description: 'Procurement, program sponsor, requirements, policy, and NAVWAR-adjacent interfaces.',
		focusX: 0.45,
		focusY: 0.15,
	},
	{
		id: 'forward-slope',
		label: 'Forward Slope Lineage',
		src: withBase(`${assetBase}forward-slope-lineage.svg`),
		description:
			'Forward Slope / Accelint / Lyntris ownership lineage, Application Arsenal award trail, and NIWC C2 adjacency.',
		focusX: 0.5,
		focusY: 0.2,
	},
];
---

<SiteLayout
	title="NIWC PAC Research Atlas"
	description="Private public-source NIWC Pacific org atlas and Application Arsenal contact matrix."
	noindex={true}
	nofollow={true}
>
	<section
		class="research-app"
		data-niwc-research
		data-csv-url={withBase(`${assetBase}niwc-pacific-org-roster.csv`)}
		data-connections-csv-url={withBase(`${assetBase}forward-slope-connections.csv`)}
	>
		<SurfacePageHeader
			stickyActive="none"
			eyebrowLinks={[{ label: 'Research', href: withBase('/research/') }, { label: 'NIWC PAC' }]}
			title="NIWC Pacific Public Org Atlas"
			description="Interactive public-source structure map for NIWC Pacific, Code 53 / Code 532, Application Arsenal, adjacent program/acquisition interfaces, and the Forward Slope / Accelint / Lyntris lineage behind the AA support trail."
		>
			<div slot="actions" class="flex flex-wrap gap-2">
				<a class="ui-link-btn ui-link-btn-primary" href={withBase(`${assetBase}niwc-pacific-org-roster.csv`)}>CSV</a>
				<a
					class="ui-link-btn ui-link-btn-muted"
					href={withBase(`${assetBase}niwc-pacific-application-arsenal-poc-matrix-augmented.xlsx`)}>Workbook</a
				>
				<a class="ui-link-btn ui-link-btn-muted" href={withBase(`${assetBase}forward-slope-connections.csv`)}
					>Lineage CSV</a
				>
				<a class="ui-link-btn ui-link-btn-muted" href={withBase(`${assetBase}full-report-export.png`)}>PNG</a>
			</div>
		</SurfacePageHeader>

		<div class="research-banner mt-3 border border-teal-400/20 bg-teal-950/20 p-3 text-xs leading-5 text-slate-300">
			<span class="font-semibold text-teal-100">Noindex research surface.</span>
			This page is excluded from sitemap/robots and is not linked from the public navigation. It is still a public URL if
			shared.
		</div>

		<nav class="research-jump mt-3" aria-label="Research section navigation">
			<a href={withBase('/research/')}>Research Index</a>
			<a href={withBase('/research/system/')}>System</a>
			<a href="#chart-title">Charts</a>
			<a href="#connections-title">Forward Slope</a>
			<a href="#roster-title">Org Roster</a>
			<a href={withBase('/research/cgcyber-iom/')}>CGCYBER IOM</a>
			<a href={withBase('/research/naval-aviation-enterprise/')}>NAE</a>
		</nav>

		<section class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-5" aria-label="Research summary">
			<div class="metric-panel">
				<b data-metric="rows">145</b>
				<span>Roster rows</span>
			</div>
			<div class="metric-panel">
				<b data-metric="internal">115</b>
				<span>NIWC PAC/internal</span>
			</div>
			<div class="metric-panel">
				<b data-metric="current">31</b>
				<span>Current / official</span>
			</div>
			<div class="metric-panel">
				<b data-metric="gaps">34</b>
				<span>Public gaps</span>
			</div>
			<div class="metric-panel">
				<b data-metric="dated">80</b>
				<span>Dated / historical</span>
			</div>
		</section>

		<section class="mt-4 border border-slate-800 bg-slate-950/95" aria-labelledby="chart-title">
			<div class="flex flex-col gap-3 border-b border-slate-800 p-3 lg:flex-row lg:items-start lg:justify-between">
				<div class="min-w-0">
					<h2 id="chart-title" class="text-base font-semibold text-slate-50">Structure Charts</h2>
					<p class="mt-1 max-w-5xl text-xs leading-5 text-slate-400" data-chart-description>
						{charts[0].description}
					</p>
				</div>
				<div class="flex flex-wrap gap-2 text-xs" aria-label="Chart view controls">
					{
						charts.map((chart, index) => (
							<button
								class:list={['chart-tab', index === 0 && 'chart-tab-active']}
								type="button"
								data-chart-tab={chart.id}
								data-chart-src={chart.src}
								data-chart-tab-description={chart.description}
								data-chart-focus-x={chart.focusX}
								data-chart-focus-y={chart.focusY}
							>
								{chart.label}
							</button>
						))
					}
				</div>
			</div>

			<div class="chart-toolbar border-b border-slate-800 p-3">
				<div class="flex flex-wrap items-center gap-2">
					<button type="button" class="control-btn" data-chart-action="zoom-out">Zoom -</button>
					<button type="button" class="control-btn" data-chart-action="zoom-in">Zoom +</button>
					<button type="button" class="control-btn" data-chart-action="fit">Fit</button>
					<button type="button" class="control-btn" data-chart-action="reset">100%</button>
					<a class="control-btn no-underline" data-chart-download href={charts[0].src}>Open SVG</a>
					<span class="ui-pill" data-chart-zoom>100%</span>
				</div>
			</div>

			<div class="chart-stage" data-chart-stage>
				<img
					src={charts[0].src}
					alt="NIWC Pacific public research chart"
					class="chart-image"
					data-chart-image
					draggable="false"
				/>
			</div>
		</section>

		<section class="mt-4 border border-slate-800 bg-slate-950/95" aria-labelledby="connections-title">
			<div class="border-b border-slate-800 p-3">
				<div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
					<div class="min-w-0">
						<h2 id="connections-title" class="text-base font-semibold text-slate-50">
							Forward Slope Lineage Connections
						</h2>
						<p class="mt-1 max-w-4xl text-xs leading-5 text-slate-400">
							Public corporate lineage, award trail, executives, contract contacts, and NIWC / Application Arsenal
							relevance. Direct AA evidence is separated from broader C2 or corporate context.
						</p>
					</div>
					<div class="text-xs text-slate-400">
						<span data-connections-count>Loading connections...</span>
					</div>
				</div>

				<div class="mt-3 grid gap-2 md:grid-cols-2 xl:grid-cols-5">
					<label class="filter-field md:col-span-2 xl:col-span-1">
						<span>Search</span>
						<input type="search" data-connections-search placeholder="Company, person, award, source..." />
					</label>
					<label class="filter-field">
						<span>Entity</span>
						<select data-connections-filter="Entity"><option value="">All entities</option></select>
					</label>
					<label class="filter-field">
						<span>Type</span>
						<select data-connections-filter="Type"><option value="">All types</option></select>
					</label>
					<label class="filter-field">
						<span>Relevance</span>
						<select data-connections-filter="AA / NIWC PAC Relevance"><option value="">All relevance</option></select>
					</label>
					<label class="filter-field">
						<span>Confidence</span>
						<select data-connections-filter="Confidence"><option value="">All confidence</option></select>
					</label>
				</div>
			</div>

			<div class="roster-table-wrap connections-table-wrap">
				<table class="roster-table connections-table" data-connections-table>
					<thead>
						<tr>
							<th><button type="button" data-connections-sort-key="ID">ID</button></th>
							<th><button type="button" data-connections-sort-key="Person / Node">Person / Node</button></th>
							<th><button type="button" data-connections-sort-key="Entity">Entity</button></th>
							<th><button type="button" data-connections-sort-key="Type">Type</button></th>
							<th>
								<button type="button" data-connections-sort-key="Public Role / Relationship">Role / relationship</button
								>
							</th>
							<th><button type="button" data-connections-sort-key="Connection / Evidence">Evidence</button></th>
							<th
								><button type="button" data-connections-sort-key="AA / NIWC PAC Relevance">AA / NIWC relevance</button
								></th
							>
							<th><button type="button" data-connections-sort-key="Confidence">Confidence</button></th>
							<th><button type="button" data-connections-sort-key="Source Date">Source date</button></th>
							<th>Source</th>
						</tr>
					</thead>
					<tbody data-connections-body>
						<tr>
							<td colspan="10" class="px-3 py-6 text-center text-sm text-slate-400"> Loading connections... </td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class="mt-4 border border-slate-800 bg-slate-950/95" aria-labelledby="roster-title">
			<div class="border-b border-slate-800 p-3">
				<div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
					<div class="min-w-0">
						<h2 id="roster-title" class="text-base font-semibold text-slate-50">Contact And Org Roster</h2>
						<p class="mt-1 max-w-4xl text-xs leading-5 text-slate-400">
							Search, sort, and filter the public-source rows behind the chart. Gaps are kept as first-class rows.
						</p>
					</div>
					<div class="text-xs text-slate-400">
						<span data-roster-count>Loading roster...</span>
					</div>
				</div>

				<div class="mt-3 grid gap-2 md:grid-cols-2 xl:grid-cols-5">
					<label class="filter-field md:col-span-2 xl:col-span-1">
						<span>Search</span>
						<input type="search" data-roster-search placeholder="Name, role, code, source..." />
					</label>
					<label class="filter-field">
						<span>Domain</span>
						<select data-roster-filter="Structure Domain"><option value="">All domains</option></select>
					</label>
					<label class="filter-field">
						<span>Status</span>
						<select data-roster-filter="Status Class"><option value="">All statuses</option></select>
					</label>
					<label class="filter-field">
						<span>AA relation</span>
						<select data-roster-filter="AA Relationship"><option value="">All relations</option></select>
					</label>
					<label class="filter-field">
						<span>Confidence</span>
						<select data-roster-filter="Confidence"><option value="">All confidence</option></select>
					</label>
				</div>
			</div>

			<div class="roster-table-wrap">
				<table class="roster-table" data-roster-table>
					<thead>
						<tr>
							<th><button type="button" data-sort-key="ID">ID</button></th>
							<th><button type="button" data-sort-key="Name / Public Node">Name / Node</button></th>
							<th><button type="button" data-sort-key="Exact Public Role">Role</button></th>
							<th><button type="button" data-sort-key="Status Class">Status</button></th>
							<th><button type="button" data-sort-key="AA Relationship">AA relation</button></th>
							<th><button type="button" data-sort-key="Org Code">Code</button></th>
							<th><button type="button" data-sort-key="Organization / Unit">Unit</button></th>
							<th><button type="button" data-sort-key="Structure Domain">Domain</button></th>
							<th><button type="button" data-sort-key="Hierarchy Path">Hierarchy</button></th>
							<th><button type="button" data-sort-key="Confidence">Confidence</button></th>
							<th><button type="button" data-sort-key="Source Date">Source date</button></th>
						</tr>
					</thead>
					<tbody data-roster-body>
						<tr>
							<td colspan="11" class="px-3 py-6 text-center text-sm text-slate-400">Loading roster...</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>
	</section>

	<script type="module" src={researchScriptUrl}></script>
</SiteLayout>

<style>
	.research-app {
		--research-border: rgba(51, 65, 85, 0.92);
		--research-muted: rgb(148 163 184);
		--research-soft: rgba(15, 23, 42, 0.72);
	}

	.research-banner,
	.metric-panel,
	.chart-tab,
	.control-btn,
	.filter-field input,
	.filter-field select {
		border-radius: 0;
	}

	.research-jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		border: 1px solid rgba(51, 65, 85, 0.92);
		background: rgba(2, 6, 23, 0.86);
		padding: 0.65rem;
	}

	.research-jump a {
		border: 1px solid rgba(71, 85, 105, 0.88);
		padding: 0.35rem 0.65rem;
		color: rgb(203 213 225);
		font-size: 0.75rem;
		line-height: 1.2;
		text-decoration: none;
	}

	.research-jump a:hover,
	.research-jump a:focus-visible {
		border-color: rgba(45, 212, 191, 0.65);
		color: rgb(240 253 250);
	}

	.metric-panel {
		border: 1px solid var(--research-border);
		background: rgb(2 6 23);
		padding: 0.85rem;
	}

	.metric-panel b {
		display: block;
		font-size: 1.55rem;
		line-height: 1.1;
		color: rgb(248 250 252);
	}

	.metric-panel span {
		margin-top: 0.25rem;
		display: block;
		font-size: 0.72rem;
		line-height: 1.25;
		color: var(--research-muted);
		text-transform: uppercase;
	}

	.chart-tab,
	.control-btn {
		min-height: 2rem;
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgba(2, 6, 23, 0.88);
		padding: 0.35rem 0.65rem;
		color: rgb(203 213 225);
		line-height: 1.2;
	}

	.chart-tab:hover,
	.control-btn:hover {
		border-color: rgba(45, 212, 191, 0.65);
		color: rgb(240 253 250);
	}

	.chart-tab-active {
		border-color: rgba(45, 212, 191, 0.78);
		background: rgba(20, 184, 166, 0.2);
		color: rgb(240 253 250);
	}

	.chart-stage {
		position: relative;
		height: min(72vh, 760px);
		min-height: 420px;
		overflow: hidden;
		background: rgb(248 250 252);
		cursor: grab;
		touch-action: none;
	}

	.chart-stage:active {
		cursor: grabbing;
	}

	.chart-image {
		display: block;
		max-width: none;
		transform-origin: 0 0;
		user-select: none;
		will-change: transform;
	}

	.filter-field {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.35rem;
	}

	.filter-field span {
		font-size: 0.68rem;
		line-height: 1.2;
		color: var(--research-muted);
		text-transform: uppercase;
	}

	.filter-field input,
	.filter-field select {
		width: 100%;
		min-height: 2.35rem;
		border: 1px solid rgba(71, 85, 105, 0.82);
		background: rgba(2, 6, 23, 0.86);
		padding: 0.45rem 0.6rem;
		color: rgb(226 232 240);
		font-size: 0.82rem;
		line-height: 1.25;
	}

	.roster-table-wrap {
		max-height: 72vh;
		overflow: auto;
		background:
			linear-gradient(90deg, rgb(2 6 23), transparent 1.25rem) left/1.25rem 100% no-repeat,
			rgb(2 6 23);
		scrollbar-color: rgba(45, 212, 191, 0.48) rgba(15, 23, 42, 0.92);
	}

	.roster-table {
		--id-col-width: 4.25rem;
		--name-col-width: 18rem;
		width: 100%;
		min-width: 1420px;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 0.78rem;
		line-height: 1.42;
	}

	.connections-table {
		min-width: 1680px;
	}

	.roster-table th,
	.research-app :global(.roster-table td) {
		border-bottom: 1px solid rgba(30, 41, 59, 0.95);
		padding: 0.62rem 0.7rem;
		text-align: left;
		vertical-align: top;
	}

	.roster-table th {
		position: sticky;
		top: 0;
		z-index: 4;
		border-bottom-color: rgba(45, 212, 191, 0.28);
		background: rgb(15 23 42);
		box-shadow: inset 0 -1px 0 rgba(45, 212, 191, 0.24);
	}

	.roster-table th button {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: rgb(226 232 240);
		font-weight: 600;
		text-align: left;
	}

	.roster-table th button::after {
		content: '';
		width: 0.36rem;
		height: 0.36rem;
		border-right: 1px solid rgba(148, 163, 184, 0.65);
		border-bottom: 1px solid rgba(148, 163, 184, 0.65);
		opacity: 0.45;
		transform: rotate(45deg) translateY(-0.08rem);
	}

	.roster-table th button[data-sort-state='asc']::after {
		border-color: rgb(94 234 212);
		opacity: 1;
		transform: rotate(225deg) translateY(-0.08rem);
	}

	.roster-table th button[data-sort-state='desc']::after {
		border-color: rgb(94 234 212);
		opacity: 1;
	}

	.research-app :global(.roster-row) {
		--row-bg: rgb(2 6 23);
		--row-accent: rgba(100, 116, 139, 0.75);
		background: var(--row-bg);
		color: rgb(203 213 225);
		outline: none;
	}

	.research-app :global(.roster-table tbody tr:nth-child(odd)) {
		--row-bg: rgb(5 13 30);
	}

	.research-app :global(.roster-table tbody tr:nth-child(even)) {
		--row-bg: rgb(10 18 36);
	}

	.research-app :global(.roster-row-current),
	.research-app :global(.roster-row-official) {
		--row-accent: rgb(20 184 166);
	}

	.research-app :global(.roster-row-gap) {
		--row-accent: rgb(251 146 60);
	}

	.research-app :global(.roster-row-dated),
	.research-app :global(.roster-row-forecast) {
		--row-accent: rgb(245 158 11);
	}

	.research-app :global(.roster-row-historical) {
		--row-accent: rgb(148 163 184);
	}

	.research-app :global(.roster-row-unverified) {
		--row-accent: rgb(248 113 113);
	}

	.research-app :global(.roster-table tbody tr:hover),
	.research-app :global(.roster-table tbody tr:focus-visible),
	.research-app :global(.roster-row-selected) {
		--row-bg: rgb(20 32 55);
		box-shadow: inset 0 0 0 1px rgba(45, 212, 191, 0.2);
		color: rgb(241 245 249);
	}

	.roster-table th:nth-child(1),
	.roster-table th:nth-child(2),
	.research-app :global(.cell-id),
	.research-app :global(.cell-name) {
		position: sticky;
		background: inherit;
	}

	.roster-table th:nth-child(1),
	.roster-table th:nth-child(2) {
		z-index: 5;
		background: rgb(15 23 42);
	}

	.roster-table th:nth-child(1),
	.research-app :global(.cell-id) {
		left: 0;
		width: var(--id-col-width);
		min-width: var(--id-col-width);
		max-width: var(--id-col-width);
	}

	.roster-table th:nth-child(2),
	.research-app :global(.cell-name) {
		left: var(--id-col-width);
		width: var(--name-col-width);
		min-width: var(--name-col-width);
		max-width: var(--name-col-width);
		box-shadow: 1px 0 0 rgba(45, 212, 191, 0.12);
	}

	.research-app :global(.cell-id) {
		border-left: 3px solid var(--row-accent);
		color: rgb(148 163 184);
		font-variant-numeric: tabular-nums;
	}

	.research-app :global(.cell-name strong) {
		display: block;
		color: rgb(248 250 252);
		font-size: 0.84rem;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}

	.research-app :global(.cell-role) {
		min-width: 18rem;
		color: rgb(226 232 240);
	}

	.research-app :global(.cell-entity),
	.research-app :global(.cell-type) {
		min-width: 12rem;
		color: rgb(203 213 225);
	}

	.research-app :global(.cell-evidence) {
		min-width: 24rem;
		color: rgb(226 232 240);
	}

	.research-app :global(.cell-relation) {
		min-width: 13rem;
		color: rgb(204 251 241);
	}

	.research-app :global(.cell-unit),
	.research-app :global(.cell-hierarchy) {
		min-width: 19rem;
	}

	.research-app :global(.cell-domain) {
		min-width: 13rem;
	}

	.research-app :global(.cell-code),
	.research-app :global(.cell-date) {
		min-width: 7.5rem;
		font-variant-numeric: tabular-nums;
	}

	.research-app :global(.cell-confidence) {
		min-width: 10rem;
	}

	.research-app :global(.cell-source) {
		min-width: 9rem;
		white-space: nowrap;
	}

	.research-app :global(.cell-hierarchy),
	.research-app :global(.cell-domain),
	.research-app :global(.cell-confidence),
	.research-app :global(.cell-date),
	.research-app :global(.cell-id) {
		color: rgb(148 163 184);
	}

	.research-app :global(.status-badge) {
		display: inline-flex;
		align-items: center;
		min-height: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.3);
