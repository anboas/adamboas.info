---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../../components/SurfacePageHeader.astro';
import { withBase } from '../../../utils/withBase';
import researchScriptUrl from '../../../scripts/research-cgcyber-iom.js?url';

const assetBase = '/research/cgcyber-iom/';
const charts = [
	{
		id: 'authority',
		label: 'Authority / Customer',
		src: withBase(`${assetBase}cgcyber-authority-org.svg`),
		description:
			'DHS, Coast Guard, CG-C5I, CGCYBER, DCS, PEO C5I/Cyber, C5ISC, acquisition, contracting, and technology interfaces.',
		focusX: 0.49,
		focusY: 0.19,
	},
	{
		id: 'operations',
		label: 'Operations / C5ISC',
		src: withBase(`${assetBase}cgcyber-operations-structure.svg`),
		description:
			'CGCC-2/3/33/35/36/37/AA operating structure, senior workforce signals, exercise readiness, and the highest C5ISC interface seams.',
		focusX: 0.43,
		focusY: 0.2,
	},
	{
		id: 'contracts',
		label: 'Contract Ecosystem',
		src: withBase(`${assetBase}cgcyber-contract-ecosystem.svg`),
		description:
			'IOM target opportunity, APFS/CG-914 buyer metadata, legacy NOSC/CND lineage, IARMS, IMS/IPSS, C5I apps, C5ISR, VIA, BLMSS, and OEM/training seams.',
		focusX: 0.43,
		focusY: 0.2,
	},
];

const tableSections = [
	{
		id: 'org',
		title: 'Government POC And Org Roster',
		description:
			'Public-source CGCYBER, acquisition, systems, C5ISC, contracting, workforce, exercise, and technology roles. Offices remain offices where no public incumbent is known.',
		countAttr: 'data-org-count',
		searchAttr: 'data-org-search',
		searchPlaceholder: 'Name, role, code, office, source...',
		filterAttr: 'data-org-filter',
		filters: [
			['Domain', 'All domains'],
			['Status', 'All statuses'],
			['IOM Relevance', 'All relevance'],
			['Confidence', 'All confidence'],
		],
		tableAttr: 'data-org-table',
		bodyAttr: 'data-org-body',
		sortAttr: 'data-org-sort-key',
		headers: [
			['ID', 'ID'],
			['Node', 'Name / Node'],
			['Role', 'Role'],
			['Status', 'Status'],
			['IOM Relevance', 'IOM relation'],
			['Code', 'Code'],
			['Domain', 'Domain'],
			['Type', 'Type'],
			['Evidence', 'Evidence'],
			['Confidence', 'Confidence'],
			['Source Refs', 'Refs'],
			['Source URL', 'Source'],
		],
	},
	{
		id: 'contracts',
		title: 'Contract Ecosystem And Transition Seams',
		description:
			'Adjacent active, historical, forecast, cancelled, and false-positive contract records that shape IOM transition and teaming.',
		countAttr: 'data-contracts-count',
		searchAttr: 'data-contracts-search',
		searchPlaceholder: 'Program, prime, award ID, scope...',
		filterAttr: 'data-contracts-filter',
		filters: [
			['Prime', 'All primes'],
			['Status', 'All statuses'],
			['IOM Seam / Relevance', 'All seams'],
			['Confidence', 'All confidence'],
		],
		tableAttr: 'data-contracts-table',
		bodyAttr: 'data-contracts-body',
		sortAttr: 'data-contracts-sort-key',
		headers: [
			['ID', 'ID'],
			['Program', 'Program'],
			['Prime', 'Prime'],
			['Status', 'Status'],
			['IOM Seam / Relevance', 'IOM seam'],
			['Award / Forecast ID', 'Award / forecast'],
			['Value / Term', 'Value / term'],
			['Scope', 'Scope'],
			['Confidence', 'Confidence'],
			['Source Refs', 'Refs'],
			['Source URL', 'Source'],
		],
	},
	{
		id: 'competitors',
		title: 'Competitive Field And Teaming Posture',
		description:
			'Probability-weighted field from the package, with explicit gaps and suggested diligence posture separated from confirmed bidder intelligence.',
		countAttr: 'data-competitors-count',
		searchAttr: 'data-competitors-search',
		searchPlaceholder: 'Company, tier, vehicle, risk...',
		filterAttr: 'data-competitors-filter',
		filters: [
			['Tier', 'All tiers'],
			['Vehicle', 'All vehicles'],
			['Confidence', 'All confidence'],
		],
		tableAttr: 'data-competitors-table',
		bodyAttr: 'data-competitors-body',
		sortAttr: 'data-competitors-sort-key',
		headers: [
			['ID', 'ID'],
			['Entity', 'Entity'],
			['Tier', 'Tier'],
			['Recommended Posture', 'Posture'],
			['Power Base', 'Power base'],
			['Gap / Vulnerability', 'Gap / risk'],
			['Vehicle', 'Vehicle'],
			['Confidence', 'Confidence'],
			['Source Refs', 'Refs'],
			['Source URL', 'Source'],
		],
	},
	{
		id: 'sources',
		title: 'Source Register',
		description: 'Public-source anchors carried over from the PDF package plus this follow-on contact pass.',
		countAttr: 'data-sources-count',
		searchAttr: 'data-sources-search',
		searchPlaceholder: 'Source title, use, URL...',
		filterAttr: 'data-sources-filter',
		filters: [],
		tableAttr: 'data-sources-table',
		bodyAttr: 'data-sources-body',
		sortAttr: 'data-sources-sort-key',
		headers: [
			['ID', 'ID'],
			['Title', 'Title'],
			['Use', 'Use'],
			['URL', 'Source'],
		],
	},
];
---

<SiteLayout
	title="CGCYBER IOM Research Atlas"
	description="Private public-source CGCYBER Integrated Operations Management capture research atlas."
	noindex={true}
	nofollow={true}
>
	<section
		class="research-app"
		data-cgcyber-research
		data-org-csv-url={withBase(`${assetBase}cgcyber-iom-org-roster.csv`)}
		data-contracts-csv-url={withBase(`${assetBase}cgcyber-iom-contract-ecosystem.csv`)}
		data-competitors-csv-url={withBase(`${assetBase}cgcyber-iom-competitors.csv`)}
		data-sources-csv-url={withBase(`${assetBase}cgcyber-iom-source-register.csv`)}
	>
		<SurfacePageHeader
			stickyActive="none"
			eyebrowLinks={[{ label: 'Research', href: withBase('/research/') }, { label: 'CGCYBER IOM' }]}
			title="CGCYBER IOM Public-Source Research Atlas"
			description="Interactive capture workspace for the Coast Guard Cyber Command Integrated Operations Management forecast: org structure, government POCs, contracting/workforce interfaces, contract ecosystem, competitor field, and source register."
		>
			<div slot="actions" class="flex flex-wrap gap-2">
				<a class="ui-link-btn ui-link-btn-primary" href={withBase(`${assetBase}cgcyber-iom-org-roster.csv`)}>Org CSV</a>
				<a class="ui-link-btn ui-link-btn-muted" href={withBase(`${assetBase}cgcyber-iom-contract-ecosystem.csv`)}
					>Contracts CSV</a
				>
				<a class="ui-link-btn ui-link-btn-muted" href={withBase(`${assetBase}cgcyber-iom-competitors.csv`)}
					>Competitors CSV</a
				>
			</div>
		</SurfacePageHeader>

		<div class="research-banner mt-3 border border-teal-400/20 bg-teal-950/20 p-3 text-xs leading-5 text-slate-300">
			<span class="font-semibold text-teal-100">Noindex research surface.</span>
			This page is excluded from sitemap/robots and is not linked from the public navigation. It is still a public URL if
			shared.
		</div>

		<nav class="research-jump mt-3" aria-label="Research section navigation">
			<a href={withBase('/research/')}>Research Index</a>
			<a href="#chart-title">Charts</a>
			<a href="#org-title">Org / POCs</a>
			<a href="#contracts-title">Contracts</a>
			<a href="#competitors-title">Competitors</a>
			<a href="#sources-title">Sources</a>
			<a href={withBase('/research/niwc-pac/')}>NIWC PAC</a>
		</nav>

		<section class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-5" aria-label="Research summary">
			<div class="metric-panel">
				<b>&gt;$100M</b>
				<span>Forecast value</span>
			</div>
			<div class="metric-panel">
				<b>23 Sep</b>
				<span>Forecast RFQ</span>
			</div>
			<div class="metric-panel">
				<b>46</b>
				<span>Org / POC rows</span>
			</div>
			<div class="metric-panel">
				<b>18</b>
				<span>Contract seams</span>
			</div>
			<div class="metric-panel">
				<b>11</b>
				<span>Competitor rows</span>
			</div>
			<div class="metric-panel">
				<b>47</b>
				<span>Source records</span>
			</div>
		</section>

		<section class="mt-4 border border-slate-800 bg-slate-950/95" aria-labelledby="chart-title">
			<div class="flex flex-col gap-3 border-b border-slate-800 p-3 lg:flex-row lg:items-start lg:justify-between">
				<div class="min-w-0">
					<h2 id="chart-title" class="text-base font-semibold text-slate-50">Structure Charts</h2>
					<p class="mt-1 max-w-5xl text-xs leading-5 text-slate-400" data-chart-description>
						{charts[0].description}
					</p>
				</div>
				<div class="flex flex-wrap gap-2 text-xs" aria-label="Chart view controls">
					{
						charts.map((chart, index) => (
							<button
								class:list={['chart-tab', index === 0 && 'chart-tab-active']}
								type="button"
								data-chart-tab={chart.id}
								data-chart-src={chart.src}
								data-chart-tab-description={chart.description}
								data-chart-focus-x={chart.focusX}
								data-chart-focus-y={chart.focusY}
							>
								{chart.label}
							</button>
						))
					}
				</div>
			</div>

			<div class="chart-toolbar border-b border-slate-800 p-3">
				<div class="flex flex-wrap items-center gap-2">
					<button type="button" class="control-btn" data-chart-action="zoom-out">Zoom -</button>
					<button type="button" class="control-btn" data-chart-action="zoom-in">Zoom +</button>
					<button type="button" class="control-btn" data-chart-action="fit">Fit</button>
					<button type="button" class="control-btn" data-chart-action="reset">100%</button>
					<a class="control-btn no-underline" data-chart-download href={charts[0].src}>Open SVG</a>
					<span class="ui-pill" data-chart-zoom>100%</span>
				</div>
			</div>

			<div class="chart-stage" data-chart-stage>
				<img
					src={charts[0].src}
					alt="CGCYBER Integrated Operations Management public research chart"
					class="chart-image"
					data-chart-image
					draggable="false"
				/>
			</div>
		</section>

		{
			tableSections.map((section) => (
				<section class="mt-4 border border-slate-800 bg-slate-950/95" aria-labelledby={`${section.id}-title`}>
					<div class="border-b border-slate-800 p-3">
						<div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
							<div class="min-w-0">
								<h2 id={`${section.id}-title`} class="text-base font-semibold text-slate-50">
									{section.title}
								</h2>
								<p class="mt-1 max-w-4xl text-xs leading-5 text-slate-400">{section.description}</p>
							</div>
							<div class="text-xs text-slate-400">
								<span {...{ [section.countAttr]: true }}>Loading...</span>
							</div>
						</div>

						<div class="mt-3 grid gap-2 md:grid-cols-2 xl:grid-cols-5">
							<label class="filter-field md:col-span-2 xl:col-span-1">
								<span>Search</span>
								<input type="search" {...{ [section.searchAttr]: true }} placeholder={section.searchPlaceholder} />
							</label>
							{section.filters.map(([key, label]) => (
								<label class="filter-field">
									<span>{key}</span>
									<select {...{ [section.filterAttr]: key }}>
										<option value="">{label}</option>
									</select>
								</label>
							))}
						</div>
					</div>

					<div class:list={['roster-table-wrap', `${section.id}-table-wrap`]}>
						<table class="roster-table" {...{ [section.tableAttr]: true }}>
							<thead>
								<tr>
									{section.headers.map(([key, label]) => (
										<th>
											<button type="button" {...{ [section.sortAttr]: key }}>
												{label}
											</button>
										</th>
									))}
								</tr>
							</thead>
							<tbody {...{ [section.bodyAttr]: true }}>
								<tr>
									<td colspan={section.headers.length} class="px-3 py-6 text-center text-sm text-slate-400">
										Loading...
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>
			))
		}
	</section>

	<script type="module" src={researchScriptUrl}></script>
</SiteLayout>

<style>
	.research-app {
		--research-border: rgba(51, 65, 85, 0.92);
		--research-muted: rgb(148 163 184);
	}

	.research-banner,
	.metric-panel,
	.chart-tab,
	.control-btn,
	.filter-field input,
	.filter-field select {
		border-radius: 0;
	}

	.research-jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		border: 1px solid rgba(51, 65, 85, 0.92);
		background: rgba(2, 6, 23, 0.86);
		padding: 0.65rem;
	}

	.research-jump a {
		border: 1px solid rgba(71, 85, 105, 0.88);
		padding: 0.35rem 0.65rem;
		color: rgb(203 213 225);
		font-size: 0.75rem;
		line-height: 1.2;
		text-decoration: none;
	}

	.research-jump a:hover,
	.research-jump a:focus-visible {
		border-color: rgba(45, 212, 191, 0.65);
		color: rgb(240 253 250);
	}

	.metric-panel {
		border: 1px solid var(--research-border);
		background: rgb(2 6 23);
		padding: 0.85rem;
	}

	.metric-panel b {
		display: block;
		font-size: 1.42rem;
		line-height: 1.1;
		color: rgb(248 250 252);
	}

	.metric-panel span {
		margin-top: 0.25rem;
		display: block;
		font-size: 0.7rem;
		line-height: 1.25;
		color: var(--research-muted);
		text-transform: uppercase;
	}

	.chart-tab,
	.control-btn {
		min-height: 2rem;
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgba(2, 6, 23, 0.88);
		padding: 0.35rem 0.65rem;
		color: rgb(203 213 225);
		line-height: 1.2;
	}

	.chart-tab:hover,
	.control-btn:hover {
		border-color: rgba(45, 212, 191, 0.65);
		color: rgb(240 253 250);
	}

	.chart-tab-active {
		border-color: rgba(45, 212, 191, 0.78);
		background: rgba(20, 184, 166, 0.2);
		color: rgb(240 253 250);
	}

	.chart-stage {
		position: relative;
		height: min(72vh, 760px);
		min-height: 420px;
		overflow: hidden;
		background: rgb(248 250 252);
		cursor: grab;
		touch-action: none;
	}

	.chart-stage:active {
		cursor: grabbing;
	}

	.chart-image {
		display: block;
		max-width: none;
		transform-origin: 0 0;
		user-select: none;
		will-change: transform;
	}

	.filter-field {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.35rem;
	}

	.filter-field span {
		font-size: 0.68rem;
		line-height: 1.2;
		color: var(--research-muted);
		text-transform: uppercase;
	}

	.filter-field input,
	.filter-field select {
		width: 100%;
		min-height: 2.35rem;
		border: 1px solid rgba(71, 85, 105, 0.82);
		background: rgba(2, 6, 23, 0.86);
		padding: 0.45rem 0.6rem;
		color: rgb(226 232 240);
		font-size: 0.82rem;
		line-height: 1.25;
	}

	.roster-table-wrap {
		max-height: 72vh;
		overflow: auto;
		background:
			linear-gradient(90deg, rgb(2 6 23), transparent 1.25rem) left/1.25rem 100% no-repeat,
			rgb(2 6 23);
		scrollbar-color: rgba(45, 212, 191, 0.48) rgba(15, 23, 42, 0.92);
	}

	.roster-table {
		--id-col-width: 4.25rem;
		--name-col-width: 18rem;
		width: 100%;
		min-width: 1560px;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 0.78rem;
		line-height: 1.42;
	}

	.sources-table-wrap .roster-table {
		min-width: 980px;
	}

	.roster-table th,
	.research-app :global(.roster-table td) {
		border-bottom: 1px solid rgba(30, 41, 59, 0.95);
		padding: 0.62rem 0.7rem;
		text-align: left;
		vertical-align: top;
	}

	.roster-table th {
		position: sticky;
		top: 0;
		z-index: 4;
		border-bottom-color: rgba(45, 212, 191, 0.28);
		background: rgb(15 23 42);
		box-shadow: inset 0 -1px 0 rgba(45, 212, 191, 0.24);
	}

	.roster-table th button {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: rgb(226 232 240);
		font-weight: 600;
		text-align: left;
	}

	.roster-table th button::after {
		content: '';
		width: 0.36rem;
		height: 0.36rem;
		border-right: 1px solid rgba(148, 163, 184, 0.65);
		border-bottom: 1px solid rgba(148, 163, 184, 0.65);
		opacity: 0.45;
		transform: rotate(45deg) translateY(-0.08rem);
	}

	.roster-table th button[data-sort-state='asc']::after {
		border-color: rgb(94 234 212);
		opacity: 1;
		transform: rotate(225deg) translateY(-0.08rem);
	}

	.roster-table th button[data-sort-state='desc']::after {
		border-color: rgb(94 234 212);
		opacity: 1;
	}

	.research-app :global(.roster-row) {
		--row-bg: rgb(2 6 23);
		--row-accent: rgba(100, 116, 139, 0.75);
		background: var(--row-bg);
		color: rgb(203 213 225);
		outline: none;
	}

	.research-app :global(.roster-table tbody tr:nth-child(odd)) {
		--row-bg: rgb(5 13 30);
	}

	.research-app :global(.roster-table tbody tr:nth-child(even)) {
		--row-bg: rgb(10 18 36);
	}

	.research-app :global(.roster-row-current),
	.research-app :global(.roster-row-official) {
		--row-accent: rgb(20 184 166);
	}

	.research-app :global(.roster-row-gap) {
		--row-accent: rgb(251 146 60);
	}

	.research-app :global(.roster-row-forecast) {
		--row-accent: rgb(245 158 11);
	}

	.research-app :global(.roster-row-historical) {
		--row-accent: rgb(148 163 184);
	}

	.research-app :global(.roster-row-unverified) {
		--row-accent: rgb(248 113 113);
	}

	.research-app :global(.roster-table tbody tr:hover),
	.research-app :global(.roster-table tbody tr:focus-visible),
	.research-app :global(.roster-row-selected) {
		--row-bg: rgb(20 32 55);
		box-shadow: inset 0 0 0 1px rgba(45, 212, 191, 0.2);
		color: rgb(241 245 249);
	}

	.roster-table th:nth-child(1),
	.roster-table th:nth-child(2),
	.research-app :global(.cell-id),
	.research-app :global(.cell-name) {
		position: sticky;
		background: inherit;
	}

	.roster-table th:nth-child(1),
	.roster-table th:nth-child(2) {
		z-index: 5;
		background: rgb(15 23 42);
	}

	.roster-table th:nth-child(1),
	.research-app :global(.cell-id) {
		left: 0;
		width: var(--id-col-width);
		min-width: var(--id-col-width);
		max-width: var(--id-col-width);
	}

	.roster-table th:nth-child(2),
	.research-app :global(.cell-name) {
		left: var(--id-col-width);
		width: var(--name-col-width);
		min-width: var(--name-col-width);
		max-width: var(--name-col-width);
		box-shadow: 1px 0 0 rgba(45, 212, 191, 0.12);
	}

	.research-app :global(.cell-id) {
		border-left: 3px solid var(--row-accent);
		color: rgb(148 163 184);
		font-variant-numeric: tabular-nums;
	}

	.research-app :global(.cell-name strong) {
		display: block;
		color: rgb(248 250 252);
		font-size: 0.84rem;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}

	.research-app :global(.cell-role),
	.research-app :global(.cell-evidence) {
		min-width: 22rem;
		color: rgb(226 232 240);
	}

	.research-app :global(.cell-entity),
	.research-app :global(.cell-type),
	.research-app :global(.cell-relation) {
		min-width: 13rem;
		color: rgb(204 251 241);
	}

	.research-app :global(.cell-domain),
	.research-app :global(.cell-confidence),
	.research-app :global(.cell-source-ref),
	.research-app :global(.cell-date),
	.research-app :global(.cell-code),
	.research-app :global(.cell-id) {
		color: rgb(148 163 184);
	}

	.research-app :global(.cell-code) {
		min-width: 9rem;
		font-variant-numeric: tabular-nums;
	}

	.research-app :global(.cell-confidence),
	.research-app :global(.cell-source-ref) {
		min-width: 8rem;
	}

	.research-app :global(.cell-source) {
		min-width: 9rem;
		white-space: nowrap;
	}

	.research-app :global(.status-badge) {
		display: inline-flex;
		align-items: center;
		min-height: 1.35rem;
		border: 1px solid rgba(148, 163, 184, 0.3);
		padding: 0.15rem 0.45rem;
		font-size: 0.68rem;
		line-height: 1.2;
		white-space: nowrap;
	}

	.research-app :global(.status-current),
	.research-app :global(.status-official) {
		border-color: rgba(45, 212, 191, 0.45);
		background: rgba(20, 184, 166, 0.16);
		color: rgb(204 251 241);
	}

