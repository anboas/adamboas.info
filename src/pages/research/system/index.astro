---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../../components/SurfacePageHeader.astro';
import { withBase } from '../../../utils/withBase';
import researchScriptUrl from '../../../scripts/research-cgcyber-iom.js?url';

const assetBase = '/research/system/';
const charts = [
	{
		id: 'pipeline',
		label: 'Pipeline',
		src: withBase(`${assetBase}research-system-pipeline.svg`),
		description:
			'Repeatable capture-intel pipeline: intake, evidence, maps, actions, publish, watch, deepen, and executive brief.',
		focusX: 0.5,
		focusY: 0.19,
	},
	{
		id: 'schema',
		label: 'Block Format',
		src: withBase(`${assetBase}research-system-schema.svg`),
		description:
			'Canonical research block schema: org/POCs, opportunities, contracts, companies, source register, and shared controls.',
		focusX: 0.5,
		focusY: 0.2,
	},
	{
		id: 'roadmap',
		label: 'Pursuit Roadmap',
		src: withBase(`${assetBase}research-system-roadmap.svg`),
		description:
			'Current build plan for NIWC PAC AA, CGCYBER IOM, NAE, the global research index table, deep dives, graphs, and watchlist automation.',
		focusX: 0.5,
		focusY: 0.2,
	},
];

const tableSections = [
	{
		id: 'org',
		title: 'Research System Modules',
		description:
			'The repeatable module set every future company, organization, opportunity, or market research block should produce.',
		countAttr: 'data-org-count',
		searchAttr: 'data-org-search',
		searchPlaceholder: 'Module, role, evidence, domain...',
		filterAttr: 'data-org-filter',
		filters: [
			['Domain', 'All domains'],
			['Status', 'All statuses'],
			['IOM Relevance', 'All uses'],
			['Confidence', 'All confidence'],
		],
		tableAttr: 'data-org-table',
		bodyAttr: 'data-org-body',
		sortAttr: 'data-org-sort-key',
		headers: [
			['ID', 'ID'],
			['Node', 'Module'],
			['Role', 'Role'],
			['Status', 'Status'],
			['IOM Relevance', 'Use'],
			['Code', 'Code'],
			['Domain', 'Domain'],
			['Type', 'Type'],
			['Evidence', 'Output standard'],
			['Confidence', 'Priority'],
			['Source Refs', 'Refs'],
			['Source URL', 'Source'],
		],
	},
	{
		id: 'contracts',
		title: 'Reusable Intake Template',
		description:
			'The minimum information model for starting a new research block from a company, organization, program, opportunity, or market phrase.',
		countAttr: 'data-contracts-count',
		searchAttr: 'data-contracts-search',
		searchPlaceholder: 'Target, buyer, incumbent, gaps...',
		filterAttr: 'data-contracts-filter',
		filters: [
			['Prime', 'All fields'],
			['Status', 'All statuses'],
			['IOM Seam / Relevance', 'All purposes'],
			['Confidence', 'All confidence'],
		],
		tableAttr: 'data-contracts-table',
		bodyAttr: 'data-contracts-body',
		sortAttr: 'data-contracts-sort-key',
		headers: [
			['ID', 'ID'],
			['Program', 'Field'],
			['Prime', 'What goes here'],
			['Status', 'Status'],
			['IOM Seam / Relevance', 'Purpose'],
			['Award / Forecast ID', 'Code'],
			['Value / Term', 'Example'],
			['Scope', 'Definition'],
			['Confidence', 'Priority'],
			['Source Refs', 'Refs'],
			['Source URL', 'Source'],
		],
	},
	{
		id: 'competitors',
		title: 'Current Pursuit Plans',
		description:
			'The concrete next-build queue for the research system and the three active pursuit blocks: NAE, CGCYBER IOM, and NIWC PAC AA.',
		countAttr: 'data-competitors-count',
		searchAttr: 'data-competitors-search',
		searchPlaceholder: 'Dashboard, deep dive, NAE, CGCYBER, NIWC...',
		filterAttr: 'data-competitors-filter',
		filters: [
			['Tier', 'All work types'],
			['Vehicle', 'All scopes'],
			['Confidence', 'All priorities'],
		],
		tableAttr: 'data-competitors-table',
		bodyAttr: 'data-competitors-body',
		sortAttr: 'data-competitors-sort-key',
		headers: [
			['ID', 'ID'],
			['Entity', 'Plan'],
			['Tier', 'Type'],
			['Recommended Posture', 'Timing'],
			['Power Base', 'What to build'],
			['Gap / Vulnerability', 'Dependency / gap'],
			['Vehicle', 'Scope'],
			['Confidence', 'Priority'],
			['Source Refs', 'Refs'],
			['Source URL', 'Source'],
		],
	},
	{
		id: 'sources',
		title: 'Source Register',
		description: 'Internal source anchors for the repeatable system and the current research blocks.',
		countAttr: 'data-sources-count',
		searchAttr: 'data-sources-search',
		searchPlaceholder: 'Source title, use, URL...',
		filterAttr: 'data-sources-filter',
		filters: [],
		tableAttr: 'data-sources-table',
		bodyAttr: 'data-sources-body',
		sortAttr: 'data-sources-sort-key',
		headers: [
			['ID', 'ID'],
			['Title', 'Title'],
			['Use', 'Use'],
			['URL', 'Source'],
		],
	},
];
---

<SiteLayout
	title="Research System"
	description="Private repeatable capture-intelligence system for public-source research blocks."
	noindex={true}
	nofollow={true}
>
	<section
		class="research-app"
		data-cgcyber-research
		data-org-csv-url={withBase(`${assetBase}research-system-modules.csv`)}
		data-contracts-csv-url={withBase(`${assetBase}research-system-intake-template.csv`)}
		data-competitors-csv-url={withBase(`${assetBase}research-system-pursuit-plans.csv`)}
		data-sources-csv-url={withBase(`${assetBase}research-system-source-register.csv`)}
	>
		<SurfacePageHeader
			stickyActive="none"
			eyebrowLinks={[{ label: 'Research', href: withBase('/research/') }, { label: 'System' }]}
			title="Research System"
			description="Repeatable public-source capture-intel machine: give it a company, organization, opportunity, or market, and it produces a noindex research block with evidence, maps, tables, gaps, and next actions."
		>
			<div slot="actions" class="flex flex-wrap gap-2">
				<a class="ui-link-btn ui-link-btn-primary" href={withBase(`${assetBase}research-system-modules.csv`)}
					>Modules CSV</a
				>
				<a class="ui-link-btn ui-link-btn-muted" href={withBase(`${assetBase}research-system-intake-template.csv`)}
					>Intake CSV</a
				>
				<a class="ui-link-btn ui-link-btn-muted" href={withBase(`${assetBase}research-system-pursuit-plans.csv`)}
					>Plans CSV</a
				>
			</div>
		</SurfacePageHeader>

		<div class="research-banner mt-3 border border-teal-400/20 bg-teal-950/20 p-3 text-xs leading-5 text-slate-300">
			<span class="font-semibold text-teal-100">Noindex operating manual.</span>
			This is the reusable format for future research blocks. It is excluded from sitemap/robots and is not linked from public
			navigation.
		</div>

		<nav class="research-jump mt-3" aria-label="Research section navigation">
			<a href={withBase('/research/')}>Research Index</a>
			<a href="#chart-title">Charts</a>
			<a href="#org-title">Modules</a>
			<a href="#contracts-title">Intake</a>
			<a href="#competitors-title">Plans</a>
			<a href="#sources-title">Sources</a>
			<a href={withBase('/research/niwc-pac/')}>NIWC PAC</a>
			<a href={withBase('/research/cgcyber-iom/')}>CGCYBER IOM</a>
			<a href={withBase('/research/naval-aviation-enterprise/')}>NAE</a>
		</nav>

		<section class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-5" aria-label="Research summary">
			<div class="metric-panel">
				<b>12</b>
				<span>System modules</span>
			</div>
			<div class="metric-panel">
				<b>12</b>
				<span>Intake fields</span>
			</div>
			<div class="metric-panel">
				<b>11</b>
				<span>Current plans</span>
			</div>
			<div class="metric-panel">
				<b>3</b>
				<span>Active pursuit blocks</span>
			</div>
			<div class="metric-panel">
				<b>1</b>
				<span>Global index table</span>
			</div>
		</section>

		<section class="mt-4 border border-slate-800 bg-slate-950/95" aria-labelledby="chart-title">
			<div class="flex flex-col gap-3 border-b border-slate-800 p-3 lg:flex-row lg:items-start lg:justify-between">
				<div class="min-w-0">
					<h2 id="chart-title" class="text-base font-semibold text-slate-50">System Charts</h2>
					<p class="mt-1 max-w-5xl text-xs leading-5 text-slate-400" data-chart-description>
						{charts[0].description}
					</p>
				</div>
				<div class="flex flex-wrap gap-2 text-xs" aria-label="Chart view controls">
					{
						charts.map((chart, index) => (
							<button
								class:list={['chart-tab', index === 0 && 'chart-tab-active']}
								type="button"
								data-chart-tab={chart.id}
								data-chart-src={chart.src}
								data-chart-tab-description={chart.description}
								data-chart-focus-x={chart.focusX}
								data-chart-focus-y={chart.focusY}
							>
								{chart.label}
							</button>
						))
					}
				</div>
			</div>

			<div class="chart-toolbar border-b border-slate-800 p-3">
				<div class="flex flex-wrap items-center gap-2">
					<button type="button" class="control-btn" data-chart-action="zoom-out">Zoom -</button>
					<button type="button" class="control-btn" data-chart-action="zoom-in">Zoom +</button>
					<button type="button" class="control-btn" data-chart-action="fit">Fit</button>
					<button type="button" class="control-btn" data-chart-action="reset">100%</button>
					<a class="control-btn no-underline" data-chart-download href={charts[0].src}>Open SVG</a>
					<span class="ui-pill" data-chart-zoom>100%</span>
				</div>
			</div>

			<div class="chart-stage" data-chart-stage>
				<img
					src={charts[0].src}
					alt="Research system capture-intelligence chart"
					class="chart-image"
					data-chart-image
					draggable="false"
				/>
			</div>
		</section>

		{
			tableSections.map((section) => (
				<section class="mt-4 border border-slate-800 bg-slate-950/95" aria-labelledby={`${section.id}-title`}>
					<div class="border-b border-slate-800 p-3">
						<div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
							<div class="min-w-0">
								<h2 id={`${section.id}-title`} class="text-base font-semibold text-slate-50">
									{section.title}
								</h2>
								<p class="mt-1 max-w-4xl text-xs leading-5 text-slate-400">{section.description}</p>
							</div>
							<div class="text-xs text-slate-400">
								<span {...{ [section.countAttr]: true }}>Loading...</span>
							</div>
						</div>

						<div class="mt-3 grid gap-2 md:grid-cols-2 xl:grid-cols-5">
							<label class="filter-field md:col-span-2 xl:col-span-1">
								<span>Search</span>
								<input type="search" {...{ [section.searchAttr]: true }} placeholder={section.searchPlaceholder} />
							</label>
							{section.filters.map(([key, label]) => (
								<label class="filter-field">
									<span>{key}</span>
									<select {...{ [section.filterAttr]: key }}>
										<option value="">{label}</option>
									</select>
								</label>
							))}
						</div>
					</div>

					<div class:list={['roster-table-wrap', `${section.id}-table-wrap`]}>
						<table class="roster-table" {...{ [section.tableAttr]: true }}>
							<thead>
								<tr>
									{section.headers.map(([key, label]) => (
										<th>
											<button type="button" {...{ [section.sortAttr]: key }}>
												{label}
											</button>
										</th>
									))}
								</tr>
							</thead>
							<tbody {...{ [section.bodyAttr]: true }}>
								<tr>
									<td colspan={section.headers.length} class="px-3 py-6 text-center text-sm text-slate-400">
										Loading...
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>
			))
		}
	</section>

	<script type="module" src={researchScriptUrl}></script>
</SiteLayout>

<style>
	.research-app {
		--research-border: rgba(51, 65, 85, 0.92);
		--research-muted: rgb(148 163 184);
	}

	.research-banner,
	.metric-panel,
	.chart-tab,
	.control-btn,
	.filter-field input,
	.filter-field select {
		border-radius: 0;
	}

	.research-jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		border: 1px solid rgba(51, 65, 85, 0.92);
		background: rgba(2, 6, 23, 0.86);
		padding: 0.65rem;
	}

	.research-jump a {
		border: 1px solid rgba(71, 85, 105, 0.88);
		padding: 0.35rem 0.65rem;
		color: rgb(203 213 225);
		font-size: 0.75rem;
		line-height: 1.2;
		text-decoration: none;
	}

	.research-jump a:hover,
	.research-jump a:focus-visible {
		border-color: rgba(45, 212, 191, 0.65);
		color: rgb(240 253 250);
	}

	.metric-panel {
		border: 1px solid var(--research-border);
		background: rgb(2 6 23);
		padding: 0.85rem;
	}

	.metric-panel b {
		display: block;
		font-size: 1.42rem;
		line-height: 1.1;
		color: rgb(248 250 252);
	}

	.metric-panel span {
		margin-top: 0.25rem;
		display: block;
		font-size: 0.7rem;
		line-height: 1.25;
		color: var(--research-muted);
		text-transform: uppercase;
	}

	.chart-tab,
	.control-btn {
		min-height: 2rem;
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgba(2, 6, 23, 0.88);
		padding: 0.35rem 0.65rem;
		color: rgb(203 213 225);
		line-height: 1.2;
	}

	.chart-tab:hover,
	.control-btn:hover {
		border-color: rgba(45, 212, 191, 0.65);
		color: rgb(240 253 250);
	}

	.chart-tab-active {
		border-color: rgba(45, 212, 191, 0.78);
		background: rgba(20, 184, 166, 0.2);
		color: rgb(240 253 250);
	}

	.chart-stage {
		position: relative;
		height: min(68vh, 680px);
		min-height: 390px;
		overflow: hidden;
		background: rgb(248 250 252);
		cursor: grab;
		touch-action: none;
	}

	.chart-stage:active {
		cursor: grabbing;
	}

	.chart-image {
		display: block;
		max-width: none;
		transform-origin: 0 0;
		user-select: none;
		will-change: transform;
	}

	.filter-field {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.35rem;
	}

	.filter-field span {
		font-size: 0.68rem;
		line-height: 1.2;
		color: var(--research-muted);
		text-transform: uppercase;
	}

	.filter-field input,
	.filter-field select {
		width: 100%;
		min-height: 2.35rem;
		border: 1px solid rgba(71, 85, 105, 0.82);
		background: rgba(2, 6, 23, 0.86);
		padding: 0.45rem 0.6rem;
		color: rgb(226 232 240);
		font-size: 0.82rem;
		line-height: 1.25;
	}

	.roster-table-wrap {
		max-height: 72vh;
		overflow: auto;
		background: rgb(2 6 23);
		scrollbar-color: rgba(45, 212, 191, 0.48) rgba(15, 23, 42, 0.92);
	}

	.roster-table {
		--id-col-width: 4.25rem;
		--name-col-width: 18rem;
		width: 100%;
		min-width: 1480px;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 0.78rem;
		line-height: 1.42;
	}

	.sources-table-wrap .roster-table {
		min-width: 980px;
	}

	.roster-table th,
	.research-app :global(.roster-table td) {
		border-bottom: 1px solid rgba(30, 41, 59, 0.95);
		padding: 0.62rem 0.7rem;
		text-align: left;
		vertical-align: top;
	}

	.roster-table th {
		position: sticky;
		top: 0;
		z-index: 4;
		border-bottom-color: rgba(45, 212, 191, 0.28);
		background: rgb(15 23 42);
		box-shadow: inset 0 -1px 0 rgba(45, 212, 191, 0.24);
	}

	.roster-table th button {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		border: 0;
		background: transparent;
		padding: 0;
		color: rgb(226 232 240);
		font: inherit;
		font-weight: 700;
	}

	.roster-table th button::after {
		content: '↕';
		color: rgb(100 116 139);
		font-size: 0.68rem;
	}

	.roster-table th button[data-sort-state='asc']::after {
		content: '↑';
		color: rgb(45 212 191);
	}

	.roster-table th button[data-sort-state='desc']::after {
		content: '↓';
		color: rgb(45 212 191);
	}

	.roster-table th:nth-child(1),
	.research-app :global(.roster-table td:nth-child(1)) {
		position: sticky;
		left: 0;
		z-index: 3;
		width: var(--id-col-width);
		min-width: var(--id-col-width);
	}

	.roster-table th:nth-child(2),
	.research-app :global(.roster-table td:nth-child(2)) {
		position: sticky;
		left: var(--id-col-width);
		z-index: 3;
		width: var(--name-col-width);
		min-width: var(--name-col-width);
		box-shadow: 1px 0 0 rgba(45, 212, 191, 0.18);
	}

	.roster-table th:nth-child(1),
	.roster-table th:nth-child(2) {
		z-index: 5;
	}

	.research-app :global(.roster-row) {
		background: rgb(2 6 23);
		box-shadow: inset 3px 0 0 rgba(71, 85, 105, 0.72);
	}

	.research-app :global(.roster-row:nth-child(even)) {
		background: rgb(8 13 27);
	}

	.research-app :global(.roster-row:hover),
	.research-app :global(.roster-row-selected) {
		background: rgb(12 24 40);
		box-shadow: inset 3px 0 0 rgba(45, 212, 191, 0.95);
	}

	.research-app :global(.roster-row td:nth-child(1)),
	.research-app :global(.roster-row td:nth-child(2)) {
		background: inherit;
	}

	.research-app :global(.cell-name strong) {
		color: rgb(248 250 252);
	}

	.research-app :global(.status-badge) {
		display: inline-flex;
		max-width: 100%;
		border: 1px solid rgba(148, 163, 184, 0.32);
		padding: 0.18rem 0.4rem;
		background: rgba(15, 23, 42, 0.92);
		color: rgb(226 232 240);
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.research-app :global(.status-current),
	.research-app :global(.status-official) {
		border-color: rgba(45, 212, 191, 0.48);
		color: rgb(204 251 241);
	}

	.research-app :global(.status-gap),
	.research-app :global(.status-forecast) {
		border-color: rgba(245, 158, 11, 0.5);
		color: rgb(253 230 138);
	}

	.research-app :global(.source-link) {
		color: rgb(94 234 212);
		text-decoration: none;
	}

	.research-app :global(.source-link:hover) {
		text-decoration: underline;
	}

	@media (max-width: 720px) {
		.chart-stage {
			height: 58vh;
			min-height: 360px;
		}

		.roster-table {
			--name-col-width: 14rem;
			min-width: 1320px;
		}
	}
</style>
