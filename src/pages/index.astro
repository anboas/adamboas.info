---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const roles = [
	{ company: 'KBR', title: 'Solutions Architect', period: '2025–present' },
	{ company: 'Booz Allen Hamilton', title: 'Solutions Architect', period: '2024–2025' },
	{ company: 'KBR', title: 'Solutions Architect', period: '2022–2024' },
	{ company: 'Booz Allen Hamilton', title: 'Solutions Architect', period: '2019–2022' },
	{ company: 'KBRwyle', title: 'Cloud Architect / Site Reliability Engineer', period: '2018–2019' },
	{ company: 'KBRwyle', title: 'Architecture Analyst / Software Engineer', period: '2018' },
	{ company: 'KBR', title: 'Software Engineer', period: '2015–2018' },
	{ company: 'Fast DAS', title: 'Jr. RF Engineer', period: '2015' },
	{ company: 'Kerry Group', title: 'Programming Consultant', period: '2014' },
	{ company: 'Central Florida Health Alliance', title: 'Programming Consultant', period: '2014' },
];

const certs = [
	{
		issuer: 'University of Maryland Global Campus',
		name: 'Bachelor of Science — Cybersecurity Management and Policy',
		year: '2023',
	},
	{ issuer: 'Amazon Web Services', name: 'AWS Certified Cloud Practitioner', year: '2019' },
	{ issuer: 'Amazon Web Services', name: 'AWS Certified Solutions Architect - Associate', year: '2019' },
	{ issuer: 'HP Enterprise (HPE)', name: 'HP ASE - FORTIFY V1', year: '2016' },
	{ issuer: 'ScrumAlliance', name: 'CERTIFIED SCRUMMASTER', year: '2016' },
	{ issuer: 'College of Southern Maryland', name: 'ASSOCIATE OF SCIENCE - COMPUTER SCIENCE', year: '2013–2015' },
	{ issuer: 'James A. Forest Career and Technology Center', name: 'CCNA Exploration: Networking Fundamentals 4.0', year: '2010–2011' },
];

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<a id="page-top" class="block" aria-hidden="true"></a>

	<section class="card p-8">
		<div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
			<div class="max-w-2xl">
				<h1 class="text-3xl font-semibold tracking-tight text-slate-50">Adam Boas</h1>
				<p class="mt-2 text-slate-400">Solutions Architect</p>
				<p class="mt-4 text-lg text-slate-300">
					Autonomy, governance, and systems that actually ship.
				</p>
			</div>
			<div class="flex gap-3">
				<a
					href="#experience"
					class="rounded-none border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-100 hover:bg-slate-900"
				>
					Experience
				</a>
				<a
					href="#writing"
					class="rounded-none border border-slate-700 bg-slate-900/40 px-4 py-2 text-sm font-semibold text-stone-100 hover:bg-slate-900"
				>
					Writing
				</a>
			</div>
		</div>
	</section>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		<section class="card p-6">
			<h2 class="section-title">Focus</h2>
			<ul class="mt-3 space-y-2 text-sm text-slate-300">
				<li>Agent governance and control planes</li>
				<li>Policy-as-code and trust scopes</li>
				<li>Operational reliability under adversarial pressure</li>
				<li>Automation that is auditable and reversible</li>
			</ul>
		</section>
		<section class="card p-6">
			<h2 class="section-title">Artifacts</h2>
			<p class="mt-3 text-sm text-slate-300">Whitepapers and working docs.</p>
			<p class="mt-4">
				<a href="#writing" class="text-sm font-semibold">Browse writing →</a>
			</p>
		</section>
		<section class="card p-6">
			<h2 class="section-title">Contact</h2>
			<p class="mt-3 text-sm text-slate-300">Email is best.</p>
			<p class="mt-4 text-sm"><a href="mailto:anboas@gmail.com">anboas@gmail.com</a></p>
		</section>
	</div>

	<section id="experience" class="mt-10">
		<div class="card p-6">
			<h2 class="text-xl font-semibold text-slate-50">Experience</h2>

			<div class="mt-6 overflow-hidden rounded-none border border-slate-800">
				<table class="w-full border-collapse text-sm">
					<thead class="bg-slate-950/60">
						<tr>
							<th class="px-4 py-3 text-left font-semibold text-slate-200">Company</th>
							<th class="px-4 py-3 text-left font-semibold text-slate-200">Role</th>
							<th class="px-4 py-3 text-right font-semibold text-slate-200">Period</th>
						</tr>
					</thead>
					<tbody>
						{roles.map((r) => (
							<tr class="border-t border-slate-800">
								<td class="px-4 py-3 text-slate-100">{r.company}</td>
								<td class="px-4 py-3 text-slate-300">{r.title}</td>
								<td class="px-4 py-3 text-right text-slate-400">{r.period}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section id="education" class="mt-10">
		<div class="card p-6">
			<h2 class="text-xl font-semibold text-slate-50">Education</h2>

			<ul class="mt-6 space-y-3 text-sm">
				{certs.map((c) => (
					<li class="flex flex-col gap-1 border-b border-slate-800 pb-3 md:flex-row md:items-baseline md:justify-between">
						<span class="text-slate-50">{c.name}</span>
						<span class="text-slate-400">{c.issuer}{c.year ? ` • ${c.year}` : ''}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section id="writing" class="mt-10">
		<div class="card p-6">
			<h2 class="text-xl font-semibold text-slate-50">Writing</h2>

			<div class="mt-6 grid gap-4">
				{papers.map((p) => (
					<a class="card block p-5 hover:border-slate-700" href={`${import.meta.env.BASE_URL}papers/${p.id}/`}>
						<div class="flex items-baseline justify-between gap-4">
							<div class="min-w-0">
								<div class="flex items-baseline gap-2">
									<span class="rounded-none border border-slate-700 bg-slate-950/40 px-2 py-0.5 text-[10px] uppercase tracking-wide text-slate-300">Paper</span>
									<h3 class="truncate text-base font-semibold text-slate-50">{p.data.title}</h3>
								</div>
								{p.data.description && <p class="mt-2 text-sm text-slate-300">{p.data.description}</p>}
							</div>
							{p.data.date && <span class="shrink-0 text-xs text-slate-400">{p.data.date.toISOString().slice(0, 10)}</span>}
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Blog section merged into Writing -->
</SiteLayout>
