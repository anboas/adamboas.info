---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { absoluteUrl, contactMailto } from '../config/site';
import { withBase } from '../utils/withBase';
import WritingCompactCard from '../components/WritingCompactCard.astro';
import {
	PERSON_DESCRIPTION,
	PERSON_ID,
	PERSON_IMAGE_PATH,
	PERSON_JOB_TITLE,
	PERSON_KNOWS_ABOUT,
	PERSON_NAME,
	PERSON_SAME_AS,
} from '../data/entity';

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));

const homepageWriting = [
	...writing.map((w) => ({
		slug: w.id.split('/').pop(),
		type: w.data.type,
		title: w.data.title,
		description: w.data.summary,
		tags: w.data.tags ?? [],
		hasAudio: Boolean(w.data.audioPath),
		date: w.data.date,
	})),
	...papers.map((p) => ({
		slug: p.id,
		type: 'paper',
		title: p.data.title,
		description: p.data.description,
		tags: p.data.tags ?? [],
		hasAudio: Boolean(p.data.audioPath),
		date: p.data.date,
	})),
]
	.filter((x) => !!x.slug)
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0));

const featuredOrder = [
	'2026-07-31-digital-engineering-not-a-department',
	'2026-07-30-missing-operating-system-defense-growth',
	'2026-07-30-technology-insertion-management-system',
];
const featuredFromOrder = featuredOrder.map((slug) => homepageWriting.find((w) => w.slug === slug)).filter(Boolean);
const featuredFill = homepageWriting
	.filter((w) => !featuredOrder.includes(String(w.slug)))
	.slice(0, Math.max(0, 3 - featuredFromOrder.length));
const featuredReading = [...featuredFromOrder, ...featuredFill].slice(0, 3);

const siteUrl = absoluteUrl('/');
const writingSearchTarget = new URL(withBase('/writing/?q={search_term_string}'), Astro.site).toString();

const HOME_TITLE = `${PERSON_NAME} | Defense Technology Strategy and Writing`;
const HOME_DESCRIPTION = PERSON_DESCRIPTION;
---

<SiteLayout title={HOME_TITLE} description={HOME_DESCRIPTION} image="/og/home.png">
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			'@id': PERSON_ID,
			name: PERSON_NAME,
			url: siteUrl,
			sameAs: PERSON_SAME_AS,
			jobTitle: PERSON_JOB_TITLE,
			description: HOME_DESCRIPTION,
			image: absoluteUrl(PERSON_IMAGE_PATH),
			mainEntityOfPage: siteUrl,
			knowsAbout: PERSON_KNOWS_ABOUT,
		})}
	/>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			url: siteUrl,
			potentialAction: {
				'@type': 'SearchAction',
				target: writingSearchTarget,
				'query-input': 'required name=search_term_string',
			},
		})}
	/>
	<a id="page-top" class="block" aria-hidden="true"></a>

	<section class="card p-6 sm:p-8">
		<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start">
			<div class="max-w-4xl">
				<p class="home-kicker">Defense technology strategy</p>
				<h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">{PERSON_NAME}</h1>
				<p class="mt-2 text-base text-slate-400">{PERSON_JOB_TITLE}</p>
				<p class="mt-5 text-lg leading-relaxed text-slate-200">
					I write and work where mission needs, software, AI, policy, acquisition, and delivery have to become one
					operational system.
				</p>
				<p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-400">
					My focus is practical defense modernization: understanding the real program problem, shaping credible
					technical paths, and moving useful capability from idea to adoption.
				</p>
				<div class="mt-5 flex flex-wrap items-center gap-3">
					<a href={withBase('/writing/')} class="ui-link-btn ui-link-btn-primary px-4 text-sm font-semibold">
						Read writing
					</a>
					<a href={withBase('/profile/')} class="ui-link-btn px-4 text-sm font-semibold">Profile and resume</a>
					<a data-track="Contact: Email Click" href={contactMailto()} class="ui-link-btn px-4 text-sm font-semibold">
						Contact
					</a>
				</div>
			</div>
			<div class="border border-slate-800 bg-slate-950/40 p-4">
				<h2 class="section-title">Focus</h2>
				<ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-300">
					<li>Defense growth and technical capture</li>
					<li>Technology transition and mission discovery</li>
					<li>Governed AI, software, data, and modernization</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="mt-6 card p-6">
		<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
			<h2 class="section-title">Featured Writing</h2>
			<a href={withBase('/writing/')} class="text-sm font-semibold text-stone-100 hover:text-stone-50"
				>Browse all writing -></a
			>
		</div>
		<div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
			{featuredReading.map((w) => <WritingCompactCard item={w} showTopicCount={false} />)}
		</div>
	</section>

	<section class="mt-6 card p-6">
		<div class="grid gap-5 md:grid-cols-2">
			<div>
				<h2 class="section-title">Tools</h2>
				<ul class="mt-3 space-y-2 text-sm text-slate-300">
					<li>
						<a
							class="font-semibold text-stone-100 hover:text-stone-50"
							href="https://policy-intelligence-full.pages.dev/">Policy Intelligence</a>
					</li>
					<li>
						<a
							class="font-semibold text-stone-100 hover:text-stone-50"
							href="https://opportunity-intelligence-full.pages.dev/">Opportunity Intelligence</a>
					</li>
					<li>
						<a class="font-semibold text-stone-100 hover:text-stone-50" href={withBase('/opportunities/')}
							>Opportunities</a>
					</li>
					<li><a class="font-semibold text-stone-100 hover:text-stone-50" href={withBase('/events/')}>Events</a></li>
				</ul>
			</div>
			<div>
				<h2 class="section-title">Profile</h2>
				<p class="mt-3 text-sm leading-relaxed text-slate-300">
					Background, selected experience, credentials, speaking, and resume.
				</p>
				<div class="mt-4 flex flex-wrap gap-3">
					<a href={withBase('/profile/')} class="ui-link-btn px-3 text-sm font-semibold">Open profile</a>
					<a href={withBase('/files/adam-boas-resume.pdf')} class="ui-link-btn px-3 text-sm font-semibold">
						Resume PDF
					</a>
				</div>
			</div>
		</div>
	</section>
</SiteLayout>

<style>
	.home-kicker {
		font-size: 0.62rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: rgba(148, 163, 184, 0.94);
	}
</style>
