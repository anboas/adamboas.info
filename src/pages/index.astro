---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { absoluteUrl, contactMailto } from '../config/site';
import { withBase } from '../utils/withBase';
import WritingCompactCard from '../components/WritingCompactCard.astro';
import {
	PERSON_DESCRIPTION,
	PERSON_ID,
	PERSON_IMAGE_PATH,
	PERSON_JOB_TITLE,
	PERSON_KNOWS_ABOUT,
	PERSON_NAME,
	PERSON_SAME_AS,
} from '../data/entity';

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));

const homepageWriting = [
	...writing.map((w) => ({
		slug: w.id.split('/').pop(),
		type: w.data.type,
		title: w.data.title,
		description: w.data.summary,
		tags: w.data.tags ?? [],
		hasAudio: Boolean(w.data.audioPath),
		date: w.data.date,
	})),
	...papers.map((p) => ({
		slug: p.id,
		type: 'paper',
		title: p.data.title,
		description: p.data.description,
		tags: p.data.tags ?? [],
		hasAudio: Boolean(p.data.audioPath),
		date: p.data.date,
	})),
]
	.filter((x) => !!x.slug)
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0));

const featuredOrder = [
	'2026-07-31-digital-engineering-not-a-department',
	'2026-07-30-missing-operating-system-defense-growth',
	'2026-07-30-technology-insertion-management-system',
];
const featuredFromOrder = featuredOrder.map((slug) => homepageWriting.find((w) => w.slug === slug)).filter(Boolean);
const featuredFill = homepageWriting
	.filter((w) => !featuredOrder.includes(String(w.slug)))
	.slice(0, Math.max(0, 3 - featuredFromOrder.length));
const featuredReading = [...featuredFromOrder, ...featuredFill].slice(0, 3);

const siteUrl = absoluteUrl('/');
const writingSearchTarget = new URL(withBase('/writing/?q={search_term_string}'), Astro.site).toString();

const HOME_TITLE = `${PERSON_NAME} | Defense Technology Strategy, Mission Systems & Modernization`;
const HOME_DESCRIPTION = PERSON_DESCRIPTION;
---

<SiteLayout title={HOME_TITLE} description={HOME_DESCRIPTION} image="/og/home.png">
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			'@id': PERSON_ID,
			name: PERSON_NAME,
			url: siteUrl,
			sameAs: PERSON_SAME_AS,
			jobTitle: PERSON_JOB_TITLE,
			description: HOME_DESCRIPTION,
			image: absoluteUrl(PERSON_IMAGE_PATH),
			mainEntityOfPage: siteUrl,
			knowsAbout: PERSON_KNOWS_ABOUT,
		})}
	/>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			url: siteUrl,
			potentialAction: {
				'@type': 'SearchAction',
				target: writingSearchTarget,
				'query-input': 'required name=search_term_string',
			},
		})}
	/>
	<a id="page-top" class="block" aria-hidden="true"></a>

	<section class="card p-8">
		<div class="flex flex-col gap-6">
			<div class="w-full max-w-4xl">
				<h1 class="text-3xl font-semibold tracking-tight text-slate-50">{PERSON_NAME}</h1>
				<p class="mt-2 text-slate-400">{PERSON_JOB_TITLE}</p>
				<p class="mt-4 text-lg leading-relaxed text-slate-300">
					I connect policy, mission engineering, software, data, AI, and acquisition to move defense capabilities from
					strategic intent to operational use.
				</p>
				<p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-400">
					My work spans enterprise modernization, technical capture, technology insertion, governed autonomy, and the
					operating systems required to identify, shape, deliver, and scale mission capability.
				</p>
				<div class="mt-5 flex flex-wrap items-center gap-3">
					<a href={withBase('/strategic-work/')} class="ui-link-btn ui-link-btn-primary px-4 text-sm font-semibold">
						View strategic work
					</a>
					<a href={withBase('/capabilities/')} class="ui-link-btn px-4 text-sm font-semibold">Explore capabilities</a>
					<a data-track="Contact: Email Click" href={contactMailto()} class="ui-link-btn px-4 text-sm font-semibold"
						>Contact</a
					>
				</div>
			</div>
		</div>
	</section>

	<section class="mt-6 card p-6">
		<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
			<h2 class="section-title">Selected Strategic Work</h2>
			<a href={withBase('/strategic-work/')} class="text-sm font-semibold text-stone-100 hover:text-stone-50">
				View all →
			</a>
		</div>
		<div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
			<article class="border border-slate-800 bg-slate-950/40 p-4">
				<p class="home-kicker">Growth strategy</p>
				<h3 class="mt-2 text-sm font-bold text-slate-50">Defense growth and technical capture</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-300">
					Opportunity sensing, solution shaping, proposal architecture, discriminators, and stakeholder alignment.
				</p>
			</article>
			<article class="border border-slate-800 bg-slate-950/40 p-4">
				<p class="home-kicker">Technology transition</p>
				<h3 class="mt-2 text-sm font-bold text-slate-50">Technology insertion and mission discovery</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-300">
					Program immersion, operational problem framing, integration constraints, and scale/stop evidence.
				</p>
			</article>
			<article class="border border-slate-800 bg-slate-950/40 p-4">
				<p class="home-kicker">Policy modernization</p>
				<h3 class="mt-2 text-sm font-bold text-slate-50">From PDFs to Pull Requests</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-300">
					A public architecture for turning policy into governed, testable, executable delivery constraints.
				</p>
			</article>
			<article class="border border-slate-800 bg-slate-950/40 p-4">
				<p class="home-kicker">Technical architecture</p>
				<h3 class="mt-2 text-sm font-bold text-slate-50">Agent Control Plane Reference Architecture</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-300">
					Bounded autonomy, trust scopes, evidence, and continuous assurance for high-consequence operations.
				</p>
			</article>
		</div>
	</section>

	<section class="mt-6 card p-6">
		<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
			<h2 class="section-title">Featured Reading</h2>
			<div class="flex flex-wrap items-center gap-3 text-sm font-semibold">
				<a href={withBase('/writing/')} class="text-stone-100 hover:text-stone-50">All writing →</a>
			</div>
		</div>
		<div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
			{featuredReading.map((w) => <WritingCompactCard item={w} showTopicCount={false} />)}
		</div>
	</section>

	<div class="mt-6 grid gap-6 md:grid-cols-2">
		<section class="card p-6">
			<h2 class="section-title">Operating Principles</h2>
			<ul class="mt-3 space-y-2 text-[0.94rem] leading-relaxed text-slate-300">
				<li>
					<span class="text-slate-100">Mission outcomes over technology novelty</span>: the operational problem sets the
					architecture
				</li>
				<li>
					<span class="text-slate-100">Operational truth before executive narrative</span>: no story without program
					immersion and evidence
				</li>
				<li>
					<span class="text-slate-100">Transition pathways before isolated demonstrations</span>: ownership, funding,
					integration, and acceptance criteria matter early
				</li>
				<li>
					<span class="text-slate-100">Control planes over disconnected point solutions</span>: authority, policy, data,
					and telemetry need system boundaries
				</li>
				<li>
					<span class="text-slate-100">Evidence-based capture and delivery</span>: claims should survive proposal,
					transition, and execution
				</li>
				<li>
					<span class="text-slate-100">Repeatable systems over heroic intervention</span>: useful organizations learn
					across programs
				</li>
			</ul>
		</section>

		<section class="card p-6">
			<h2 class="section-title">Work With Me</h2>
			<p class="mt-3 text-[0.94rem] leading-relaxed text-slate-300">
				Support for defense executives and technical teams that need to connect mission demand, technical architecture,
				acquisition realities, and delivery evidence.
			</p>
			<ul class="mt-4 space-y-2 text-[0.94rem] leading-relaxed text-slate-300">
				<li>
					<span class="text-slate-100">Strategy and solutioning</span> (opportunity framing, architecture, win themes)
				</li>
				<li>
					<span class="text-slate-100">Modernization and transition</span> (software, cloud, data, digital engineering)
				</li>
				<li><span class="text-slate-100">Governed AI and autonomy</span> (trust scopes, policy gates, evidence)</li>
				<li>
					<span class="text-slate-100">Capture and proposals</span> (technical volumes, white papers, discriminators)
				</li>
			</ul>
			<div class="mt-5 flex flex-wrap gap-3">
				<a
					href={withBase('/capabilities/')}
					class="ui-link-btn bg-slate-900/40 px-3 text-sm font-semibold text-slate-100">Explore capabilities</a
				>
				<a
					data-track="Contact: Intake Click"
					href={withBase('/contact/')}
					class="ui-link-btn px-3 text-sm font-semibold">Contact</a
				>
			</div>
			<p class="mt-3 text-xs text-slate-400">
				Background: <a href={withBase('/profile/')} class="text-slate-300 hover:text-slate-100">Profile</a> · <a
					href={withBase('/speaking/')}
					class="text-slate-300 hover:text-slate-100">Speaking</a
				> · <a href={withBase('/files/adam-boas-resume.pdf')} class="text-slate-300 hover:text-slate-100">Resume PDF</a>
			</p>
		</section>
	</div>

	<!-- Blog section merged into Writing -->
</SiteLayout>

<style>
	.home-kicker {
		font-size: 0.62rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: rgba(148, 163, 184, 0.94);
	}
</style>
