---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { education, experience } from '../data/resume';

const roles = experience;
const certs = education;

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));

// Show a small slice on the homepage.
const homepageWriting = [
	...writing.map((w) => ({
		slug: w.id.split('/').pop(),
		type: w.data.type,
		title: w.data.title,
		description: w.data.summary,
		date: w.data.date,
	})),
	...papers.map((p) => ({
		slug: p.id,
		type: 'paper',
		title: p.data.title,
		description: p.data.description,
		date: p.data.date,
	})),
]
	.filter((x) => !!x.slug)
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0))
	.slice(0, 8);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: 'Adam Boas',
			url: 'https://adamboas.info/',
			sameAs: ['https://github.com/anboas'],
			jobTitle: 'Solutions Architect',
			description: SITE_DESCRIPTION,
		})}
	/>
	<a id="page-top" class="block" aria-hidden="true"></a>

	<section class="card p-8">
		<div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
			<div class="max-w-2xl">
				<h1 class="text-3xl font-semibold tracking-tight text-slate-50">Adam Boas</h1>
				<p class="mt-2 text-slate-400">Solutions Architect</p>
				<p class="mt-4 text-lg text-slate-300">
					Warfighter lethality through trusted autonomy, control planes, and execution at tempo.
				</p>
			</div>
			<div class="flex gap-3">
				<a
					href="#writing"
					class="rounded-none border border-slate-700 bg-slate-900/40 px-4 py-2 text-sm font-semibold text-stone-100 hover:bg-slate-900"
				>
					Writing
				</a>
				<a
					href="#experience"
					class="rounded-none border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-100 hover:bg-slate-900"
				>
					Experience
				</a>
				<a
					href="#education"
					class="rounded-none border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-100 hover:bg-slate-900"
				>
					Education
				</a>
			</div>
		</div>
	</section>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		<section class="card p-6">
			<h2 class="section-title">Focus</h2>
			<ul class="mt-3 space-y-2 text-sm text-slate-300">
				<li><span class="text-slate-100">Control planes</span> that bound autonomy with policy, budgets, and audit</li>
				<li><span class="text-slate-100">Trust scopes</span> that make delegation safe in contested environments</li>
				<li><span class="text-slate-100">Adversarial reliability</span>: resilience under deception, drift, and failure</li>
				<li><span class="text-slate-100">Execution at tempo</span>: systems that ship and keep shipping</li>
			</ul>
		</section>
		<section class="card p-6">
			<h2 class="section-title">Artifacts</h2>
			<p class="mt-3 text-sm text-slate-300">Notes, memos, and papers.</p>
			<ul class="mt-4 space-y-2 text-sm text-slate-300">
				<li><span class="text-slate-100">Notes</span> for sharp takes and field lessons</li>
				<li><span class="text-slate-100">Memos</span> for actionable briefs</li>
				<li><span class="text-slate-100">Papers</span> for full arguments + PDFs</li>
			</ul>
			<p class="mt-4">
				<a href={`${import.meta.env.BASE_URL}writing/`} class="text-sm font-semibold">Browse writing →</a>
			</p>
		</section>
		<section class="card p-6">
			<h2 class="section-title">Contact</h2>
			<p class="mt-3 text-sm text-slate-300">Email is best.</p>
			<p class="mt-4 text-sm"><a data-track="Contact: Email Click" href="mailto:anboas@gmail.com">anboas@gmail.com</a></p>
		</section>
	</div>

	<section id="writing" class="mt-10">
		<div class="card p-6">
			<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
				<h2 class="text-xl font-semibold text-slate-50">Writing</h2>
				<a href={`${import.meta.env.BASE_URL}writing/`} class="text-sm font-semibold text-stone-100 hover:text-stone-50">
					All writing →
				</a>
			</div>

			<div class="mt-6 grid gap-4">
				{homepageWriting.map((w) => (
					<a class="card block overflow-hidden p-5 hover:border-slate-700" href={`${import.meta.env.BASE_URL}writing/${w.slug}/`}>
						<div class="flex items-baseline justify-between gap-4">
							<div class="min-w-0">
								<div class="flex min-w-0 items-baseline gap-2">
									<span class="rounded-none border border-slate-700 bg-slate-900/60 px-2 py-0.5 text-[10px] uppercase tracking-wide text-slate-200">
										{w.type}
									</span>
									<h3 class="min-w-0 truncate text-base font-semibold text-slate-50">{w.title}</h3>
								</div>
								{w.description && <p class="clamp-3 mt-2 break-words text-sm text-slate-300">{w.description}</p>}
							</div>
							{w.date && <span class="shrink-0 text-xs text-slate-400">{w.date.toISOString().slice(0, 10)}</span>}
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section id="experience" class="mt-10">
		<div class="card p-6">
			<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
				<h2 class="text-xl font-semibold text-slate-50">Experience</h2>
				<a href={`${import.meta.env.BASE_URL}experience/`} class="text-sm font-semibold text-stone-100 hover:text-stone-50">
					Experience pages →
				</a>
			</div>

			<div class="mt-6 grid gap-3 md:hidden">
					{roles.map((r) => (
						<div class="card p-4">
							<div class="flex items-baseline justify-between gap-3">
								<span class="min-w-0 truncate font-semibold text-slate-50">{r.company}</span>
								<span class="shrink-0 text-xs text-slate-400">{r.period}</span>
							</div>
							<p class="mt-1 text-sm text-slate-300">{r.title}</p>
						</div>
					))}
				</div>

				<div class="mt-6 hidden overflow-hidden rounded-none border border-slate-800 md:block">
				<table class="w-full border-collapse text-sm">
					<thead class="bg-slate-950/60">
						<tr>
							<th class="px-4 py-3 text-left font-semibold text-slate-200">Company</th>
							<th class="px-4 py-3 text-left font-semibold text-slate-200">Role</th>
							<th class="px-4 py-3 text-right font-semibold text-slate-200">Period</th>
						</tr>
					</thead>
					<tbody>
						{roles.map((r) => (
							<tr class="border-t border-slate-800">
								<td class="px-4 py-3 text-slate-100">{r.company}</td>
								<td class="px-4 py-3 text-slate-300">{r.title}</td>
								<td class="px-4 py-3 text-right text-slate-400">{r.period}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section id="education" class="mt-10">
		<div class="card p-6">
			<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
				<h2 class="text-xl font-semibold text-slate-50">Education</h2>
				<a href={`${import.meta.env.BASE_URL}education/`} class="text-sm font-semibold text-stone-100 hover:text-stone-50">
					Education pages →
				</a>
			</div>

			<ul class="mt-6 space-y-3 text-sm">
				{certs.map((c) => (
					<li class="flex flex-col gap-1 border-b border-slate-800 pb-3 md:flex-row md:items-baseline md:justify-between">
						<span class="text-slate-50">{c.name}</span>
						<span class="text-slate-400">{c.issuer}{c.year ? ` • ${c.year}` : ''}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Blog section merged into Writing -->
</SiteLayout>
