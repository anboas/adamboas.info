---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CONTACT_PHONE, RESUME_CLEARANCE, education, experience } from '../data/resume';
import { withBase } from '../utils/withBase';
import WritingCompactCard from '../components/WritingCompactCard.astro';

const roles = experience;
const certs = education;

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));

// Show a small slice on the homepage.
const homepageWriting = [
	...writing.map((w) => ({
		slug: w.id.split('/').pop(),
		type: w.data.type,
		title: w.data.title,
		description: w.data.summary,
		tags: w.data.tags ?? [],
		hasAudio: Boolean(w.data.audioPath),
		date: w.data.date,
	})),
	...papers.map((p) => ({
		slug: p.id,
		type: 'paper',
		title: p.data.title,
		description: p.data.description,
		tags: p.data.tags ?? [],
		hasAudio: Boolean(p.data.audioPath),
		date: p.data.date,
	})),
]
	.filter((x) => !!x.slug)
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0))
	.slice(0, 8);

const featuredOrder = ['acp-ra', 'agentic-force-creation', '2026-02-09-agent-tool-security-research'];
const featuredFromOrder = featuredOrder
	.map((slug) => homepageWriting.find((w) => w.slug === slug))
	.filter(Boolean);
const featuredFill = homepageWriting.filter((w) => !featuredOrder.includes(String(w.slug))).slice(0, Math.max(0, 3 - featuredFromOrder.length));
const featuredReading = [...featuredFromOrder, ...featuredFill].slice(0, 3);

const siteUrl = new URL(withBase('/'), Astro.site).toString();
const writingSearchTarget = new URL(withBase('/writing/?q={search_term_string}'), Astro.site).toString();
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION} image="/og/home.png">
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: 'Adam Boas',
			url: 'https://www.adamboas.com/',
			sameAs: ['https://github.com/anboas', 'https://www.linkedin.com/in/adamnboas/'],
			jobTitle: 'Solutions Architect',
			telephone: CONTACT_PHONE,
			description: SITE_DESCRIPTION,
		})}
	/>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			url: siteUrl,
			potentialAction: {
				'@type': 'SearchAction',
				target: writingSearchTarget,
				'query-input': 'required name=search_term_string',
			},
		})}
	/>
	<a id="page-top" class="block" aria-hidden="true"></a>

	<section class="card p-8">
		<div class="flex flex-col gap-6">
			<div class="w-full max-w-4xl">
				<h1 class="text-3xl font-semibold tracking-tight text-slate-50">Adam Boas</h1>
				<p class="mt-2 text-slate-400">Solutions Architect</p>
				<p class="mt-4 text-lg leading-relaxed text-slate-300">
					Warfighter lethality through trusted autonomy, control planes, and execution at tempo.
				</p>
				<div class="mt-5 flex flex-wrap items-center gap-3">
					<a data-track="Contact: Intake Click" href={withBase('/contact/?intent=consulting')} class="ui-link-btn ui-link-btn-primary px-4 text-sm font-semibold">
						Start project
					</a>
					<a data-track="Contact: Email Click" href="mailto:anboas@gmail.com" class="ui-link-btn px-4 text-sm font-semibold">Email direct</a>
					<a data-track="Contact: Phone Click" href="tel:+13019042011" class="ui-link-btn px-4 text-sm font-semibold">{CONTACT_PHONE}</a>
				</div>
				<div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-400">
					<span class="uppercase tracking-wide text-slate-500">Quick intents</span>
					<a data-track="Contact: Intent Consulting Click" href={withBase('/contact/?intent=consulting')} class="ui-pill px-2.5 py-1 text-xs hover:bg-slate-900 hover:text-slate-100">
						Consulting
					</a>
					<a data-track="Contact: Intent Proposal Click" href={withBase('/contact/?intent=proposal-support')} class="ui-pill px-2.5 py-1 text-xs hover:bg-slate-900 hover:text-slate-100">
						Proposal support
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="mt-6 card p-6">
		<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
			<h2 class="section-title">Featured Reading</h2>
			<div class="flex flex-wrap items-center gap-3 text-sm font-semibold">
				<a href={withBase('/capabilities/')} class="text-stone-100 hover:text-stone-50">Capability topics →</a>
				<a href={withBase('/writing/')} class="text-stone-100 hover:text-stone-50">All writing →</a>
			</div>
		</div>
		<div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
			{featuredReading.map((w) => (
				<WritingCompactCard item={w} />
			))}
		</div>
	</section>

	<div class="mt-10 grid gap-6 md:grid-cols-2">
		<section class="card p-6">
			<h2 class="section-title">Operating Principles</h2>
			<ul class="mt-3 space-y-2 text-[0.94rem] leading-relaxed text-slate-300">
				<li><span class="text-slate-100">Mission assurance over novelty</span>: contested operations first, graceful degradation always</li>
				<li><span class="text-slate-100">Governed autonomy by default</span>: trust scopes, policy gates, and operator override paths</li>
				<li><span class="text-slate-100">Evidence before action</span>: signed traces, provenance, and auditable decisions</li>
				<li><span class="text-slate-100">Control planes over point solutions</span>: PDP/PIP/PEP patterns with clean system boundaries</li>
				<li><span class="text-slate-100">Continuous adversarial validation</span>: evals, red-teaming, and rollback as normal operations</li>
			</ul>
		</section>

		<section class="card p-6">
			<h2 class="section-title">Engagement</h2>
			<p class="mt-3 text-[0.94rem] leading-relaxed text-slate-300">Consulting and hands-on support for high-tempo delivery. If you need fast execution, use the intake form and include mission outcome + timeline. Quick intents in the hero route requests to the right lane faster.</p>
			<ul class="mt-4 space-y-2 text-[0.94rem] leading-relaxed text-slate-300">
				<li><span class="text-slate-100">Architecture &amp; modernization</span> (cloud platforms, control planes, migration plans)</li>
				<li><span class="text-slate-100">Delivery systems</span> (paved roads, CI/CD, SLOs, observability, rollback)</li>
				<li><span class="text-slate-100">Governed autonomy</span> (evals, trust scopes, policy + audit trails)</li>
				<li><span class="text-slate-100">Proposal support</span> (whitepapers, technical volumes, RFI/RFP responses)</li>
			</ul>
			<div class="mt-5 flex flex-wrap gap-3">
				<a href="#experience" class="ui-link-btn bg-slate-900/40 px-3 text-sm font-semibold text-slate-100">See experience</a>
				<a data-track="Contact: Intake Click" href={withBase('/contact/?intent=consulting')} class="ui-link-btn px-3 text-sm font-semibold">Start project</a>
			</div>
		</section>
	</div>

	<section id="writing" class="mt-10" data-writing-home>
		<div class="card p-6">
			<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
				<h2 class="section-title">Writing</h2>
				<a href={withBase('/writing/')} class="text-sm font-semibold text-stone-100 hover:text-stone-50">
					All writing →
				</a>
			</div>

			<div class="mt-6 grid gap-3">
				{homepageWriting.map((w) => (
					<WritingCompactCard item={w} />
				))}
			</div>
		</div>
	</section>

	<section id="experience" class="mt-10">
		<div class="card p-6">
			<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
				<h2 class="section-title">Experience</h2>
				<div class="flex flex-col items-start gap-1 text-sm font-semibold">
					<div class="flex items-center gap-3">
						<a href={withBase('/files/adam-boas-resume.pdf')} class="text-stone-100 hover:text-stone-50">Latest resume PDF →</a>
						<a href={withBase('/experience/')} class="text-stone-100 hover:text-stone-50">Experience pages →</a>
					</div>
					<span class="text-[11px] font-normal uppercase tracking-wide text-slate-400">Clearance: {RESUME_CLEARANCE}</span>
				</div>
			</div>

			<div class="mt-6 grid gap-3 md:hidden">
				{roles.map((r) => (
						<div class="card w-full overflow-hidden p-4">
							<div class="flex min-w-0 items-baseline justify-between gap-3">
								<span class="min-w-0 truncate font-semibold text-slate-50">{r.company}</span>
								<span class="shrink-0 whitespace-nowrap text-xs text-slate-400">{r.period}</span>
							</div>
							<p class="mt-1 break-words text-sm text-slate-300">{r.title}</p>
						</div>
				))}
			</div>

			<div class="mt-6 hidden overflow-hidden rounded-none border border-slate-800 md:block">
				<table class="w-full border-collapse text-sm">
					<thead class="bg-slate-950/60">
						<tr>
							<th class="px-4 py-3 text-left font-semibold text-slate-200">Company</th>
							<th class="px-4 py-3 text-left font-semibold text-slate-200">Role</th>
							<th class="px-4 py-3 text-right font-semibold text-slate-200">Period</th>
						</tr>
					</thead>
					<tbody>
						{roles.map((r) => (
							<tr class="border-t border-slate-800">
								<td class="px-4 py-3 text-slate-100">{r.company}</td>
								<td class="px-4 py-3 text-slate-300">{r.title}</td>
								<td class="px-4 py-3 text-right text-slate-400">{r.period}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section id="education" class="mt-10">
		<div class="card p-6">
			<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
				<h2 class="section-title">Education</h2>
				<a href={withBase('/education/')} class="text-sm font-semibold text-stone-100 hover:text-stone-50">
					Education pages →
				</a>
			</div>

			<ul class="mt-6 space-y-3 text-sm">
				{certs.map((c) => (
					<li class="flex flex-col gap-1 border-b border-slate-800 pb-3 md:flex-row md:items-baseline md:justify-between">
						<span class="text-slate-50">{c.name}</span>
						<span class="text-slate-400">{c.issuer}{c.year ? ` • ${c.year}` : ''}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Blog section merged into Writing -->
</SiteLayout>
