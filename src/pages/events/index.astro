---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
import { radarEventsSeed } from '../../data/radar/events';

const events = radarEventsSeed;

const branches = [...new Set(events.map((e) => e.branch))].sort();
const types = [...new Set(events.map((e) => e.type))].sort();
const statuses = ['Upcoming', 'Projected', 'Needs Date', 'Past'] as const;

function daysUntilValue(date: string | null) {
	if (!date) return null;
	const target = new Date(date);
	if (Number.isNaN(target.getTime())) return null;
	const now = new Date();
	const targetDay = Date.UTC(target.getFullYear(), target.getMonth(), target.getDate());
	const nowDay = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
	return Math.round((targetDay - nowDay) / 86_400_000);
}

function daysUntilBadge(date: string | null) {
	const days = daysUntilValue(date);
	if (days === null) return 'Date TBD';
	if (days === 0) return 'Today';
	if (days > 0) return `In ${days}d`;
	return `${Math.abs(days)}d ago`;
}

function daysUntilDetail(date: string | null) {
	const days = daysUntilValue(date);
	if (days === null) return 'Date pending';
	if (days === 0) return 'Starts today';
	if (days > 0) return `${days} day(s)`;
	return `Started ${Math.abs(days)} day(s) ago`;
}

const nextUpcomingDays = events
	.map((e) => daysUntilValue(e.startDate))
	.filter((days): days is number => days !== null && days >= 0);

const summaryStats = {
	total: events.length,
	upcoming: events.filter((e) => e.status === 'Upcoming').length,
	needsDate: events.filter((e) => e.status === 'Needs Date').length,
	nextInDays: nextUpcomingDays.length ? Math.min(...nextUpcomingDays) : null,
};

function fmtDate(date: string | null) {
	if (!date) return 'Date pending';
	return new Date(date).toLocaleDateString(undefined, {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
}

function fmtDateRange(start: string | null, end: string | null | undefined) {
	if (!start) return 'Date pending';
	if (!end) return fmtDate(start);
	return `${fmtDate(start)} - ${fmtDate(end)}`;
}

function locationLabel(event: (typeof events)[number]) {
	return event.location.state ? `${event.location.city}, ${event.location.state}` : event.location.city;
}

function costLabel(event: (typeof events)[number]) {
	const range = event.ontology.logistics.estimatedCostUsd;
	if (!range) return null;
	if (range.max === 0 && range.min === 0) return '$0';
	if (range.min === range.max) return `$${range.min.toLocaleString()}`;
	return `$${range.min.toLocaleString()} - $${range.max.toLocaleString()}`;
}

function sourceConfidenceBand(event: (typeof events)[number]) {
	const confidence = event.ontology.provenance.map((p) => p.confidence);
	if (confidence.includes('High')) return 'high';
	if (confidence.includes('Medium')) return 'medium';
	return 'low';
}

function eventPrimaryLink(event: (typeof events)[number]) {
	return event.ontology.links.official ?? null;
}

---

<SiteLayout
	title="DoW Event Tracker | Adam Boas"
	description="Department of War event tracker with ontology-rich metadata, date-first prioritization, and expandable intelligence cards."
	canonicalHref="https://www.adamboas.com/events/"
>
	<StickyBrowseBar active="events" />


	<section class="mt-2 space-y-6">
		<section class="card p-4 radar-control-shell">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<h1 class="text-2xl font-semibold tracking-tight text-slate-50 sm:text-3xl">DoW Event Tracker</h1>
				<div class="flex flex-wrap gap-2">
					<button id="radar-toggle-map" class="radar-btn radar-btn-tight" type="button">Hide map</button>
					<button id="radar-toggle-compact" class="radar-btn radar-btn-tight" type="button">Compact mode</button>
				</div>
			</div>
			<div class="mt-3 flex flex-wrap gap-2">
				<span class="radar-mini-stat">{summaryStats.total} events</span>
				<span class="radar-mini-stat">{summaryStats.upcoming} upcoming</span>
				<span class="radar-mini-stat">{summaryStats.nextInDays === null ? 'next date TBD' : `next in ${summaryStats.nextInDays}d`}</span>
				<span class="radar-mini-stat">{summaryStats.needsDate} needs date</span>
			</div>
			<div class="mt-3 border-t border-slate-800 pt-3 radar-filter-wrap">
				<details id="radar-filter-panel" class="radar-filter-panel">
					<summary class="radar-summary radar-summary-primary">Filters</summary>
					<div class="mt-2 grid gap-2 text-sm md:grid-cols-4">
						<label class="block md:col-span-2">
							<input id="radar-q" data-global-search class="radar-input" type="search" placeholder="Search theme, stakeholder, city..." />
						</label>
						<select id="radar-branch" class="radar-input">
							<option value="">All branches</option>
							{branches.map((branch) => <option value={branch}>{branch}</option>)}
						</select>
						<select id="radar-type" class="radar-input">
							<option value="">All types</option>
							{types.map((type) => <option value={type}>{type}</option>)}
						</select>
						<select id="radar-status" class="radar-input">
							<option value="">All statuses</option>
							{statuses.map((status) => <option value={status}>{status}</option>)}
						</select>
						<label class="radar-check"><input id="radar-upcoming-only" type="checkbox" /><span>Upcoming only</span></label>
						<label class="radar-check"><input id="radar-verified-only" type="checkbox" /><span>Verified only</span></label>
						<label class="radar-check"><input id="radar-show-past" type="checkbox" /><span>Show past</span></label>
						<button id="radar-reset" class="radar-btn" type="button">Reset</button>
					</div>
				</details>
			</div>

			<div class="mt-3 border-t border-slate-800 pt-3">
				<div class="flex flex-wrap items-end justify-between gap-3">
					<div id="radar-filter-chips" class="radar-filter-chips"></div>
					<p id="radar-count" class="radar-count text-xs text-slate-400"></p>
				</div>
			</div>
		</section>

		<div class="radar-main-col">
			<section id="radar-map-section" class="card p-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="section-title">Map View</h2>
					<div class="radar-map-tools">
						<button id="radar-map-fit" class="radar-btn radar-btn-tight" type="button">Fit Results</button>
						<button id="radar-map-reset" class="radar-btn radar-btn-tight" type="button">Reset</button>
					</div>
				</div>
				<div id="radar-map" class="radar-map" aria-label="Event map">
					<div id="radar-leaflet-map" class="radar-leaflet-map"></div>
				</div>
				<p id="radar-map-sub" class="radar-map-sub">Mapped events · clusters enabled · Ctrl/Cmd+scroll to zoom</p>
			</section>

			<section id="radar-list-section" class="card p-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="section-title">Events</h2>
					<select id="radar-sort" class="radar-input radar-input-sort" aria-label="Sort events">
						<option value="soonest">Soonest first</option>
						<option value="latest">Latest first</option>
						<option value="signal">Signal first</option>
						<option value="branch">Branch</option>
					</select>
				</div>
				<div id="radar-empty" class="hidden rounded-none border border-slate-800 bg-slate-950/60 p-4 text-sm text-slate-300">
					No events match the current filter state.
				</div>
				<div id="radar-list" class="space-y-3 radar-list">
					{events.map((event) => (
						<article
							id={event.id}
							class="radar-card"
							data-event-card
							data-id={event.id}
							data-days={daysUntilValue(event.startDate) ?? ''}
							data-date={event.startDate ?? ''}
							data-status={event.status}
							data-type={event.type}
							data-branch={event.branch}
							data-signal={event.signal}
							data-confidence={sourceConfidenceBand(event)}
							data-title={event.title}
							data-link={eventPrimaryLink(event) ?? ''}
							data-lat={event.location.lat}
							data-lng={event.location.lng}
							data-search={`${event.title} ${event.description} ${event.branch} ${event.type} ${event.status} ${event.location.city} ${event.location.state ?? ''} ${event.ontology.themes.join(' ')} ${event.ontology.stakeholders.join(' ')} ${event.ontology.keywords.join(' ')} ${event.ontology.provenance.map((p) => `${p.type} ${p.confidence}`).join(' ')}`.toLowerCase()}
						>
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div class="min-w-0 flex-1">
									<h3 class="mt-1 text-base font-semibold text-slate-50">{event.title}</h3>
									<p class="mt-1 text-sm text-slate-300 radar-desc">{event.description}</p>
									<p class="mt-2 text-xs text-slate-400 radar-meta">
										{locationLabel(event)} · {fmtDateRange(event.startDate, event.endDate)}{costLabel(event) ? ` · Reg: ${costLabel(event)}` : ''}
									</p>
								</div>
								<div class="flex flex-col items-end gap-1.5">
									<div class="flex items-center gap-2">
										<div class="radar-days-chip">{daysUntilBadge(event.startDate)}</div>
										{eventPrimaryLink(event) ? <a class="radar-pin-btn radar-link-btn" href={eventPrimaryLink(event)!} target="_blank" rel="noreferrer">Link</a> : null}
										<button class="radar-pin-btn" type="button" data-map-focus data-id={event.id}>Map</button>
									</div>
									<p class="radar-card-kicker">{event.branch} · {event.type} · {event.status}</p>
								</div>
							</div>

							<div class="mt-3 flex flex-wrap gap-2 radar-theme-row">
								{event.ontology.themes.slice(0, 4).map((theme) => <span class="radar-pill">{theme}</span>)}
							</div>

							<details class="mt-3 radar-details">
								<summary>Expand ontology + metadata</summary>
								<div class="mt-3 grid gap-4 lg:grid-cols-2">
									<div>
										<p class="radar-section-label">Capability areas</p>
										<ul class="radar-listing">{event.ontology.capabilityAreas.map((item) => <li>{item}</li>)}</ul>
									</div>
									<div>
										<p class="radar-section-label">Mission threads</p>
										<ul class="radar-listing">{event.ontology.missionThreads.map((item) => <li>{item}</li>)}</ul>
									</div>
									<div>
										<p class="radar-section-label">Stakeholders</p>
										<ul class="radar-listing">{event.ontology.stakeholders.map((item) => <li>{item}</li>)}</ul>
									</div>
									<div>
										<p class="radar-section-label">Decision windows</p>
										<ul class="radar-listing">
											<li><strong>Discovery:</strong> {event.ontology.decisionWindows.discovery}</li>
											<li><strong>Prep:</strong> {event.ontology.decisionWindows.prep}</li>
											<li><strong>Execution:</strong> {event.ontology.decisionWindows.execution}</li>
										</ul>
									</div>
								</div>

								<div class="mt-4 grid gap-4 lg:grid-cols-2">
									<div>
										<p class="radar-section-label">Links</p>
										<ul class="radar-listing">
											{event.ontology.links.official ? <li><a href={event.ontology.links.official} target="_blank" rel="noreferrer">Official page</a></li> : null}
											{event.ontology.links.registration ? <li><a href={event.ontology.links.registration} target="_blank" rel="noreferrer">Registration</a></li> : null}
											{event.ontology.links.callForPapers ? <li><a href={event.ontology.links.callForPapers} target="_blank" rel="noreferrer">Call for papers</a></li> : null}
											{event.ontology.links.agenda ? <li><a href={event.ontology.links.agenda} target="_blank" rel="noreferrer">Agenda</a></li> : null}
										</ul>
									</div>
									<div>
										<p class="radar-section-label">Logistics</p>
										<ul class="radar-listing">
											<li><strong>Format:</strong> {event.ontology.logistics.format}</li>
											{costLabel(event) ? <li><strong>Estimated cost:</strong> {costLabel(event)}</li> : null}
											<li><strong>Travel burden (DC):</strong> {event.ontology.logistics.travelBurdenFromDc}</li>
											{event.location.venue ? <li><strong>Venue:</strong> {event.location.venue}</li> : null}
										</ul>
									</div>
								</div>

								<div class="mt-4">
									<p class="radar-section-label">Timing</p>
									<ul class="radar-listing">
										<li><strong>Days until start:</strong> {daysUntilDetail(event.startDate)}</li>
										<li><strong>Opportunity window:</strong> {fmtDateRange(event.startDate, event.endDate)}</li>
									</ul>
								</div>

								<div class="mt-4">
									<p class="radar-section-label">Provenance</p>
									<ul class="radar-listing">
										{event.ontology.provenance.map((source) => (
											<li>
												<a href={source.url} target="_blank" rel="noreferrer">{source.name}</a>
												<span class="text-slate-500"> · {source.type}, {source.confidence} confidence, verified {source.lastVerified}</span>
											</li>
										))}
									</ul>
									{event.ontology.notes ? <p class="mt-2 text-xs text-slate-400">{event.ontology.notes}</p> : null}
								</div>
							</details>
						</article>
					))}
				</div>

			</section>
		</div>
		<p class="radar-legal-note">
			Event-tracker entries are compiled from public sources for research and planning. Source owners retain rights to their original content.
			Always verify key dates, terms, and eligibility on the official source before acting.
		</p>
	</section>

	<section class="mt-6">
		<a class="text-sm text-slate-300 hover:text-slate-100" href={withBase('/writing/')}>← Back to writing</a>
	</section>
</SiteLayout>

<script is:inline>
	const controls = {
		filterPanel: document.getElementById('radar-filter-panel'),
		q: document.getElementById('radar-q'),
		branch: document.getElementById('radar-branch'),
		type: document.getElementById('radar-type'),
		status: document.getElementById('radar-status'),
		sort: document.getElementById('radar-sort'),
		upcomingOnly: document.getElementById('radar-upcoming-only'),
		verifiedOnly: document.getElementById('radar-verified-only'),
		showPast: document.getElementById('radar-show-past'),
		toggleMap: document.getElementById('radar-toggle-map'),
		toggleCompact: document.getElementById('radar-toggle-compact'),
		reset: document.getElementById('radar-reset'),
	};

	const list = document.getElementById('radar-list');
	const count = document.getElementById('radar-count');
	const empty = document.getElementById('radar-empty');
	const map = document.getElementById('radar-map');
	const mapSub = document.getElementById('radar-map-sub');
	const mapCanvas = document.getElementById('radar-leaflet-map');
	const mapFitBtn = document.getElementById('radar-map-fit');
	const mapResetBtn = document.getElementById('radar-map-reset');
	const mapSection = document.getElementById('radar-map-section');
	const filterChips = document.getElementById('radar-filter-chips');
	const cards = Array.from(document.querySelectorAll('[data-event-card]'));
	const mapFocusButtons = Array.from(document.querySelectorAll('[data-map-focus]'));

	let compactMode = true;
	let mapVisible = true;


	function parseDate(value) {
		if (!value) return null;
		const ms = new Date(value).getTime();
		return Number.isNaN(ms) ? null : ms;
	}


	function parseDays(value) {
		if (value === '' || value == null) return null;
		const days = Number(value);
		return Number.isFinite(days) ? days : null;
	}

	function typeKey(type) {
		return String(type || '')
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-+|-+$/g, '');
	}

	function typeTone(type) {
		const key = typeKey(type);
		if (['conference', 'workshop', 'summit', 'hackathon', 'exercise'].includes(key)) return key;
		return 'conference';
	}

	function daysMarker(days) {
		if (days == null) return '?';
		if (days < 0) return 'P';
		if (days === 0) return '0';
		if (days > 99) return '99+';
		return String(days);
	}

	function daysText(days) {
		if (days == null) return 'Date pending';
		if (days === 0) return 'Starts today';
		if (days > 0) return `Starts in ${days} day(s)`;
		return `Started ${Math.abs(days)} day(s) ago`;
	}

	function escapeHtml(str) {
		return String(str ?? '')
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;')
			.replaceAll("'", '&#39;');
	}

	function slowScrollTo(element, duration = 900) {
		if (!element) return;
		const startY = window.scrollY;
		const targetY = element.getBoundingClientRect().top + window.scrollY - Math.max(120, window.innerHeight * 0.24);
		const delta = targetY - startY;
		const start = performance.now();
		const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
		function frame(now) {
			const t = Math.min(1, (now - start) / duration);
			window.scrollTo(0, startY + delta * ease(t));
			if (t < 1) requestAnimationFrame(frame);
		}
		requestAnimationFrame(frame);
	}

	function focusCard(id) {
		const card = cards.find((c) => c.dataset.id === id);
		if (!card) return;
		for (const c of cards) c.classList.remove('radar-card-focus');
		card.classList.add('radar-card-focus');
		slowScrollTo(card, 980);
		setTimeout(() => card.classList.remove('radar-card-focus'), 2000);
	}

	for (const card of cards) {
		card.classList.add(`radar-type-${typeTone(card.dataset.type)}`);
	}

	const US_BOUNDS = [[24.2, -125.2], [49.6, -66.0]];
	let mapLib = null;
	let clusterLayer = null;
	let leafletReady = false;
	let leafletFailed = false;
	let mapRenderedOnce = false;
	let markerIndex = new Map();

	function loadScript(src) {
		return new Promise((resolve, reject) => {
			const existing = document.querySelector(`script[data-radar-src="${src}"]`);
			if (existing) {
				if (existing.dataset.loaded === '1') return resolve();
				existing.addEventListener('load', () => resolve(), { once: true });
				existing.addEventListener('error', () => reject(new Error(`failed ${src}`)), { once: true });
				return;
			}
			const script = document.createElement('script');
			script.src = src;
			script.async = true;
			script.dataset.radarSrc = src;
			script.onload = () => {
				script.dataset.loaded = '1';
				resolve();
			};
			script.onerror = () => reject(new Error(`failed ${src}`));
			document.head.appendChild(script);
		});
	}

	function loadCss(href) {
		if (document.querySelector(`link[data-radar-href="${href}"]`)) return;
		const link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = href;
		link.dataset.radarHref = href;
		document.head.appendChild(link);
	}

	async function ensureLeaflet() {
		if (leafletReady && window.L?.markerClusterGroup) return true;
		try {
			loadCss('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css');
			loadCss('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css');
			loadCss('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css');
			await loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js');
			await loadScript('https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js');
			leafletReady = Boolean(window.L?.markerClusterGroup);
			return leafletReady;
		} catch {
			leafletFailed = true;
			if (mapSub) mapSub.textContent = 'Map failed to load.';
			return false;
		}
	}

	function enableModifierWheelZoom(map) {
		const container = map.getContainer();
		if (!container) return;
		let lastZoomTs = 0;
		container.addEventListener('wheel', (e) => {
			if (!(e.ctrlKey || e.metaKey)) return;
			e.preventDefault();
			const now = Date.now();
			if (now - lastZoomTs < 90) return;
			lastZoomTs = now;
			map.setZoom(map.getZoom() + (e.deltaY < 0 ? 1 : -1), { animate: false });
		}, { passive: false });
	}

	function pinIcon(daysLabel, tone, id) {
		return window.L.divIcon({
			className: 'radar-leaflet-pin-wrap',
			html: `<div class="radar-leaflet-pin radar-leaflet-pin-${tone}" data-event-id="${escapeHtml(id)}"><span>${escapeHtml(daysLabel)}</span></div>`,
			iconSize: [30, 30],
			iconAnchor: [15, 15],
		});
	}

	function markerPopup(card) {
		const id = card.dataset.id;
		const title = card.dataset.title || 'Untitled';
		const status = card.dataset.status || 'Unknown';
		const branch = card.dataset.branch || 'Unknown';
		const type = card.dataset.type || 'Unknown';
		const meta = card.querySelector('.radar-meta')?.textContent || '';
		const link = card.dataset.link || '';
		const days = parseDays(card.dataset.days);
		const statusClass = `radar-status-${String(status).toLowerCase().replaceAll(' ', '-')}`;
		const typeClass = `radar-type-${typeTone(type)}`;
		const linkHtml = link ? `<a class="radar-map-link" href="${escapeHtml(link)}" target="_blank" rel="noreferrer">Event site</a>` : '';
		return `
			<div class="radar-map-popup">
				<div class="radar-map-popup-title">${escapeHtml(title)}</div>
				<div class="radar-map-popup-meta"><span class="radar-map-popup-badge ${statusClass}">${escapeHtml(status)}</span> <span class="radar-map-popup-badge ${typeClass}">${escapeHtml(type)}</span> ${escapeHtml(branch)}</div>
				<div class="radar-map-popup-meta">${escapeHtml(meta)}</div>
				<div class="radar-map-popup-actions">
					<span class="radar-map-popup-days">${escapeHtml(daysText(days))}</span>
					<div class="radar-map-popup-cta">${linkHtml}<button class="radar-map-jump" type="button" data-event-id="${escapeHtml(id)}">Open event</button></div>
				</div>
			</div>
		`;
	}

	async function initLeafletMap() {
		if (mapLib || leafletFailed || !mapCanvas) return;
		const ok = await ensureLeaflet();
		if (!ok) return;

		mapLib = window.L.map(mapCanvas, {
			zoomControl: true,
			scrollWheelZoom: false,
			worldCopyJump: true,
		});
		window.L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
			subdomains: 'abcd',
			maxZoom: 18,
			attribution: '&copy; OpenStreetMap &copy; CARTO',
		}).addTo(mapLib);

		clusterLayer = window.L.markerClusterGroup({
			showCoverageOnHover: false,
			spiderfyOnMaxZoom: true,
			maxClusterRadius: 52,
		});
		mapLib.addLayer(clusterLayer);
		enableModifierWheelZoom(mapLib);
		mapLib.fitBounds(US_BOUNDS);
		mapLib.on('contextmenu', () => mapLib.fitBounds(US_BOUNDS));
		mapLib.on('popupopen', (e) => {
			document.querySelectorAll('.radar-leaflet-pin.is-active').forEach((n) => n.classList.remove('is-active'));
			const sourceIcon = e.popup?._source?._icon?.querySelector?.('.radar-leaflet-pin');
			if (sourceIcon) sourceIcon.classList.add('is-active');
			const el = e.popup?.getElement();
			const btn = el?.querySelector?.('.radar-map-jump');
			if (btn) btn.addEventListener('click', () => focusMapEvent(btn.dataset.eventId, { openPopup: false }));
		});
		mapLib.on('popupclose', () => {
			document.querySelectorAll('.radar-leaflet-pin.is-active').forEach((n) => n.classList.remove('is-active'));
		});
		mapFitBtn?.addEventListener('click', () => fitMapToResults());
		mapResetBtn?.addEventListener('click', () => mapLib.fitBounds(US_BOUNDS));
	}

	function fitMapToResults() {
		if (!mapLib || !clusterLayer) return;
		const bounds = clusterLayer.getBounds();
		if (bounds && bounds.isValid()) mapLib.fitBounds(bounds.pad(0.2));
		else mapLib.fitBounds(US_BOUNDS);
	}

	function focusMapEvent(id, options = { openPopup: true }) {
		if (!id) return;
		const card = cards.find((c) => c.dataset.id === id);
		if (!card) return;
		focusCard(id);
		if (!mapVisible) {
			mapVisible = true;
			render();
		}
		if (!mapLib || !clusterLayer) {
			initLeafletMap().then(() => focusMapEvent(id, options));
			return;
		}
		const marker = markerIndex.get(id);
		if (!marker) return;
		clusterLayer.zoomToShowLayer(marker, () => {
			if (options.openPopup) marker.openPopup();
			mapLib.panTo(marker.getLatLng(), { animate: true, duration: 0.4 });
		});
	}

	function stateFromUI() {
		return {
			q: controls.q.value.trim(),
			branch: controls.branch.value,
			type: controls.type.value,
			status: controls.status.value,
			sort: controls.sort.value,
			upcoming: controls.upcomingOnly.checked,
			verified: controls.verifiedOnly.checked,
			showPast: controls.showPast.checked,
		};
	}

	function applyState(state) {
		controls.q.value = state.q || '';
		controls.branch.value = state.branch || '';
		controls.type.value = state.type || '';
		controls.status.value = state.status || '';
		controls.sort.value = state.sort || 'soonest';
		controls.upcomingOnly.checked = Boolean(state.upcoming);
		controls.verifiedOnly.checked = Boolean(state.verified);
		controls.showPast.checked = Boolean(state.showPast);
	}

	function toQuery(state) {
		const params = new URLSearchParams();
		if (state.q) params.set('q', state.q);
		if (state.branch) params.set('branch', state.branch);
		if (state.type) params.set('type', state.type);
		if (state.status) params.set('status', state.status);
		if (state.sort && state.sort !== 'soonest') params.set('sort', state.sort);
		if (state.upcoming) params.set('upcoming', '1');
		if (state.verified) params.set('verified', '1');
		if (state.showPast) params.set('past', '1');
		return params.toString();
	}

	function hasActiveFilters(state) {
		return Boolean(
			state.q ||
			state.branch ||
			state.type ||
			state.status ||
			state.upcoming ||
			state.verified ||
			state.showPast ||
			(state.sort && state.sort !== 'soonest')
		);
	}

	function applyUrlState() {
		const params = new URLSearchParams(window.location.search);
		const state = {
			q: params.get('q') || '',
			branch: params.get('branch') || '',
			type: params.get('type') || '',
			status: params.get('status') || '',
			sort: params.get('sort') || 'soonest',
			upcoming: params.get('upcoming') === '1',
			verified: params.get('verified') === '1',
			showPast: params.get('past') === '1',
		};
		applyState(state);
		if (controls.filterPanel) controls.filterPanel.open = hasActiveFilters(state);
	}

	function sortBySoonest(a, b) {
		const da = parseDate(a.dataset.date || '');
		const db = parseDate(b.dataset.date || '');
		if (da === null && db === null) return (a.dataset.title || '').localeCompare(b.dataset.title || '');
		if (da === null) return 1;
		if (db === null) return -1;
		return da - db;
	}

	function getVisibleCards() {
		const state = stateFromUI();
		const q = state.q.toLowerCase();
		const visible = cards.filter((card) => {
			if (state.branch && card.dataset.branch !== state.branch) return false;
			if (state.type && card.dataset.type !== state.type) return false;
			if (state.status && card.dataset.status !== state.status) return false;
			if (!state.showPast && card.dataset.status === 'Past' && state.status !== 'Past') return false;
			if (state.upcoming && card.dataset.status !== 'Upcoming') return false;
			if (state.verified && card.dataset.confidence !== 'high') return false;
			if (!q) return true;
			return (card.dataset.search || '').includes(q);
		});

		if (state.sort === 'latest') {
			visible.sort((a, b) => sortBySoonest(b, a));
		} else if (state.sort === 'signal') {
			const rank = { High: 3, Medium: 2, Low: 1 };
			visible.sort((a, b) => (rank[b.dataset.signal] - rank[a.dataset.signal]) || sortBySoonest(a, b));
		} else if (state.sort === 'branch') {
			visible.sort((a, b) => (a.dataset.branch || '').localeCompare(b.dataset.branch || '') || sortBySoonest(a, b));
		} else {
			visible.sort(sortBySoonest);
		}

		return { visible, state };
	}

	function renderFilterChips(state) {
		const chips = [];
		if (state.q) chips.push(`Search: ${state.q}`);
		if (state.branch) chips.push(`Branch: ${state.branch}`);
		if (state.type) chips.push(`Type: ${state.type}`);
		if (state.status) chips.push(`Status: ${state.status}`);
		if (state.upcoming) chips.push('Upcoming only');
		if (state.verified) chips.push('Verified only');
		if (state.showPast) chips.push('Including past');
		if (!chips.length) chips.push('No active filters');
		filterChips.innerHTML = chips.map((chip) => `<span class="radar-chip">${chip}</span>`).join('');
	}


	function renderMap(visibleCards) {
		const cardsForMap = visibleCards.length ? visibleCards : cards;
		if (!mapVisible) {
			if (mapSub) mapSub.textContent = 'Map hidden';
			return;
		}
		if (!mapLib) {
			initLeafletMap().then(() => renderMap(cardsForMap));
			return;
		}
		if (!clusterLayer) return;

		clusterLayer.clearLayers();
		markerIndex = new Map();
		let mapped = 0;
		for (const card of cardsForMap) {
			const lat = Number(card.dataset.lat || '');
			const lng = Number(card.dataset.lng || '');
			if (!Number.isFinite(lat) || !Number.isFinite(lng)) continue;
			const days = parseDays(card.dataset.days);
			const tone = typeTone(card.dataset.type);
			const eventId = card.dataset.id || '';
			const marker = window.L.marker([lat, lng], { icon: pinIcon(daysMarker(days), tone, eventId) });
			marker.bindPopup(markerPopup(card), { maxWidth: 380 });
			clusterLayer.addLayer(marker);
			markerIndex.set(eventId, marker);
			mapped += 1;
		}

		if (!mapRenderedOnce) {
			fitMapToResults();
			mapRenderedOnce = true;
		}

		if (mapSub) {
			mapSub.textContent = `Mapped ${mapped} ${mapped === 1 ? 'event' : 'events'} · clusters enabled · drag to pan · Ctrl/Cmd+scroll to zoom · right-click to reset`;
		}
	}

	function render() {
		const { visible, state } = getVisibleCards();
		for (const card of cards) card.classList.add('hidden');
		for (const card of visible) {
			card.classList.remove('hidden');
			list.appendChild(card);
		}

		list.classList.toggle('is-compact', compactMode);
		mapSection.classList.toggle('hidden', !mapVisible);
		controls.toggleMap.textContent = mapVisible ? 'Hide map' : 'Show map';
		controls.toggleCompact.textContent = compactMode ? 'Detailed mode' : 'Compact mode';

		empty.classList.toggle('hidden', visible.length > 0);
		count.textContent = `${visible.length} of ${cards.length} events shown`;
		renderFilterChips(state);
		renderMap(visible);

		const query = toQuery(state);
		const href = query ? `${window.location.pathname}?${query}` : window.location.pathname;
		history.replaceState(null, '', href);
	}




	[controls.q, controls.branch, controls.type, controls.status, controls.sort].forEach((node) => node.addEventListener('input', render));
	[controls.upcomingOnly, controls.verifiedOnly, controls.showPast].forEach((node) => node.addEventListener('change', render));
	controls.reset.addEventListener('click', () => {
		applyState({ q: '', branch: '', type: '', status: '', sort: 'soonest', upcoming: false, verified: false, showPast: false });
		render();
	});
	controls.toggleMap.addEventListener('click', () => {
		mapVisible = !mapVisible;
		render();
	});
	controls.toggleCompact.addEventListener('click', () => {
		compactMode = !compactMode;
		render();
	});


	for (const btn of mapFocusButtons) {
		btn.addEventListener('click', () => focusMapEvent(btn.dataset.id, { openPopup: true }));
	}

	document.addEventListener('keydown', (event) => {
		if (event.target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(event.target.tagName)) return;
		if (event.key === '/') {
			event.preventDefault();
			if (controls.filterPanel && !controls.filterPanel.open) controls.filterPanel.open = true;
			controls.q.focus();
			controls.q.select();
		}
		if (event.key.toLowerCase() === 'm') {
			mapVisible = !mapVisible;
			render();
		}
		if (event.key.toLowerCase() === 'c') {
			compactMode = !compactMode;
			render();
		}
	});

	applyUrlState();
	render();
</script>

