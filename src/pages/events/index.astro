---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
import { radarEventsSeed } from '../../data/radar/events';
import type { RadarEngagementKind } from '../../data/radar/types';

const DISALLOWED_SOURCE_HOSTS = new Set(['jbenton1.github.io']);

function urlHost(url: string | null | undefined) {
	if (!url) return null;
	try {
		return new URL(url.trim()).hostname.toLowerCase();
	} catch {
		return null;
	}
}

function isTrackerSelfLink(url: string | null | undefined) {
	if (!url) return false;
	return /^https?:\/\/(www\.)?adamboas\.com\/events\/?$/i.test(url.trim());
}

function isDisallowedSourceUrl(url: string | null | undefined) {
	const host = urlHost(url);
	return Boolean(host && DISALLOWED_SOURCE_HOSTS.has(host));
}

function isFutureEventDate(date: string | null | undefined) {
	if (!date) return false;
	const parsed = new Date(date);
	if (Number.isNaN(parsed.getTime())) return false;
	const targetDay = Date.UTC(parsed.getFullYear(), parsed.getMonth(), parsed.getDate());
	const now = new Date();
	const todayDay = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
	return targetDay > todayDay;
}

function isUsableExternalUrl(url: string | null | undefined) {
	if (!url || isTrackerSelfLink(url) || isDisallowedSourceUrl(url)) return false;
	try {
		const parsed = new URL(url.trim());
		return parsed.protocol === 'http:' || parsed.protocol === 'https:';
	} catch {
		return false;
	}
}

const events = radarEventsSeed.filter((event) => {
	if (!isFutureEventDate(event.startDate)) return false;
	const candidateLinks = [
		event.ontology.links.official,
		event.ontology.links.registration,
		event.ontology.links.callForPapers,
		event.ontology.links.agenda,
		event.ontology.links.hotelBlock,
		...event.ontology.provenance.map((source) => source.url),
	];
	if (candidateLinks.some((url) => isDisallowedSourceUrl(url))) return false;
	return candidateLinks.some((url) => isUsableExternalUrl(url));
});

const attendingEventIds = new Set<string>([
	'radar-sofweek-2026',
	// Add event ids here to mark attendance in the calendar.
	// Example: 'radar-defense-it-summit-2026',
]);

function isAttendingEvent(event: (typeof events)[number]) {
	return attendingEventIds.has(event.id);
}

const branches = [...new Set(events.map((e) => e.branch))].sort();
const types = [...new Set(events.map((e) => e.type))].sort();
const statuses = ['Upcoming', 'Projected', 'Needs Date', 'Past'] as const;

function daysUntilValue(date: string | null) {
	if (!date) return null;
	const target = new Date(date);
	if (Number.isNaN(target.getTime())) return null;
	const now = new Date();
	const targetDay = Date.UTC(target.getFullYear(), target.getMonth(), target.getDate());
	const nowDay = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
	return Math.round((targetDay - nowDay) / 86_400_000);
}

function daysUntilBadge(date: string | null) {
	const days = daysUntilValue(date);
	if (days === null) return 'Date TBD';
	if (days === 0) return 'Today';
	if (days > 0) return `In ${days}d`;
	return `${Math.abs(days)}d ago`;
}

function daysUntilDetail(date: string | null) {
	const days = daysUntilValue(date);
	if (days === null) return 'Date pending';
	if (days === 0) return 'Starts today';
	if (days > 0) return `${days} day(s)`;
	return `Started ${Math.abs(days)} day(s) ago`;
}

const nextUpcomingDays = events
	.map((e) => daysUntilValue(e.startDate))
	.filter((days): days is number => days !== null && days >= 0);

const engagementKinds: RadarEngagementKind[] = ['Industry Day', 'Pre-solicitation', 'Sources Sought', 'Vendor Outreach', 'Special Notice'];

function eventTextBlob(event: (typeof events)[number]) {
	return [
		event.title,
		event.description,
		event.ontology.keywords.join(' '),
		event.ontology.notes || '',
		event.ontology.links.official || '',
		event.ontology.acquisition?.noticeType || '',
	]
		.join(' ')
		.toLowerCase();
}

function inferEngagementKinds(event: (typeof events)[number]) {
	const explicit = event.ontology.acquisition?.engagementKinds ?? [];
	const blob = eventTextBlob(event);
	const kinds = new Set<RadarEngagementKind>(explicit);

	if (/industry\s*day|industry\s*outreach|technology\s*industry\s*day|vendor\s*day/i.test(blob)) kinds.add('Industry Day');
	if (/pre[-\s]?solicitation|presolicitation|draft\s*rfp|rfi\b/i.test(blob)) kinds.add('Pre-solicitation');
	if (/sources?\s*sought/i.test(blob)) kinds.add('Sources Sought');
	if (/vendor\s*outreach|open\s*house|small\s*business\s*outreach|business\s*opportunit/i.test(blob)) kinds.add('Vendor Outreach');
	if (/special\s*notice/i.test(blob)) kinds.add('Special Notice');

	return engagementKinds.filter((kind) => kinds.has(kind));
}

function isSamOfficialNotice(event: (typeof events)[number]) {
	return event.ontology.provenance.some((source) => {
		const blob = `${source.name} ${source.url}`.toLowerCase();
		return blob.includes('sam.gov') || blob.includes('get opportunities public api');
	});
}

function normalizedHttpUrl(url: string | null | undefined) {
	if (!url) return null;
	try {
		const parsed = new URL(url.trim());
		if (!['http:', 'https:'].includes(parsed.protocol)) return null;
		return parsed;
	} catch {
		return null;
	}
}

function isCircularEventsLink(url: string | null | undefined) {
	const parsed = normalizedHttpUrl(url);
	if (!parsed) return false;
	const host = parsed.hostname.toLowerCase();
	const path = parsed.pathname.replace(/\/+$/, '') || '/';
	return ['adamboas.com', 'www.adamboas.com'].includes(host) && path === '/events';
}

function isUsableEventLink(url: string | null | undefined) {
	const parsed = normalizedHttpUrl(url);
	if (!parsed) return false;
	if (isCircularEventsLink(parsed.toString())) return false;
	if (DISALLOWED_SOURCE_HOSTS.has(parsed.hostname.toLowerCase())) return false;
	return true;
}

function sanitizedLink(url: string | null | undefined) {
	if (!isUsableEventLink(url)) return null;
	return normalizedHttpUrl(url)!.toString();
}

function samOpportunityLink(event: (typeof events)[number]) {
	const official = sanitizedLink(event.ontology.links.official);
	if (official && /sam\.gov/i.test(official)) return official;
	const fromProvenance = event.ontology.provenance.map((source) => sanitizedLink(source.url)).find((url) => url && /sam\.gov/i.test(url));
	return fromProvenance ?? null;
}

function samOpportunityLinks(event: (typeof events)[number]) {
	const links = [
		event.ontology.links.official,
		event.ontology.links.registration,
		...event.ontology.provenance.map((source) => source.url),
	]
		.map((url) => sanitizedLink(url))
		.filter((url): url is string => Boolean(url && /sam\.gov/i.test(url)));
	return [...new Set(links)];
}

function inferredGovernmentOrganizations(event: (typeof events)[number]) {
	const govHint = /(department|agency|office|command|program\s+office|peo|navy|army|air\s*force|marine|joint|dod|federal|gov|u\.s\.)/i;
	const genericNoise = new Set([
		'joint stakeholders',
		'program offices',
		'industry partners',
		'vendors',
		'program executives',
		'agency cio shops',
	]);
	const items = [
		event.ontology.acquisition?.agency,
		...event.ontology.provenance.map((source) => source.name),
	]
		.filter((item): item is string => Boolean(item && item.trim()))
		.map((item) => item.trim())
		.filter((item) => govHint.test(item))
		.filter((item) => !genericNoise.has(item.toLowerCase()));
	return [...new Set(items)];
}

function governmentPocs(event: (typeof events)[number]) {
	const govHint = /(department|agency|office|command|program\s+office|peo|navy|army|air\s*force|marine|joint|dod|federal|gov|u\.s\.)/i;
	return (event.ontology.engagement?.contacts ?? []).filter((contact) => govHint.test(`${contact.organization ?? ''} ${contact.role ?? ''}`));
}

function noticeTypeLabel(event: (typeof events)[number]) {
	const explicit = event.ontology.acquisition?.noticeType?.trim();
	if (explicit) return explicit;
	const kinds = inferEngagementKinds(event);
	if (kinds.includes('Pre-solicitation')) return 'Pre-solicitation';
	if (kinds.includes('Sources Sought')) return 'Sources Sought';
	if (kinds.includes('Special Notice')) return 'Special Notice';
	if (kinds.includes('Industry Day')) return 'Industry Day';
	if (kinds.includes('Vendor Outreach')) return 'Vendor Outreach';
	return null;
}

const industryDayCount = events.filter((event) => inferEngagementKinds(event).includes('Industry Day')).length;

const summaryStats = {
	total: events.length,
	upcoming: events.filter((e) => e.status === 'Upcoming').length,
	needsDate: events.filter((e) => e.status === 'Needs Date').length,
	industryDays: industryDayCount,
	nextInDays: nextUpcomingDays.length ? Math.min(...nextUpcomingDays) : null,
};

function fmtDate(date: string | null) {
	if (!date) return 'Date pending';
	return new Date(date).toLocaleDateString(undefined, {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
}

function fmtDateRange(start: string | null, end: string | null | undefined) {
	if (!start) return 'Date pending';
	if (!end) return fmtDate(start);
	return `${fmtDate(start)} - ${fmtDate(end)}`;
}

function parseIsoDate(value: string | null | undefined) {
	if (!value) return null;
	const d = new Date(value);
	return Number.isNaN(d.getTime()) ? null : d;
}

function daysSince(value: string | null | undefined) {
	const d = parseIsoDate(value);
	if (!d) return null;
	const now = new Date();
	const dayMs = 86_400_000;
	return Math.floor((Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())) / dayMs);
}

function provenanceFreshness(value: string | null | undefined) {
	const age = daysSince(value);
	if (age === null) return { label: 'Unknown', tone: 'unknown' as const };
	if (age <= 14) return { label: `Fresh (${age}d)`, tone: 'fresh' as const };
	if (age <= 30) return { label: `Watch (${age}d)`, tone: 'watch' as const };
	return { label: `Stale (${age}d)`, tone: 'stale' as const };
}

function evidenceHealth(event: (typeof events)[number]) {
	const tones = event.ontology.provenance.map((source) => provenanceFreshness(source.lastVerified).tone);
	if (!tones.length) return 'Unknown';
	if (tones.includes('stale')) return 'Needs refresh';
	if (tones.includes('watch')) return 'Monitor';
	return 'Fresh';
}

function informationalInsights(event: (typeof events)[number]) {
	const insights: string[] = [];
	const engagement = inferEngagementKinds(event);
	if (engagement.length) insights.push(`Detected opportunity signals: ${engagement.join(', ')}.`);
	if (noticeTypeLabel(event)) insights.push(`Notice posture: ${noticeTypeLabel(event)}.`);
	if (event.ontology.acquisition?.solicitationNumber) insights.push(`Solicitation reference present: ${event.ontology.acquisition.solicitationNumber}.`);
	if (event.ontology.acquisition?.registrationDeadline) insights.push(`Registration deadline: ${fmtDate(event.ontology.acquisition.registrationDeadline)}.`);
	if (event.ontology.acquisition?.responseDueDate) insights.push(`Response due: ${fmtDate(event.ontology.acquisition.responseDueDate)}.`);
	if (samOpportunityLinks(event).length) insights.push(`SAM-linked records available (${samOpportunityLinks(event).length}).`);
	return insights;
}

function locationLabel(event: (typeof events)[number]) {
	return event.location.state ? `${event.location.city}, ${event.location.state}` : event.location.city;
}

function costLabel(event: (typeof events)[number]) {
	const range = event.ontology.logistics.estimatedCostUsd;
	if (!range) return null;
	if (range.max === 0 && range.min === 0) return '$0';
	if (range.min === range.max) return `$${range.min.toLocaleString()}`;
	return `$${range.min.toLocaleString()} - $${range.max.toLocaleString()}`;
}

function sourceConfidenceBand(event: (typeof events)[number]) {
	const confidence = event.ontology.provenance.map((p) => p.confidence);
	if (confidence.includes('High')) return 'high';
	if (confidence.includes('Medium')) return 'medium';
	return 'low';
}

function sourceConfidenceLabel(event: (typeof events)[number]) {
	const band = sourceConfidenceBand(event);
	if (band === 'high') return 'High';
	if (band === 'medium') return 'Medium';
	return 'Low';
}

function sourceTypeLabel(event: (typeof events)[number]) {
	const sourceTypes = event.ontology.provenance.map((source) => String(source.type || '').toLowerCase());
	if (sourceTypes.includes('official')) return 'Official';
	if (sourceTypes.includes('government')) return 'Government';
	if (sourceTypes.includes('aggregator')) return 'Aggregator';
	if (sourceTypes.includes('manual')) return 'Manual';
	return 'Source';
}

function sourceTypeTone(event: (typeof events)[number]) {
	const source = sourceTypeLabel(event).toLowerCase();
	if (source === 'official' || source === 'government') return 'trusted';
	if (source === 'aggregator') return 'aggregator';
	if (source === 'manual') return 'manual';
	return 'neutral';
}

function eventFreshnessBadge(event: (typeof events)[number]) {
	const all = event.ontology.provenance.map((source) => provenanceFreshness(source.lastVerified));
	if (!all.length) return { label: 'Unknown', tone: 'unknown' as const };
	if (all.some((entry) => entry.tone === 'stale')) return { label: 'Stale', tone: 'stale' as const };
	if (all.some((entry) => entry.tone === 'watch')) return { label: 'Watch', tone: 'watch' as const };
	if (all.some((entry) => entry.tone === 'fresh')) return { label: 'Fresh', tone: 'fresh' as const };
	return { label: 'Unknown', tone: 'unknown' as const };
}

function quickTopicTags(event: (typeof events)[number]) {
	const blob = [
		event.title,
		event.description,
		event.branch,
		event.type,
		event.ontology.themes.join(' '),
		event.ontology.capabilityAreas.join(' '),
		event.ontology.keywords.join(' '),
		event.ontology.notes ?? '',
	].join(' ').toLowerCase();

	const tags = new Set<string>();
	if (/\bai\b|artificial intelligence|ml\b|machine learning|agentic|autonomy|autonomous/.test(blob)) tags.add('ai');
	if (/\bcloud\b|multi-cloud|hybrid|edge\b|kubernetes|container/.test(blob)) tags.add('cloud');
	if (/software|devsecops|devops|application|platform engineering|software factory|code|pipeline/.test(blob)) tags.add('software');
	if (/\bcyber\b|zero trust|identity|cmmc|supply chain security|security/.test(blob)) tags.add('cyber');
	return [...tags];
}

function eventCandidateLinks(event: (typeof events)[number]) {
	const links = [
		event.ontology.links.official,
		event.ontology.links.registration,
		event.ontology.links.callForPapers,
		event.ontology.links.agenda,
		event.ontology.links.hotelBlock,
		...event.ontology.provenance.map((source) => source.url),
	]
		.map((url) => sanitizedLink(url))
		.filter((url): url is string => Boolean(url));
	return [...new Set(links)];
}

function eventPrimaryLink(event: (typeof events)[number]) {
	return eventCandidateLinks(event)[0] ?? null;
}

function eventAuxiliaryLinks(event: (typeof events)[number]) {
	const primary = eventPrimaryLink(event);
	const registration = sanitizedLink(event.ontology.links.registration);
	const callForPapers = sanitizedLink(event.ontology.links.callForPapers);
	const agenda = sanitizedLink(event.ontology.links.agenda);
	const hotelBlock = sanitizedLink(event.ontology.links.hotelBlock);
	const sourceReferences = event.ontology.provenance
		.map((source) => sanitizedLink(source.url))
		.filter((url): url is string => Boolean(url && url !== primary && ![registration, callForPapers, agenda, hotelBlock].includes(url)))
		.slice(0, 3);
	return {
		registration: registration && registration !== primary ? registration : null,
		callForPapers: callForPapers && callForPapers !== primary ? callForPapers : null,
		agenda: agenda && agenda !== primary ? agenda : null,
		hotelBlock: hotelBlock && hotelBlock !== primary ? hotelBlock : null,
		sourceReferences,
	};
}

function addDaysIso(dateIso: string, days: number) {
	const d = new Date(`${dateIso}T00:00:00Z`);
	d.setUTCDate(d.getUTCDate() + days);
	return d.toISOString().slice(0, 10);
}

function gcalDate(dateIso: string) {
	return dateIso.replaceAll('-', '');
}

function icsEscape(value: string) {
	return value
		.replaceAll('\\', '\\\\')
		.replaceAll(';', '\\;')
		.replaceAll(',', '\\,')
		.replaceAll('\n', '\\n');
}

function eventIcsContent(event: (typeof events)[number]) {
	if (!event.startDate) return null;
	const start = event.startDate;
	const endExclusive = addDaysIso(event.endDate ?? event.startDate, 1);
	const detailsParts = [
		event.description,
		eventPrimaryLink(event) ? `Official: ${eventPrimaryLink(event)}` : null,
		samOpportunityLink(event) ? `SAM: ${samOpportunityLink(event)}` : null,
		`Source confidence: ${sourceConfidenceLabel(event)}`,
	].filter(Boolean);
	const uid = `${event.id}@adamboas.com`;
	const stamp = `${new Date().toISOString().replaceAll('-', '').replaceAll(':', '').split('.')[0]}Z`;
	return [
		'BEGIN:VCALENDAR',
		'VERSION:2.0',
		'PRODID:-//Adam Boas//DoW Events Intelligence//EN',
		'CALSCALE:GREGORIAN',
		'METHOD:PUBLISH',
		'BEGIN:VEVENT',
		`UID:${icsEscape(uid)}`,
		`DTSTAMP:${stamp}`,
		`DTSTART;VALUE=DATE:${gcalDate(start)}`,
		`DTEND;VALUE=DATE:${gcalDate(endExclusive)}`,
		`SUMMARY:${icsEscape(event.title)}`,
		`DESCRIPTION:${icsEscape(detailsParts.join('\n'))}`,
		`LOCATION:${icsEscape(locationLabel(event))}`,
		eventPrimaryLink(event) ? `URL:${icsEscape(eventPrimaryLink(event)!)}` : null,
		'END:VEVENT',
		'END:VCALENDAR',
	]
		.filter(Boolean)
		.join('\r\n');
}

function eventOutlookIcsLink(event: (typeof events)[number]) {
	const ics = eventIcsContent(event);
	if (!ics) return null;
	return `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
}

function eventIcsFilename(event: (typeof events)[number]) {
	return `${event.id}.ics`;
}

function eventCalendarLink(event: (typeof events)[number]) {
	if (!event.startDate) return null;
	const start = event.startDate;
	const endExclusive = addDaysIso(event.endDate ?? event.startDate, 1);
	const detailsParts = [
		event.description,
		eventPrimaryLink(event) ? `Official: ${eventPrimaryLink(event)}` : null,
		samOpportunityLink(event) ? `SAM: ${samOpportunityLink(event)}` : null,
		`Source confidence: ${sourceConfidenceLabel(event)}`,
	].filter(Boolean);
	const params = new URLSearchParams({
		action: 'TEMPLATE',
		text: event.title,
		dates: `${gcalDate(start)}/${gcalDate(endExclusive)}`,
		details: detailsParts.join('\n'),
		location: locationLabel(event),
	});
	return `https://calendar.google.com/calendar/render?${params.toString()}`;
}

function confidenceNotes(event: (typeof events)[number]) {
	const confidence = sourceConfidenceLabel(event);
	const freshest = eventFreshnessBadge(event);
	const evidence = evidenceHealth(event);
	return `${confidence} source confidence. ${freshest.label}. ${evidence}`;
}

function acquisitionReferences(event: (typeof events)[number]) {
	const refs: string[] = [];
	if (event.ontology.acquisition?.solicitationNumber) refs.push(`Solicitation ${event.ontology.acquisition.solicitationNumber}`);
	if (noticeTypeLabel(event)) refs.push(`${noticeTypeLabel(event)} notice`);
	if (samOpportunityLinks(event).length) refs.push(`${samOpportunityLinks(event).length} SAM linked record(s)`);
	return refs;
}

---

<SiteLayout
	title="DoW Events Intelligence | Adam Boas"
	description="Upcoming DoW events with validated links, source transparency, and layered opportunity intelligence."
	canonicalHref="https://www.adamboas.com/events/"
	image="/og/events.png"
>
	<StickyBrowseBar active="events" />


	<section class="mt-2 space-y-4">
		<section class="card p-3 radar-control-shell control-shell">
			<div class="flex flex-wrap items-start justify-between gap-2">
				<div class="max-w-3xl">
					<h1 class="text-xl font-semibold tracking-tight text-slate-50 sm:text-2xl">DoW Events Intelligence</h1>
					<p class="mt-0.5 text-xs text-slate-400">
						<a href={withBase('/events/sources/')}>Source feeds</a>
						<span class="text-slate-600"> · </span>
						<a href="https://github.com/anboas/adamboas.info/blob/main/src/data/radar/feed-registry.json" target="_blank" rel="noreferrer">Feed registry PR target</a>
					</p>
				</div>
				<div class="flex flex-wrap gap-1.5">
					<button id="radar-toggle-map" class="radar-btn radar-btn-tight" type="button">Pin map above list</button>
					<button id="radar-toggle-compact" class="radar-btn radar-btn-tight" type="button">Compact mode</button>
				</div>
			</div>
			<details id="radar-overview-panel" class="radar-filter-panel radar-overview-panel mt-2">
				<summary class="radar-summary radar-summary-primary">Overview + quick filters</summary>
				<div class="mt-2 space-y-2">
					<div class="flex flex-wrap gap-2">
						<span class="radar-mini-stat">{summaryStats.total} events</span>
						<span class="radar-mini-stat">{summaryStats.upcoming} upcoming</span>
						<span class="radar-mini-stat">{summaryStats.industryDays} industry days</span>
						<span class="radar-mini-stat">{summaryStats.nextInDays === null ? 'next date TBD' : `next in ${summaryStats.nextInDays}d`}</span>
						<span class="radar-mini-stat">{summaryStats.needsDate} needs date</span>
					</div>
					<div class="flex flex-wrap items-center gap-2" id="radar-quick-topics" aria-label="Quick topic filters">
						<span class="radar-quick-label">Quick:</span>
						<button class="radar-topic-btn" type="button" data-topic="ai" aria-pressed="false">AI</button>
						<button class="radar-topic-btn" type="button" data-topic="cloud" aria-pressed="false">Cloud</button>
						<button class="radar-topic-btn" type="button" data-topic="software" aria-pressed="false">Software</button>
						<button class="radar-topic-btn" type="button" data-topic="cyber" aria-pressed="false">Cyber</button>
					</div>
					<div class="flex flex-wrap items-center gap-2" id="radar-quick-window" aria-label="Quick timeline filters">
						<span class="radar-quick-label">Window:</span>
						<button class="radar-topic-btn" type="button" data-window-days="30" aria-pressed="false">Next 30d</button>
						<button class="radar-topic-btn" type="button" data-window-days="90" aria-pressed="false">Next 90d</button>
						<button class="radar-topic-btn" type="button" data-window-days="180" aria-pressed="false">Next 180d</button>
					</div>
				</div>
			</details>
			<div class="mt-2 border-t border-slate-800 pt-2 radar-filter-wrap control-shell-row">
				<label class="block">
					<input id="radar-q" aria-label="Search events" data-global-search class="radar-input" type="search" placeholder="Search events by title, agency, keyword, or location..." />
				</label>
				<details id="radar-filter-panel" class="radar-filter-panel mt-2">
					<summary class="radar-summary radar-summary-primary">More filters</summary>
					<div class="mt-2 grid gap-2 text-sm md:grid-cols-4">
						<select id="radar-branch" class="radar-input" aria-label="Filter by branch">
							<option value="">All branches</option>
							{branches.map((branch) => <option value={branch}>{branch}</option>)}
						</select>
						<select id="radar-type" class="radar-input" aria-label="Filter by event type">
							<option value="">All types</option>
							{types.map((type) => <option value={type}>{type}</option>)}
						</select>
						<div id="radar-status-wrap">
							<select id="radar-status" class="radar-input" aria-label="Filter by status">
								<option value="">All statuses</option>
								{statuses.map((status) => <option value={status}>{status}</option>)}
							</select>
						</div>
						<button id="radar-reset" class="radar-btn" type="button">Reset</button>
						<label class="radar-check"><input id="radar-upcoming-only" type="checkbox" /><span>Upcoming only</span></label>
						<label class="radar-check"><input id="radar-verified-only" type="checkbox" /><span>High-confidence only</span></label>
						<label class="radar-check"><input id="radar-show-past" type="checkbox" /><span>Show past</span></label>
					</div>
				</details>
			</div>

			<div class="mt-2 border-t border-slate-800 pt-2">
				<div class="flex flex-wrap items-end justify-between gap-3">
					<div id="radar-filter-chips" class="radar-filter-chips"></div>
					<p id="radar-count" class="radar-count text-xs text-slate-400"></p>
				</div>
			</div>
		</section>

		<section id="radar-calendar-section" class="card p-5">
			<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
				<h2 class="section-title">Calendar View</h2>
				<div class="radar-cal-toolbar">
					<button id="radar-cal-prev" class="radar-btn radar-btn-tight" type="button" aria-label="Previous month">Prev month</button>
					<button id="radar-cal-today" class="radar-btn radar-btn-tight" type="button">This month</button>
					<button id="radar-cal-next" class="radar-btn radar-btn-tight" type="button" aria-label="Next month">Next month</button>
				</div>
			</div>
			<div class="mb-2 flex flex-wrap items-center justify-between gap-2">
				<p id="radar-cal-label" class="radar-cal-label">Month</p>
				<div class="radar-cal-legend">
					<span class="radar-cal-legend-chip">Tracked event</span>
					<span class="radar-cal-legend-chip radar-cal-legend-chip-attending" data-tooltip="I’ll be there and would love to connect." title="I’ll be there and would love to connect." aria-label="Attending. I’ll be there and would love to connect.">Attending</span>
					<span class="radar-cal-legend-chip">🤖 AI</span>
					<span class="radar-cal-legend-chip">🧩 Software</span>
					<span class="radar-cal-legend-chip">☁️ Cloud</span>
					<span class="radar-cal-legend-chip">🛡️ Cyber</span>
				</div>
			</div>
			<div id="radar-cal-empty" class="hidden rounded-none border border-slate-800 bg-slate-950/60 p-3 text-xs text-slate-300">
				No dated events match your current filters for this month.
			</div>
			<div id="radar-calendar-grid" class="radar-calendar-grid" aria-label="Events calendar"></div>
		</section>

		<div class="radar-main-col">
			<section id="radar-list-section" class="card p-5">
				<div class="mb-3 flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between">
					<h2 class="section-title radar-list-title">Upcoming Events</h2>
					<select id="radar-sort" class="radar-input radar-input-sort w-full sm:w-auto sm:min-w-[11.5rem]" aria-label="Sort events">
						<option value="soonest">Soonest first</option>
						<option value="latest">Latest first</option>
						<option value="signal">Signal first</option>
						<option value="branch">Branch</option>
					</select>
				</div>
				<div id="radar-empty" class="hidden rounded-none border border-slate-800 bg-slate-950/60 p-4 text-sm text-slate-300">
					No events match your current filters.
				</div>
				<div id="radar-list" class="space-y-3 radar-list">
					{events.map((event) => (
						<article
							id={event.id}
							class="radar-card"
							data-event-card
							data-id={event.id}
							data-days={daysUntilValue(event.startDate) ?? ''}
							data-date={event.startDate ?? ''}
							data-end-date={event.endDate ?? event.startDate ?? ''}
							data-status={event.status}
							data-type={event.type}
							data-branch={event.branch}
							data-attending={isAttendingEvent(event) ? '1' : '0'}
							data-signal={event.signal}
							data-confidence={sourceConfidenceBand(event)}
							data-topics={quickTopicTags(event).join(',')}
							data-title={event.title}
							data-link={eventPrimaryLink(event) ?? ''}
							data-sam-link={samOpportunityLink(event) ?? ''}
							data-calendar-link={eventCalendarLink(event) ?? ''}
							data-outlook-link={eventOutlookIcsLink(event) ?? ''}
							data-lat={event.location.lat}
							data-lng={event.location.lng}
							data-search={`${event.title} ${event.description} ${event.branch} ${event.type} ${event.status} ${event.location.city} ${event.location.state ?? ''} ${event.ontology.themes.join(' ')} ${event.ontology.stakeholders.join(' ')} ${event.ontology.keywords.join(' ')} ${event.ontology.provenance.map((p) => `${p.type} ${p.confidence} ${p.name}`).join(' ')} ${inferEngagementKinds(event).join(' ')} ${noticeTypeLabel(event) ?? ''}`.toLowerCase()}
						>
							<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
								<div class="min-w-0 flex-1">
									<h3 class="mt-1 text-base font-semibold leading-snug text-slate-50">{event.title}</h3>
									<p class="mt-1 text-sm text-slate-300 radar-desc">{event.description}</p>
									<p class="mt-2 text-xs text-slate-400 radar-meta">
										<span class="radar-meta-item">{locationLabel(event)}</span>
										<span class="radar-meta-sep" aria-hidden="true">·</span>
										<span class="radar-meta-item">{fmtDateRange(event.startDate, event.endDate)}</span>
										{costLabel(event) ? <><span class="radar-meta-sep" aria-hidden="true">·</span><span class="radar-meta-item">Reg: {costLabel(event)}</span></> : null}
									</p>
								</div>
								<div class="flex w-full flex-col items-start gap-1.5 sm:w-auto sm:items-end">
									<div class="flex w-full flex-wrap items-center gap-2 sm:w-auto sm:justify-end">
										<div class="radar-days-chip">{daysUntilBadge(event.startDate)}</div>
										{eventPrimaryLink(event) ? <a class="radar-pin-btn radar-link-btn" href={eventPrimaryLink(event)!} target="_blank" rel="noreferrer">Event Link</a> : null}
										{(eventCalendarLink(event) || eventOutlookIcsLink(event)) ? (
											<span class="radar-calendar-group" aria-label="Calendar options">
												<span class="radar-calendar-group-label">Calendar</span>
												{eventCalendarLink(event) ? <a class="radar-calendar-chip radar-calendar-chip-google" href={eventCalendarLink(event)!} target="_blank" rel="noreferrer">Google</a> : null}
												{eventOutlookIcsLink(event) ? <a class="radar-calendar-chip radar-calendar-chip-outlook" href={eventOutlookIcsLink(event)!} download={eventIcsFilename(event)}>Outlook</a> : null}
											</span>
										) : null}
										<button class="radar-pin-btn" type="button" data-map-focus data-id={event.id}>Map</button>
										<button class="radar-pin-btn" type="button" data-calendar-focus data-id={event.id}>In Calendar</button>
									</div>
									<div class="radar-badge-row">
										<span class={`radar-source-confidence-pill radar-source-confidence-pill-${sourceTypeTone(event)}`} title="Source confidence and source type">{sourceConfidenceLabel(event)} · {sourceTypeLabel(event)}</span>
										<span class="radar-evidence-pill radar-evidence-pill-fresh hidden" data-fresh-badge title="Added recently to your feed">Fresh</span>
										<span class="radar-new-pill hidden" data-new-badge>New</span>
									</div>
									<p class="radar-card-kicker text-left sm:text-right">{event.branch} · {event.type} · {event.status}</p>
								</div>
							</div>

							<div class="mt-3 flex flex-wrap gap-2 radar-theme-row">
								{event.ontology.themes.slice(0, 4).map((theme) => <span class="radar-pill">{theme}</span>)}
							</div>

							<details class="mt-3 radar-details">
								<summary>Event intelligence details</summary>

								<div class="mt-4 grid gap-4 lg:grid-cols-2">
									<div>
										<p class="radar-section-label">Verified links</p>
										<ul class="radar-listing">
											{eventPrimaryLink(event) ? <li><a href={eventPrimaryLink(event)!} target="_blank" rel="noreferrer">Official page</a></li> : null}
											{(samOpportunityLink(event) && samOpportunityLink(event) !== eventPrimaryLink(event)) ? <li><a href={samOpportunityLink(event)!} target="_blank" rel="noreferrer">SAM opportunity</a></li> : null}
											{eventAuxiliaryLinks(event).registration ? <li><a href={eventAuxiliaryLinks(event).registration!} target="_blank" rel="noreferrer">Registration</a></li> : null}
											{(eventCalendarLink(event) || eventOutlookIcsLink(event)) ? (
												<li>
													<strong>Add to calendar:</strong>{' '}
													{eventCalendarLink(event) ? <a href={eventCalendarLink(event)!} target="_blank" rel="noreferrer">Google</a> : null}
													{(eventCalendarLink(event) && eventOutlookIcsLink(event)) ? <span>{' · '}</span> : null}
													{eventOutlookIcsLink(event) ? <a href={eventOutlookIcsLink(event)!} download={eventIcsFilename(event)}>Outlook (.ics)</a> : null}
												</li>
											) : null}
											{eventAuxiliaryLinks(event).callForPapers ? <li><a href={eventAuxiliaryLinks(event).callForPapers!} target="_blank" rel="noreferrer">Call for papers</a></li> : null}
											{eventAuxiliaryLinks(event).agenda ? <li><a href={eventAuxiliaryLinks(event).agenda!} target="_blank" rel="noreferrer">Agenda</a></li> : null}
											{eventAuxiliaryLinks(event).hotelBlock ? <li><a href={eventAuxiliaryLinks(event).hotelBlock!} target="_blank" rel="noreferrer">Hotel block</a></li> : null}
											{eventAuxiliaryLinks(event).sourceReferences.length ? (
												<li>
													<strong>Source references:</strong>{' '}
													{eventAuxiliaryLinks(event).sourceReferences.map((url, idx) => (
														<span>
															<a href={url} target="_blank" rel="noreferrer">Ref {idx + 1}</a>
															{idx < eventAuxiliaryLinks(event).sourceReferences.length - 1 ? <span>{' · '}</span> : null}
														</span>
													))}
												</li>
											) : null}
										</ul>
									</div>
									<div>
										<p class="radar-section-label">Logistics</p>
										<ul class="radar-listing">
											<li><strong>Format:</strong> {event.ontology.logistics.format}</li>
											{costLabel(event) ? <li><strong>Estimated cost:</strong> {costLabel(event)}</li> : null}
											<li><strong>Travel burden from DC:</strong> {event.ontology.logistics.travelBurdenFromDc}</li>
											{event.location.venue ? <li><strong>Venue:</strong> {event.location.venue}</li> : null}
										</ul>
									</div>
								</div>

								{(inferEngagementKinds(event).length || noticeTypeLabel(event) || isSamOfficialNotice(event) || event.ontology.acquisition?.agency || event.ontology.acquisition?.solicitationNumber || event.ontology.acquisition?.responseDueDate || event.ontology.acquisition?.registrationDeadline || inferredGovernmentOrganizations(event).length || governmentPocs(event).length || informationalInsights(event).length) ? (
									<div class="mt-4 grid gap-4 lg:grid-cols-2">
										<div>
											<p class="radar-section-label">Opportunity intelligence</p>
											<ul class="radar-listing">
												{noticeTypeLabel(event) ? <li><strong>Notice type:</strong> {noticeTypeLabel(event)}</li> : null}
												{inferEngagementKinds(event).length ? <li><strong>Opportunity signals:</strong> {inferEngagementKinds(event).join(', ')}</li> : null}
												{event.ontology.acquisition?.agency ? <li><strong>Agency:</strong> {event.ontology.acquisition?.agency}</li> : null}
												{event.ontology.acquisition?.solicitationNumber ? <li><strong>Solicitation #:</strong> {event.ontology.acquisition?.solicitationNumber}</li> : null}
												{event.ontology.acquisition?.registrationDeadline ? <li><strong>Registration closes:</strong> {fmtDate(event.ontology.acquisition?.registrationDeadline)}</li> : null}
												{event.ontology.acquisition?.responseDueDate ? <li><strong>Response due:</strong> {fmtDate(event.ontology.acquisition?.responseDueDate)}</li> : null}
												{samOpportunityLinks(event).length ? (
													<li>
														<strong>SAM opportunities:</strong>{' '}
														{samOpportunityLinks(event).map((url, idx) => (
															<span>
																<a href={url} target="_blank" rel="noreferrer">{samOpportunityLinks(event).length > 1 ? `Link ${idx + 1}` : 'Open notice'}</a>
																{idx < samOpportunityLinks(event).length - 1 ? <span>{' · '}</span> : null}
															</span>
														))}
													</li>
												) : null}
												{acquisitionReferences(event).length ? <li><strong>Acquisition references:</strong> {acquisitionReferences(event).join(' · ')}</li> : null}
											</ul>
										</div>
										<div>
											<p class="radar-section-label">Government organizations</p>
											{inferredGovernmentOrganizations(event).length ? (
												<ul class="radar-listing">
													{inferredGovernmentOrganizations(event).map((org) => <li>{org}</li>)}
												</ul>
											) : (
												<p class="mt-2 text-xs text-slate-500">No government organizations inferred yet.</p>
											)}
										</div>
										<div>
											<p class="radar-section-label">Public government contacts</p>
											{governmentPocs(event).length ? (
												<ul class="radar-listing">
													{governmentPocs(event).map((contact) => (
														<li>
															{contact.name}
															{contact.role ? <span class="text-slate-500"> · {contact.role}</span> : null}
															{contact.organization ? <span class="text-slate-500"> · {contact.organization}</span> : null}
															{contact.email ? <span class="text-slate-500"> · {contact.email}</span> : null}
														</li>
													))}
												</ul>
											) : (
												<p class="mt-2 text-xs text-slate-500">No public government contacts captured yet.</p>
											)}
										</div>
										<div>
											<p class="radar-section-label">Actionable insights</p>
											{informationalInsights(event).length ? (
												<ul class="radar-listing">
													{informationalInsights(event).map((insight) => <li>{insight}</li>)}
												</ul>
											) : (
												<p class="mt-2 text-xs text-slate-500">No sourced actionable insights yet.</p>
											)}
										</div>
									</div>
								) : null}

								<div class="mt-4">
									<p class="radar-section-label">Schedule</p>
									<ul class="radar-listing">
										<li><strong>Days until start:</strong> {daysUntilDetail(event.startDate)}</li>
										<li><strong>Event window:</strong> {fmtDateRange(event.startDate, event.endDate)}</li>
									</ul>
								</div>

								<div class="mt-4">
									<p class="radar-section-label">Evidence & provenance</p>
									<ul class="radar-listing">
										{event.ontology.provenance.map((source) => (
											<li>
												<a href={source.url} target="_blank" rel="noreferrer">{source.name}</a>
												<span class="text-slate-500"> · {source.type}, {source.confidence} confidence, verified {source.lastVerified}</span>
												<span class={`radar-evidence-pill radar-evidence-pill-${provenanceFreshness(source.lastVerified).tone}`}>{provenanceFreshness(source.lastVerified).label}</span>
												{source.evidenceId ? <span class="text-slate-500"> · evidence {source.evidenceId}</span> : null}
											</li>
										))}
									</ul>
									<p class="mt-2 text-xs text-slate-400">Evidence health: {evidenceHealth(event)}</p>
									<p class="mt-1 text-xs text-slate-400">Confidence notes: {confidenceNotes(event)}</p>
									{event.ontology.notes ? <p class="mt-2 text-xs text-slate-400">{event.ontology.notes}</p> : null}
								</div>
							</details>
						</article>
					))}
				</div>
				<div id="radar-pagination" class="mt-4 hidden flex flex-wrap items-center justify-between gap-2 md:flex-nowrap">
					<p id="radar-pagination-status" class="text-xs text-slate-400"></p>
					<div class="flex items-center gap-2">
						<button id="radar-page-first" class="radar-btn radar-btn-tight" type="button">First</button>
						<button id="radar-page-prev" class="radar-btn radar-btn-tight" type="button">Prev</button>
						<span id="radar-page-label" class="text-xs text-slate-300">Page 1 of 1</span>
						<button id="radar-page-next" class="radar-btn radar-btn-tight" type="button">Next</button>
						<button id="radar-page-last" class="radar-btn radar-btn-tight" type="button">Last</button>
					</div>
				</div>

			</section>

			<section id="radar-map-section" class="card p-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="section-title">Geographic View</h2>
					<div class="radar-map-tools">
						<button id="radar-map-fit" class="radar-btn radar-btn-tight" type="button">Fit Results</button>
						<button id="radar-map-reset" class="radar-btn radar-btn-tight" type="button">Reset</button>
					</div>
				</div>
				<div id="radar-map" class="radar-map" aria-label="Event map">
					<div id="radar-leaflet-map" class="radar-leaflet-map"></div>
				</div>
				<p id="radar-map-sub" class="radar-map-sub">Mapped events · clusters on · drag to pan · Ctrl/Cmd+scroll to zoom</p>
			</section>
		</div>
		<p class="radar-legal-note">
			Event-tracker entries are compiled from public sources for research and planning. Source owners retain rights to their original content.
			Always verify key dates, terms, and eligibility on the official source before acting.
		</p>
	</section>

	<section class="mt-6">
		<a class="text-sm text-slate-300 hover:text-slate-100" href={withBase('/writing/')}>← Back to writing</a>
	</section>
</SiteLayout>

<script is:inline>
	const controls = {
		filterPanel: document.getElementById('radar-filter-panel'),
		q: document.getElementById('radar-q'),
		branch: document.getElementById('radar-branch'),
		type: document.getElementById('radar-type'),
		status: document.getElementById('radar-status'),
		sort: document.getElementById('radar-sort'),
		upcomingOnly: document.getElementById('radar-upcoming-only'),
		verifiedOnly: document.getElementById('radar-verified-only'),
		showPast: document.getElementById('radar-show-past'),
		toggleMap: document.getElementById('radar-toggle-map'),
		toggleCompact: document.getElementById('radar-toggle-compact'),
		calendarPrev: document.getElementById('radar-cal-prev'),
		calendarNext: document.getElementById('radar-cal-next'),
		calendarToday: document.getElementById('radar-cal-today'),
		reset: document.getElementById('radar-reset'),
		topicButtons: Array.from(document.querySelectorAll('[data-topic]')),
		windowButtons: Array.from(document.querySelectorAll('[data-window-days]')),
	};

	const list = document.getElementById('radar-list');
	const count = document.getElementById('radar-count');
	const empty = document.getElementById('radar-empty');
	const map = document.getElementById('radar-map');
	const mapSub = document.getElementById('radar-map-sub');
	const mapCanvas = document.getElementById('radar-leaflet-map');
	const mapFitBtn = document.getElementById('radar-map-fit');
	const mapResetBtn = document.getElementById('radar-map-reset');
	const mapSection = document.getElementById('radar-map-section');
	const listSection = document.getElementById('radar-list-section');
	const mainCol = document.querySelector('.radar-main-col');
	const calendarSection = document.getElementById('radar-calendar-section');
	const calendarGrid = document.getElementById('radar-calendar-grid');
	const calendarLabel = document.getElementById('radar-cal-label');
	const calendarEmpty = document.getElementById('radar-cal-empty');
	const statusWrap = document.getElementById('radar-status-wrap');
	const filterChips = document.getElementById('radar-filter-chips');
	const cards = Array.from(document.querySelectorAll('[data-event-card]'));
	const mapFocusButtons = Array.from(document.querySelectorAll('[data-map-focus]'));
	const calendarFocusButtons = Array.from(document.querySelectorAll('[data-calendar-focus]'));
	const pagination = document.getElementById('radar-pagination');
	const pageFirst = document.getElementById('radar-page-first');
	const pagePrev = document.getElementById('radar-page-prev');
	const pageNext = document.getElementById('radar-page-next');
	const pageLast = document.getElementById('radar-page-last');
	const pageLabel = document.getElementById('radar-page-label');
	const pageStatus = document.getElementById('radar-pagination-status');
	const eventStateStorageKey = 'adamboas.events.state.v2';
	const legacySeenEventsStorageKey = 'adamboas.events.seen.v1';
	const mapPinStorageKey = 'adamboas.events.mapPin.v1';
	const PAGE_SIZE = 10;
	const FRESH_WINDOW_DAYS = 14;
	let eventState = { version: 2, events: {} };

	let compactMode = true;
	let mapPin = 'below';
	let calendarMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
	let currentPage = 1;
	let currentTotalPages = 1;
	let statusFacetEnabled = true;


	function parseDate(value) {
		if (!value) return null;
		const ms = new Date(value).getTime();
		return Number.isNaN(ms) ? null : ms;
	}


	function parseDays(value) {
		if (value === '' || value == null) return null;
		const days = Number(value);
		return Number.isFinite(days) ? days : null;
	}

	function parseTopics(value) {
		return String(value || '')
			.split(',')
			.map((v) => v.trim().toLowerCase())
			.filter(Boolean);
	}

	function parseWindowDays(value) {
		const parsed = Number(value);
		if (!Number.isFinite(parsed) || parsed <= 0) return null;
		return Math.floor(parsed);
	}

	function activeWindowDays() {
		const selected = controls.windowButtons.find((button) => button.getAttribute('aria-pressed') === 'true');
		if (!selected) return null;
		return parseWindowDays(selected.dataset.windowDays || '');
	}

	function setActiveWindowDays(days) {
		for (const button of controls.windowButtons) {
			const buttonDays = parseWindowDays(button.dataset.windowDays || '');
			const pressed = days !== null && buttonDays === days;
			button.setAttribute('aria-pressed', pressed ? 'true' : 'false');
		}
	}

	function topicStateToValue(topics) {
		return [...topics].sort().join(',');
	}

	function readMapPinPreference() {
		try {
			const raw = localStorage.getItem(mapPinStorageKey);
			if (raw === 'above' || raw === 'below') return raw;
		} catch {}
		return 'below';
	}

	function persistMapPinPreference() {
		try {
			localStorage.setItem(mapPinStorageKey, mapPin);
		} catch {}
	}

	function applyMapPin() {
		if (!mainCol || !mapSection || !listSection) return;
		if (mapPin === 'above') mainCol.insertBefore(mapSection, listSection);
		else mainCol.appendChild(mapSection);
		if (controls.toggleMap) {
			controls.toggleMap.textContent = mapPin === 'above' ? 'Pin map below list' : 'Pin map above list';
		}
	}

	function parseYmdLocal(value) {
		if (!value) return null;
		const text = String(value).trim();
		const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
		if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
		const d = new Date(text);
		if (Number.isNaN(d.getTime())) return null;
		return new Date(d.getFullYear(), d.getMonth(), d.getDate());
	}

	function addDaysLocal(date, days) {
		return new Date(date.getFullYear(), date.getMonth(), date.getDate() + days);
	}

	function dayDiffLocal(a, b) {
		const dayMs = 86_400_000;
		const aUtc = Date.UTC(a.getFullYear(), a.getMonth(), a.getDate());
		const bUtc = Date.UTC(b.getFullYear(), b.getMonth(), b.getDate());
		return Math.round((bUtc - aUtc) / dayMs);
	}

	function monthStartLocal(date) {
		return new Date(date.getFullYear(), date.getMonth(), 1);
	}

	function sameLocalDay(a, b) {
		return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
	}

	function parseTopicList(value) {
		return String(value || '')
			.split(',')
			.map((v) => v.trim().toLowerCase())
			.filter(Boolean);
	}

	function primaryTopic(topics) {
		const order = ['ai', 'software', 'cloud', 'cyber'];
		for (const key of order) {
			if (topics.includes(key)) return key;
		}
		return topics[0] || '';
	}

	function topicCalendarLabel(topic) {
		if (topic === 'ai') return '🤖';
		if (topic === 'software') return '🧩';
		if (topic === 'cloud') return '☁️';
		if (topic === 'cyber') return '🛡️';
		return '•';
	}

	function calendarItemsFromCards(sourceCards) {
		const items = [];
		for (const card of sourceCards) {
			const start = parseYmdLocal(card.dataset.date || '');
			if (!start) continue;
			const endRaw = parseYmdLocal(card.dataset.endDate || card.dataset.date || '');
			const end = endRaw && endRaw >= start ? endRaw : start;
			const topics = parseTopicList(card.dataset.topics || '');
			items.push({
				id: card.dataset.id || '',
				title: card.dataset.title || 'Untitled event',
				start,
				end,
				attending: card.dataset.attending === '1',
				link: card.dataset.link || '',
				branch: card.dataset.branch || '',
				type: card.dataset.type || '',
				status: card.dataset.status || '',
				topic: primaryTopic(topics),
			});
		}
		items.sort((a, b) => a.start - b.start || dayDiffLocal(b.start, b.end) - dayDiffLocal(a.start, a.end) || a.title.localeCompare(b.title));
		return items;
	}

	function segmentWeekItems(items, weekStart, weekEnd) {
		const segments = [];
		for (const item of items) {
			if (item.end < weekStart || item.start > weekEnd) continue;
			const start = item.start < weekStart ? weekStart : item.start;
			const end = item.end > weekEnd ? weekEnd : item.end;
			segments.push({
				item,
				startCol: dayDiffLocal(weekStart, start) + 1,
				endCol: dayDiffLocal(weekStart, end) + 1,
				startsInWeek: item.start >= weekStart,
				endsInWeek: item.end <= weekEnd,
			});
		}
		segments.sort((a, b) => a.startCol - b.startCol || b.endCol - a.endCol || a.item.title.localeCompare(b.item.title));
		const laneEnds = [];
		for (const segment of segments) {
			let lane = laneEnds.findIndex((endCol) => segment.startCol > endCol);
			if (lane === -1) {
				lane = laneEnds.length;
				laneEnds.push(segment.endCol);
			} else {
				laneEnds[lane] = segment.endCol;
			}
			segment.lane = lane;
		}
		return { segments, lanes: laneEnds.length };
	}

	function fmtCalendarMonth(date) {
		return new Intl.DateTimeFormat(undefined, { month: 'long', year: 'numeric' }).format(date);
	}

	function fmtCalendarDateRange(start, end) {
		const fmt = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
		if (!start) return 'Date pending';
		if (!end || sameLocalDay(start, end)) return fmt.format(start);
		return `${fmt.format(start)} to ${fmt.format(end)}`;
	}

	function renderCalendar(sourceCards) {
		if (!calendarGrid) return;
		const items = calendarItemsFromCards(sourceCards);
		const monthStart = monthStartLocal(calendarMonth);
		const monthEnd = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0);
		const gridStart = addDaysLocal(monthStart, -monthStart.getDay());
		const days = Array.from({ length: 42 }, (_, idx) => addDaysLocal(gridStart, idx));
		const hasInMonth = items.some((item) => item.end >= monthStart && item.start <= monthEnd);

		if (calendarLabel) calendarLabel.textContent = fmtCalendarMonth(monthStart);
		if (calendarEmpty) calendarEmpty.classList.toggle('hidden', hasInMonth);
		calendarGrid.innerHTML = '';

		const weekdayRow = document.createElement('div');
		weekdayRow.className = 'radar-cal-weekdays';
		for (const label of ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']) {
			const cell = document.createElement('div');
			cell.className = 'radar-cal-weekday';
			cell.textContent = label;
			weekdayRow.appendChild(cell);
		}
		calendarGrid.appendChild(weekdayRow);

		for (let week = 0; week < 6; week += 1) {
			const weekStart = days[week * 7];
			const weekEnd = days[week * 7 + 6];
			const weekWrap = document.createElement('div');
			weekWrap.className = 'radar-cal-week';

			const dayRow = document.createElement('div');
			dayRow.className = 'radar-cal-days';
			for (let i = 0; i < 7; i += 1) {
				const day = days[week * 7 + i];
				const dayCell = document.createElement('div');
				dayCell.className = 'radar-cal-day';
				if (day.getMonth() !== monthStart.getMonth()) dayCell.classList.add('is-outside-month');
				if (sameLocalDay(day, new Date())) dayCell.classList.add('is-today');

				const dayNum = document.createElement('span');
				dayNum.className = 'radar-cal-day-num';
				dayNum.textContent = String(day.getDate());
				dayCell.appendChild(dayNum);

				const dayMatches = items.filter((item) => item.start <= day && item.end >= day).length;
				if (dayMatches) {
					const dayCount = document.createElement('span');
					dayCount.className = 'radar-cal-day-count';
					dayCount.textContent = String(dayMatches);
					dayCell.appendChild(dayCount);
				}

				dayRow.appendChild(dayCell);
			}
			weekWrap.appendChild(dayRow);

			const { segments, lanes } = segmentWeekItems(items, weekStart, weekEnd);
			const bars = document.createElement('div');
			bars.className = 'radar-cal-bars';
			if (lanes > 0) bars.style.gridTemplateRows = `repeat(${lanes}, minmax(1.15rem, auto))`;
			for (const segment of segments) {
				const el = segment.item.link ? document.createElement('a') : document.createElement('span');
				el.className = 'radar-cal-bar';
				if (segment.item.id) el.dataset.eventId = segment.item.id;
				if (!segment.startsInWeek) el.classList.add('is-continued-left');
				if (!segment.endsInWeek) el.classList.add('is-continued-right');
				if (segment.item.attending) el.classList.add('is-attending');
				el.style.gridColumn = `${segment.startCol} / ${segment.endCol + 1}`;
				el.style.gridRow = `${segment.lane + 1}`;
				const topicBadge = segment.item.topic ? `${topicCalendarLabel(segment.item.topic)} ` : '';
				const labelText = `${segment.item.attending ? '★ ' : ''}${topicBadge}${segment.item.title}`;
				const detailDate = fmtCalendarDateRange(segment.item.start, segment.item.end);
				const detailMeta = statusFacetEnabled
					? `${segment.item.branch} · ${segment.item.type} · ${segment.item.status}`
					: `${segment.item.branch} · ${segment.item.type}`;
				const label = document.createElement('span');
				label.className = 'radar-cal-bar-label';
				label.textContent = labelText;
				const tooltip = document.createElement('span');
				tooltip.className = 'radar-cal-tooltip';
				tooltip.innerHTML = `<span class="radar-cal-tooltip-title">${escapeHtml(segment.item.title)}</span><span class="radar-cal-tooltip-meta">${escapeHtml(detailDate)}</span><span class="radar-cal-tooltip-meta">${escapeHtml(detailMeta)}</span>`;
				el.setAttribute('aria-label', `${segment.item.title}. ${detailDate}. ${detailMeta}`);
				el.appendChild(label);
				el.appendChild(tooltip);
				if (segment.item.link) {
					el.href = segment.item.link;
					el.target = '_blank';
					el.rel = 'noreferrer';
				}
				bars.appendChild(el);
			}
			weekWrap.appendChild(bars);
			calendarGrid.appendChild(weekWrap);
		}
	}

	function nowIso() {
		return new Date().toISOString();
	}

	function parseIsoMs(value) {
		if (!value || typeof value !== 'string') return null;
		const ms = new Date(value).getTime();
		return Number.isNaN(ms) ? null : ms;
	}

	function parseLegacySeenIds() {
		try {
			const raw = localStorage.getItem(legacySeenEventsStorageKey);
			if (!raw) return new Set();
			const parsed = JSON.parse(raw);
			if (!Array.isArray(parsed)) return new Set();
			return new Set(parsed.map((v) => String(v)).filter(Boolean));
		} catch {
			return new Set();
		}
	}

	function normalizeEventEntry(entry) {
		return {
			firstDetectedAt: typeof entry?.firstDetectedAt === 'string' ? entry.firstDetectedAt : null,
			firstSeenAt: typeof entry?.firstSeenAt === 'string' ? entry.firstSeenAt : null,
			lastSeenAt: typeof entry?.lastSeenAt === 'string' ? entry.lastSeenAt : null,
		};
	}

	function persistEventState() {
		try {
			localStorage.setItem(eventStateStorageKey, JSON.stringify(eventState));
		} catch {}
	}

	function readEventState() {
		const ids = cards.map((card) => card.dataset.id).filter(Boolean);
		let stored = null;
		try {
			const raw = localStorage.getItem(eventStateStorageKey);
			if (raw) stored = JSON.parse(raw);
		} catch {}

		if (!stored || typeof stored !== 'object' || typeof stored.events !== 'object' || !stored.events) {
			const seenFromLegacy = parseLegacySeenIds();
			const hasLegacy = seenFromLegacy.size > 0;
			const stamp = nowIso();
			const seededEvents = {};
			for (const id of ids) {
				const seen = hasLegacy ? seenFromLegacy.has(id) : true;
				seededEvents[id] = {
					firstDetectedAt: null,
					firstSeenAt: seen ? stamp : null,
					lastSeenAt: seen ? stamp : null,
				};
			}
			eventState = { version: 2, initializedAt: stamp, events: seededEvents };
			persistEventState();
			return;
		}

		const normalizedEvents = {};
		for (const [id, value] of Object.entries(stored.events || {})) {
			if (!id) continue;
			normalizedEvents[String(id)] = normalizeEventEntry(value);
		}
		let changed = false;
		const discoveredAt = nowIso();
		for (const id of ids) {
			if (!normalizedEvents[id]) {
				normalizedEvents[id] = {
					firstDetectedAt: discoveredAt,
					firstSeenAt: null,
					lastSeenAt: null,
				};
				changed = true;
			}
		}
		eventState = {
			version: 2,
			initializedAt: typeof stored.initializedAt === 'string' ? stored.initializedAt : discoveredAt,
			events: normalizedEvents,
		};
		if (changed) persistEventState();
	}

	function freshAgeLabel(entry) {
		const detectedMs = parseIsoMs(entry?.firstDetectedAt);
		if (detectedMs === null) return null;
		const ageDays = Math.floor((Date.now() - detectedMs) / 86_400_000);
		if (ageDays < 0 || ageDays > FRESH_WINDOW_DAYS) return null;
		if (ageDays === 0) return 'Fresh';
		return `Fresh (${ageDays}d)`;
	}

	function typeKey(type) {
		return String(type || '')
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-+|-+$/g, '');
	}

	function typeTone(type) {
		const key = typeKey(type);
		if (['conference', 'workshop', 'summit', 'hackathon', 'exercise'].includes(key)) return key;
		return 'conference';
	}

	function daysMarker(days) {
		if (days == null) return '?';
		if (days < 0) return 'P';
		if (days === 0) return '0';
		if (days > 99) return '99+';
		return String(days);
	}

	function daysText(days) {
		if (days == null) return 'Date pending';
		if (days === 0) return 'Starts today';
		if (days > 0) return `Starts in ${days} day(s)`;
		return `Started ${Math.abs(days)} day(s) ago`;
	}

	function escapeHtml(str) {
		return String(str ?? '')
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;')
			.replaceAll("'", '&#39;');
	}

	function slowScrollTo(element, duration = 900) {
		if (!element) return;
		const startY = window.scrollY;
		const targetY = element.getBoundingClientRect().top + window.scrollY - Math.max(120, window.innerHeight * 0.24);
		const delta = targetY - startY;
		const start = performance.now();
		const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
		function frame(now) {
			const t = Math.min(1, (now - start) / duration);
			window.scrollTo(0, startY + delta * ease(t));
			if (t < 1) requestAnimationFrame(frame);
		}
		requestAnimationFrame(frame);
	}

	function focusCard(id) {
		const card = cards.find((c) => c.dataset.id === id);
		if (!card) return;
		for (const c of cards) c.classList.remove('radar-card-focus');
		card.classList.add('radar-card-focus');
		slowScrollTo(card, 980);
		setTimeout(() => card.classList.remove('radar-card-focus'), 2000);
	}

	function focusCalendarEvent(id) {
		if (!id) return;
		const card = cards.find((c) => c.dataset.id === id);
		if (!card) return;
		const start = parseYmdLocal(card.dataset.date || '');
		if (start) calendarMonth = new Date(start.getFullYear(), start.getMonth(), 1);
		render();
		if (calendarSection) slowScrollTo(calendarSection, 900);
		requestAnimationFrame(() => {
			const bars = Array.from(document.querySelectorAll('.radar-cal-bar[data-event-id]'));
			for (const bar of bars) bar.classList.remove('is-focus');
			const match = bars.find((bar) => bar.dataset.eventId === id);
			if (!match) return;
			match.classList.add('is-focus');
			setTimeout(() => match.classList.remove('is-focus'), 2400);
		});
	}

	function applyStatusFacetMode() {
		const uniqueStatuses = new Set(cards.map((c) => String(c.dataset.status || '').trim()).filter(Boolean));
		statusFacetEnabled = uniqueStatuses.size > 1;
		if (!statusFacetEnabled && controls.status) controls.status.value = '';
		if (statusWrap) statusWrap.classList.toggle('hidden', !statusFacetEnabled);
		if (!statusFacetEnabled && controls.filterPanel) {
			const state = stateFromUI();
			controls.filterPanel.open = hasActiveFilters(state);
		}
		for (const card of cards) {
			const kicker = card.querySelector('.radar-card-kicker');
			if (!kicker) continue;
			const branch = card.dataset.branch || 'Unknown';
			const type = card.dataset.type || 'Unknown';
			const status = card.dataset.status || 'Unknown';
			kicker.textContent = statusFacetEnabled ? `${branch} · ${type} · ${status}` : `${branch} · ${type}`;
		}
	}

	for (const card of cards) {
		card.classList.add(`radar-type-${typeTone(card.dataset.type)}`);
	}

	const US_BOUNDS = [[24.2, -125.2], [49.6, -66.0]];
	let mapLib = null;
	let clusterLayer = null;
	let leafletReady = false;
	let leafletFailed = false;
	let mapRenderedOnce = false;
	let markerIndex = new Map();

	function loadScript(src) {
		return new Promise((resolve, reject) => {
			const existing = document.querySelector(`script[data-radar-src="${src}"]`);
			if (existing) {
				if (existing.dataset.loaded === '1') return resolve();
				existing.addEventListener('load', () => resolve(), { once: true });
				existing.addEventListener('error', () => reject(new Error(`failed ${src}`)), { once: true });
				return;
			}
			const script = document.createElement('script');
			script.src = src;
			script.async = true;
			script.dataset.radarSrc = src;
			script.onload = () => {
				script.dataset.loaded = '1';
				resolve();
			};
			script.onerror = () => reject(new Error(`failed ${src}`));
			document.head.appendChild(script);
		});
	}

	function loadCss(href) {
		if (document.querySelector(`link[data-radar-href="${href}"]`)) return;
		const link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = href;
		link.dataset.radarHref = href;
		document.head.appendChild(link);
	}

	async function ensureLeaflet() {
		if (leafletReady && window.L?.markerClusterGroup) return true;
		try {
			loadCss('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css');
			loadCss('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css');
			loadCss('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css');
			await loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js');
			await loadScript('https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js');
			leafletReady = Boolean(window.L?.markerClusterGroup);
			return leafletReady;
		} catch {
			leafletFailed = true;
			if (mapSub) mapSub.textContent = 'Map failed to load.';
			return false;
		}
	}

	function enableModifierWheelZoom(map) {
		const container = map.getContainer();
		if (!container) return;
		let lastZoomTs = 0;
		container.addEventListener('wheel', (e) => {
			if (!(e.ctrlKey || e.metaKey)) return;
			e.preventDefault();
			const now = Date.now();
			if (now - lastZoomTs < 90) return;
			lastZoomTs = now;
			map.setZoom(map.getZoom() + (e.deltaY < 0 ? 1 : -1), { animate: false });
		}, { passive: false });
	}

	function pinIcon(daysLabel, tone, id) {
		return window.L.divIcon({
			className: 'radar-leaflet-pin-wrap',
			html: `<div class="radar-leaflet-pin radar-leaflet-pin-${tone}" data-event-id="${escapeHtml(id)}"><span>${escapeHtml(daysLabel)}</span></div>`,
			iconSize: [30, 30],
			iconAnchor: [15, 15],
		});
	}

	function markerPopup(card) {
		const id = card.dataset.id;
		const title = card.dataset.title || 'Untitled';
		const status = card.dataset.status || 'Unknown';
		const branch = card.dataset.branch || 'Unknown';
		const type = card.dataset.type || 'Unknown';
		const meta = card.querySelector('.radar-meta')?.textContent || '';
		const link = card.dataset.link || '';
		const samLink = card.dataset.samLink || '';
		const calendarLink = card.dataset.calendarLink || '';
		const outlookLink = card.dataset.outlookLink || '';
		const outlookFile = `${String(id || 'event').replace(/[^a-z0-9_-]/gi, '-')}.ics`;
		const days = parseDays(card.dataset.days);
		const statusClass = `radar-status-${String(status).toLowerCase().replaceAll(' ', '-')}`;
		const typeClass = `radar-type-${typeTone(type)}`;
		const linkHtml = link ? `<a class="radar-map-link" href="${escapeHtml(link)}" target="_blank" rel="noreferrer">Event Link</a>` : '';
		const samLinkHtml = samLink && samLink !== link ? `<a class="radar-map-link radar-map-link-sam" href="${escapeHtml(samLink)}" target="_blank" rel="noreferrer">SAM</a>` : '';
		const calendarLinkHtml = calendarLink ? `<a class="radar-map-link radar-map-link-calendar" href="${escapeHtml(calendarLink)}" target="_blank" rel="noreferrer">Google</a>` : '';
		const outlookLinkHtml = outlookLink ? `<a class="radar-map-link radar-map-link-outlook" href="${escapeHtml(outlookLink)}" download="${escapeHtml(outlookFile)}">Outlook</a>` : '';
		const calendarGroupHtml = (calendarLinkHtml || outlookLinkHtml)
			? `<span class="radar-map-cal-group"><span class="radar-map-cal-label">Cal</span>${calendarLinkHtml}${outlookLinkHtml}</span>`
			: '';
		return `
			<div class="radar-map-popup">
				<div class="radar-map-popup-title">${escapeHtml(title)}</div>
				<div class="radar-map-popup-meta"><span class="radar-map-popup-badge ${statusClass}">${escapeHtml(status)}</span> <span class="radar-map-popup-badge ${typeClass}">${escapeHtml(type)}</span> ${escapeHtml(branch)}</div>
				<div class="radar-map-popup-meta">${escapeHtml(meta)}</div>
				<div class="radar-map-popup-actions">
					<span class="radar-map-popup-days">${escapeHtml(daysText(days))}</span>
					<div class="radar-map-popup-cta">${linkHtml}${samLinkHtml}${calendarGroupHtml}<button class="radar-map-jump" type="button" data-event-id="${escapeHtml(id)}">Open event</button></div>
				</div>
			</div>
		`;
	}

	async function initLeafletMap() {
		if (mapLib || leafletFailed || !mapCanvas) return;
		const ok = await ensureLeaflet();
		if (!ok) return;

		mapLib = window.L.map(mapCanvas, {
			zoomControl: true,
			scrollWheelZoom: false,
			worldCopyJump: true,
		});
		window.L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
			subdomains: 'abcd',
			maxZoom: 18,
			attribution: '&copy; OpenStreetMap &copy; CARTO',
		}).addTo(mapLib);

		clusterLayer = window.L.markerClusterGroup({
			showCoverageOnHover: false,
			spiderfyOnMaxZoom: true,
			maxClusterRadius: 52,
		});
		mapLib.addLayer(clusterLayer);
		enableModifierWheelZoom(mapLib);
		mapLib.fitBounds(US_BOUNDS);
		mapLib.on('contextmenu', () => mapLib.fitBounds(US_BOUNDS));
		mapLib.on('popupopen', (e) => {
			document.querySelectorAll('.radar-leaflet-pin.is-active').forEach((n) => n.classList.remove('is-active'));
			const sourceIcon = e.popup?._source?._icon?.querySelector?.('.radar-leaflet-pin');
			if (sourceIcon) sourceIcon.classList.add('is-active');
			const el = e.popup?.getElement();
			const btn = el?.querySelector?.('.radar-map-jump');
			if (btn) btn.addEventListener('click', () => focusMapEvent(btn.dataset.eventId, { openPopup: false }));
		});
		mapLib.on('popupclose', () => {
			document.querySelectorAll('.radar-leaflet-pin.is-active').forEach((n) => n.classList.remove('is-active'));
		});
		mapFitBtn?.addEventListener('click', () => fitMapToResults());
		mapResetBtn?.addEventListener('click', () => mapLib.fitBounds(US_BOUNDS));
	}

	function fitMapToResults() {
		if (!mapLib || !clusterLayer) return;
		const bounds = clusterLayer.getBounds();
		if (bounds && bounds.isValid()) mapLib.fitBounds(bounds.pad(0.2));
		else mapLib.fitBounds(US_BOUNDS);
	}

	function focusMapEvent(id, options = { openPopup: true }) {
		if (!id) return;
		const card = cards.find((c) => c.dataset.id === id);
		if (!card) return;
		focusCard(id);
		if (!mapLib || !clusterLayer) {
			initLeafletMap().then(() => focusMapEvent(id, options));
			return;
		}
		const marker = markerIndex.get(id);
		if (!marker) return;
		clusterLayer.zoomToShowLayer(marker, () => {
			if (options.openPopup) marker.openPopup();
			mapLib.panTo(marker.getLatLng(), { animate: true, duration: 0.4 });
		});
	}

	function stateFromUI() {
		const topics = new Set(
			controls.topicButtons
				.filter((btn) => btn.getAttribute('aria-pressed') === 'true')
				.map((btn) => String(btn.dataset.topic || '').toLowerCase())
				.filter(Boolean),
		);
		return {
			q: controls.q.value.trim(),
			branch: controls.branch.value,
			type: controls.type.value,
			status: controls.status.value,
			sort: controls.sort.value,
			upcoming: controls.upcomingOnly.checked,
			verified: controls.verifiedOnly.checked,
			showPast: controls.showPast.checked,
			topics,
			windowDays: activeWindowDays(),
		};
	}

	function applyState(state) {
		controls.q.value = state.q || '';
		controls.branch.value = state.branch || '';
		controls.type.value = state.type || '';
		controls.status.value = state.status || '';
		controls.sort.value = state.sort || 'soonest';
		controls.upcomingOnly.checked = Boolean(state.upcoming);
		controls.verifiedOnly.checked = Boolean(state.verified);
		controls.showPast.checked = Boolean(state.showPast);
		const activeTopics = state.topics instanceof Set ? state.topics : new Set(parseTopics(state.topics));
		for (const button of controls.topicButtons) {
			const topic = String(button.dataset.topic || '').toLowerCase();
			button.setAttribute('aria-pressed', activeTopics.has(topic) ? 'true' : 'false');
		}
		setActiveWindowDays(parseWindowDays(state.windowDays));
	}

	function toQuery(state) {
		const params = new URLSearchParams();
		if (state.q) params.set('q', state.q);
		if (state.branch) params.set('branch', state.branch);
		if (state.type) params.set('type', state.type);
		if (state.status) params.set('status', state.status);
		if (state.sort && state.sort !== 'soonest') params.set('sort', state.sort);
		if (state.upcoming) params.set('upcoming', '1');
		if (state.verified) params.set('verified', '1');
		if (state.showPast) params.set('past', '1');
		if (state.topics?.size) params.set('topics', topicStateToValue(state.topics));
		if (state.windowDays) params.set('window', String(state.windowDays));
		if (currentPage > 1) params.set('page', String(currentPage));
		return params.toString();
	}

	function hasActiveFilters(state) {
		return Boolean(
			state.q ||
			state.branch ||
			state.type ||
			state.status ||
			state.upcoming ||
			state.verified ||
			state.showPast ||
			(state.topics && state.topics.size) ||
			state.windowDays ||
			(state.sort && state.sort !== 'soonest')
		);
	}

	function applyUrlState() {
		const params = new URLSearchParams(window.location.search);
		const state = {
			q: params.get('q') || '',
			branch: params.get('branch') || '',
			type: params.get('type') || '',
			status: params.get('status') || '',
			sort: params.get('sort') || 'soonest',
			upcoming: params.get('upcoming') === '1',
			verified: params.get('verified') === '1',
			showPast: params.get('past') === '1',
			topics: new Set(parseTopics(params.get('topics') || '')),
			windowDays: parseWindowDays(params.get('window')),
		};
		const page = Number(params.get('page') || '1');
		currentPage = Number.isFinite(page) && page > 0 ? Math.floor(page) : 1;
		applyState(state);
		if (controls.filterPanel) controls.filterPanel.open = hasActiveFilters(state);
	}

	function sortBySoonest(a, b) {
		const da = parseDate(a.dataset.date || '');
		const db = parseDate(b.dataset.date || '');
		if (da === null && db === null) return (a.dataset.title || '').localeCompare(b.dataset.title || '');
		if (da === null) return 1;
		if (db === null) return -1;
		return da - db;
	}

	function getVisibleCards() {
		const state = stateFromUI();
		const q = state.q.toLowerCase();
		const visible = cards.filter((card) => {
			if (state.branch && card.dataset.branch !== state.branch) return false;
			if (state.type && card.dataset.type !== state.type) return false;
			if (state.status && card.dataset.status !== state.status) return false;
			if (!state.showPast && card.dataset.status === 'Past' && state.status !== 'Past') return false;
			if (state.upcoming && card.dataset.status !== 'Upcoming') return false;
			if (state.verified && card.dataset.confidence !== 'high') return false;
			if (state.topics?.size) {
				const cardTopics = parseTopics(card.dataset.topics || '');
				if (!cardTopics.some((topic) => state.topics.has(topic))) return false;
			}
			if (state.windowDays) {
				const days = parseDays(card.dataset.days);
				if (days == null || days < 0 || days > state.windowDays) return false;
			}
			if (!q) return true;
			return (card.dataset.search || '').includes(q);
		});

		if (state.sort === 'latest') {
			visible.sort((a, b) => sortBySoonest(b, a));
		} else if (state.sort === 'signal') {
			const rank = { High: 3, Medium: 2, Low: 1 };
			visible.sort((a, b) => (rank[b.dataset.signal] - rank[a.dataset.signal]) || sortBySoonest(a, b));
		} else if (state.sort === 'branch') {
			visible.sort((a, b) => (a.dataset.branch || '').localeCompare(b.dataset.branch || '') || sortBySoonest(a, b));
		} else {
			visible.sort(sortBySoonest);
		}

		return { visible, state };
	}

	function renderFilterChips(state) {
		const chips = [];
		if (state.q) chips.push(`Search: ${state.q}`);
		if (state.branch) chips.push(`Branch: ${state.branch}`);
		if (state.type) chips.push(`Type: ${state.type}`);
		if (state.status) chips.push(`Status: ${state.status}`);
		if (state.topics?.size) chips.push(`Topics: ${[...state.topics].join(', ')}`);
		if (state.windowDays) chips.push(`Window: Next ${state.windowDays}d`);
		if (state.upcoming) chips.push('Upcoming only');
		if (state.verified) chips.push('High-confidence only');
		if (state.showPast) chips.push('Including past');
		if (!chips.length) chips.push('No active filters');
		filterChips.innerHTML = chips.map((chip) => `<span class="radar-chip">${chip}</span>`).join('');
	}

	function isFallbackCoordinate(lat, lng) {
		return Math.abs(lat - 39.5) < 1e-6 && Math.abs(lng + 98.35) < 1e-6;
	}

	function isMappableCoordinate(lat, lng) {
		if (!Number.isFinite(lat) || !Number.isFinite(lng)) return false;
		if (lat < -90 || lat > 90 || lng < -180 || lng > 180) return false;
		if (isFallbackCoordinate(lat, lng)) return false;
		return true;
	}

	function renderMap(visibleCards) {
		const cardsForMap = visibleCards.length ? visibleCards : cards;
		if (!mapLib) {
			initLeafletMap().then(() => renderMap(cardsForMap));
			return;
		}
		if (!clusterLayer) return;

		clusterLayer.clearLayers();
		markerIndex = new Map();
		let mapped = 0;
		for (const card of cardsForMap) {
			const lat = Number(card.dataset.lat || '');
			const lng = Number(card.dataset.lng || '');
			if (!isMappableCoordinate(lat, lng)) continue;
			const days = parseDays(card.dataset.days);
			const tone = typeTone(card.dataset.type);
			const eventId = card.dataset.id || '';
			const marker = window.L.marker([lat, lng], { icon: pinIcon(daysMarker(days), tone, eventId) });
			marker.bindPopup(markerPopup(card), { maxWidth: 380 });
			clusterLayer.addLayer(marker);
			markerIndex.set(eventId, marker);
			mapped += 1;
		}

		if (!mapRenderedOnce) {
			fitMapToResults();
			mapRenderedOnce = true;
		}

		if (mapSub) {
			mapSub.textContent = `Mapped ${mapped} ${mapped === 1 ? 'event' : 'events'} · clusters enabled · drag to pan · Ctrl/Cmd+scroll to zoom · right-click to reset`;
		}
	}

	function renderRecencyBadges(visibleCards) {
		let changed = false;
		const seenAt = nowIso();
		for (const card of cards) {
			const id = card.dataset.id;
			if (!id) continue;
			const isVisible = visibleCards.includes(card);
			if (!eventState.events[id]) {
				eventState.events[id] = {
					firstDetectedAt: nowIso(),
					firstSeenAt: null,
					lastSeenAt: null,
				};
				changed = true;
			}
			const entry = eventState.events[id];

			const freshBadge = card.querySelector('[data-fresh-badge]');
			if (freshBadge) {
				const label = freshAgeLabel(entry);
				const showFresh = Boolean(label);
				freshBadge.classList.toggle('hidden', !showFresh);
				if (showFresh && freshBadge.textContent !== label) freshBadge.textContent = label;
			}

			const newBadge = card.querySelector('[data-new-badge]');
			if (newBadge) {
				const isNew = isVisible && !entry.firstSeenAt;
				newBadge.classList.toggle('hidden', !isNew);
			}

			if (isVisible) {
				if (!entry.firstSeenAt) {
					entry.firstSeenAt = seenAt;
					changed = true;
				}
				if (entry.lastSeenAt !== seenAt) {
					entry.lastSeenAt = seenAt;
					changed = true;
				}
			}
		}
		if (changed) persistEventState();
	}

	function renderPagination(totalMatches, pageStartIdx, pageEndIdx, totalPages) {
		if (!pagination || !pagePrev || !pageNext || !pageLabel || !pageStatus) return;
		currentTotalPages = totalPages;
		const show = totalMatches > PAGE_SIZE;
		pagination.classList.toggle('hidden', !show);
		if (!show) return;
		const atFirst = currentPage <= 1;
		const atLast = currentPage >= totalPages;
		if (pageFirst) pageFirst.disabled = atFirst;
		pagePrev.disabled = atFirst;
		pageNext.disabled = atLast;
		if (pageLast) pageLast.disabled = atLast;
		pageLabel.textContent = `Page ${currentPage} of ${totalPages}`;
		pageStatus.textContent = `${pageStartIdx + 1}-${pageEndIdx} of ${totalMatches}`;
	}

	function render() {
		const { visible, state } = getVisibleCards();
		const totalMatches = visible.length;
		const totalPages = Math.max(1, Math.ceil(totalMatches / PAGE_SIZE));
		if (currentPage > totalPages) currentPage = totalPages;
		const pageStartIdx = (currentPage - 1) * PAGE_SIZE;
		const pageCards = visible.slice(pageStartIdx, pageStartIdx + PAGE_SIZE);
		const pageEndIdx = pageStartIdx + pageCards.length;

		for (const card of cards) card.classList.add('hidden');
		for (const card of pageCards) {
			card.classList.remove('hidden');
			list.appendChild(card);
		}

		list.classList.toggle('is-compact', compactMode);
		applyMapPin();
		controls.toggleCompact.textContent = compactMode ? 'Detailed mode' : 'Compact mode';

		empty.classList.toggle('hidden', totalMatches > 0);
		count.textContent = `${totalMatches} of ${cards.length} events shown`;
		renderFilterChips(state);
		renderPagination(totalMatches, pageStartIdx, pageEndIdx, totalPages);
		renderRecencyBadges(pageCards);
		renderCalendar(visible);
		renderMap(visible);

		const query = toQuery(state);
		const href = query ? `${window.location.pathname}?${query}` : window.location.pathname;
		history.replaceState(null, '', href);
	}




	const renderFromFilterChange = () => {
		currentPage = 1;
		render();
	};

	[controls.q, controls.branch, controls.type, controls.status, controls.sort]
		.filter(Boolean)
		.forEach((node) => node.addEventListener('input', renderFromFilterChange));
	[controls.upcomingOnly, controls.verifiedOnly, controls.showPast]
		.filter(Boolean)
		.forEach((node) => node.addEventListener('change', renderFromFilterChange));
	for (const button of controls.topicButtons) {
		button.addEventListener('click', () => {
			const nowPressed = button.getAttribute('aria-pressed') === 'true';
			button.setAttribute('aria-pressed', nowPressed ? 'false' : 'true');
			renderFromFilterChange();
		});
	}
	for (const button of controls.windowButtons) {
		button.addEventListener('click', () => {
			const buttonDays = parseWindowDays(button.dataset.windowDays || '');
			const currentDays = activeWindowDays();
			if (buttonDays !== null && currentDays === buttonDays) {
				setActiveWindowDays(null);
			} else {
				setActiveWindowDays(buttonDays);
			}
			renderFromFilterChange();
		});
	}
	controls.reset.addEventListener('click', () => {
		applyState({ q: '', branch: '', type: '', status: '', sort: 'soonest', upcoming: false, verified: false, showPast: false, topics: new Set(), windowDays: null });
		currentPage = 1;
		render();
	});
	controls.toggleMap.addEventListener('click', () => {
		mapPin = mapPin === 'above' ? 'below' : 'above';
		persistMapPinPreference();
		render();
	});
	controls.toggleCompact.addEventListener('click', () => {
		compactMode = !compactMode;
		render();
	});
	controls.calendarPrev?.addEventListener('click', () => {
		calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() - 1, 1);
		render();
	});
	controls.calendarNext?.addEventListener('click', () => {
		calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + 1, 1);
		render();
	});
	controls.calendarToday?.addEventListener('click', () => {
		const now = new Date();
		calendarMonth = new Date(now.getFullYear(), now.getMonth(), 1);
		render();
	});
	pageFirst?.addEventListener('click', () => {
		if (currentPage <= 1) return;
		currentPage = 1;
		render();
	});
	pagePrev?.addEventListener('click', () => {
		if (currentPage <= 1) return;
		currentPage -= 1;
		render();
	});
	pageNext?.addEventListener('click', () => {
		if (currentPage >= currentTotalPages) return;
		currentPage += 1;
		render();
	});
	pageLast?.addEventListener('click', () => {
		if (currentPage >= currentTotalPages) return;
		currentPage = currentTotalPages;
		render();
	});

	for (const btn of mapFocusButtons) {
		btn.addEventListener('click', () => focusMapEvent(btn.dataset.id, { openPopup: true }));
	}
	for (const btn of calendarFocusButtons) {
		btn.addEventListener('click', () => focusCalendarEvent(btn.dataset.id));
	}

	document.addEventListener('keydown', (event) => {
		if (event.target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(event.target.tagName)) return;
		if (event.key === '/') {
			event.preventDefault();
			if (controls.filterPanel && !controls.filterPanel.open) controls.filterPanel.open = true;
			controls.q.focus();
			controls.q.select();
		}
		if (event.key.toLowerCase() === 'm') {
			mapPin = mapPin === 'above' ? 'below' : 'above';
			persistMapPinPreference();
			render();
		}
		if (event.key.toLowerCase() === 'c') {
			compactMode = !compactMode;
			render();
		}
	});

	readEventState();
	mapPin = readMapPinPreference();
	applyUrlState();
	applyStatusFacetMode();
	render();
</script>

