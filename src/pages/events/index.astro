							data-outlook-link={eventOutlookIcsLink(event) ?? ''}
							data-lat={event.location.lat}
							data-lng={event.location.lng}
							data-search={`${event.title} ${event.description} ${event.branch} ${event.type} ${event.status} ${event.location.city} ${event.location.state ?? ''} ${event.ontology.themes.join(' ')} ${event.ontology.stakeholders.join(' ')} ${event.ontology.keywords.join(' ')} ${event.ontology.provenance.map((p) => `${p.type} ${p.confidence} ${p.name}`).join(' ')} ${inferEngagementKinds(event).join(' ')} ${noticeTypeLabel(event) ?? ''}`.toLowerCase()}
						>
							<div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between lg:gap-3">
								<div class="min-w-0 flex-1">
									<h3 class="mt-1 text-base font-semibold leading-snug text-slate-50">{event.title}</h3>
									<div class="radar-topline">
										<span class="radar-topline-pill radar-topline-pill-status">{event.status}</span>
										<span class="radar-topline-pill radar-topline-pill-type">{event.type}</span>
										<span class="radar-topline-pill radar-topline-pill-branch">{event.branch}</span>
									</div>
									<p class="mt-1 text-sm text-slate-300 radar-desc">{event.description}</p>
									<p class="mt-2 text-xs text-slate-400 radar-meta">
										<span class="radar-meta-item">{locationLabel(event)}</span>
										<span class="radar-meta-sep" aria-hidden="true">·</span>
										<span class="radar-meta-item">{fmtDateRange(event.startDate, event.endDate)}</span>
										{costLabel(event) ? <><span class="radar-meta-sep" aria-hidden="true">·</span><span class="radar-meta-item">Reg: {costLabel(event)}</span></> : null}
									</p>
								</div>
								<div class="flex w-full flex-col items-start gap-1.5 lg:w-auto lg:items-end">
									<div class="radar-card-actions">
										<div class="radar-card-actions-main">
											<div class="radar-days-chip">{daysUntilBadge(event.startDate)}</div>
											{eventPrimaryLink(event) ? <a class="radar-pin-btn radar-link-btn" href={eventPrimaryLink(event)!} target="_blank" rel="noreferrer">Event link</a> : null}
											{(samOpportunityLink(event) && samOpportunityLink(event) !== eventPrimaryLink(event)) ? <a class="radar-pin-btn radar-link-btn-sam" href={samOpportunityLink(event)!} target="_blank" rel="noreferrer">SAM notice</a> : null}
											{(eventCalendarLink(event) || eventIosIcsLink(event) || eventOutlookIcsLink(event)) ? (
												<span class="radar-calendar-group" aria-label="Calendar options">
													<span class="radar-calendar-group-label">Calendar:</span>
													{eventIosIcsLink(event) ? <a class="radar-calendar-chip radar-calendar-chip-ios" href={eventIosIcsLink(event)!} target="_blank" rel="noreferrer" aria-label="iOS calendar (.ics)" title="iOS calendar (.ics)"><span class="radar-calendar-chip-icon" aria-hidden="true">🍎</span><span class="radar-calendar-chip-label">iOS (.ics)</span></a> : null}
													{eventCalendarLink(event) ? <a class="radar-calendar-chip radar-calendar-chip-google" href={eventCalendarLink(event)!} target="_blank" rel="noreferrer" aria-label="Google Calendar" title="Google Calendar"><span class="radar-calendar-chip-icon" aria-hidden="true">🗓️</span><span class="radar-calendar-chip-label">Google</span></a> : null}
													{eventOutlookIcsLink(event) ? <a class="radar-calendar-chip radar-calendar-chip-outlook" href={eventOutlookIcsLink(event)!} download={eventIcsFilename(event)} aria-label="Outlook calendar (.ics)" title="Outlook calendar (.ics)"><span class="radar-calendar-chip-icon" aria-hidden="true">📘</span><span class="radar-calendar-chip-label">Outlook (.ics)</span></a> : null}
												</span>
											) : null}
											<a class="radar-pin-btn radar-link-btn-opps" href={opportunitiesSliceHref(event)}>Opp intel</a>
											<button class="radar-pin-btn radar-inline-tool" type="button" data-map-focus data-id={event.id}>Map</button>
											<button class="radar-pin-btn radar-inline-tool" type="button" data-calendar-focus data-id={event.id}>Calendar</button>
										</div>
										<div class="radar-card-actions-cta">
											<button class="radar-pin-btn radar-pin-btn-primary" type="button" data-open-event data-id={event.id}>Open event</button>
										</div>
									</div>
									<div class="radar-badge-row">
										{solicitationCount(event) > 0 ? <span class="radar-solicitations-pill" title="Matched SAM solicitations">{solicitationCount(event)} solicitations</span> : null}
										<span class={`radar-source-confidence-pill radar-source-confidence-pill-${sourceTypeTone(event)}`} title="Source confidence and source type">{sourceConfidenceLabel(event)} · {sourceTypeLabel(event)}</span>
										<span class="radar-evidence-pill radar-evidence-pill-fresh hidden" data-fresh-badge title="Added recently to your feed">Fresh</span>
										<span class="radar-new-pill hidden" data-new-badge>New</span>
									</div>
									<p class="radar-card-kicker text-left lg:text-right">{event.branch} · {event.type} · {event.status}</p>
								</div>
							</div>

							<div class="mt-3 flex flex-wrap gap-2 radar-theme-row">
								{event.ontology.themes.slice(0, 4).map((theme) => <span class="radar-pill">{theme}</span>)}
							</div>

							<details class="mt-3 radar-details">
								<summary>Event intelligence details</summary>

								<div class="mt-4 grid gap-4 lg:grid-cols-2">
									<div>
										<p class="radar-section-label">Verified links</p>
										<ul class="radar-listing">
											{eventPrimaryLink(event) ? <li><a href={eventPrimaryLink(event)!} target="_blank" rel="noreferrer">Official page</a></li> : null}
											{(samOpportunityLink(event) && samOpportunityLink(event) !== eventPrimaryLink(event)) ? <li><a href={samOpportunityLink(event)!} target="_blank" rel="noreferrer">SAM opportunity</a></li> : null}
											{eventAuxiliaryLinks(event).registration ? <li><a href={eventAuxiliaryLinks(event).registration!} target="_blank" rel="noreferrer">Registration</a></li> : null}
											{(eventCalendarLink(event) || eventIosIcsLink(event) || eventOutlookIcsLink(event)) ? (
												<li>
													<strong>Calendar:</strong>{' '}
													{eventIosIcsLink(event) ? <a href={eventIosIcsLink(event)!} target="_blank" rel="noreferrer">🍎 iOS (.ics)</a> : null}
													{(eventIosIcsLink(event) && eventCalendarLink(event)) ? <span>{' / '}</span> : null}
													{eventCalendarLink(event) ? <a href={eventCalendarLink(event)!} target="_blank" rel="noreferrer">🗓️ Google</a> : null}
													{((eventIosIcsLink(event) || eventCalendarLink(event)) && eventOutlookIcsLink(event)) ? <span>{' / '}</span> : null}
													{eventOutlookIcsLink(event) ? <a href={eventOutlookIcsLink(event)!} download={eventIcsFilename(event)}>📘 Outlook (.ics)</a> : null}
												</li>
											) : null}
											{eventAuxiliaryLinks(event).callForPapers ? <li><a href={eventAuxiliaryLinks(event).callForPapers!} target="_blank" rel="noreferrer">Call for papers</a></li> : null}
											{eventAuxiliaryLinks(event).agenda ? <li><a href={eventAuxiliaryLinks(event).agenda!} target="_blank" rel="noreferrer">Agenda</a></li> : null}
											{eventAuxiliaryLinks(event).hotelBlock ? <li><a href={eventAuxiliaryLinks(event).hotelBlock!} target="_blank" rel="noreferrer">Hotel block</a></li> : null}
											{eventAuxiliaryLinks(event).sourceReferences.length ? (
												<li>
													<strong>Source references:</strong>{' '}
													{eventAuxiliaryLinks(event).sourceReferences.map((url, idx) => (
														<span>
															<a href={url} target="_blank" rel="noreferrer">Ref {idx + 1}</a>
															{idx < eventAuxiliaryLinks(event).sourceReferences.length - 1 ? <span>{' · '}</span> : null}
														</span>
													))}
												</li>
											) : null}
										</ul>
									</div>
									<div>
										<p class="radar-section-label">Logistics</p>
										<ul class="radar-listing">
											<li><strong>Format:</strong> {event.ontology.logistics.format}</li>
											{costLabel(event) ? <li><strong>Estimated cost:</strong> {costLabel(event)}</li> : null}
											<li><strong>Travel burden from DC:</strong> {event.ontology.logistics.travelBurdenFromDc}</li>
											{event.location.venue ? <li><strong>Venue:</strong> {event.location.venue}</li> : null}
										</ul>
									</div>
								</div>

								{hasSamIntelligence(event) ? (
									<div class="mt-4 grid gap-4 lg:grid-cols-2">
										<div>
											<p class="radar-section-label">Comparative pane: event stakeholders</p>
											<ul class="radar-listing">
												{event.ontology.stakeholders.length ? <li><strong>Involved parties:</strong> {event.ontology.stakeholders.join(' · ')}</li> : null}
												{event.ontology.missionThreads.length ? <li><strong>Mission threads:</strong> {event.ontology.missionThreads.join(' · ')}</li> : null}
												{event.ontology.capabilityAreas.length ? <li><strong>Capability areas:</strong> {event.ontology.capabilityAreas.join(' · ')}</li> : null}
												{inferredGovernmentOrganizations(event).length ? <li><strong>Government orgs inferred:</strong> {inferredGovernmentOrganizations(event).join(' · ')}</li> : null}
											</ul>
											<p class="radar-section-label mt-3">Government contacts</p>
											{governmentPocs(event).length ? (
												<ul class="radar-listing">
													{governmentPocs(event).map((contact) => (
														<li>
															{contact.name}
															{contact.role ? <span class="text-slate-500"> · {contact.role}</span> : null}
															{contact.organization ? <span class="text-slate-500"> · {contact.organization}</span> : null}
															{contact.email ? <span class="text-slate-500"> · {contact.email}</span> : null}
														</li>
													))}
												</ul>
											) : (
												<p class="mt-2 text-xs text-slate-500">No public government contacts captured yet.</p>
											)}
										</div>
										<div>
											<p class="radar-section-label">Comparative pane: solicitation overlap</p>
											<ul class="radar-listing">
												{samIntel(event)?.collectedAt ? <li><strong>Last SAM run:</strong> {fmtDate(samIntel(event)?.collectedAt ?? null)}</li> : null}
												{samPostedWindow(event) ? <li><strong>Posted window:</strong> {samPostedWindow(event)}</li> : null}
												{typeof samIntel(event)?.totalMatched === 'number' ? <li><strong>Total matched solicitations:</strong> {samIntel(event)?.totalMatched}</li> : null}
												<li><strong>Captured in this pane:</strong> {samTopNotices(event).length}</li>
												<li><strong>Deep text captured:</strong> {deepCoverage(event).withDetail}/{deepCoverage(event).captured} notices</li>
												<li><strong>Notices with attachments:</strong> {deepCoverage(event).withAttachments}/{deepCoverage(event).captured}</li>
												<li><strong>Attachment links captured:</strong> {deepCoverage(event).attachmentLinks}</li>
												<li><strong>Stakeholder overlap coverage:</strong> {overlapCoverage(event).withOverlap}/{overlapCoverage(event).total} captured notices</li>
												{event.ontology.acquisition?.agency ? <li><strong>Agency focus:</strong> {event.ontology.acquisition?.agency}</li> : null}
												{event.ontology.acquisition?.solicitationNumber ? <li><strong>Reference solicitation #:</strong> {event.ontology.acquisition?.solicitationNumber}</li> : null}
												{event.ontology.acquisition?.responseDueDate ? <li><strong>Nearest response due:</strong> {fmtDate(event.ontology.acquisition?.responseDueDate)}</li> : null}
											</ul>
										</div>
									</div>

									<div class="mt-4 grid gap-4 xl:grid-cols-3">
										<div>
											<p class="radar-section-label">Public participant organizations (event crawl)</p>
											{inferredAttendeeOrganizations(event).length ? (
												<div class="radar-intel-scroll">
													<ul class="radar-listing">
														{inferredAttendeeOrganizations(event).map((org) => <li>{org}</li>)}
													</ul>
												</div>
											) : (
												<p class="mt-2 text-xs text-slate-500">No attendee organization crawl data attached for this event yet.</p>
											)}
										</div>
										<div>
											<p class="radar-section-label">Solicitation type distribution</p>
											{samTypeCounts(event).length ? (
												<div class="space-y-1.5">
													{samTypeCounts(event).map(([label, count]) => (
														<div class="radar-intel-bar-row">
															<div class="radar-intel-bar-meta">
																<span>{label}</span>
																<span>{count}</span>
															</div>
															<div class="radar-intel-bar-track"><span class="radar-intel-bar-fill" style={`width:${maxCount(samTypeCounts(event)) ? Math.max(6, Math.round((count / maxCount(samTypeCounts(event))) * 100)) : 0}%`}></span></div>
														</div>
													))}
												</div>
											) : (
												<p class="mt-2 text-xs text-slate-500">No solicitation type breakdown yet.</p>
											)}
										</div>
										<div>
											<p class="radar-section-label">Stakeholder overlap graph</p>
											{samOverlapCounts(event).length ? (
												<div class="space-y-1.5">
													{samOverlapCounts(event).map(([label, count]) => (
														<div class="radar-intel-bar-row">
															<div class="radar-intel-bar-meta">
																<span>{label}</span>
																<span>{count}</span>
															</div>
															<div class="radar-intel-bar-track"><span class="radar-intel-bar-fill radar-intel-bar-fill-overlap" style={`width:${maxCount(samOverlapCounts(event)) ? Math.max(6, Math.round((count / maxCount(samOverlapCounts(event))) * 100)) : 0}%`}></span></div>
														</div>
													))}
												</div>
											) : (
												<p class="mt-2 text-xs text-slate-500">No overlap signals detected in captured solicitations.</p>
											)}
										</div>
									</div>

									<div class="mt-4">
										<div class="flex flex-wrap items-center justify-between gap-2">
											<p class="radar-section-label">Solicitation table</p>
											<div class="flex items-center gap-2">
												<span class="text-[11px] text-slate-400" data-sam-showing data-event-id={event.id}>Showing {samTopNotices(event).length} of {solicitationCount(event)} matched</span>
												<label class="text-[11px] text-slate-400">View
													<select class="radar-input radar-input-sort radar-inline-select" data-sam-sort data-event-id={event.id}>
														<option value="score">Ranked (weight)</option>
														<option value="intel-depth">Intel depth</option>
														<option value="attachment-count">Attachment count</option>
														<option value="due">Nearest due date</option>
														<option value="posted">Newest posted</option>
														<option value="title">Title (A-Z)</option>
													</select>
												</label>
												<label class="text-[11px] text-slate-400">Filter
													<select class="radar-input radar-input-sort radar-inline-select" data-sam-filter data-event-id={event.id}>
														<option value="all">All</option>
														<option value="my-focus">My focus (Software/Cloud/AI/Cyber/Data)</option>
														<option value="deep-text">Deep text available</option>
														<option value="attachments">Has attachments</option>
														<option value="software">Software</option>
														<option value="cloud">Cloud</option>
														<option value="ai">AI/ML</option>
														<option value="data">Data/Analytics</option>
														<option value="cyber">Cybersecurity</option>
														<option value="logistics">Logistics</option>
														<option value="maintenance">Maintenance</option>
														<option value="training">Training</option>
														<option value="engineering">Engineering/SETA</option>
														<option value="hardware">Hardware/Systems</option>
														<option value="services">Professional Services</option>
														<option value="general">General</option>
													</select>
												</label>
											</div>
										</div>
										{samTopNotices(event).length ? (
											<div class="radar-intel-scroll radar-intel-table-wrap">
												<table class="radar-intel-table" data-sam-table data-event-id={event.id}>
													<thead>
														<tr>
															<th class="radar-col-weight">Weight</th>
															<th>Solicitation name</th>
															<th>Intel row</th>
															<th>Type</th>
															<th>Posted</th>
															<th>Due</th>
															<th class="radar-col-days-due">Days to due</th>
															<th>Solicitation #</th>
															<th>Agency</th>
															<th>Deep text</th>
															<th>Files</th>
															<th>Overlap</th>
															<th>Tags</th>
														</tr>
													</thead>
													<tbody>
														{samTopNotices(event).map((notice) => (
															<tr data-score={notice.score ?? 0} data-posted={notice.postedDate ?? ''} data-due={notice.responseDueDate ?? ''} data-title={notice.title.toLowerCase()} data-tags={noticeFocusTags(notice).map((tag) => tag.key).join(',')} data-detail={samDeepTextLength(notice)} data-files={samAttachmentCount(notice)}>
															<td class="radar-col-weight">{notice.score ?? 0}</td>
															<td>{notice.uiLink ? <a href={notice.uiLink} target="_blank" rel="noreferrer">{notice.title}</a> : <span>{notice.title}</span>}</td>
															<td><a class="radar-intel-open-link" href={opportunitiesIntelHref(notice, event.id)}>Open intel</a></td>
															<td>{notice.noticeType}</td>
															<td>{notice.postedDate ?? '—'}</td>
															<td class={dueDateClass(notice.responseDueDate)}>{notice.responseDueDate ? fmtDate(notice.responseDueDate) : '—'}</td>
															<td class="radar-col-days-due">{daysUntilDueLabel(notice.responseDueDate)}</td>
															<td>{notice.solicitationNumber ?? '—'}</td>
															<td>{notice.agencyPath ?? '—'}</td>
															<td>{samDeepTextLength(notice) > 0 ? `${Math.round(samDeepTextLength(notice) / 1000)}k chars` : '—'}</td>
															<td>{samAttachmentCount(notice) > 0 ? samAttachmentCount(notice) : '—'}</td>
															<td>{noticeOverlapStakeholders(event, notice).length ? noticeOverlapStakeholders(event, notice).join(', ') : '—'}</td>
															<td><div class="radar-intel-tags">{noticeFocusTags(notice).map((tag) => <span class="radar-pill radar-sam-tag" title={tag.key}>{tag.label}</span>)}</div></td>
														</tr>
														))}
													</tbody>
												</table>
											</div>
										) : (
											<p class="mt-2 text-xs text-slate-500">No SAM solicitations captured yet.</p>
										)}
									</div>
								) : null}

								<div class="mt-4">
									<p class="radar-section-label">Schedule</p>
									<ul class="radar-listing">
										<li><strong>Days until start:</strong> {daysUntilDetail(event.startDate)}</li>
										<li><strong>Event window:</strong> {fmtDateRange(event.startDate, event.endDate)}</li>
									</ul>
								</div>

								<div class="mt-4">
									<p class="radar-section-label">Evidence & provenance</p>
									<ul class="radar-listing">
										{event.ontology.provenance.map((source) => (
											<li>
												<a href={source.url} target="_blank" rel="noreferrer">{source.name}</a>
												<span class="text-slate-500"> · {source.type}, {source.confidence} confidence, verified {source.lastVerified}</span>
												<span class={`radar-evidence-pill radar-evidence-pill-${provenanceFreshness(source.lastVerified).tone}`}>{provenanceFreshness(source.lastVerified).label}</span>
												{source.evidenceId ? <span class="text-slate-500"> · evidence {source.evidenceId}</span> : null}
											</li>
										))}
									</ul>
									<p class="mt-2 text-xs text-slate-400">Evidence health: {evidenceHealth(event)}</p>
									<p class="mt-1 text-xs text-slate-400">Confidence notes: {confidenceNotes(event)}</p>
									{event.ontology.notes ? <p class="mt-2 text-xs text-slate-400">{event.ontology.notes}</p> : null}
								</div>
							</details>
						</article>
					))}
				</div>
				<div id="radar-pagination" class="mt-4 hidden flex flex-wrap items-center justify-between gap-2 md:flex-nowrap">
					<p id="radar-pagination-status" class="text-xs text-slate-400"></p>
					<div class="flex items-center gap-2">
						<button id="radar-page-first" class="radar-btn radar-btn-tight" type="button">First</button>
						<button id="radar-page-prev" class="radar-btn radar-btn-tight" type="button">Prev</button>
						<span id="radar-page-label" class="text-xs text-slate-300">Page 1 of 1</span>
						<button id="radar-page-next" class="radar-btn radar-btn-tight" type="button">Next</button>
						<button id="radar-page-last" class="radar-btn radar-btn-tight" type="button">Last</button>
					</div>
				</div>

			</section>

			<section id="radar-map-section" class="card p-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="section-title">Map View</h2>
					<div class="radar-map-tools">
						<button id="radar-map-fit" class="radar-btn radar-btn-tight" type="button">Fit Results</button>
						<button id="radar-map-reset" class="radar-btn radar-btn-tight" type="button">Reset</button>
					</div>
				</div>
				<div id="radar-map" class="radar-map" aria-label="Event map">
					<div id="radar-leaflet-map" class="radar-leaflet-map"></div>
				</div>
				<p id="radar-map-sub" class="radar-map-sub">Mapped events · clusters on · drag to pan · Ctrl/Cmd+scroll to zoom</p>
			</section>
		</div>
		<p class="radar-legal-note">
			Event-tracker entries are compiled from public sources for research and planning. Source owners retain rights to their original content.
			Always verify key dates, terms, and eligibility on the official source before acting.
		</p>
	</section>

	<section class="mt-6">
		<a class="text-sm text-slate-300 hover:text-slate-100" href={withBase('/writing/')}>← Back to writing</a>
	</section>
</SiteLayout>

<script is:inline>
	const controls = {
		filterPanel: document.getElementById('radar-filter-panel'),
		q: document.getElementById('radar-q'),
		branch: document.getElementById('radar-branch'),
		type: document.getElementById('radar-type'),
		status: document.getElementById('radar-status'),
		sort: document.getElementById('radar-sort'),
		upcomingOnly: document.getElementById('radar-upcoming-only'),
		verifiedOnly: document.getElementById('radar-verified-only'),
		newOnly: document.getElementById('radar-new-only'),
		showPast: document.getElementById('radar-show-past'),
		toggleMap: document.getElementById('radar-toggle-map'),
		toggleCompact: document.getElementById('radar-toggle-compact'),
		calendarPrev: document.getElementById('radar-cal-prev'),
		calendarNext: document.getElementById('radar-cal-next'),
		calendarToday: document.getElementById('radar-cal-today'),
		calendarToggle: document.getElementById('radar-cal-toggle'),
		reset: document.getElementById('radar-reset'),
		topicButtons: Array.from(document.querySelectorAll('[data-topic]')),
		windowButtons: Array.from(document.querySelectorAll('[data-window-days]')),
		opportunityContext: document.getElementById('radar-opportunity-context'),
		opportunityContextText: document.getElementById('radar-opportunity-context-text'),
		opportunityContextBack: document.getElementById('radar-opportunity-context-back'),
		opportunityContextClear: document.getElementById('radar-opportunity-context-clear'),
		emptyReset: document.getElementById('radar-empty-reset'),
		calendarEmptyReset: document.getElementById('radar-cal-empty-reset'),
	};

	const list = document.getElementById('radar-list');
	const count = document.getElementById('radar-count');
	const empty = document.getElementById('radar-empty');
	const map = document.getElementById('radar-map');
	const mapSub = document.getElementById('radar-map-sub');
	const mapCanvas = document.getElementById('radar-leaflet-map');
	const mapFitBtn = document.getElementById('radar-map-fit');
	const mapResetBtn = document.getElementById('radar-map-reset');
	const mapSection = document.getElementById('radar-map-section');
