---
import SiteLayout from '../../layouts/SiteLayout.astro';
import feedRegistry from '../../data/radar/feed-registry.json';
import crawlReport from '../../data/radar/feed-crawl-report-latest.json';

type Feed = {
	id: string;
	name: string;
	category: string;
	url: string;
	displayUrl?: string;
	crawlEnabled: boolean;
	ingester?: string;
	notes?: string;
};

const feeds = (feedRegistry.feeds ?? []) as Feed[];

const officialFeeds = feeds.filter((f) => ['official_api', 'official_pages', 'official_calendar', 'constrained_official'].includes(f.category));
const aggregators = feeds.filter((f) => ['aggregator', 'aggregator_discovery'].includes(f.category));
const oneOff = feeds.filter((f) => f.category === 'one_off_event');

const summary = crawlReport.summary ?? { total: feeds.length, ok: 0, blocked: 0, failed: 0 };
const generatedAt = crawlReport.generatedAt ?? null;
---

<SiteLayout
	title="Event Source Feeds | Adam Boas"
	description="Public registry of event feeds and one-off URLs used to power DoW Events Intelligence."
	canonicalHref="https://www.adamboas.com/events/sources/"
	image="/og/events.png"
>
	<section class="mt-2 max-w-5xl space-y-6">
		<div class="card p-5 text-sm text-slate-300">
			<h1 class="text-2xl font-semibold tracking-tight text-slate-50 sm:text-3xl">Event Source Feeds</h1>
			<p class="mt-2 text-slate-400">This is the public source registry for the Events tracker. If you want to add or fix a source, submit a PR against <code>src/data/radar/feed-registry.json</code>.</p>
			<div class="mt-3 flex flex-wrap gap-2">
				<span class="radar-mini-stat">{summary.total} feeds</span>
				<span class="radar-mini-stat">{summary.ok} crawl OK</span>
				<span class="radar-mini-stat">{summary.blocked} blocked</span>
				<span class="radar-mini-stat">{summary.failed} failed</span>
				{generatedAt ? <span class="radar-mini-stat">last crawl {new Date(generatedAt).toLocaleString()}</span> : null}
			</div>
			<p class="mt-3 text-xs text-slate-500">Automated crawl report: <code>src/data/radar/feed-crawl-report-latest.md</code></p>
		</div>

		<div class="card p-5 text-sm text-slate-300">
			<h2 class="section-title">Official Feeds</h2>
			<ul class="mt-3 space-y-2">
				{officialFeeds.map((f) => {
					const href = f.displayUrl ?? f.url;
					return (
						<li>
							<a href={href} target="_blank" rel="noreferrer">{f.name}</a>
							<span class="text-slate-500"> · {f.category} · {f.ingester ?? 'manual'}{f.notes ? ` · ${f.notes}` : ''}{f.displayUrl ? ' · crawl endpoint kept internal' : ''}</span>
						</li>
					);
				})}
			</ul>
		</div>

		<div class="card p-5 text-sm text-slate-300">
			<h2 class="section-title">Aggregator Feeds</h2>
			<ul class="mt-3 space-y-2">
				{aggregators.map((f) => {
					const href = f.displayUrl ?? f.url;
					return (
						<li>
							<a href={href} target="_blank" rel="noreferrer">{f.name}</a>
							<span class="text-slate-500"> · {f.category} · {f.ingester ?? 'manual'}{f.notes ? ` · ${f.notes}` : ''}{f.displayUrl ? ' · crawl endpoint kept internal' : ''}</span>
						</li>
					);
				})}
			</ul>
		</div>

		<div class="card p-5 text-sm text-slate-300">
			<h2 class="section-title">One-Off Event URLs (PR-Target List)</h2>
			<p class="mt-2 text-slate-400">These are specific event URLs we track directly and can expand via pull requests.</p>
			<ul class="mt-3 space-y-2">
				{oneOff.map((f) => {
					const href = f.displayUrl ?? f.url;
					return (
						<li>
							<a href={href} target="_blank" rel="noreferrer">{f.name}</a>
							<span class="text-slate-500"> · {f.id}</span>
						</li>
					);
				})}
			</ul>
		</div>
	</section>
</SiteLayout>

<style>
	.section-title {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.2;
		color: rgb(248, 250, 252);
		border-left: 3px solid rgba(0, 196, 196, 0.55);
		padding-left: 0.65rem;
	}
	.radar-mini-stat {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.25rem 0.5rem;
		border: 1px solid rgba(51, 65, 85, 0.75);
		background: rgba(2, 6, 23, 0.65);
		color: rgb(203, 213, 225);
		font-size: 0.75rem;
	}
</style>
