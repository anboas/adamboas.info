---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../utils/withBase';

type PdfItem = {
	title: string;
	type: 'paper' | 'memo' | 'note';
	date: Date | null;
	pdfPath: string;
	pagePath: string;
};

const writing = (await getCollection('writing'))
	.filter((w) => w.data.status === 'published' && !!w.data.pdfPath)
	.map((w) => {
		const slug = w.id.split('/').pop();
		return {
			title: w.data.title,
			type: w.data.type,
			date: w.data.date ?? null,
			pdfPath: w.data.pdfPath!,
			pagePath: `/writing/${slug}/`,
		} satisfies PdfItem;
	});

const papers = (await getCollection('papers'))
	.filter((p) => p.data.status === 'published' && !!p.data.pdfPath)
	.map((p) => ({
		title: p.data.title,
		type: 'paper' as const,
		date: p.data.date ?? null,
		pdfPath: p.data.pdfPath!,
		pagePath: `/writing/${p.id}/`,
	}));

const all = [...papers, ...writing].sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0));
---

<SiteLayout
	title="Published PDFs | Adam Boas"
	description="Simple index of all published PDFs across papers and writing."
	canonicalHref="https://www.adamboas.com/pdfs/"
>
	<section class="mt-2 max-w-5xl">
		<div class="card p-5 sm:p-6">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<h1 class="text-2xl font-semibold tracking-tight text-slate-50 sm:text-3xl">Published PDFs</h1>
					<p class="mt-2 text-sm text-slate-300">Simple index of every published PDF currently on the site.</p>
				</div>
				<p class="text-xs text-slate-400">{all.length} total</p>
			</div>

			<ul class="mt-5 divide-y divide-slate-800 border border-slate-800 bg-slate-950/40">
				{all.map((item) => (
					<li class="p-3 sm:p-4">
						<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
							<div class="min-w-0">
								<p class="text-base font-semibold text-slate-100">{item.title}</p>
								<p class="mt-1 text-xs uppercase tracking-wide text-slate-400">
									{item.type}
									{item.date ? ` · ${item.date.toISOString().slice(0, 10)}` : ''}
								</p>
							</div>
							<div class="flex flex-wrap gap-3 text-sm">
								<a class="font-semibold text-stone-100 hover:text-stone-50" href={withBase(item.pdfPath)}>
									PDF ↗
								</a>
								<a class="text-slate-300 hover:text-slate-100" href={withBase(item.pagePath)}>
									Page →
								</a>
							</div>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>
</SiteLayout>
