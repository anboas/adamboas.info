---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../components/SurfacePageHeader.astro';
import { absoluteUrl } from '../../config/site';

const entries = [
	{ label: 'LLMs quick map', href: '/llms.txt', desc: 'Compact machine-readable site overview.' },
	{ label: 'LLMs full map', href: '/llms-full.txt', desc: 'Expanded crawl and ingestion map for autonomous agents.' },
	{ label: 'Agent manifest', href: '/agents.json', desc: 'Capabilities, trust policy, and preferred ingestion order.' },
	{ label: 'Well-known manifest', href: '/.well-known/agent-manifest.json', desc: 'Well-known alias for machine discovery clients.' },
	{ label: 'Changes feed', href: '/changes.json', desc: 'Machine-readable release and discovery highlights.' },
	{ label: 'Changes stream (JSONL)', href: '/changes.jsonl', desc: 'Append-friendly event stream for incremental sync.' },
	{ label: 'Selected strategic work', href: '/strategic-work/', desc: 'Sanitized public evidence across strategy, capture, transition, governance, and mission systems.' },
	{ label: 'Writing manifest', href: '/writing/manifest.json', desc: 'Structured inventory of published writing and papers.' },
	{ label: 'Writing surface map', href: '/writing/agent.json', desc: 'Agent-focused extraction + refresh hints for writing.' },
	{ label: 'Events surface map', href: '/events/agent.json', desc: 'Agent-focused extraction + refresh hints for events.' },
	{ label: 'Opportunities surface map', href: '/opportunities/agent.json', desc: 'Agent-focused extraction + source-route hints for opportunities.' },
	{ label: 'Opportunities export (combined)', href: '/opportunities/export.json', desc: 'Normalized opportunities export with source metadata and per-source links.' },
	{ label: 'Opportunities export (SAM)', href: '/opportunities/export-sam.json', desc: 'Deterministic SAM-only normalized opportunity rows.' },
	{ label: 'Opportunities export (SAM core)', href: '/opportunities/export-sam-core.json', desc: 'Lower-noise SAM core profile for lightweight agent ingest.' },
	{ label: 'Opportunities export (SBIR)', href: '/opportunities/export-sbir.json', desc: 'Deterministic SBIR artifact pointers and source route metadata.' },
	{ label: 'Opportunities freshness', href: '/opportunities/freshness.json', desc: 'Lightweight freshness and lineage metadata for poll-first clients.' },
	{ label: 'Opportunities lineage', href: '/opportunities/lineage.json', desc: 'Snapshot IDs and lineage map for deterministic cache/replay decisions.' },
	{ label: 'Integrity manifest', href: '/integrity.json', desc: 'SHA-256 integrity hashes for machine discovery source files.' },
	{ label: 'Agent priority map', href: '/agent-priority.json', desc: 'Ingestion tiers and refresh hints for autonomous clients.' },
	{ label: 'Sitemap index', href: '/sitemap-index.xml', desc: 'Canonical URL coverage for crawl orchestration.' },
	{ label: 'RSS feed', href: '/rss.xml', desc: 'Incremental publication feed for polling clients.' },
	{ label: 'Schema: agents', href: '/schemas/agents.schema.json', desc: 'JSON Schema contract for /agents.json.' },
	{ label: 'Schema: priority', href: '/schemas/agent-priority.schema.json', desc: 'JSON Schema contract for /agent-priority.json.' },
	{ label: 'Schema: changes', href: '/schemas/changes.schema.json', desc: 'JSON Schema contract for /changes.json.' },
	{ label: 'Schema: opportunities export', href: '/schemas/opportunities-export.schema.json', desc: 'JSON Schema contract for /opportunities/export.json.' },
	{ label: 'Schema: opportunities export (SAM)', href: '/schemas/opportunities-export-sam.schema.json', desc: 'JSON Schema contract for /opportunities/export-sam.json.' },
	{ label: 'Schema: opportunities export (SBIR)', href: '/schemas/opportunities-export-sbir.schema.json', desc: 'JSON Schema contract for /opportunities/export-sbir.json.' },
	{ label: 'Schema: opportunities freshness', href: '/schemas/opportunities-freshness.schema.json', desc: 'JSON Schema contract for /opportunities/freshness.json.' },
	{ label: 'Schema: opportunities lineage', href: '/schemas/opportunities-lineage.schema.json', desc: 'JSON Schema contract for /opportunities/lineage.json.' },
];
---

<SiteLayout
	title="For Agents | Adam Boas"
	description="Machine-readable discovery hub for autonomous and agentic clients."
	canonicalHref={absoluteUrl('/for-agents/')}
>
	<SurfacePageHeader
		stickyActive="home"
		eyebrow="Machine Discovery"
		title="For Agents"
		description="Structured entry points for autonomous clients to discover content, policy, and update surfaces."
	/>

	<section class="card mt-4 p-4 md:mt-5 md:p-5">
		<h2 class="section-title">Discovery Endpoints</h2>
		<ul class="mt-4 space-y-3">
			{
				entries.map((entry) => (
					<li class="border border-slate-800 bg-slate-950/40 p-3">
						<a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={entry.href}>
							{entry.label}
						</a>
						<p class="mt-1 text-xs text-slate-300">{entry.desc}</p>
						<p class="mt-1 text-[11px] text-slate-500">{absoluteUrl(entry.href)}</p>
					</li>
				))
			}
		</ul>
		<div class="mt-4 border border-slate-800 bg-slate-950/30 p-3 text-xs text-slate-300">
			<strong class="text-slate-100">Low-noise extraction mode:</strong>
			 append <code>?view=agent</code> to page URLs to minimize UI chrome for agent parsing.
		</div>
	</section>
</SiteLayout>

<style>
	.section-title {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.2;
		color: rgb(248, 250, 252);
		border-left: 3px solid rgba(0, 196, 196, 0.55);
		padding-left: 0.65rem;
	}
</style>
