---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
---

<SiteLayout title="Speaking | Adam Boas" description="Talks, panels, and speaking engagements.">
	<StickyBrowseBar active="speaking" />
	<section class="card control-shell p-5">
		<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
			<h1 class="section-title">Speaking</h1>
			<span class="text-xs uppercase tracking-wide text-slate-400">Talks · Panels · Podcasts</span>
		</div>
		<p class="mt-2 text-sm text-slate-300">
			Speaking engagements now live here as a dedicated profile surface, separate from experience and education.
		</p>
	</section>

	<section class="mt-4 grid gap-4 md:mt-5 md:grid-cols-2">
		<div class="card p-4">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Upcoming</h2>
			<p class="mt-2 text-sm text-slate-400">No upcoming public speaking events listed yet.</p>
		</div>
		<div class="card p-4">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Past engagements</h2>
			<p class="mt-2 text-sm text-slate-400">Archive section ready for talk history, links, and recordings.</p>
		</div>
	</section>

	<section class="card mt-4 p-4 md:mt-5">
		<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Speaking topics</h2>
		<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-300">
			<li>Agent systems and delegated authority</li>
			<li>AI governance and policy-as-code</li>
			<li>Defense/autonomy capability delivery</li>
		</ul>
	</section>
</SiteLayout>
