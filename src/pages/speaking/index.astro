---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
const profileSpeakingHref = withBase('/profile/#speaking');
---

<SiteLayout title="Speaking | Adam Boas" description="Speaking is now consolidated into the Profile page.">
	<StickyBrowseBar active="profile" />
	<section class="card control-shell p-5">
		<h1 class="section-title">Speaking moved to Profile</h1>
		<p class="mt-2 text-sm text-slate-300">Speaking engagements are now part of the unified profile surface with experience and education.</p>
		<a class="mt-3 inline-flex h-8 items-center rounded-none border border-slate-700 bg-slate-900/90 px-2.5 text-sm font-medium text-slate-50" href={profileSpeakingHref}>Go to Profile → Speaking</a>
	</section>

	<script is:inline>
		setTimeout(() => {
			window.location.replace({JSON.stringify(profileSpeakingHref)});
		}, 150);
	</script>
</SiteLayout>
