---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { absoluteUrl } from '../../config/site';
import { withBase } from '../../utils/withBase';
import {
	sabreResumeEducation,
	sabreResumeExperience,
	sabreResumeProfile,
	sabreResumeSideProjects,
	sabreResumeSpeaking,
	sabreResumeSummary,
	sabreResumeValueProposition,
} from '../../data/sabreResume';

const pageTitle = 'Sabre Resume | Adam Boas';
const pageDescription =
	'Sabre-focused expanded resume for Adam Boas, aligned to defense technology strategy, technical capture, mission engineering, data modernization, and growth-focused solution architecture.';
const printable = Astro.url.searchParams.get('print') === '1';
const contactLine = `${sabreResumeProfile.email} | ${sabreResumeProfile.phone} | ${sabreResumeProfile.url}`;
const publishedWriting = (await getCollection('writing')).filter((item) => item.data.status === 'published');
const publishedPapers = (await getCollection('papers')).filter((item) => item.data.status === 'published');
const sabreWritingItems = [
	...publishedPapers.map((item) => ({
		slug: item.id,
		type: 'paper',
		title: item.data.title,
		description: item.data.description,
		date: item.data.date,
	})),
	...publishedWriting.map((item) => ({
		slug: item.id.split('/').pop(),
		type: item.data.type,
		title: item.data.title,
		description: item.data.summary,
		date: item.data.date,
	})),
]
	.filter((item) => item.slug && item.date)
	.sort((a, b) => b.date.valueOf() - a.date.valueOf());
const formatWritingDate = (date: Date) => date.toLocaleDateString(undefined, { year: 'numeric', month: 'short' });
---

<SiteLayout
	title={pageTitle}
	description={pageDescription}
	canonicalHref={absoluteUrl('/sabre/')}
	noindex={true}
	nofollow={true}
>
	<article class:list={['resume-shell', printable && 'is-print-preview']}>
		<table class="resume-print-table">
			<thead class="resume-print-header">
				<tr>
					<th scope="col">
						<div class="resume-print-header-inner">
							<h1>{sabreResumeProfile.name}</h1>
							<p>{contactLine}</p>
							<p>Clearance: {sabreResumeProfile.clearance}</p>
						</div>
					</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td>
						<div class="resume-body">
							<header class="resume-header">
								<h1>{sabreResumeProfile.name}</h1>
								<p>{contactLine}</p>
								<p>Clearance: {sabreResumeProfile.clearance}</p>
							</header>

							<section class="resume-section resume-summary" aria-labelledby="resume-summary-title">
								<h2 id="resume-summary-title">Professional Summary</h2>
								<ul class="summary-list">
									{sabreResumeSummary.map((item) => <li>{item}</li>)}
								</ul>
							</section>

							<section class="resume-section" aria-labelledby="resume-value-title">
								<h2 id="resume-value-title">Sabre Value Proposition</h2>
								<div class="value-grid">
									{
										sabreResumeValueProposition.map((item) => (
											<section class="value-item">
												<h3>{item.title}</h3>
												<p>{item.body}</p>
											</section>
										))
									}
								</div>
							</section>

							<section class="resume-section" aria-labelledby="resume-experience-title">
								<h2 id="resume-experience-title">Experience</h2>
								<div class="role-stack">
									{
										sabreResumeExperience.map((role) => (
											<section class="resume-role">
												<div class="role-heading">
													<h3>
														{role.company} <span>{role.title}</span>
													</h3>
													<p>{role.period}</p>
												</div>
												<p class="role-summary">{role.summary}</p>
												{role.groups?.map((group) => (
													<div class="role-group">
														<h4>{group.title}</h4>
														<ul>
															{group.bullets.map((bullet) => (
																<li>{bullet}</li>
															))}
														</ul>
													</div>
												))}
											</section>
										))
									}
								</div>
							</section>

							<section class="resume-section projects-section" aria-labelledby="resume-projects-title">
								<h2 id="resume-projects-title">Side Projects</h2>
								<div class="project-library">
									{
										sabreResumeSideProjects.map((project) => (
											<section class="project-item">
												<div class="project-heading">
													<h3>{project.title}</h3>
													{project.url && (
														<a href={project.url} rel="noopener noreferrer">
															{project.label ?? project.url}
														</a>
													)}
												</div>
												<p>{project.description}</p>
											</section>
										))
									}
								</div>
							</section>

							<section class="resume-section compact-section" aria-labelledby="resume-education-title">
								<h2 id="resume-education-title">Education & Certifications</h2>
								<ul class="compact-list">
									{sabreResumeEducation.map((item) => <li>{item}</li>)}
								</ul>
							</section>

							<section class="resume-section compact-section writing-section" aria-labelledby="resume-writing-title">
								<h2 id="resume-writing-title">Writing, Memos & Notes</h2>
								<div class="writing-library" aria-label="Published writing">
									{
										sabreWritingItems.map((item) => (
											<a class={`writing-item writing-item-${item.type}`} href={withBase(`/writing/${item.slug}/`)}>
												<div>
													<span class="writing-type">{item.type}</span>
													<h3>{item.title}</h3>
												</div>
												<p>{item.description}</p>
												<span class="writing-meta">
													{formatWritingDate(item.date)} | {absoluteUrl(`/writing/${item.slug}/`)}
												</span>
											</a>
										))
									}
								</div>
							</section>

							<section class="resume-section compact-section" aria-labelledby="resume-speaking-title">
								<h2 id="resume-speaking-title">Speaking</h2>
								<ul class="compact-list">
									{
										sabreResumeSpeaking.map((item) => (
											<li>
												{item}. {absoluteUrl('/speaking/')}
											</li>
										))
									}
								</ul>
							</section>

							<p class="resume-note">Home address and earlier roles intentionally omitted.</p>
						</div>
					</td>
				</tr>
			</tbody>
		</table>
	</article>
</SiteLayout>

<style>
	:global(.sabre-screen-only.surface-header) {
		margin-top: 1rem;
	}

	.resume-shell {
		margin-top: 1rem;
		border: 1px solid rgba(51, 65, 85, 0.82);
		background: rgb(2, 6, 23);
		box-shadow:
			0 0 0 1px rgba(15, 23, 42, 0.72) inset,
			0 10px 28px rgba(2, 6, 23, 0.28);
	}

	.resume-body {
		padding: 1.15rem;
	}

	.resume-print-header {
		display: none;
	}

	.resume-print-table,
	.resume-print-table tbody,
	.resume-print-table tr,
	.resume-print-table td {
		display: block;
		width: 100%;
		border: 0;
		border-collapse: collapse;
		padding: 0;
	}

	.resume-header {
		border-bottom: 1px solid rgba(212, 165, 116, 0.82);
		padding-bottom: 0.85rem;
		text-align: center;
	}

	.resume-header h1 {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		line-height: 1.08;
		font-weight: 700;
		color: rgba(248, 250, 252, 0.99);
		letter-spacing: 0;
	}

	.resume-header p {
		margin-top: 0.35rem;
		font-size: 0.82rem;
		line-height: 1.45;
		color: rgba(203, 213, 225, 0.96);
		overflow-wrap: anywhere;
	}

	.resume-section {
		margin-top: 1.15rem;
	}

	.resume-section h2 {
		border-bottom: 1px solid rgba(212, 165, 116, 0.76);
		padding-bottom: 0.26rem;
		font-size: 0.82rem;
		line-height: 1.2;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(245, 222, 179, 0.98);
	}

	.summary-list {
		margin-top: 0.7rem;
		display: grid;
		gap: 0.6rem;
		padding: 0;
		list-style: none;
	}

	.role-summary,
	.resume-note {
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgba(203, 213, 225, 0.96);
	}

	.summary-list li,
	.role-group li,
	.compact-list li {
		position: relative;
		padding-left: 0.95rem;
	}

	.summary-list li::before,
	.role-group li::before,
	.compact-list li::before {
		position: absolute;
		top: 0.58em;
		left: 0;
		width: 0.34rem;
		height: 0.34rem;
		border-radius: 999px;
		background: rgba(212, 165, 116, 0.92);
		content: '';
	}

	.summary-list li {
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgba(203, 213, 225, 0.96);
	}

	.value-grid {
		margin-top: 0.7rem;
		display: grid;
		gap: 0.65rem;
	}

	.value-item {
		border-left: 2px solid rgba(212, 165, 116, 0.82);
		background: rgba(15, 23, 42, 0.46);
		padding: 0.58rem 0.7rem;
	}

	.value-item h3 {
		font-size: 0.78rem;
		line-height: 1.25;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgba(245, 222, 179, 0.98);
	}

	.value-item p {
		margin-top: 0.25rem;
		font-size: 0.82rem;
		line-height: 1.45;
		color: rgba(203, 213, 225, 0.96);
	}

	.role-stack {
		margin-top: 0.8rem;
		display: grid;
		gap: 1.05rem;
	}

	.resume-role {
		border-top: 1px solid rgba(51, 65, 85, 0.78);
		padding-top: 0.85rem;
	}

	.resume-role:first-child {
		border-top: 0;
		padding-top: 0;
	}

	.role-heading {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.role-heading h3 {
		font-size: 0.98rem;
		line-height: 1.32;
		font-weight: 700;
		color: rgba(248, 250, 252, 0.99);
	}

	.role-heading h3 span {
		display: block;
		margin-top: 0.1rem;
		font-weight: 500;
		color: rgba(203, 213, 225, 0.98);
	}

	.role-heading p {
		font-size: 0.76rem;
		line-height: 1.3;
		color: rgba(148, 163, 184, 0.96);
	}

	.role-summary {
		margin-top: 0.45rem;
	}

	.role-group {
		margin-top: 0.7rem;
	}

	.role-group h4 {
		font-size: 0.72rem;
		line-height: 1.25;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: rgba(148, 163, 184, 0.98);
	}

	.role-group ul,
	.compact-list {
		margin-top: 0.42rem;
		padding-left: 0;
		list-style: none;
	}

	.role-group li,
	.compact-list li {
		margin-top: 0.34rem;
		font-size: 0.83rem;
		line-height: 1.52;
		color: rgba(203, 213, 225, 0.96);
	}

	.compact-list a {
		overflow-wrap: anywhere;
	}

	.writing-library {
		margin-top: 0.7rem;
		display: grid;
		gap: 0.65rem;
	}

	.project-library {
		margin-top: 0.7rem;
		display: grid;
		gap: 0.65rem;
	}

	.project-item {
		border: 1px solid rgba(51, 65, 85, 0.78);
		background: rgba(15, 23, 42, 0.5);
		padding: 0.7rem;
	}

	.project-heading {
		display: flex;
		flex-direction: column;
		gap: 0.22rem;
	}

	.project-heading h3 {
		font-size: 0.86rem;
		line-height: 1.28;
		font-weight: 700;
		color: rgba(248, 250, 252, 0.99);
	}

	.project-heading a {
		font-size: 0.72rem;
		line-height: 1.35;
		color: rgba(245, 222, 179, 0.98);
		overflow-wrap: anywhere;
		text-decoration: none;
	}

	.project-heading a:hover {
		color: rgba(248, 250, 252, 0.99);
	}

	.project-item p {
		margin-top: 0.38rem;
		font-size: 0.82rem;
		line-height: 1.48;
		color: rgba(203, 213, 225, 0.96);
	}

	.writing-item {
		display: block;
		border: 1px solid rgba(51, 65, 85, 0.78);
		background: rgba(15, 23, 42, 0.5);
		padding: 0.7rem;
		color: inherit;
		text-decoration: none;
	}

	.writing-item:hover {
		border-color: rgba(100, 116, 139, 0.95);
		background: rgba(15, 23, 42, 0.72);
	}

	.writing-item div {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.writing-type {
		flex: 0 0 auto;
		border: 1px solid rgba(212, 165, 116, 0.62);
		padding: 0.1rem 0.35rem;
		font-size: 0.62rem;
		line-height: 1.2;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgba(245, 222, 179, 0.98);
	}

	.writing-item h3 {
		min-width: 0;
		font-size: 0.86rem;
		line-height: 1.28;
		font-weight: 700;
		color: rgba(248, 250, 252, 0.99);
	}

	.writing-item p {
		margin-top: 0.35rem;
		font-size: 0.8rem;
		line-height: 1.45;
		color: rgba(203, 213, 225, 0.96);
	}

	.writing-meta {
		display: block;
		margin-top: 0.38rem;
		font-size: 0.72rem;
		line-height: 1.35;
		color: rgba(148, 163, 184, 0.96);
		overflow-wrap: anywhere;
	}

	.resume-note {
		margin-top: 1rem;
		border-top: 1px solid rgba(51, 65, 85, 0.78);
		padding-top: 0.7rem;
		font-size: 0.74rem;
		color: rgba(148, 163, 184, 0.96);
	}

	@media (min-width: 720px) {
		.resume-body {
			padding: 1.6rem;
		}

		.summary-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.value-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.writing-library {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.project-library {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.role-heading {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: 1rem;
		}

		.role-heading h3 span {
			display: inline;
			margin-top: 0;
		}

		.role-heading h3 span::before {
			content: ' - ';
			color: rgba(148, 163, 184, 0.72);
		}

		.role-heading p {
			flex: 0 0 auto;
			text-align: right;
		}
	}

	@media print {
		@page {
			size: letter;
			margin: 0 0 0.42in;
			background: white;
		}

		:global(html),
		:global(body) {
			width: auto !important;
			height: auto !important;
			overflow: visible !important;
			background: white !important;
			color: #111827 !important;
			font-family: Arial, Helvetica, sans-serif !important;
		}

		:global(body) {
			display: block !important;
			min-height: auto !important;
		}

		:global(.site-header),
		:global(.site-footer),
		:global(.sabre-screen-only),
		:global(#global-shortcuts-overlay),
		:global(#global-shortcuts-fab),
		:global(#global-shortcut-leader) {
			display: none !important;
		}

		:global(.site-main) {
			display: block !important;
			max-width: none !important;
			min-width: 0 !important;
			width: auto !important;
			margin: 0 !important;
			padding: 0 !important;
		}

		.resume-shell,
		.resume-body {
			margin: 0 !important;
			border: 0 !important;
			background: transparent !important;
			box-shadow: none !important;
		}

		.resume-body {
			padding: 0.1in 0 0.62in !important;
		}

		.resume-print-table {
			display: table;
			width: 100%;
			border-collapse: collapse;
		}

		.resume-print-table tbody {
			display: table-row-group;
		}

		.resume-print-table tr {
			display: table-row;
		}

		.resume-print-table th,
		.resume-print-table td {
			display: table-cell;
			width: 100%;
			padding: 0;
			border: 0;
			vertical-align: top;
		}

		.resume-print-header {
			display: table-header-group;
		}

		.resume-print-header th {
			border-bottom: 1px solid #c49a6c;
			padding: 0.44in 0.62in 0.1in;
			font-weight: 400;
		}

		.resume-print-table td {
			padding-right: 0.62in;
			padding-left: 0.62in;
		}

		.resume-print-header-inner {
			border-bottom: 1px solid #c49a6c;
			padding-bottom: 0.08in;
			text-align: center;
			background: white;
		}

		.resume-print-header h1 {
			margin: 0;
			font-size: 15pt;
			line-height: 1.1;
			color: #111827;
		}

		.resume-print-header p {
			margin: 2pt 0 0;
			font-size: 8.5pt;
			line-height: 1.2;
			color: #374151;
		}

		.resume-header {
			display: none;
		}

		.resume-section {
			margin-top: 0.12in;
		}

		.resume-section h2 {
			break-after: avoid;
			border-bottom: 1px solid #c49a6c;
			padding-bottom: 3pt;
			font-size: 9.5pt;
			line-height: 1.15;
			color: #111827;
			letter-spacing: 0.04em;
		}

		.summary-list,
		.value-grid {
			display: grid;
			margin-top: 6pt;
			column-gap: 0.16in;
			row-gap: 4pt;
		}

		.summary-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.value-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.role-stack {
			display: block;
			margin-top: 6pt;
		}

		.summary-list li,
		.role-summary,
		.resume-note,
		.role-group li,
		.compact-list li {
			font-size: 8.25pt;
			line-height: 1.3;
			color: #111827;
		}

		.summary-list,
		.role-group ul,
		.compact-list {
			list-style: none;
			padding-left: 0;
		}

		.summary-list li {
			margin: 0;
		}

		.summary-list li,
		.role-group li,
		.compact-list li {
			padding-left: 0.13in;
		}

		.summary-list li::before,
		.role-group li::before,
		.compact-list li::before {
			top: 0.42em;
			left: 0;
			width: 3.2pt;
			height: 3.2pt;
			background: #c49a6c;
		}

		.value-item {
			break-inside: avoid;
			border-left: 0;
			background: transparent;
			padding: 0;
		}

		.value-item h3 {
			margin: 0;
			font-size: 8.1pt;
			line-height: 1.18;
			color: #374151;
			letter-spacing: 0.03em;
		}

		.value-item p {
			margin: 2pt 0 0;
			font-size: 8.25pt;
			line-height: 1.3;
			color: #111827;
		}

		.resume-role {
			break-inside: auto;
			border-top: 0;
			padding-top: 0;
			margin-top: 0.1in;
		}

		.role-heading {
			break-after: avoid;
			display: flex;
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: 0.25in;
		}

		.role-heading h3 {
			margin: 0;
			font-size: 9.5pt;
			line-height: 1.2;
			color: #111827;
		}

		.role-heading h3 span {
			display: inline;
			color: #111827;
			font-weight: 400;
		}

		.role-heading h3 span::before {
			content: ' - ';
			color: #111827;
		}

		.role-heading p {
			margin: 0;
			flex: 0 0 auto;
			font-size: 8.5pt;
			color: #374151;
		}

		.role-summary {
			margin: 3pt 0 0;
		}

		.role-group {
			margin-top: 4pt;
		}

		.role-group h4 {
			break-after: avoid;
			margin: 0;
			font-size: 8.1pt;
			line-height: 1.18;
			color: #374151;
			letter-spacing: 0.03em;
		}

		.role-group ul,
		.compact-list {
			margin: 3pt 0 0;
			padding-left: 0;
		}

		.role-group li,
		.compact-list li {
			margin-top: 2pt;
		}

		.compact-section {
			break-inside: avoid;
		}

		.writing-section {
			break-inside: auto;
		}

