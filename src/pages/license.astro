---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
	title="License | Adam Boas"
	description="Code and content licensing terms for this site and repository."
	canonicalHref="https://www.adamboas.com/license/"
>
	<section class="mt-2 max-w-3xl space-y-4">
		<h1 class="section-title">License</h1>

		<div id="code" class="card p-5 space-y-3 text-sm text-slate-300">
			<h2 class="text-base font-semibold text-slate-100">Code</h2>
			<p>
				Software code in this repository is licensed under
				<strong class="text-slate-100">GNU Affero General Public License v3.0 or later (AGPL-3.0-or-later)</strong>.
			</p>
			<p>
				Full text:
				<a href="https://github.com/anboas/adamboas.info/blob/main/LICENSE" target="_blank" rel="noreferrer">LICENSE</a>
			</p>
		</div>

		<div id="content" class="card p-5 space-y-3 text-sm text-slate-300">
			<h2 class="text-base font-semibold text-slate-100">Writing and non-code content</h2>
			<p>
				Writing and non-code content are licensed under
				<strong class="text-slate-100">CC BY-NC-ND 4.0</strong>, unless a file says otherwise.
			</p>
			<p>
				Full terms:
				<a href="https://github.com/anboas/adamboas.info/blob/main/CONTENT_LICENSE.md" target="_blank" rel="noreferrer">CONTENT_LICENSE.md</a>
			</p>
			<p>
				Radar entries compile references from public sources. Source owners retain rights to original third-party materials.
			</p>
		</div>
	</section>
</SiteLayout>
