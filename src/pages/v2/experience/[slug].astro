---
import V2Layout from '../../../layouts/V2Layout.astro';
import { experience } from '../../../data/resume';
import { withBase } from '../../../utils/withBase';

export async function getStaticPaths() {
	return experience.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props;

const idx = experience.findIndex((x) => x.slug === r.slug);
const prev = idx > 0 ? experience[idx - 1] : null;
const next = idx >= 0 && idx + 1 < experience.length ? experience[idx + 1] : null;
---

<V2Layout title={`Experience | ${r.company}`} description={`${r.title} (${r.period}).`} active="experience">
	<article class="card p-8">
		<header class="flex flex-col gap-3">
			<a class="text-sm text-slate-400 hover:text-slate-200" href={withBase('/v2/experience/')}>← Experience</a>
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold text-slate-50">{r.company}</h1>
				<p class="mt-2 text-slate-300">{r.title}</p>
				<p class="mt-2 text-sm text-slate-400">{r.period}</p>
				<p class="mt-4 text-sm text-slate-300">{r.summary}</p>
			</div>
		</header>

		<div class="mt-10 flex flex-col gap-3 border-t border-slate-800 pt-6 md:flex-row md:justify-between">
			{prev ? (
				<a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/v2/experience/${prev.slug}/`)}>
					← {prev.company}
				</a>
			) : (
				<span />
			)}
			{next ? (
				<a class="text-sm font-semibold text-stone-100 hover:text-stone-50" href={withBase(`/v2/experience/${next.slug}/`)}>
					{next.company} →
				</a>
			) : (
				<span />
			)}
		</div>
	</article>
</V2Layout>
