---
// Back-compat: /v2/papers/<slug> → /v2/writing/<slug>
import { getCollection } from 'astro:content';
import V2Layout from '../../../layouts/V2Layout.astro';
import { withBase } from '../../../utils/withBase';

export async function getStaticPaths() {
	const papers = await getCollection('papers');
	return papers.map((paper) => ({
		params: { slug: paper.id },
		props: { slug: paper.id },
	}));
}

const { slug } = Astro.props as { slug: string };
---

<V2Layout title="Writing | Adam Boas" description="Redirecting…" canonicalHref={`/v2/writing/${slug}/`} active="writing">
	<meta http-equiv="refresh" content={`0; url=${withBase(`/v2/writing/${slug}/`)}`} />
	<p class="text-slate-300">Redirecting to <a href={withBase(`/v2/writing/${slug}/`)}>{`/v2/writing/${slug}/`}</a>…</p>
</V2Layout>
