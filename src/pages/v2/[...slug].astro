---
import { getCollection } from 'astro:content';
import V2Layout from '../../layouts/V2Layout.astro';
import UiVersionToggle from '../../components/UiVersionToggle.astro';
import { withBase } from '../../utils/withBase';
import { education, experience } from '../../data/resume';

function withTrailingSlash(pathname: string) {
	if (!pathname) return '/';
	return pathname.endsWith('/') ? pathname : `${pathname}/`;
}

export async function getStaticPaths() {
	const normalizeRoute = (pathname: string) => pathname.replace(/^\/+/, '').replace(/\/+$/, '');
	const routes = new Set<string>();
	const add = (route: string) => {
		const normalized = normalizeRoute(route);
		if (normalized) routes.add(normalized);
	};

	[
		'experience',
		'education',
		'changes',
		'status',
		'status/site-analytics',
		'sitemap',
		'credentials',
		'content-license',
		'license',
		'papers',
		'blog',
	].forEach(add);

	const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
	const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

	for (const w of writing) {
		const slug = w.id.split('/').pop();
		if (slug) add(`writing/${slug}`);
	}
	for (const p of papers) {
		add(`writing/${p.id}`);
		add(`papers/${p.id}`);
	}

	for (const role of experience) add(`experience/${role.slug}`);
	for (const cert of education) add(`education/${cert.slug}`);

	return [...routes]
		.sort((a, b) => a.localeCompare(b))
		.map((slug) => ({ params: { slug }, props: { slug } }));
}

const normalizeCurrent = (pathname: string) => pathname.replace(/^\/+/, '').replace(/\/+$/, '');

const slugFromProps = Astro.props.slug as string | undefined;
const slugFromParams = Astro.params.slug as string | undefined;
const rawSlug = slugFromProps ?? slugFromParams ?? '';
const slug = normalizeCurrent(rawSlug);

const segments = slug.split('/').filter(Boolean);
const section = segments[0] ?? 'home';
const active = ['writing', 'events', 'opportunities', 'capabilities', 'experience', 'education'].includes(section) ? section : 'home';

const classicPath = withTrailingSlash(`/${slug}`);
const prettyPath = `/${slug}/`;
---

<V2Layout title={`UI v2 Mirror • ${prettyPath}`} description={`Independent v2 mirror route for ${prettyPath}`} active={active}>
	<section class="card v2-mirror-shell p-5">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<p class="v2-kicker">Independent v2 site buildout</p>
				<h1 class="section-title mt-1">{prettyPath}</h1>
				<p class="mt-2 text-sm text-slate-300">This route is live under the v2 namespace so you can navigate the entire site independently while production remains untouched.</p>
			</div>
			<UiVersionToggle current="v2" />
		</div>
		<div class="mt-3 flex flex-wrap gap-2">
			<a class="ui-link-btn ui-link-btn-primary" href={withBase(classicPath)} target="_blank" rel="noopener noreferrer">Open production route</a>
			<a class="ui-link-btn" href={withBase('/v2/')}>Back to v2 home</a>
		</div>
	</section>

	<section class="mt-4 card v2-mirror-shell p-2 sm:p-3">
		<div class="v2-iframe-frame">
			<iframe id="v2-mirror-frame" title={`Production mirror ${prettyPath}`} src={withBase(classicPath)} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
		</div>
	</section>

	<script is:inline>
		(() => {
			const frame = document.getElementById('v2-mirror-frame');
			if (!frame) return;

			const v2Css = `
				:root {
					color-scheme: dark;
				}
				body {
					background: #05070b !important;
					color: #e6edf3 !important;
				}
				.site-header,
				.site-footer {
					background: #05070b !important;
					border-color: #1e2b3e !important;
				}
				.card,
				.control-shell,
				.writing-detail-shell,
				.writing-main-card,
				.writing-right-rail,
				.writing-left-rail,
				.writing-content-card {
					background: #0a0f1a !important;
					border-color: #243244 !important;
				}
				a {
					color: #b8d5ff;
				}
				a:hover {
					color: #d8e8ff;
				}
				.ui-link-btn,
				button,
				.footer-link {
					border-radius: 0 !important;
					border-color: #2c3d54 !important;
				}
				.ui-link-btn-primary,
				button.primary,
				button[type='submit'] {
					background: #2f81f7 !important;
					border-color: #2f81f7 !important;
					color: #f8fbff !important;
				}
				.ui-pill,
				.badge,
				.tag-chip,
				[class*='pill'] {
					background: #0f1626 !important;
					border-color: #243244 !important;
					color: #9da7b3 !important;
				}
				input,
				select,
				textarea {
					background: #0f1626 !important;
					border-color: #243244 !important;
					color: #e6edf3 !important;
				}
				tr:hover td,
				tbody tr:hover {
					background: rgba(47, 129, 247, 0.08) !important;
				}
				.sticky-tab-active,
				[aria-current='page'] {
					background: rgba(34, 211, 238, 0.16) !important;
					border-color: rgba(34, 211, 238, 0.45) !important;
					color: #c7fbff !important;
				}
			`;

			const basePath = document.body?.dataset?.siteBase || '/';
			const stripBase = (path) => {
				if (!path.startsWith(basePath)) return path;
				return `/${path.slice(basePath.length).replace(/^\/+/, '')}`;
			};

			const toV2Href = (href) => {
				try {
					const parsed = new URL(href, window.location.origin);
					if (parsed.origin !== window.location.origin) return null;
					if (/\.(pdf|xml|png|jpg|jpeg|webp|gif|mp3|m4a)$/i.test(parsed.pathname)) return null;
					const path = stripBase(parsed.pathname);
					if (path.startsWith('/v2/')) return parsed.pathname + parsed.search + parsed.hash;
					if (path === '/v2') return parsed.pathname + parsed.search + parsed.hash;
					const next = `${basePath.replace(/\/$/, '')}/v2${path === '/' ? '/' : path}`;
					return `${next}${parsed.search}${parsed.hash}`;
				} catch {
					return null;
				}
			};

			const applyToFrame = () => {
				const doc = frame.contentDocument;
				if (!doc) return;

				let style = doc.getElementById('v2-mirror-overrides');
				if (!style) {
					style = doc.createElement('style');
					style.id = 'v2-mirror-overrides';
					doc.head.appendChild(style);
				}
				style.textContent = v2Css;

				doc.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof Element)) return;
					const anchor = target.closest('a[href]');
					if (!anchor) return;
					if (anchor.hasAttribute('download')) return;
					const href = anchor.getAttribute('href');
					if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
					const next = toV2Href(anchor.href);
					if (!next) return;
					event.preventDefault();
					window.location.href = next;
				}, { capture: true });
			};

			frame.addEventListener('load', applyToFrame);
			applyToFrame();
		})();
	</script>
</V2Layout>

<style>
	.v2-mirror-shell {
		border: 1px solid rgba(51, 65, 85, 0.92);
		background: rgba(5, 7, 11, 0.95);
	}
	.v2-kicker {
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(34, 211, 238, 0.95);
	}
	.v2-iframe-frame {
		border: 1px solid rgba(51, 65, 85, 0.88);
		background: rgba(2, 6, 23, 0.9);
		overflow: hidden;
	}
	.v2-iframe-frame iframe {
		display: block;
		width: 100%;
		height: min(85vh, 1200px);
		border: 0;
		background: transparent;
	}
</style>
