---
import SiteLayout from '../layouts/SiteLayout.astro';
import SurfacePageHeader from '../components/SurfacePageHeader.astro';
import { withBase } from '../utils/withBase';
import { CONTACT_PHONE } from '../data/resume';
import { absoluteUrl, CONTACT_EMAIL, CONTACT_FORM_ENDPOINT, CONTACT_PHONE_E164, contactMailto } from '../config/site';
import { PERSON_ID, PERSON_IMAGE_PATH, PERSON_NAME, PERSON_SAME_AS } from '../data/entity';

const contactFormSubject = `${new URL(absoluteUrl('/')).hostname} contact form`;
const contactUrl = absoluteUrl('/contact/');

const contactPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: `Contact ${PERSON_NAME}`,
	url: contactUrl,
	description: `Start a project conversation with ${PERSON_NAME}. Share mission, timeline, and scope.`,
	mainEntity: {
		'@id': PERSON_ID,
	},
};

const personContactSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': PERSON_ID,
	name: PERSON_NAME,
	url: absoluteUrl('/'),
	image: absoluteUrl(PERSON_IMAGE_PATH),
	sameAs: PERSON_SAME_AS,
	contactPoint: [
		{
			'@type': 'ContactPoint',
			contactType: 'business inquiries',
			email: CONTACT_EMAIL,
			telephone: CONTACT_PHONE_E164,
			url: contactUrl,
			availableLanguage: ['English'],
		},
	],
};

const contactBreadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
		{ '@type': 'ListItem', position: 2, name: 'Contact', item: contactUrl },
	],
};
---

<SiteLayout
	title="Contact | Adam Boas"
	description="Start a project conversation with Adam Boas. Share mission, timeline, and scope."
	canonicalHref={absoluteUrl('/contact/')}
>
	<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(personContactSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(contactBreadcrumbSchema)} />
	<SurfacePageHeader
		stickyActive="home"
		eyebrow="Engage"
		title="Start a project"
		description="Tell me what you need, what timeline you are working against, and where execution is blocked. I read every request."
	>
		<div slot="actions" class="flex flex-wrap items-center gap-2">
			<a class="ui-link-btn" data-track="Contact: Email Click" href={contactMailto()}>Email direct</a>
			<a class="ui-link-btn" data-track="Contact: Phone Click" href={`tel:${CONTACT_PHONE_E164}`}
				>Call {CONTACT_PHONE}</a
			>
			<a class="ui-link-btn ui-link-btn-muted" href={withBase('/writing/')}>Read work</a>
		</div>
	</SurfacePageHeader>

	<section class="card control-shell mt-4 p-5">
		<form
			data-contact-form
			data-contact-endpoint={CONTACT_FORM_ENDPOINT}
			data-contact-subject={contactFormSubject}
			class="contact-form"
			novalidate
		>
			<input type="hidden" name="_subject" value={contactFormSubject} />
			<input type="hidden" name="_template" value="table" />
			<input type="hidden" name="_captcha" value="false" />
			<input type="text" name="website" class="contact-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

			<div class="contact-grid">
				<label class="contact-field">
					<span>Name</span>
					<input class="contact-input" name="name" type="text" autocomplete="name" placeholder="Your name" required />
				</label>

				<label class="contact-field">
					<span>Email</span>
					<input
						class="contact-input"
						name="email"
						type="email"
						autocomplete="email"
						placeholder="you@company.com"
						required
					/>
				</label>

				<label class="contact-field">
					<span>Organization</span>
					<input
						class="contact-input"
						name="organization"
						type="text"
						autocomplete="organization"
						placeholder="Company / program office"
					/>
				</label>

				<label class="contact-field">
					<span>Request type</span>
					<select class="contact-input" name="intent" required>
						<option value="">Select one</option>
						<option value="consulting">Consulting engagement</option>
						<option value="architecture">Architecture review</option>
						<option value="proposal">Proposal / capture support</option>
						<option value="speaking">Speaking / briefing</option>
						<option value="other">Other</option>
					</select>
				</label>
			</div>

			<div class="contact-intent-brief mt-3" data-intent-brief hidden>
				<p class="contact-intent-title" data-intent-brief-title></p>
				<ul class="contact-intent-points" data-intent-brief-points></ul>
			</div>

			<div class="contact-grid mt-3" data-intent-followups hidden>
				<label class="contact-field">
					<span data-intent-focus-label>Primary objective</span>
					<input
						class="contact-input"
						name="focus"
						type="text"
						autocomplete="off"
						data-intent-focus-input
						placeholder="What outcome do you need most?"
					/>
				</label>

				<label class="contact-field">
					<span data-intent-window-label>Decision window</span>
					<input
						class="contact-input"
						name="timeline"
						type="text"
						autocomplete="off"
						data-intent-window-input
						placeholder="When do you need this moving?"
					/>
				</label>
			</div>

			<label class="contact-field mt-3">
				<span data-intent-message-label>Project brief</span>
				<textarea
					class="contact-input contact-textarea"
					name="message"
					rows="7"
					data-intent-message-input
					placeholder="Context, mission outcome, timeline, constraints, and what success looks like."
					required></textarea>
			</label>

			<div class="mt-4 flex flex-wrap items-center gap-3">
				<button class="contact-submit ui-link-btn ui-link-btn-primary" data-contact-submit type="submit"
					>Send request</button
				>
				<p class="text-xs text-slate-400">
					Or email <a
						class="underline decoration-slate-600 underline-offset-2 hover:decoration-slate-400"
						href={contactMailto()}>{CONTACT_EMAIL}</a
					> or call <a
						class="underline decoration-slate-600 underline-offset-2 hover:decoration-slate-400"
						href={`tel:${CONTACT_PHONE_E164}`}>{CONTACT_PHONE}</a
					>.
				</p>
			</div>

			<div class="mt-3 space-y-2">
				<p class="contact-status text-xs text-slate-300" data-contact-status aria-live="polite"></p>
				<div class="contact-errors text-xs text-rose-300" data-contact-errors hidden></div>
			</div>
		</form>
	</section>

	<script type="module" src={withBase('/scripts/contact-form.js')}></script>
</SiteLayout>

<style>
	.contact-form {
		display: grid;
		gap: 0.35rem;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.contact-field {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.67rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: rgba(148, 163, 184, 0.95);
	}
	.contact-input {
		height: 2.2rem;
		border: 1px solid rgba(71, 85, 105, 0.9);
		background: rgba(2, 6, 23, 0.9);
		color: rgba(241, 245, 249, 0.98);
		padding: 0 0.65rem;
		font-size: 0.86rem;
		text-transform: none;
		letter-spacing: normal;
	}
	.contact-input::placeholder {
		color: rgba(148, 163, 184, 0.8);
	}
	.contact-textarea {
		height: auto;
		padding: 0.65rem;
		line-height: 1.45;
		resize: vertical;
		min-height: 9rem;
	}
	.contact-intent-brief {
		border: 1px solid rgba(71, 85, 105, 0.8);
		background: rgba(15, 23, 42, 0.75);
		padding: 0.75rem;
	}
	.contact-intent-title {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: rgba(148, 163, 184, 0.98);
	}
	.contact-intent-points {
		margin: 0.45rem 0 0;
		padding-left: 1rem;
		display: grid;
		gap: 0.25rem;
		font-size: 0.8rem;
		line-height: 1.45;
		color: rgba(226, 232, 240, 0.96);
	}
	.contact-submit {
		min-height: 2.15rem;
		padding: 0 0.9rem;
		font-size: 0.76rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.contact-submit:disabled {
		opacity: 0.6;
		cursor: wait;
	}
	.contact-hp {
		position: absolute;
		left: -9999px;
		top: -9999px;
		height: 0;
		width: 0;
		opacity: 0;
		pointer-events: none;
	}
	.contact-status[data-tone='success'] {
		color: rgba(187, 247, 208, 0.98);
	}
	.contact-status[data-tone='error'] {
		color: rgba(254, 205, 211, 0.98);
	}
	/* header quick links use global ui-link-btn classes */
	@media (max-width: 760px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
