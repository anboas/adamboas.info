---
import SiteLayout from '../layouts/SiteLayout.astro';
import StickyBrowseBar from '../components/StickyBrowseBar.astro';
import { withBase } from '../utils/withBase';
---

<SiteLayout
	title="Contact | Adam Boas"
	description="Start a project conversation with Adam Boas. Share mission, timeline, and scope."
	canonicalHref="https://www.adamboas.com/contact/"
>
	<StickyBrowseBar active="home" />

	<section class="card control-shell p-5">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="max-w-3xl">
				<h1 class="section-title">Start a project</h1>
				<p class="mt-2 text-sm text-slate-300">
					Tell me what you need, what timeline you are working against, and where execution is blocked. I read every request.
				</p>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<a class="ui-link-btn" data-track="Contact: Email Click" href="mailto:anboas@gmail.com">Email direct</a>
				<a class="ui-link-btn ui-link-btn-muted" href={withBase('/writing/')}>Read work</a>
			</div>
		</div>
	</section>

	<section class="card control-shell mt-4 p-5">
		<form data-contact-form class="contact-form" novalidate>
			<input type="hidden" name="_subject" value="adamboas.com contact form" />
			<input type="hidden" name="_template" value="table" />
			<input type="hidden" name="_captcha" value="false" />
			<input type="text" name="website" class="contact-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

			<div class="contact-grid">
				<label class="contact-field">
					<span>Name</span>
					<input class="contact-input" name="name" type="text" autocomplete="name" placeholder="Your name" required />
				</label>

				<label class="contact-field">
					<span>Email</span>
					<input class="contact-input" name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
				</label>

				<label class="contact-field">
					<span>Organization</span>
					<input class="contact-input" name="organization" type="text" autocomplete="organization" placeholder="Company / program office" />
				</label>

				<label class="contact-field">
					<span>Request type</span>
					<select class="contact-input" name="intent" required>
						<option value="">Select one</option>
						<option value="consulting">Consulting engagement</option>
						<option value="architecture">Architecture review</option>
						<option value="proposal">Proposal / capture support</option>
						<option value="speaking">Speaking / briefing</option>
						<option value="other">Other</option>
					</select>
				</label>
			</div>

			<label class="contact-field mt-3">
				<span>Project brief</span>
				<textarea
					class="contact-input contact-textarea"
					name="message"
					rows="7"
					placeholder="Context, mission outcome, timeline, constraints, and what success looks like."
					required
				></textarea>
			</label>

			<div class="mt-4 flex flex-wrap items-center gap-3">
				<button class="contact-submit ui-link-btn ui-link-btn-primary" data-contact-submit type="submit">Send request</button>
				<p class="text-xs text-slate-400">Or email <a class="underline decoration-slate-600 underline-offset-2 hover:decoration-slate-400" href="mailto:anboas@gmail.com">anboas@gmail.com</a>.</p>
			</div>

			<div class="mt-3 space-y-2">
				<p class="contact-status text-xs text-slate-300" data-contact-status aria-live="polite"></p>
				<div class="contact-errors text-xs text-rose-300" data-contact-errors hidden></div>
			</div>
		</form>
	</section>

	<script type="module" src={withBase('/scripts/contact-form.js')}></script>
</SiteLayout>

<style>
	.contact-form {
		display: grid;
		gap: 0.35rem;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.contact-field {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.67rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: rgba(148, 163, 184, 0.95);
	}
	.contact-input {
		height: 2.2rem;
		border: 1px solid rgba(71, 85, 105, 0.9);
		background: rgba(2, 6, 23, 0.9);
		color: rgba(241, 245, 249, 0.98);
		padding: 0 0.65rem;
		font-size: 0.86rem;
		text-transform: none;
		letter-spacing: normal;
	}
	.contact-input::placeholder {
		color: rgba(148, 163, 184, 0.8);
	}
	.contact-textarea {
		height: auto;
		padding: 0.65rem;
		line-height: 1.45;
		resize: vertical;
		min-height: 9rem;
	}
	.contact-submit {
		min-height: 2.15rem;
		padding: 0 0.9rem;
		font-size: 0.76rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.contact-submit:disabled {
		opacity: 0.6;
		cursor: wait;
	}
	.contact-hp {
		position: absolute;
		left: -9999px;
		top: -9999px;
		height: 0;
		width: 0;
		opacity: 0;
		pointer-events: none;
	}
	.contact-status[data-tone='success'] {
		color: rgba(187, 247, 208, 0.98);
	}
	.contact-status[data-tone='error'] {
		color: rgba(254, 205, 211, 0.98);
	}
	/* header quick links use global ui-link-btn classes */
	@media (max-width: 760px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
