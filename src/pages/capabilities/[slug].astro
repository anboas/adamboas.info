---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../components/SurfacePageHeader.astro';
import { withBase } from '../../utils/withBase';
import { capabilityTopics, capabilityBySlug } from '../../data/capabilities';
import { radarEventsSeed } from '../../data/radar/events';
import samOpportunitiesFeed from '../../data/radar/events-candidates-sam-opportunities.json';

export async function getStaticPaths() {
	return capabilityTopics.map((topic) => ({ params: { slug: topic.slug }, props: { slug: topic.slug } }));
}

type OpportunityRow = {
	notice_id?: string;
	noticeId?: string;
	title?: string;
	noticeType?: string;
	notice_type?: string;
	postedDate?: string;
	posted_date?: string;
	responseDueDate?: string;
	response_due_date?: string;
	agencyPath?: string;
	agency_path?: string;
	naicsCode?: string;
	naics_code?: string;
	solicitationNumber?: string;
	solicitation_number?: string;
	uiLink?: string;
	ui_link?: string;
	detailUrl?: string;
	detail_url?: string;
};

const { slug } = Astro.props as { slug: string };
const capability = capabilityBySlug(slug);
if (!capability) throw new Error(`Unknown capability slug: ${slug}`);

function toText(value: unknown) {
	return String(value ?? '').toLowerCase();
}

function matches(blob: string, keywords: string[]) {
	return keywords.some((keyword) => blob.includes(keyword.toLowerCase()));
}

function safeDate(value: string | null | undefined) {
	if (!value) return null;
	const d = new Date(value);
	return Number.isNaN(d.getTime()) ? null : d;
}

const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

const writingItems = [
	...writing
		.filter((entry) => {
			const blob = `${entry.data.title} ${entry.data.summary ?? ''} ${(entry.data.tags ?? []).join(' ')}`.toLowerCase();
			const tagHit = (entry.data.tags ?? []).some((tag) => capability.writingTags.includes(tag));
			return tagHit || matches(blob, capability.keywords);
		})
		.map((entry) => ({
			type: entry.data.type,
			title: entry.data.title,
			description: entry.data.summary ?? '',
			date: entry.data.date,
			href: withBase(`/writing/${entry.id.split('/').pop()}/`),
		})),
	...papers
		.filter((entry) => {
			const blob =
				`${entry.data.title} ${entry.data.description ?? ''} ${(entry.data.tags ?? []).join(' ')}`.toLowerCase();
			const tagHit = (entry.data.tags ?? []).some((tag) => capability.writingTags.includes(tag));
			return tagHit || matches(blob, capability.keywords);
		})
		.map((entry) => ({
			type: 'paper',
			title: entry.data.title,
			description: entry.data.description ?? '',
			date: entry.data.date ?? null,
			href: withBase(`/writing/${entry.id}/`),
		})),
]
	.sort((a, b) => (b.date?.valueOf?.() ?? 0) - (a.date?.valueOf?.() ?? 0))
	.slice(0, 16);

const now = new Date();
const todayUtc = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
const eventItems = radarEventsSeed
	.filter((event) => {
		const d = safeDate(event.startDate);
		if (!d) return false;
		const day = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());
		if (day < todayUtc) return false;
		const blob = [
			event.title,
			event.description,
			event.branch,
			event.type,
			event.ontology.capabilityAreas.join(' '),
			event.ontology.missionThreads.join(' '),
			event.ontology.themes.join(' '),
			event.ontology.keywords.join(' '),
		]
			.join(' ')
			.toLowerCase();
		return matches(blob, capability.keywords);
	})
	.sort((a, b) => (safeDate(a.startDate)?.getTime() ?? 0) - (safeDate(b.startDate)?.getTime() ?? 0))
	.slice(0, 14)
	.map((event) => ({
		id: event.id,
		title: event.title,
		description: event.description,
		branch: event.branch,
		type: event.type,
		startDate: event.startDate,
		href: withBase(`/events/#${event.id}`),
	}));

const opportunitiesByKey = new Map<string, OpportunityRow>();
for (const raw of samOpportunitiesFeed as OpportunityRow[]) {
	const noticeId = String(raw.notice_id ?? raw.noticeId ?? '').trim();
	const title = String(raw.title ?? '').trim();
	const noticeType = String(raw.noticeType ?? raw.notice_type ?? '').trim();
	const key = noticeId || `${title.toLowerCase()}::${noticeType.toLowerCase()}`;
	if (!key) continue;
	if (!opportunitiesByKey.has(key)) opportunitiesByKey.set(key, raw);
}

const opportunityItems = [...opportunitiesByKey.values()]
	.filter((row) => {
		const blob = [
			toText(row.title),
			toText(row.noticeType ?? row.notice_type),
			toText(row.agencyPath ?? row.agency_path),
			toText(row.naicsCode ?? row.naics_code),
			toText(row.solicitationNumber ?? row.solicitation_number),
		].join(' ');
		return matches(blob, capability.keywords);
	})
	.sort((a, b) => {
		const aDue =
			safeDate(String(a.responseDueDate ?? a.response_due_date ?? ''))?.getTime() ?? Number.POSITIVE_INFINITY;
		const bDue =
			safeDate(String(b.responseDueDate ?? b.response_due_date ?? ''))?.getTime() ?? Number.POSITIVE_INFINITY;
		if (aDue !== bDue) return aDue - bDue;
		const aPosted = safeDate(String(a.postedDate ?? a.posted_date ?? ''))?.getTime() ?? 0;
		const bPosted = safeDate(String(b.postedDate ?? b.posted_date ?? ''))?.getTime() ?? 0;
		return bPosted - aPosted;
	})
	.slice(0, 16)
	.map((row) => {
		const noticeId = String(row.notice_id ?? row.noticeId ?? '').trim();
		const title = String(row.title ?? 'Opportunity').trim();
		const due = String(row.responseDueDate ?? row.response_due_date ?? '').trim() || null;
		const agency = String(row.agencyPath ?? row.agency_path ?? '').trim() || null;
		const noticeType = String(row.noticeType ?? row.notice_type ?? '').trim() || null;
		const openHref = noticeId
			? withBase(`/opportunities/?q=${encodeURIComponent(noticeId)}&opp=${encodeURIComponent(noticeId)}&open=1`)
			: withBase(`/opportunities/?q=${encodeURIComponent(title)}`);
		const sourceHref = String(row.uiLink ?? row.ui_link ?? row.detailUrl ?? row.detail_url ?? '').trim() || null;
		return { noticeId, title, due, agency, noticeType, openHref, sourceHref };
	});

const canonicalHref = withBase(`/capabilities/${capability.slug}/`);
const capabilitySeoDescription = `${capability.description} Includes linked writing, events, and opportunity intelligence for ${capability.title}.`;
const homeUrl = new URL(withBase('/'), Astro.site).toString();
const capabilitiesUrl = new URL(withBase('/capabilities/'), Astro.site).toString();
const pageUrl = new URL(canonicalHref, Astro.site).toString();
---

<SiteLayout
	title={`${capability.title} Capability | Adam Boas`}
	description={capabilitySeoDescription}
	canonicalHref={canonicalHref}
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
				{ '@type': 'ListItem', position: 2, name: 'Capabilities', item: capabilitiesUrl },
				{ '@type': 'ListItem', position: 3, name: capability.title, item: pageUrl },
			],
		})}
	/>

	<SurfacePageHeader
		stickyActive="capabilities"
		eyebrow="Capability topic"
		title={capability.title}
		description={capability.description}
	>
		<div slot="actions" class="flex flex-wrap gap-2">
			<a class="ui-link-btn ui-link-btn-primary" href={withBase('/contact/?intent=consulting')}>Start project</a>
			<a class="ui-link-btn ui-link-btn-muted" href={withBase('/capabilities/')}>All topics</a>
		</div>
		<div class="flex flex-wrap gap-2">
			<span class="ui-pill">Writing: {writingItems.length}</span>
			<span class="ui-pill">Upcoming events: {eventItems.length}</span>
			<span class="ui-pill">Opportunities: {opportunityItems.length}</span>
		</div>
	</SurfacePageHeader>

	<section class="mt-4 grid gap-4 xl:grid-cols-3">
		<article class="card p-4 capability-card xl:col-span-1">
			<h2 class="section-title">Writing</h2>
			<ul class="mt-3 space-y-2">
				{
					writingItems.length ? (
						writingItems.map((item) => (
							<li class="cap-item">
								<a href={item.href} class="cap-item-link">
									<span class="cap-item-type">{item.type}</span>
									<span class="cap-item-title wrap-anywhere">{item.title}</span>
								</a>
								{item.description ? <p class="cap-item-copy wrap-anywhere">{item.description}</p> : null}
							</li>
						))
					) : (
						<li class="text-sm text-slate-300">No matched writing yet.</li>
					)
				}
			</ul>
		</article>

		<article class="card p-4 capability-card xl:col-span-1">
			<h2 class="section-title">Upcoming events</h2>
			<ul class="mt-3 space-y-2">
				{
					eventItems.length ? (
						eventItems.map((item) => (
							<li class="cap-item">
								<a href={item.href} class="cap-item-link">
									<span class="cap-item-title wrap-anywhere">{item.title}</span>
								</a>
								<p class="cap-item-copy wrap-anywhere">
									{item.branch} · {item.type}
									{item.startDate ? ` · ${item.startDate}` : ''}
								</p>
							</li>
						))
					) : (
						<li class="text-sm text-slate-300">No matched upcoming events.</li>
					)
				}
			</ul>
		</article>

		<article class="card p-4 capability-card xl:col-span-1">
			<h2 class="section-title">Opportunities</h2>
			<ul class="mt-3 space-y-2">
				{
					opportunityItems.length ? (
						opportunityItems.map((item) => (
							<li class="cap-item">
								<a href={item.openHref} class="cap-item-link">
									<span class="cap-item-title wrap-anywhere">{item.title}</span>
								</a>
								<p class="cap-item-copy wrap-anywhere">
									{item.noticeType ?? 'Notice'}
									{item.agency ? ` · ${item.agency}` : ''}
									{item.due ? ` · Due ${item.due}` : ''}
								</p>
								<div class="mt-1 flex flex-wrap gap-1.5">
									<a class="cap-mini-link" href={item.openHref}>
										Open in opportunities
									</a>
									{item.sourceHref ? (
										<a class="cap-mini-link" href={item.sourceHref} target="_blank" rel="noreferrer">
											Source
										</a>
									) : null}
								</div>
							</li>
						))
					) : (
						<li class="text-sm text-slate-300">No matched opportunities yet.</li>
					)
				}
			</ul>
		</article>
	</section>
</SiteLayout>

<style>
	.capability-card {
		border: 1px solid rgba(51, 65, 85, 0.86);
		background: rgba(2, 6, 23, 0.86);
	}
	.cap-kicker {
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: rgba(148, 163, 184, 0.94);
	}
	/* shared pills/buttons use global .ui-pill and .ui-link-btn */
	.cap-item {
		border: 1px solid rgba(51, 65, 85, 0.76);
		background: rgba(2, 6, 23, 0.75);
		padding: 0.5rem 0.55rem;
	}
	.cap-item-link {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.35rem;
		text-decoration: none;
	}
	.cap-item-type {
		border: 1px solid rgba(71, 85, 105, 0.76);
		padding: 0.06rem 0.3rem;
		font-size: 0.58rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: rgba(148, 163, 184, 0.95);
	}
	.cap-item-title {
		font-size: 0.84rem;
		font-weight: 600;
		color: rgba(226, 232, 240, 0.98);
	}
	.cap-item-link:hover .cap-item-title {
		color: rgba(240, 249, 255, 0.99);
	}
	.cap-item-copy {
		margin-top: 0.25rem;
		font-size: 0.73rem;
		line-height: 1.35;
		color: rgba(148, 163, 184, 0.94);
	}
	.cap-mini-link {
		display: inline-flex;
		align-items: center;
		height: 1.35rem;
		padding: 0 0.45rem;
		border: 1px solid rgba(71, 85, 105, 0.78);
		background: rgba(2, 6, 23, 0.78);
		font-size: 0.64rem;
		color: rgba(191, 219, 254, 0.96);
		text-decoration: none;
	}
	.cap-mini-link:hover {
		border-color: rgba(125, 211, 252, 0.65);
	}
</style>
