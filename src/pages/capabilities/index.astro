---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
import { capabilityTopics } from '../../data/capabilities';
import { radarEventsSeed } from '../../data/radar/events';
import samOpportunitiesFeed from '../../data/radar/events-candidates-sam-opportunities.json';

type OpportunityRow = {
	notice_id?: string;
	noticeId?: string;
	title?: string;
	noticeType?: string;
	notice_type?: string;
	agencyPath?: string;
	agency_path?: string;
	solicitationNumber?: string;
	solicitation_number?: string;
	naicsCode?: string;
	naics_code?: string;
	classificationCode?: string;
	classification_code?: string;
};

function text(value: unknown) {
	return String(value ?? '').toLowerCase();
}

function matches(blob: string, keywords: string[]) {
	return keywords.some((keyword) => blob.includes(keyword.toLowerCase()));
}

const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

const opportunitiesByKey = new Map<string, OpportunityRow>();
for (const raw of samOpportunitiesFeed as OpportunityRow[]) {
	const noticeId = String(raw.notice_id ?? raw.noticeId ?? '').trim();
	const title = String(raw.title ?? '').trim();
	const noticeType = String(raw.noticeType ?? raw.notice_type ?? '').trim();
	const key = noticeId || `${title.toLowerCase()}::${noticeType.toLowerCase()}`;
	if (!key) continue;
	if (!opportunitiesByKey.has(key)) opportunitiesByKey.set(key, raw);
}

const now = new Date();
const todayUtc = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
const upcomingEvents = radarEventsSeed.filter((event) => {
	const d = event.startDate ? new Date(event.startDate) : null;
	if (!d || Number.isNaN(d.getTime())) return false;
	const day = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());
	return day >= todayUtc;
});

const rows = capabilityTopics.map((capability) => {
	const writingCount = [
		...writing.filter((entry) => {
			const blob = `${entry.data.title} ${entry.data.summary ?? ''} ${(entry.data.tags ?? []).join(' ')}`.toLowerCase();
			const tagHit = (entry.data.tags ?? []).some((tag) => capability.writingTags.includes(tag));
			return tagHit || matches(blob, capability.keywords);
		}),
		...papers.filter((entry) => {
			const blob = `${entry.data.title} ${entry.data.description ?? ''} ${(entry.data.tags ?? []).join(' ')}`.toLowerCase();
			const tagHit = (entry.data.tags ?? []).some((tag) => capability.writingTags.includes(tag));
			return tagHit || matches(blob, capability.keywords);
		}),
	].length;

	const eventCount = upcomingEvents.filter((event) => {
		const blob = [
			event.title,
			event.description,
			event.branch,
			event.type,
			event.ontology.capabilityAreas.join(' '),
			event.ontology.missionThreads.join(' '),
			event.ontology.themes.join(' '),
			event.ontology.keywords.join(' '),
		]
			.join(' ')
			.toLowerCase();
		return matches(blob, capability.keywords);
	}).length;

	const opportunityCount = [...opportunitiesByKey.values()].filter((row) => {
		const blob = [
			text(row.title),
			text(row.noticeType ?? row.notice_type),
			text(row.agencyPath ?? row.agency_path),
			text(row.solicitationNumber ?? row.solicitation_number),
			text(row.naicsCode ?? row.naics_code),
			text(row.classificationCode ?? row.classification_code),
		].join(' ');
		return matches(blob, capability.keywords);
	}).length;

	return {
		...capability,
		writingCount,
		eventCount,
		opportunityCount,
	};
});
---

<SiteLayout
	title="Capabilities | Adam Boas"
	description="SEO landing pages by capability/topic across writing, events, and opportunities."
	canonicalHref="https://www.adamboas.com/capabilities/"
>
	<StickyBrowseBar active="capabilities" />

	<section class="card control-shell p-5">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h1 class="section-title">Capabilities & Topics</h1>
				<p class="mt-2 text-sm text-slate-300">Explore focus areas across published writing, upcoming events, and opportunity intelligence.</p>
			</div>
			<a class="cap-link" href={withBase('/contact/?intent=consulting')}>Start project</a>
		</div>
	</section>

	<section class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
		{rows.map((capability) => (
			<article class="card p-4 capability-card">
				<h2 class="text-base font-semibold text-slate-50">{capability.title}</h2>
				<p class="mt-2 text-sm text-slate-300">{capability.summary}</p>
				<div class="mt-3 flex flex-wrap gap-2">
					<span class="cap-pill">Writing: {capability.writingCount}</span>
					<span class="cap-pill">Events: {capability.eventCount}</span>
					<span class="cap-pill">Opps: {capability.opportunityCount}</span>
				</div>
				<div class="mt-4 flex flex-wrap gap-2">
					<a class="cap-link" href={withBase(`/capabilities/${capability.slug}/`)}>Open topic</a>
					<a class="cap-link cap-link-muted" href={withBase(`/opportunities/?q=${encodeURIComponent(capability.opportunityQuery)}`)}>Open opportunities</a>
				</div>
			</article>
		))}
	</section>
</SiteLayout>

<style>
	.capability-card {
		border: 1px solid rgba(51, 65, 85, 0.86);
		background: rgba(2, 6, 23, 0.86);
	}
	.cap-pill {
		display: inline-flex;
		align-items: center;
		height: 1.45rem;
		padding: 0 0.5rem;
		border: 1px solid rgba(71, 85, 105, 0.78);
		background: rgba(2, 6, 23, 0.75);
		font-size: 0.66rem;
		color: rgba(203, 213, 225, 0.95);
	}
	.cap-link {
		display: inline-flex;
		align-items: center;
		height: 1.8rem;
		padding: 0 0.65rem;
		border: 1px solid rgba(45, 212, 191, 0.58);
		background: rgba(20, 184, 166, 0.16);
		font-size: 0.72rem;
		color: rgba(236, 253, 245, 0.98);
		text-decoration: none;
	}
	.cap-link:hover {
		background: rgba(20, 184, 166, 0.25);
	}
	.cap-link-muted {
		border-color: rgba(71, 85, 105, 0.82);
		background: rgba(2, 6, 23, 0.8);
		color: rgba(226, 232, 240, 0.95);
	}
	.cap-link-muted:hover {
		border-color: rgba(125, 211, 252, 0.62);
		background: rgba(15, 23, 42, 0.88);
	}
</style>
