---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../components/SurfacePageHeader.astro';
import { withBase } from '../../utils/withBase';
import { capabilityTopics } from '../../data/capabilities';
import { radarEventsSeed } from '../../data/radar/events';
import samOpportunitiesFeed from '../../data/radar/events-candidates-sam-opportunities.json';
import { absoluteUrl } from '../../config/site';

type OpportunityRow = {
	notice_id?: string;
	noticeId?: string;
	title?: string;
	noticeType?: string;
	notice_type?: string;
	agencyPath?: string;
	agency_path?: string;
	solicitationNumber?: string;
	solicitation_number?: string;
	naicsCode?: string;
	naics_code?: string;
	classificationCode?: string;
	classification_code?: string;
};

function text(value: unknown) {
	return String(value ?? '').toLowerCase();
}

function matches(blob: string, keywords: string[]) {
	return keywords.some((keyword) => blob.includes(keyword.toLowerCase()));
}

const writing = (await getCollection('writing')).filter((w) => w.data.status === 'published');
const papers = (await getCollection('papers')).filter((p) => p.data.status === 'published');

const opportunitiesByKey = new Map<string, OpportunityRow>();
for (const raw of samOpportunitiesFeed as OpportunityRow[]) {
	const noticeId = String(raw.notice_id ?? raw.noticeId ?? '').trim();
	const title = String(raw.title ?? '').trim();
	const noticeType = String(raw.noticeType ?? raw.notice_type ?? '').trim();
	const key = noticeId || `${title.toLowerCase()}::${noticeType.toLowerCase()}`;
	if (!key) continue;
	if (!opportunitiesByKey.has(key)) opportunitiesByKey.set(key, raw);
}

const now = new Date();
const todayUtc = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
const upcomingEvents = radarEventsSeed.filter((event) => {
	const d = event.startDate ? new Date(event.startDate) : null;
	if (!d || Number.isNaN(d.getTime())) return false;
	const day = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());
	return day >= todayUtc;
});

const rows = capabilityTopics.map((capability) => {
	const writingCount = [
		...writing.filter((entry) => {
			const blob = `${entry.data.title} ${entry.data.summary ?? ''} ${(entry.data.tags ?? []).join(' ')}`.toLowerCase();
			const tagHit = (entry.data.tags ?? []).some((tag) => capability.writingTags.includes(tag));
			return tagHit || matches(blob, capability.keywords);
		}),
		...papers.filter((entry) => {
			const blob =
				`${entry.data.title} ${entry.data.description ?? ''} ${(entry.data.tags ?? []).join(' ')}`.toLowerCase();
			const tagHit = (entry.data.tags ?? []).some((tag) => capability.writingTags.includes(tag));
			return tagHit || matches(blob, capability.keywords);
		}),
	].length;

	const eventCount = upcomingEvents.filter((event) => {
		const blob = [
			event.title,
			event.description,
			event.branch,
			event.type,
			event.ontology.capabilityAreas.join(' '),
			event.ontology.missionThreads.join(' '),
			event.ontology.themes.join(' '),
			event.ontology.keywords.join(' '),
		]
			.join(' ')
			.toLowerCase();
		return matches(blob, capability.keywords);
	}).length;

	const opportunityCount = [...opportunitiesByKey.values()].filter((row) => {
		const blob = [
			text(row.title),
			text(row.noticeType ?? row.notice_type),
			text(row.agencyPath ?? row.agency_path),
			text(row.solicitationNumber ?? row.solicitation_number),
			text(row.naicsCode ?? row.naics_code),
			text(row.classificationCode ?? row.classification_code),
		].join(' ');
		return matches(blob, capability.keywords);
	}).length;

	return {
		...capability,
		writingCount,
		eventCount,
		opportunityCount,
	};
});
---

<SiteLayout
	title="Capabilities: Defense Technology Strategy & Modernization | Adam Boas"
	description="Executive capability map for defense technology strategy, mission and digital engineering, software modernization, governed AI, transition, capture, and enterprise governance."
	canonicalHref={absoluteUrl('/capabilities/')}
	image="/og/capabilities.png"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'ItemList',
			name: 'Adam Boas Capability Map',
			itemListElement: rows.map((capability, idx) => ({
				'@type': 'ListItem',
				position: idx + 1,
				url: absoluteUrl(`/capabilities/${capability.slug}/`),
				name: capability.title,
				description: capability.valueProposition,
			})),
		})}
	/>
	<SurfacePageHeader
		stickyActive="capabilities"
		eyebrow="Capability map"
		title="Capabilities"
		description="Outcome-oriented capability areas across strategy, mission systems, digital engineering, modernization, governed AI, transition, capture, and enterprise policy."
	>
		<div slot="actions" class="flex flex-wrap gap-2">
			<a class="ui-link-btn ui-link-btn-primary" href={withBase('/strategic-work/')}>View strategic work</a>
			<a class="ui-link-btn" href={withBase('/contact/')}>Contact</a>
		</div>
	</SurfacePageHeader>

	<section class="mt-4 grid gap-4 md:mt-5 md:grid-cols-2 xl:grid-cols-3">
		{
			rows.map((capability) => (
				<article class="card p-4 capability-card flex h-full flex-col">
					<h2 class="text-base font-semibold text-slate-50 wrap-anywhere">{capability.title}</h2>
					<p class="mt-2 text-sm text-slate-300 wrap-anywhere">{capability.summary}</p>
					<p class="mt-3 text-sm leading-relaxed text-slate-200 wrap-anywhere">{capability.valueProposition}</p>
					<div class="mt-4 grid gap-3 text-sm md:grid-cols-2 xl:grid-cols-1">
						<div>
							<p class="cap-kicker">Representative activities</p>
							<ul class="mt-2 space-y-1.5 text-slate-300">
								{capability.activities.slice(0, 3).map((item) => (
									<li class="leading-snug wrap-anywhere">{item}</li>
								))}
							</ul>
						</div>
						<div>
							<p class="cap-kicker">Relevant evidence</p>
							<ul class="mt-2 space-y-1.5 text-slate-300">
								{capability.evidence.slice(0, 2).map((item) => (
									<li class="leading-snug wrap-anywhere">{item}</li>
								))}
							</ul>
						</div>
					</div>
					<div class="mt-4 flex flex-wrap gap-2">
						<span class="ui-pill">Writing: {capability.writingCount}</span>
						<span class="ui-pill">Events: {capability.eventCount}</span>
						<span class="ui-pill">Opps: {capability.opportunityCount}</span>
					</div>
					<div class="mt-auto flex flex-wrap gap-2 pt-4">
						<a class="ui-link-btn ui-link-btn-primary" href={withBase(`/capabilities/${capability.slug}/`)}>
							Open capability
						</a>
						<a
							class="ui-link-btn ui-link-btn-muted"
							href={withBase(`/opportunities/?q=${encodeURIComponent(capability.opportunityQuery)}`)}
						>
							Open opportunities
						</a>
					</div>
				</article>
			))
		}
	</section>
</SiteLayout>

<style>
	.capability-card {
		border: 1px solid rgba(51, 65, 85, 0.86);
		background: rgba(2, 6, 23, 0.86);
	}
	.cap-kicker {
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: rgba(148, 163, 184, 0.94);
	}
	/* shared pills/buttons use global .ui-pill and .ui-link-btn */
</style>
