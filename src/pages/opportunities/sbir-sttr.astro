---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../components/SurfacePageHeader.astro';
import { withBase } from '../../utils/withBase';

const artifactBase = 'https://raw.githubusercontent.com/anboas/adamboas-media/main/opportunities/sbir-sttr/latest';
const topicsUrl = `${artifactBase}/topics.json`;
const summaryUrl = `${artifactBase}/summary.json`;
const reportUrl = `${artifactBase}/report.md`;
const manifestUrl = `${artifactBase}/manifest.json`;

const both = [
	'DAF26BX02-NV501',
	'DAF26BZ01-NV500',
	'OSW26BZ02-DV003',
	'DLA26BZ02-NV005',
	'DLA26BZ02-NV006',
	'DAF26BZ01-NV008',
	'SF254-D1204',
	'DON26BZ01-DV042',
	'DAF26BX02-NV502',
	'DON26BZ01-NV023',
	'OSW26BZ02-DV004',
];
const caf = [
	'DAF26BZ01-NV006',
	'DAF26BZ01-DV007',
	'DAF26BZ01-DV005',
	'DON26BZ01-NV010',
	'DON26BZ01-NV013',
	'DON26BZ01-NV025',
	'DON26BZ01-NV030',
	'HR0011SB20254XL-01',
	'SF254-D1201',
	'SF25D-T1201',
];
const acp = [
	'HR0011SB20254-12',
	'OSW26BZ01-DV001',
	'DLA26BZ02-NV010',
	'DON26BX01-NP001',
	'DAF26BX02-NV502',
	'OSW26BZ02-DV003',
];

const themeTerms = {
	'AI/Autonomy': [
		'artificial intelligence',
		'machine learning',
		'autonomy',
		'autonomous',
		'llm',
		'agentic',
		'decision support',
		'wargaming',
		'assistant',
		'intelligent',
	],
	'Cyber/Security/Governance': [
		'cyber',
		'cybersecurity',
		'security',
		'secure',
		'authentication',
		'compliance',
		'rmf',
		'encrypted',
		'penetration',
		'assured',
		'governance',
		'zero trust',
	],
	Space: ['space', 'leo', 'pleo', 'satellite', 'orbital', 'constellation', 'de-orbit', 'launch'],
	'RF/Comms/EW': ['rf', 'radio', 'electromagnetic', 'sdr', 'pnt', 'jamming', 'antenna', 'network', 'communications'],
	'Sensing/ISR': ['radar', 'sensor', 'lidar', 'tracking', 'infrared', 'hyperspectral', 'isr', 'surveillance', 'sonar'],
	'Materials/Manufacturing': ['additive manufacturing', 'manufacturing', 'ceramic', 'powder', 'coating', 'crystal', 'composite', 'metamaterial'],
	'Bio/Medical': ['medical', 'blood', 'biologic', 'diagnostic', 'brain injury', 'veterinary', 'surgical', 'antifungal', 'military working dog'],
	'Logistics/Operations': ['logistics', 'supply', 'in transit', 'airfield', 'cargo', 'workflow'],
	'Energy/Power': ['battery', 'energy', 'power', 'thermoelectric', 'hydrogen', 'waste heat'],
	'Simulation/Modeling/Test': ['simulation', 'modeling', 'digital twin', 'test and evaluation', 'wargaming', 'training'],
} as Record<string, string[]>;
---

<SiteLayout
	title="Opportunity Intelligence (SBIR/STTR) | Adam Boas"
	description="SBIR/STTR opportunity intelligence mirror with faceted filtering and analysis controls."
	noindex={true}
>
	<SurfacePageHeader
		stickyActive="opportunities"
		eyebrow="Acquisition radar"
		title="Opportunity Intelligence — SBIR/STTR"
		description="Interactive mirror for DoD SBIR/STTR topics with faceted controls and analysis overlays."
	>
		<div slot="actions" class="opp-header-actions">
			<a class="ui-link-btn" href={withBase('/opportunities/')}>SAM.gov view</a>
			<a class="ui-link-btn ui-link-btn-active" href={withBase('/opportunities/sbir-sttr/')}>SBIR/STTR view</a>
			<a class="ui-link-btn ui-link-btn-muted" href={manifestUrl} target="_blank" rel="noreferrer">Artifact manifest</a>
		</div>
	</SurfacePageHeader>

	<section class="card sbir-shell mt-4 p-4">
		<div class="sbir-toolbar">
			<input id="sbir-search" class="sbir-input" type="search" placeholder="Search code/title/component/keywords" />
			<select id="sbir-component"><option value="">All Components</option></select>
			<select id="sbir-program"><option value="">All Programs</option></select>
			<select id="sbir-theme"><option value="">All Themes</option></select>
			<select id="sbir-sort">
				<option value="code">Sort: Topic Code</option>
				<option value="title">Sort: Title</option>
				<option value="qa">Sort: Q&A count</option>
			</select>
			<button id="sbir-clear" type="button" class="ui-link-btn ui-link-btn-muted">Clear</button>
		</div>
		<div class="sbir-toolbar mt-2">
			<button id="sbir-mode-all" class="ui-link-btn ui-link-btn-active" type="button">All</button>
			<button id="sbir-mode-both" class="ui-link-btn" type="button">CAF+ACP</button>
			<button id="sbir-mode-caf" class="ui-link-btn" type="button">CAF</button>
			<button id="sbir-mode-acp" class="ui-link-btn" type="button">ACP</button>
			<label class="sbir-checkbox"><input id="sbir-qa-only" type="checkbox" /> Q&A only</label>
		</div>
		<div id="sbir-component-chips" class="sbir-chips mt-2"></div>
		<p id="sbir-active" class="sbir-active mt-2">Filters: none</p>
	</section>

	<section class="sbir-grid mt-4">
		<div class="card p-3">
			<h2 class="sbir-heading">Dataset Analysis</h2>
			<div id="sbir-kpis" class="sbir-kpis"></div>
			<div class="sbir-analysis-grid mt-3">
				<div>
					<h3 class="sbir-subheading">Top components</h3>
					<div id="sbir-ana-components" class="sbir-listbox"></div>
				</div>
				<div>
					<h3 class="sbir-subheading">Themes</h3>
					<div id="sbir-ana-themes" class="sbir-listbox"></div>
				</div>
				<div>
					<h3 class="sbir-subheading">Top technology areas</h3>
					<div id="sbir-ana-tech" class="sbir-listbox"></div>
				</div>
				<div>
					<h3 class="sbir-subheading">Top Q&A activity</h3>
					<div id="sbir-ana-qa" class="sbir-listbox"></div>
				</div>
			</div>
			<p class="sbir-footnote mt-2">
				Artifacts: <a href={summaryUrl} target="_blank" rel="noreferrer">summary.json</a> · <a href={reportUrl} target="_blank" rel="noreferrer">report.md</a>
			</p>
		</div>

		<div class="card p-3">
			<h2 class="sbir-heading">Topics</h2>
			<p id="sbir-count" class="sbir-footnote">Loading…</p>
			<div id="sbir-topic-list" class="sbir-topic-list"></div>
		</div>

		<div class="card p-3">
			<h2 id="sbir-detail-title" class="sbir-heading">Select a topic</h2>
			<div id="sbir-detail-meta" class="sbir-meta"></div>
			<div id="sbir-detail-content" class="sbir-content sbir-footnote">Pick a topic from the list.</div>
		</div>
	</section>

	<script
		define:vars={{ topicsUrl, summaryUrl, both, caf, acp, themeTerms }}
	>
		const state = {
			topics: [],
			summary: null,
			mode: 'all',
		};

		const els = {
			search: document.getElementById('sbir-search'),
			component: document.getElementById('sbir-component'),
			program: document.getElementById('sbir-program'),
			theme: document.getElementById('sbir-theme'),
			sort: document.getElementById('sbir-sort'),
			qaOnly: document.getElementById('sbir-qa-only'),
			clear: document.getElementById('sbir-clear'),
			modeAll: document.getElementById('sbir-mode-all'),
			modeBoth: document.getElementById('sbir-mode-both'),
			modeCaf: document.getElementById('sbir-mode-caf'),
			modeAcp: document.getElementById('sbir-mode-acp'),
			chips: document.getElementById('sbir-component-chips'),
			active: document.getElementById('sbir-active'),
			count: document.getElementById('sbir-count'),
			list: document.getElementById('sbir-topic-list'),
			detailTitle: document.getElementById('sbir-detail-title'),
			detailMeta: document.getElementById('sbir-detail-meta'),
			detailContent: document.getElementById('sbir-detail-content'),
			kpis: document.getElementById('sbir-kpis'),
			anaComponents: document.getElementById('sbir-ana-components'),
			anaThemes: document.getElementById('sbir-ana-themes'),
			anaTech: document.getElementById('sbir-ana-tech'),
			anaQa: document.getElementById('sbir-ana-qa'),
		};

		const byCode = new Map();
		const stripHtml = (value) => {
			const d = document.createElement('div');
			d.innerHTML = value || '';
			return (d.textContent || d.innerText || '').trim();
		};
		const blob = (topic) =>
			[
				topic.topicCode,
				topic.topicTitle,
				topic.component,
				topic.program,
				topic.keywords,
				stripHtml(topic.objective),
				stripHtml(topic.description),
			]
				.join(' ')
				.toLowerCase();

		function hasTheme(topic, theme) {
			if (!theme) return true;
			const terms = themeTerms[theme] || [];
			const b = blob(topic);
			return terms.some((term) => b.includes(term));
		}

		function inMode(topic) {
			if (state.mode === 'both') return both.includes(topic.topicCode);
			if (state.mode === 'caf') return caf.includes(topic.topicCode);
			if (state.mode === 'acp') return acp.includes(topic.topicCode);
			return true;
		}

		function renderDetail(topic) {
			if (!topic) return;
			els.detailTitle.textContent = `${topic.topicCode} — ${topic.topicTitle}`;
			const badges = [topic.component, topic.program, topic.topicStatus, `Q&A ${(topic.questions || []).length}`]
				.filter(Boolean)
				.map((x) => `<span class="sbir-pill">${x}</span>`)
				.join('');
			els.detailMeta.innerHTML = badges;

			const refs = (topic.referenceDocuments || [])
				.map((r) => `<li>${r.referenceTitle || 'Reference'}${r.uploadId ? ` (uploadId: ${r.uploadId})` : ''}</li>`)
				.join('');
			const qs = (topic.questions || [])
				.map(
					(q) => `<div class="sbir-q"><strong>Q${q.questionNo || ''}</strong> · ${q.questionStatus || ''}<div>${q.questionHtml || ''}</div>${(q.answers || [])
						.map((a) => `<div class="sbir-a"><strong>Answer:</strong><div>${a.answerHtml || ''}</div></div>`)
						.join('')}</div>`,
				)
				.join('');

			els.detailContent.innerHTML = `
				<h3>Objective</h3><div>${topic.objective || ''}</div>
				<h3>Description</h3><div>${topic.description || ''}</div>
				<h3>Phase I</h3><div>${topic.phase1Description || ''}</div>
				<h3>Phase II</h3><div>${topic.phase2Description || ''}</div>
				<h3>Phase III</h3><div>${topic.phase3Description || ''}</div>
				<h3>Keywords</h3><div>${topic.keywords || ''}</div>
				<h3>Technology Areas</h3><div>${(topic.technologyAreas || []).join(', ') || '—'}</div>
				<h3>Focus Areas</h3><div>${(topic.focusAreas || []).join(', ') || '—'}</div>
				<h3>References</h3><ul>${refs || '<li>None</li>'}</ul>
				<h3>Q&A (${(topic.questions || []).length})</h3>${qs || '<p>No published questions.</p>'}
			`;
		}

		function renderList(topics) {
			els.count.textContent = `${topics.length} topics`;
			els.list.innerHTML = topics
				.map((topic, idx) => {
					const tags = [];
					if (both.includes(topic.topicCode)) tags.push('<span class="sbir-pill sbir-pill-pick">CAF+ACP</span>');
					if (caf.includes(topic.topicCode) && !both.includes(topic.topicCode)) tags.push('<span class="sbir-pill sbir-pill-pick">CAF</span>');
					if (acp.includes(topic.topicCode) && !both.includes(topic.topicCode)) tags.push('<span class="sbir-pill sbir-pill-pick">ACP</span>');
					return `<article class="sbir-topic-card"><a href="#" data-topic-index="${idx}"><strong>${topic.topicCode}</strong></a><p>${topic.topicTitle}</p><p class="sbir-footnote">${topic.component || ''} · ${topic.program || ''} · ${topic.topicStatus || ''} · Q&A ${(topic.questions || []).length}</p><div class="sbir-meta">${tags.join('')}</div></article>`;
				})
				.join('');
			els.list.querySelectorAll('[data-topic-index]').forEach((el) => {
				el.addEventListener('click', (event) => {
					event.preventDefault();
					renderDetail(topics[Number(el.dataset.topicIndex)]);
				});
			});
		}

		function renderAnalysis(summary) {
			if (!summary) return;
			const qa = summary.question_activity || {};
			els.kpis.innerHTML = `
				<div class="sbir-kpi"><span>Topics</span><strong>${summary.total_topics || 0}</strong></div>
				<div class="sbir-kpi"><span>With Q&A</span><strong>${qa.topics_with_questions || 0}</strong></div>
				<div class="sbir-kpi"><span>Total questions</span><strong>${qa.total_questions || 0}</strong></div>
				<div class="sbir-kpi"><span>Components</span><strong>${(summary.by_component || []).length}</strong></div>
			`;
			const li = (rows = [], limit = 12) =>
				rows
					.slice(0, limit)
					.map(([k, v]) => `<div class="sbir-footnote"><strong>${k}</strong>: ${v}</div>`)
					.join('');
			els.anaComponents.innerHTML = li(summary.by_component || [], 15);
			const themes = summary.themes_refined || summary.themes || {};
			const themeRows = Object.entries(themes)
				.map(([k, v]) => [k, v?.count || 0])
				.sort((a, b) => b[1] - a[1]);
			els.anaThemes.innerHTML = li(themeRows, 15);
			els.anaTech.innerHTML = li(summary.top_technology_areas || [], 15);
			els.anaQa.innerHTML = (qa.top_topics_by_question_count || [])
				.slice(0, 15)
				.map((row) => `<div class="sbir-footnote"><a href="#" data-qa-code="${row.topicCode}"><strong>${row.topicCode}</strong></a>: ${row.count}</div>`)
				.join('');
			els.anaQa.querySelectorAll('[data-qa-code]').forEach((el) => {
				el.addEventListener('click', (event) => {
					event.preventDefault();
					const topic = byCode.get(el.dataset.qaCode);
					if (topic) renderDetail(topic);
				});
			});
		}

		function updateModeButtons() {
			const map = {
				all: els.modeAll,
				both: els.modeBoth,
				caf: els.modeCaf,
				acp: els.modeAcp,
			};
			Object.values(map).forEach((el) => el.classList.remove('ui-link-btn-active'));
			map[state.mode].classList.add('ui-link-btn-active');
		}

		function applyFilters() {
			const q = (els.search.value || '').trim().toLowerCase();
			const component = els.component.value;
			const program = els.program.value;
			const theme = els.theme.value;
			const qaOnly = els.qaOnly.checked;
			const sort = els.sort.value;

			let filtered = state.topics.filter((topic) => {
				if (!inMode(topic)) return false;
				if (component && (topic.component || 'Unknown') !== component) return false;
				if (program && (topic.program || 'Unknown') !== program) return false;
				if (theme && !hasTheme(topic, theme)) return false;
				if (qaOnly && (topic.questions || []).length === 0) return false;
				if (!q) return true;
				return blob(topic).includes(q);
			});

			if (sort === 'title') filtered.sort((a, b) => (a.topicTitle || '').localeCompare(b.topicTitle || ''));
			else if (sort === 'qa') filtered.sort((a, b) => (b.questions || []).length - (a.questions || []).length);
			else filtered.sort((a, b) => (a.topicCode || '').localeCompare(b.topicCode || ''));

			renderList(filtered);
			if (filtered[0]) renderDetail(filtered[0]);
			els.active.textContent = `Filters: ${state.mode.toUpperCase()}${component ? ` · Component=${component}` : ''}${program ? ` · Program=${program}` : ''}${theme ? ` · Theme=${theme}` : ''}${qaOnly ? ' · Q&A only' : ''}${q ? ` · Search=\"${q}\"` : ''}`;
		}

		function hydrateControls() {
			const components = [...new Set(state.topics.map((t) => (t.component || 'Unknown').trim() || 'Unknown'))].sort((a, b) => a.localeCompare(b));
			const programs = [...new Set(state.topics.map((t) => (t.program || 'Unknown').trim() || 'Unknown'))].sort((a, b) => a.localeCompare(b));
			components.forEach((component) => {
				const option = document.createElement('option');
				option.value = component;
				option.textContent = component;
				els.component.appendChild(option);
			});
			programs.forEach((program) => {
				const option = document.createElement('option');
				option.value = program;
				option.textContent = program;
				els.program.appendChild(option);
			});
			Object.keys(themeTerms).forEach((theme) => {
				const option = document.createElement('option');
				option.value = theme;
				option.textContent = theme;
				els.theme.appendChild(option);
			});

			const topComponents = (state.summary?.by_component || []).slice(0, 12);
			els.chips.innerHTML = topComponents
				.map(([name, count]) => `<button type="button" class="sbir-chip" data-chip-component="${name}">${name} (${count})</button>`)
				.join('');
			els.chips.querySelectorAll('[data-chip-component]').forEach((el) => {
				el.addEventListener('click', () => {
					els.component.value = el.dataset.chipComponent;
					applyFilters();
				});
			});
		}

		async function boot() {
			try {
				const [topicsRes, summaryRes] = await Promise.all([fetch(topicsUrl), fetch(summaryUrl)]);
				state.topics = await topicsRes.json();
				state.summary = await summaryRes.json();
				state.topics.forEach((topic) => byCode.set(topic.topicCode, topic));
				renderAnalysis(state.summary);
				hydrateControls();
				applyFilters();
			} catch (error) {
				els.count.textContent = 'Failed to load SBIR/STTR dataset from artifact repo.';
				console.error(error);
			}
		}

		els.search.addEventListener('input', applyFilters);
		els.component.addEventListener('change', applyFilters);
		els.program.addEventListener('change', applyFilters);
		els.theme.addEventListener('change', applyFilters);
		els.sort.addEventListener('change', applyFilters);
		els.qaOnly.addEventListener('change', applyFilters);
		els.clear.addEventListener('click', () => {
			els.search.value = '';
			els.component.value = '';
			els.program.value = '';
			els.theme.value = '';
			els.sort.value = 'code';
			els.qaOnly.checked = false;
			state.mode = 'all';
			updateModeButtons();
			applyFilters();
		});

		els.modeAll.addEventListener('click', () => {
			state.mode = 'all';
			updateModeButtons();
			applyFilters();
		});
		els.modeBoth.addEventListener('click', () => {
			state.mode = 'both';
			updateModeButtons();
			applyFilters();
		});
		els.modeCaf.addEventListener('click', () => {
			state.mode = 'caf';
			updateModeButtons();
			applyFilters();
		});
		els.modeAcp.addEventListener('click', () => {
			state.mode = 'acp';
			updateModeButtons();
			applyFilters();
		});

		boot();
	</script>
</SiteLayout>

<style>
	.ui-link-btn.ui-link-btn-active {
		background: var(--brand-900, #0c365f);
		border-color: var(--brand-900, #0c365f);
		color: #fff;
	}

	.sbir-shell,
	.sbir-grid .card {
		background: var(--surface-elevated, #fff);
		border: 1px solid var(--border-subtle, #dbe3ef);
		border-radius: 14px;
	}

	.sbir-grid {
		display: grid;
		grid-template-columns: minmax(300px, 1.1fr) minmax(340px, 1fr) minmax(440px, 1.2fr);
		gap: 12px;
	}

	.sbir-toolbar {
		display: grid;
		grid-template-columns: 1.2fr repeat(4, minmax(120px, 1fr)) auto;
		gap: 8px;
	}

	.sbir-input,
	.sbir-shell select {
		width: 100%;
		border: 1px solid var(--border-subtle, #cfd8e6);
		border-radius: 10px;
		padding: 0.58rem 0.62rem;
		font-size: 0.9rem;
	}

	.sbir-checkbox {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8rem;
		color: var(--muted, #6b7280);
	}

	.sbir-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.sbir-chip {
		border: 1px solid #cddcf4;
		background: #f3f7ff;
		color: #1c4f8f;
		border-radius: 999px;
		padding: 0.22rem 0.62rem;
		font-size: 0.74rem;
		cursor: pointer;
	}

	.sbir-active,
	.sbir-footnote {
		font-size: 0.78rem;
		color: var(--muted, #6b7280);
	}

	.sbir-heading {
		font-size: 1.02rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}

	.sbir-subheading {
		margin: 0 0 0.35rem;
		font-size: 0.84rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted, #6b7280);
	}

	.sbir-kpis {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 8px;
	}

	.sbir-kpi {
		border: 1px solid #dfe7f4;
		border-radius: 10px;
		padding: 0.55rem;
		background: #f8fbff;
		display: grid;
		gap: 0.15rem;
		font-size: 0.73rem;
		color: var(--muted, #6b7280);
	}

	.sbir-kpi strong {
		font-size: 1.2rem;
		color: var(--text-primary, #0f172a);
	}

	.sbir-analysis-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}

	.sbir-listbox {
		max-height: 220px;
		overflow: auto;
		border: 1px solid #e2e9f4;
		border-radius: 10px;
		padding: 0.5rem;
	}

	.sbir-topic-list {
		max-height: 72vh;
		overflow: auto;
		display: grid;
		gap: 0.5rem;
	}

	.sbir-topic-card {
		border: 1px solid #e2e9f4;
		border-radius: 10px;
		padding: 0.55rem;
	}

	.sbir-topic-card p {
		margin: 0.26rem 0;
		font-size: 0.83rem;
	}

	.sbir-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.sbir-pill {
		display: inline-flex;
