---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/withBase';

const target = withBase('/opportunities/?source=sbir');
---

<SiteLayout
	title="Opportunities | Adam Boas"
	description="Redirecting to the unified Opportunities interface (SBIR/STTR source selected)."
	noindex={true}
>
	<meta http-equiv="refresh" content={`0;url=${target}`} />
	<script define:vars={{ target }}>
		window.location.replace(target);
	</script>
	<section class="card p-4 mt-4">
		<p>Redirecting to the unified Opportunities interface…</p>
		<p><a href={target}>Continue to SBIR/STTR in Opportunities</a></p>
	</section>
</SiteLayout>
