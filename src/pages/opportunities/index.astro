---
import fs from 'node:fs';
import path from 'node:path';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SurfacePageHeader from '../../components/SurfacePageHeader.astro';
import { withBase } from '../../utils/withBase';
import { radarEventsSeed } from '../../data/radar/events';
import sofweekIntel from '../../data/radar/intel/sofweek-intel.json';
import samOpportunitiesFeed from '../../data/radar/events-candidates-sam-opportunities.json';
import opportunitiesDrift from '../../data/radar/events-candidates-sam-opportunities-drift-latest.json';
import feedCrawlReport from '../../data/radar/feed-crawl-report-latest.json';

type ResourceAsset = {
	sourceUrl: string;
	mirrorDownloadUrl: string | null;
	mirrorBlobPath: string | null;
	fileName: string | null;
	fileId: string | null;
	contentType: string | null;
	sizeBytes: number | null;
};

type OpportunityRow = {
	key: string;
	noticeId: string | null;
	title: string;
	noticeType: string;
	postedDate: string | null;
	responseDueDate: string | null;
	solicitationNumber: string | null;
	agencyPath: string | null;
	naicsCode: string | null;
	classificationCode: string | null;
	uiLink: string | null;
	detailUrl: string | null;
	detailPreview: string | null;
	detailTextLength: number;
	resourceAssets: Map<string, ResourceAsset>;
	resourceCount: number;
	awardSignalCount: number;
	awardSignalSampleDate: string | null;
	usaspendingSignal: any | null;
	usaspendingMatchCount: number;
	usaspendingAmount: number;
	crossDataSignal: any | null;
	crossDataScore: number;
	crossDataLevel: string;
	weight: number;
	eventIds: Set<string>;
	eventTitles: Set<string>;
	branches: Set<string>;
	capabilityAreas: Set<string>;
	missionThreads: Set<string>;
};

const samIntelOverrides: Record<string, any> = {
	'radar-sofweek-2026': sofweekIntel,
};

function samIntel(event: (typeof radarEventsSeed)[number] | undefined | null) {
	if (!event) return null;
	return samIntelOverrides[event.id] ?? event.ontology.acquisition?.samIntelligence ?? null;
}

function noticeKey(notice: any) {
	const noticeId = String(notice.noticeId ?? '').trim();
	if (noticeId) return `notice:${noticeId.toLowerCase()}`;
	const solicitation = String(notice.solicitationNumber ?? '').trim();
	if (solicitation) return `sol:${solicitation.toLowerCase()}`;
	return `title:${String(notice.title ?? '')
		.trim()
		.toLowerCase()}::${String(notice.noticeType ?? '')
		.trim()
		.toLowerCase()}::${String(notice.postedDate ?? '')
		.trim()
		.toLowerCase()}`;
}

function toArray(set: Set<string>) {
	return [...set].filter(Boolean).sort((a, b) => a.localeCompare(b));
}

function signed(value: number) {
	if (!Number.isFinite(value)) return '0';
	if (value > 0) return `+${Math.round(value)}`;
	return String(Math.round(value));
}

function isGovernmentContact(contact: any) {
	const org = String(contact?.organization ?? '').toLowerCase();
	const role = String(contact?.role ?? '').toLowerCase();
	const email = String(contact?.email ?? '').toLowerCase();
	const blob = `${org} ${role} ${email}`;
	if (email.endsWith('.gov') || email.endsWith('.mil')) return true;
	return /(department|agency|command|office|district|federal|government|dod|defense|army|navy|air force|marine|usace|disa|uscybercom|cio)/.test(
		blob,
	);
}

function eventEngagementContacts(event: (typeof radarEventsSeed)[number] | undefined | null) {
	const raw = (event as any)?.ontology?.engagement?.contacts;
	if (!Array.isArray(raw)) return [];
	return raw
		.map((contact) => ({
			name: String(contact?.name ?? '').trim() || null,
			role: String(contact?.role ?? '').trim() || null,
			organization: String(contact?.organization ?? '').trim() || null,
			email: String(contact?.email ?? '').trim() || null,
			phone: String(contact?.phone ?? '').trim() || null,
			isGovernment: isGovernmentContact(contact),
		}))
		.filter((contact) => contact.name || contact.email || contact.phone || contact.organization);
}

function loadMirrorResourceIndex() {
	const index = new Map<string, ResourceAsset>();
	const root = path.resolve('src/data/radar/mirror/sam-opportunities/resources/files');
	if (!fs.existsSync(root)) return index;

	const stack: string[] = [root];
	while (stack.length) {
		const dir = stack.pop()!;
		let entries: fs.Dirent[] = [];
		try {
			entries = fs.readdirSync(dir, { withFileTypes: true });
		} catch {
			continue;
		}
		for (const entry of entries) {
			const full = path.join(dir, entry.name);
			if (entry.isDirectory()) {
				stack.push(full);
				continue;
			}
			if (!entry.isFile() || entry.name !== 'latest.json') continue;
			try {
				const payload = JSON.parse(fs.readFileSync(full, 'utf-8'));
				const sourceUrl = String(payload.source_url ?? '').trim();
				if (!sourceUrl) continue;
				const mirrorBlobPath = String(payload.mirror_blob_path ?? '').trim() || null;
				const mirrorDownloadUrl =
					String(payload.mirror_download_url ?? '').trim() ||
					(mirrorBlobPath
						? `https://raw.githubusercontent.com/anboas/adamboas.info/main/${mirrorBlobPath.replace(/^\/+/, '')}`
						: null);
				index.set(sourceUrl, {
					sourceUrl,
					mirrorDownloadUrl,
					mirrorBlobPath,
					fileName: String(payload.file_name ?? '').trim() || null,
					fileId: String(payload.file_id ?? '').trim() || null,
					contentType: String(payload.content_type ?? '').trim() || null,
					sizeBytes: Number(payload.size_bytes ?? 0) || null,
				});
			} catch {
				// skip malformed mirror metadata
			}
		}
	}
	return index;
}

const mirrorResourceIndex = loadMirrorResourceIndex();

function normalizeResourceAssets(notice: any): ResourceAsset[] {
	const out = new Map<string, ResourceAsset>();
	const items = Array.isArray(notice?.resourceItems ?? notice?.resource_items)
		? (notice.resourceItems ?? notice.resource_items)
		: [];
	for (const item of items) {
		if (!item) continue;
		if (typeof item === 'string') {
			const sourceUrl = String(item).trim();
			if (!sourceUrl) continue;
			out.set(sourceUrl, {
				sourceUrl,
				mirrorDownloadUrl: null,
				mirrorBlobPath: null,
				fileName: null,
				fileId: null,
				contentType: null,
				sizeBytes: null,
			});
			continue;
		}
		const sourceUrl = String(item.sourceUrl ?? item.source_url ?? item.url ?? item.link ?? '').trim();
		if (!sourceUrl) continue;
		const mirrorBlobPath = String(item.mirrorBlobPath ?? item.mirror_blob_path ?? '').trim() || null;
		const mirrorDownloadUrl =
			String(item.mirrorDownloadUrl ?? item.mirror_download_url ?? '').trim() ||
			(mirrorBlobPath
				? `https://raw.githubusercontent.com/anboas/adamboas.info/main/${mirrorBlobPath.replace(/^\/+/, '')}`
				: null);
		out.set(sourceUrl, {
			sourceUrl,
			mirrorDownloadUrl,
			mirrorBlobPath,
			fileName: String(item.fileName ?? item.file_name ?? '').trim() || null,
			fileId: String(item.fileId ?? item.file_id ?? '').trim() || null,
			contentType: String(item.contentType ?? item.content_type ?? '').trim() || null,
			sizeBytes: Number(item.sizeBytes ?? item.size_bytes ?? 0) || null,
		});
	}

	const fallbackLinks = Array.isArray(notice?.resourceLinks ?? notice?.resource_links)
		? (notice.resourceLinks ?? notice.resource_links)
		: [];
	for (const link of fallbackLinks) {
		const sourceUrl = String(link ?? '').trim();
		if (!sourceUrl || out.has(sourceUrl)) continue;
		const mirrored = mirrorResourceIndex.get(sourceUrl);
		out.set(sourceUrl, {
			sourceUrl,
			mirrorDownloadUrl: mirrored?.mirrorDownloadUrl ?? null,
			mirrorBlobPath: mirrored?.mirrorBlobPath ?? null,
			fileName: mirrored?.fileName ?? null,
			fileId: mirrored?.fileId ?? null,
			contentType: mirrored?.contentType ?? null,
			sizeBytes: mirrored?.sizeBytes ?? null,
		});
	}

	return [...out.values()];
}

function addResourceAssets(target: Map<string, ResourceAsset>, assets: ResourceAsset[]) {
	for (const asset of assets) {
		const sourceUrl = String(asset?.sourceUrl ?? '').trim();
		if (!sourceUrl) continue;
		const prior = target.get(sourceUrl);
		target.set(sourceUrl, {
			sourceUrl,
			mirrorDownloadUrl: asset.mirrorDownloadUrl ?? prior?.mirrorDownloadUrl ?? null,
			mirrorBlobPath: asset.mirrorBlobPath ?? prior?.mirrorBlobPath ?? null,
			fileName: asset.fileName ?? prior?.fileName ?? null,
			fileId: asset.fileId ?? prior?.fileId ?? null,
			contentType: asset.contentType ?? prior?.contentType ?? null,
			sizeBytes: asset.sizeBytes ?? prior?.sizeBytes ?? null,
		});
	}
}

function awardSignalCount(notice: any) {
	return Number(
		notice?.contractAwardsSignal?.matchedAwardCount ??
			notice?.contractAwardsSignal?.matched_award_count ??
			notice?.contract_awards_signal?.matched_award_count ??
			notice?.contract_awards_signal?.matchedAwardCount ??
			notice?.awardSignalCount ??
			notice?.award_signal_count ??
			0,
	);
}

function awardSignalSampleDate(notice: any) {
	return (
		notice?.contract_awards_signal?.sample_award?.dateSigned ??
		notice?.contractAwardsSignal?.sampleAward?.dateSigned ??
		notice?.contractAwardsSignal?.sampleAward?.date_signed ??
		null
	);
}

function usaspendingSignal(notice: any) {
	return notice?.usaspendingSignal ?? notice?.usaspending_signal ?? null;
}

function usaspendingMatchCount(notice: any) {
	const signal = usaspendingSignal(notice);
	return Number(
		signal?.matched_award_count ??
			signal?.matchedAwardCount ??
			notice?.usaspendingMatchCount ??
			notice?.usaspending_match_count ??
			0,
	);
}

function usaspendingAmount(notice: any) {
	const signal = usaspendingSignal(notice);
	return Number(
		signal?.total_award_amount ??
			signal?.totalAwardAmount ??
			notice?.usaspendingAmount ??
			notice?.usaspending_amount ??
			0,
	);
}

function crossDataSignal(notice: any) {
	return notice?.crossDataSignal ?? notice?.cross_data_signal ?? null;
}

function crossDataScore(notice: any) {
	const signal = crossDataSignal(notice);
	return Number(signal?.score ?? notice?.crossDataScore ?? notice?.cross_data_score ?? 0);
}

function crossDataLevel(notice: any) {
	const signal = crossDataSignal(notice);
	return String(signal?.level ?? notice?.crossDataLevel ?? notice?.cross_data_level ?? 'None');
}

const DETAIL_PREVIEW_MAX_CHARS = 8000;
const TOKEN_STOPWORDS = new Set([
	'and',
	'the',
	'for',
	'with',
	'from',
	'that',
	'this',
	'into',
	'your',
	'our',
	'their',
	'about',
	'through',
	'under',
	'over',
	'between',
	'contract',
	'opportunity',
	'notice',
	'sources',
	'sought',
	'solicitation',
	'combined',
	'special',
	'pre',
	'rfi',
	'rfp',
	'sam',
	'gov',
	'dept',
	'department',
	'defense',
	'command',
	'office',
	'support',
	'services',
	'systems',
	'program',
	'project',
	'task',
]);

function normalizeIdentifier(value: any) {
	return String(value ?? '')
		.trim()
		.toLowerCase();
}

function toDayEpoch(value: any) {
	if (!value) return null;
	const d = new Date(String(value));
	if (Number.isNaN(d.getTime())) return null;
	return Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());
}

function tokenize(value: any) {
	const tokens = String(value ?? '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, ' ')
		.split(' ')
		.map((token) => token.trim())
		.filter((token) => token.length >= 3 && !TOKEN_STOPWORDS.has(token));
	return new Set(tokens);
}

function overlapCount(a: Set<string>, b: Set<string>) {
	let count = 0;
	for (const token of a) if (b.has(token)) count += 1;
	return count;
}

function branchKeywordMatch(branch: string, blob: string) {
	const normalized = String(blob ?? '').toLowerCase();
	if (branch === 'Army')
		return /\barmy\b|army contracting command|army futures|usace|corps of engineers/.test(normalized);
	if (branch === 'Navy') return /\bnavy\b|navsea|navair|navsup|navfac|nswc|nuwc|naval/.test(normalized);
	if (branch === 'Air Force') return /\bair force\b|usaf|afrl|afmc|space force|space systems command/.test(normalized);
	if (branch === 'Marine Corps') return /\bmarine\b|marsoc|marine corps/.test(normalized);
	if (branch === 'Joint') return /ussocom|dod|department of defense|joint/.test(normalized);
	return false;
}

function toDetailPreview(value: any) {
	const text = String(value ?? '')
		.replace(/\r\n?/g, '\n')
		.replace(/\u00a0/g, ' ')
		.trim();
	if (!text) return null;
	return text.slice(0, DETAIL_PREVIEW_MAX_CHARS);
}

const opportunityMap = new Map<string, OpportunityRow>();
let totalRawNotices = 0;
let eventsWithSam = 0;
let samGlobalRawNotices = 0;

const eventById = new Map<string, (typeof radarEventsSeed)[number]>();
for (const event of radarEventsSeed) {
	if (!event?.id) continue;
	eventById.set(event.id, event);
}
const eventIntelIndex = radarEventsSeed.map((event) => {
	const sam = samIntel(event);
	const topNotices = sam?.topNotices ?? [];
	const solicitationSet = new Set<string>();
	const noticeSet = new Set<string>();
	const agencySet = new Set<string>();

	for (const notice of topNotices) {
		const solicitation = normalizeIdentifier(notice?.solicitationNumber ?? notice?.solicitation_number);
		if (solicitation) solicitationSet.add(solicitation);
		const noticeId = normalizeIdentifier(notice?.noticeId ?? notice?.notice_id);
		if (noticeId) noticeSet.add(noticeId);
		const agency = normalizeIdentifier(notice?.agencyPath ?? notice?.agency_path);
		if (agency) agencySet.add(agency);
	}

	const tokenBlob = [
		event.title,
		event.description,
		...(event.ontology.themes ?? []),
		...(event.ontology.capabilityAreas ?? []),
		...(event.ontology.missionThreads ?? []),
		...(event.ontology.keywords ?? []),
		...(event.ontology.stakeholders ?? []),
	].join(' ');

	return {
		id: event.id,
		title: event.title,
		branch: event.branch,
		startDay: toDayEpoch(event.startDate),
		endDay: toDayEpoch(event.endDate ?? event.startDate),
		tokens: tokenize(tokenBlob),
		solicitationSet,
		noticeSet,
		agencySet,
	};
});

for (const event of radarEventsSeed) {
	const sam = samIntel(event);
	const notices = sam?.topNotices ?? [];
	if (!notices.length) continue;
	eventsWithSam += 1;
	totalRawNotices += notices.length;

	for (const notice of notices) {
		const key = noticeKey(notice);
		if (!opportunityMap.has(key)) {
			opportunityMap.set(key, {
				key,
				noticeId: notice.noticeId ?? null,
				title: notice.title ?? 'Untitled notice',
				noticeType: notice.noticeType ?? 'Unknown',
				postedDate: notice.postedDate ?? null,
				responseDueDate: notice.responseDueDate ?? null,
				solicitationNumber: notice.solicitationNumber ?? null,
				agencyPath: notice.agencyPath ?? null,
				naicsCode: notice.naicsCode ?? null,
				classificationCode: notice.classificationCode ?? null,
				uiLink: notice.uiLink ?? null,
				detailUrl: notice.detailUrl ?? notice.detail_url ?? notice.uiLink ?? null,
				detailPreview: toDetailPreview(notice.detailText ?? notice.detail_text ?? null),
				detailTextLength: Number(notice.detailTextLength ?? notice.detail_text_length ?? 0),
				resourceAssets: new Map<string, ResourceAsset>(),
				resourceCount: Number(notice.resourceCount ?? notice.resource_count ?? 0),
				awardSignalCount: awardSignalCount(notice),
				awardSignalSampleDate: awardSignalSampleDate(notice),
				usaspendingSignal: usaspendingSignal(notice),
				usaspendingMatchCount: usaspendingMatchCount(notice),
				usaspendingAmount: usaspendingAmount(notice),
				crossDataSignal: crossDataSignal(notice),
				crossDataScore: crossDataScore(notice),
				crossDataLevel: crossDataLevel(notice),
				weight: Number(notice.score ?? 0),
				eventIds: new Set<string>(),
				eventTitles: new Set<string>(),
				branches: new Set<string>(),
				capabilityAreas: new Set<string>(),
				missionThreads: new Set<string>(),
			});
		}

		const row = opportunityMap.get(key)!;
		row.weight = Math.max(row.weight, Number(notice.score ?? 0));
		row.noticeId = row.noticeId ?? notice.noticeId ?? null;
		row.postedDate = row.postedDate ?? notice.postedDate ?? null;
		row.responseDueDate = row.responseDueDate ?? notice.responseDueDate ?? null;
		row.solicitationNumber = row.solicitationNumber ?? notice.solicitationNumber ?? null;
		row.agencyPath = row.agencyPath ?? notice.agencyPath ?? null;
		row.naicsCode = row.naicsCode ?? notice.naicsCode ?? null;
		row.classificationCode = row.classificationCode ?? notice.classificationCode ?? null;
		row.uiLink = row.uiLink ?? notice.uiLink ?? null;
		row.detailUrl = row.detailUrl ?? notice.detailUrl ?? notice.detail_url ?? notice.uiLink ?? null;
		const noticePreview = toDetailPreview(notice.detailText ?? notice.detail_text ?? null);
		if (!row.detailPreview || (noticePreview && noticePreview.length > row.detailPreview.length))
			row.detailPreview = noticePreview;
		row.detailTextLength = Math.max(
			row.detailTextLength,
			Number(notice.detailTextLength ?? notice.detail_text_length ?? noticePreview?.length ?? 0),
		);
		addResourceAssets(row.resourceAssets, normalizeResourceAssets(notice));
		row.resourceCount = Math.max(
			row.resourceCount,
			Number(notice.resourceCount ?? notice.resource_count ?? row.resourceAssets.size ?? 0),
			row.resourceAssets.size,
		);
		const nextAwardCount = awardSignalCount(notice);
		if (nextAwardCount >= row.awardSignalCount) {
			row.awardSignalCount = nextAwardCount;
			row.awardSignalSampleDate = awardSignalSampleDate(notice) ?? row.awardSignalSampleDate;
		}
		const nextUsCount = usaspendingMatchCount(notice);
		if (nextUsCount >= row.usaspendingMatchCount) {
			row.usaspendingMatchCount = nextUsCount;
			row.usaspendingAmount = Math.max(row.usaspendingAmount, usaspendingAmount(notice));
			row.usaspendingSignal = usaspendingSignal(notice) ?? row.usaspendingSignal;
		}
		const nextCrossScore = crossDataScore(notice);
		if (nextCrossScore >= row.crossDataScore) {
			row.crossDataScore = nextCrossScore;
			row.crossDataLevel = crossDataLevel(notice);
			row.crossDataSignal = crossDataSignal(notice) ?? row.crossDataSignal;
		}
		row.eventIds.add(event.id);
		row.eventTitles.add(event.title);
		row.branches.add(event.branch);
		for (const area of event.ontology.capabilityAreas ?? []) row.capabilityAreas.add(area);
		for (const thread of event.ontology.missionThreads ?? []) row.missionThreads.add(thread);
	}
}

for (const candidate of samOpportunitiesFeed as any[]) {
	samGlobalRawNotices += 1;
	const notice = {
		noticeId: candidate.notice_id ?? null,
		title: candidate.title ?? 'Untitled notice',
		noticeType: candidate.notice_type ?? 'Unknown',
		postedDate: candidate.posted_date ?? null,
		responseDueDate: candidate.response_deadline ?? null,
		solicitationNumber: candidate.solicitation_number ?? null,
		agencyPath: candidate.agency_path ?? null,
		naicsCode: candidate.naics_code ?? null,
		classificationCode: candidate.classification_code ?? null,
		uiLink: candidate.ui_link ?? candidate.opportunity_url ?? null,
		score: Number(candidate.relevance_score ?? 0),
		detailUrl: candidate.detail_url ?? null,
		detailPreview: toDetailPreview(candidate.detail_text ?? candidate.description ?? null),
		detailTextLength: Number(
			candidate.detail_text_length ?? candidate.detail_text?.length ?? candidate.description?.length ?? 0,
		),
		resourceAssets: normalizeResourceAssets(candidate),
		resourceCount: Number(candidate.resource_count ?? 0),
		awardSignalCount: awardSignalCount(candidate),
		awardSignalSampleDate: awardSignalSampleDate(candidate),
		usaspendingSignal: usaspendingSignal(candidate),
		usaspendingMatchCount: usaspendingMatchCount(candidate),
		usaspendingAmount: usaspendingAmount(candidate),
		crossDataSignal: crossDataSignal(candidate),
		crossDataScore: crossDataScore(candidate),
		crossDataLevel: crossDataLevel(candidate),
	};
	const key = noticeKey(notice);
	if (!opportunityMap.has(key)) {
		opportunityMap.set(key, {
			key,
			noticeId: notice.noticeId,
			title: notice.title,
			noticeType: notice.noticeType,
			postedDate: notice.postedDate,
			responseDueDate: notice.responseDueDate,
			solicitationNumber: notice.solicitationNumber,
			agencyPath: notice.agencyPath,
			naicsCode: notice.naicsCode,
			classificationCode: notice.classificationCode,
			uiLink: notice.uiLink,
			detailUrl: notice.detailUrl ?? notice.uiLink ?? null,
			detailPreview: notice.detailPreview ?? null,
			detailTextLength: Number(notice.detailTextLength ?? 0),
			resourceAssets: new Map<string, ResourceAsset>(),
			resourceCount: Number(notice.resourceCount ?? 0),
			awardSignalCount: Number(notice.awardSignalCount ?? 0),
			awardSignalSampleDate: notice.awardSignalSampleDate ?? null,
			usaspendingSignal: notice.usaspendingSignal ?? null,
			usaspendingMatchCount: Number(notice.usaspendingMatchCount ?? 0),
			usaspendingAmount: Number(notice.usaspendingAmount ?? 0),
			crossDataSignal: notice.crossDataSignal ?? null,
			crossDataScore: Number(notice.crossDataScore ?? 0),
			crossDataLevel: String(notice.crossDataLevel ?? 'None'),
			weight: Number(notice.score ?? 0),
			eventIds: new Set<string>(),
			eventTitles: new Set<string>(),
			branches: new Set<string>(),
			capabilityAreas: new Set<string>(),
			missionThreads: new Set<string>(),
		});
	}
	const row = opportunityMap.get(key)!;
	row.weight = Math.max(row.weight, Number(notice.score ?? 0));
	row.noticeId = row.noticeId ?? notice.noticeId;
	row.postedDate = row.postedDate ?? notice.postedDate;
	row.responseDueDate = row.responseDueDate ?? notice.responseDueDate;
	row.solicitationNumber = row.solicitationNumber ?? notice.solicitationNumber;
	row.agencyPath = row.agencyPath ?? notice.agencyPath;
	row.uiLink = row.uiLink ?? notice.uiLink;
	row.detailUrl = row.detailUrl ?? notice.detailUrl ?? notice.uiLink ?? null;
	if (!row.detailPreview || (notice.detailPreview ?? '').length > row.detailPreview.length)
		row.detailPreview = notice.detailPreview ?? row.detailPreview;
	row.detailTextLength = Math.max(
		row.detailTextLength,
		Number(notice.detailTextLength ?? notice.detailPreview?.length ?? 0),
	);
	addResourceAssets(row.resourceAssets, notice.resourceAssets ?? []);
	row.resourceCount = Math.max(
		row.resourceCount,
		Number(notice.resourceCount ?? row.resourceAssets.size),
		row.resourceAssets.size,
	);
	if (Number(notice.awardSignalCount ?? 0) >= row.awardSignalCount) {
		row.awardSignalCount = Number(notice.awardSignalCount ?? 0);
		row.awardSignalSampleDate = notice.awardSignalSampleDate ?? row.awardSignalSampleDate;
	}
	if (Number(notice.usaspendingMatchCount ?? 0) >= row.usaspendingMatchCount) {
		row.usaspendingMatchCount = Number(notice.usaspendingMatchCount ?? 0);
		row.usaspendingAmount = Math.max(row.usaspendingAmount, Number(notice.usaspendingAmount ?? 0));
		row.usaspendingSignal = notice.usaspendingSignal ?? row.usaspendingSignal;
	}
	if (Number(notice.crossDataScore ?? 0) >= row.crossDataScore) {
		row.crossDataScore = Number(notice.crossDataScore ?? 0);
		row.crossDataLevel = String(notice.crossDataLevel ?? row.crossDataLevel ?? 'None');
		row.crossDataSignal = notice.crossDataSignal ?? row.crossDataSignal;
	}
	row.branches.add('SAM Global');
}

for (const row of opportunityMap.values()) {
	if (row.eventIds.size > 0) continue;

	const rowNoticeId = normalizeIdentifier(row.noticeId);
	const rowSolicitation = normalizeIdentifier(row.solicitationNumber);
	const rowAgency = normalizeIdentifier(row.agencyPath);
	const rowTitleTokens = tokenize(`${row.title} ${row.agencyPath ?? ''} ${row.solicitationNumber ?? ''}`);
	const rowDueDay = toDayEpoch(row.responseDueDate);
	const rowPostedDay = toDayEpoch(row.postedDate);
	const rowBlob = `${row.title} ${row.agencyPath ?? ''} ${row.noticeType} ${row.solicitationNumber ?? ''}`;

	const scored = eventIntelIndex
		.map((event) => {
			let score = 0;
			if (rowNoticeId && event.noticeSet.has(rowNoticeId)) score += 12;
			if (rowSolicitation && event.solicitationSet.has(rowSolicitation)) score += 10;

			const keywordOverlap = overlapCount(rowTitleTokens, event.tokens);
			if (keywordOverlap >= 2) score += Math.min(4, keywordOverlap);
			if (branchKeywordMatch(event.branch, rowBlob)) score += 2;

			if (rowAgency) {
				for (const agency of event.agencySet) {
					if (rowAgency.includes(agency) || agency.includes(rowAgency)) {
						score += 3;
						break;
					}
				}
			}

			if (rowDueDay !== null && event.startDay !== null) {
				const eventEnd = event.endDay ?? event.startDay;
				if (rowDueDay >= event.startDay - 120 * 86_400_000 && rowDueDay <= eventEnd + 45 * 86_400_000) score += 2;
			}
			if (rowPostedDay !== null && event.startDay !== null) {
				if (rowPostedDay >= event.startDay - 220 * 86_400_000 && rowPostedDay <= event.startDay + 40 * 86_400_000)
					score += 1;
			}

			return { eventId: event.id, score };
		})
		.filter((entry) => entry.score >= 6)
		.sort((a, b) => b.score - a.score)
		.slice(0, 3);

	for (const match of scored) {
		const event = eventById.get(match.eventId);
		if (!event) continue;
		row.eventIds.add(event.id);
		row.eventTitles.add(event.title);
		row.branches.add(event.branch);
		for (const area of event.ontology.capabilityAreas ?? []) row.capabilityAreas.add(area);
		for (const thread of event.ontology.missionThreads ?? []) row.missionThreads.add(thread);
	}
}

const opportunities = [...opportunityMap.values()]
	.map((row) => ({
		key: row.key,
		noticeId: row.noticeId,
		title: row.title,
		noticeType: row.noticeType,
		postedDate: row.postedDate,
		responseDueDate: row.responseDueDate,
		solicitationNumber: row.solicitationNumber,
		agencyPath: row.agencyPath,
		naicsCode: row.naicsCode,
		classificationCode: row.classificationCode,
		uiLink: row.uiLink,
		detailUrl: row.detailUrl,
		detailPreview: row.detailPreview,
		detailTextLength: row.detailTextLength,
		resourceAssets: [...row.resourceAssets.values()].sort((a, b) =>
			String(a.fileName ?? a.sourceUrl).localeCompare(String(b.fileName ?? b.sourceUrl)),
		),
		resourceCount: Math.max(row.resourceCount, row.resourceAssets.size),
		awardSignalCount: Number(row.awardSignalCount ?? 0),
		awardSignalSampleDate: row.awardSignalSampleDate ?? null,
		usaspendingSignal: row.usaspendingSignal ?? null,
		usaspendingMatchCount: Number(row.usaspendingMatchCount ?? 0),
		usaspendingAmount: Number(row.usaspendingAmount ?? 0),
		crossDataSignal: row.crossDataSignal ?? null,
		corroborationScore: Number(row.crossDataScore ?? 0),
		corroborationLevel: row.crossDataLevel ?? 'None',
		weight: row.weight,
		eventIds: toArray(row.eventIds),
		eventTitles: toArray(row.eventTitles),
		eventRefs: [...row.eventIds]
			.map((id) => {
				const event = eventById.get(id);
				const location = event?.location
					? [event.location.venue, event.location.city, event.location.state].filter(Boolean).join(' · ')
					: null;
				const contacts = eventEngagementContacts(event);
				const governmentContacts = contacts.filter((contact) => contact.isGovernment);
				return {
					id,
					title: event?.title ?? id,
					href: withBase(`/events/#${encodeURIComponent(id)}`),
					branch: event?.branch ?? null,
					status: event?.status ?? null,
					startDate: event?.startDate ?? null,
					endDate: event?.endDate ?? null,
					type: event?.type ?? null,
					description: event?.description ?? null,
					officialLink: event?.ontology?.links?.official ?? event?.ontology?.links?.registration ?? null,
					location,
					contacts,
					contactCount: contacts.length,
					governmentContacts,
					governmentContactCount: governmentContacts.length,
				};
			})
			.sort((a, b) => a.title.localeCompare(b.title)),
		governmentPocRefs: [...row.eventIds].flatMap((id) => {
			const event = eventById.get(id);
			if (!event) return [];
			const governmentContacts = eventEngagementContacts(event).filter((contact) => contact.isGovernment);
			return governmentContacts.map((contact) => ({
				eventId: id,
				eventTitle: event.title,
				eventHref: withBase(`/events/#${encodeURIComponent(id)}`),
				...contact,
			}));
		}),
		governmentPocCount: new Set(
			[...row.eventIds]
				.flatMap((id) => {
					const event = eventById.get(id);
					if (!event) return [];
					return eventEngagementContacts(event)
						.filter((contact) => contact.isGovernment)
						.map((contact) => String(contact.email ?? contact.name ?? `${id}:${contact.role ?? ''}`).toLowerCase());
				})
				.filter(Boolean),
		).size,
		branches: toArray(row.branches),
		capabilityAreas: toArray(row.capabilityAreas),
		missionThreads: toArray(row.missionThreads),
		eventCount: row.eventIds.size,
	}))
	.sort(
		(a, b) =>
			b.weight - a.weight ||
			(a.responseDueDate ?? '').localeCompare(b.responseDueDate ?? '') ||
			a.title.localeCompare(b.title),
	);

const noticeTypes = [...new Set(opportunities.map((o) => o.noticeType).filter(Boolean))].sort((a, b) =>
	a.localeCompare(b),
);
const branches = [...new Set(opportunities.flatMap((o) => o.branches).filter(Boolean))].sort((a, b) =>
	a.localeCompare(b),
);

const lastCollectedAt =
	radarEventsSeed
		.map((event) => samIntel(event)?.collectedAt as string | undefined)
		.filter(Boolean)
		.sort()
		.at(-1) ?? null;

const driftLatest = (opportunitiesDrift ?? {}) as any;
const driftDeltas = (driftLatest.deltas ?? {}) as Record<string, number>;
const driftGeneratedAt = typeof driftLatest.generated_at === 'string' ? driftLatest.generated_at : null;

const feedSummary = (feedCrawlReport?.summary ?? {}) as Record<string, number>;
const feedGeneratedAt =
	typeof (feedCrawlReport as any)?.generatedAt === 'string' ? (feedCrawlReport as any).generatedAt : null;

const opportunitiesJson = JSON.stringify(opportunities);
