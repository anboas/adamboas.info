			const workTypeLabel = Object.fromEntries(workTypeRules.map((rule) => [rule.key, rule.label]));
			workTypeLabel.general = 'General/Other';

			const inferWorkTypes = (row, blob) => {
				const normalizedBlob = ` ${String(blob || '').toLowerCase()} `;
				const matched = [];
				for (const rule of workTypeRules) {
					if (
						rule.terms.some(
							(term) =>
								normalizedBlob.includes(` ${String(term).toLowerCase()} `) ||
								normalizedBlob.includes(String(term).toLowerCase()),
						)
					) {
						matched.push(rule.key);
					}
				}
				if (!matched.length) return ['general'];
				return [...new Set(matched)].slice(0, 3);
			};

			let rows = raw.map((row) => {
				const dueDays = daysUntil(row.responseDueDate);
				const postedEpoch = toDayEpoch(row.postedDate);
				const dueEpoch = toDayEpoch(row.responseDueDate);
				const agencyLabelText = agencyLabel(row.agencyPath);
				const clientLabelText = clientLabel(row.agencyPath);
				const blob = [
					row.title,
					row.noticeType,
					row.noticeId,
					row.solicitationNumber,
					row.agencyPath,
					agencyLabelText,
					clientLabelText,
					row.naicsCode,
					row.classificationCode,
					...(row.branches || []),
					...(row.capabilityAreas || []),
					...(row.missionThreads || []),
				]
					.join(' ')
					.toLowerCase();
				const workTypes = inferWorkTypes(row, blob);
				const primaryWorkType = workTypes[0] || 'general';

				const focusMatches = focusTerms.reduce((acc, term) => acc + (blob.includes(term) ? 1 : 0), 0);
				const type = String(row.noticeType || '').toLowerCase();
				const detailTextLength = Number(row.detailTextLength || 0);
				const resourceCount = Number(row.resourceCount || 0);
				const awardSignalCount = Number(row.awardSignalCount || 0);
				const usaspendingSignal = row.usaspendingSignal || {};
				const usaspendingMatchCount = Number(
					usaspendingSignal.matched_award_count ??
						usaspendingSignal.matchedAwardCount ??
						row.usaspendingMatchCount ??
						0,
				);
				const usaspendingAmount = Number(
					usaspendingSignal.total_award_amount ?? usaspendingSignal.totalAwardAmount ?? row.usaspendingAmount ?? 0,
				);
				const crossDataSignal = row.crossDataSignal || {};
				const corroborationScore = Number(crossDataSignal.score || 0);
				const corroborationLevel = String(crossDataSignal.level || 'None');
				const fpdsSignal = row.fpdsSignal || row.fpds_signal || {};
				const fpdsAlignmentScore = Number(
					fpdsSignal.alignment_score ?? fpdsSignal.alignmentScore ?? row.fpdsAlignmentScore ?? 0,
				);
				const fpdsAlignmentLevel = String(
					fpdsSignal.alignment_level ?? fpdsSignal.alignmentLevel ?? row.fpdsAlignmentLevel ?? 'None',
				);
				const fpdsCanonicalPiid =
					String(fpdsSignal.canonical_piid ?? fpdsSignal.canonicalPiid ?? row.fpdsCanonicalPiid ?? '').trim() || null;
				const usaspendingQueryType = String(
					usaspendingSignal.query_type || usaspendingSignal.queryType || '',
				).toLowerCase();
				const usaspendingQueryConfidence =
					String(
						usaspendingSignal.query_confidence ||
							usaspendingSignal.queryConfidence ||
							row.usaspendingQueryConfidence ||
							'',
					).trim() || 'Low';
				const usaspendingCheckedAt =
					String(usaspendingSignal.checked_at || usaspendingSignal.checkedAt || '').trim() || null;
				const usaspendingCheckedEpoch = toDayEpoch(usaspendingCheckedAt);
				const usaspendingAgeDays =
					usaspendingCheckedEpoch === null
						? null
						: Math.max(0, Math.round((todayDay - usaspendingCheckedEpoch) / dayMs));
				const usaspendingError = String(usaspendingSignal.error || '').trim();
				const governmentPocRefs = Array.isArray(row.governmentPocRefs) ? row.governmentPocRefs : [];
				const governmentPocCount = Number(row.governmentPocCount || governmentPocRefs.length || 0);
				const eventCount = Number(row.eventCount || (Array.isArray(row.eventRefs) ? row.eventRefs.length : 0) || 0);
				let confidenceScore = 8;
				if (awardSignalCount > 0) confidenceScore += 18;
				if (usaspendingMatchCount > 0) confidenceScore += 24;
				if (usaspendingQueryType.includes('solicitation')) confidenceScore += 16;
				if (usaspendingQueryType.includes('fallback')) confidenceScore += 7;
				if (corroborationScore >= 70) confidenceScore += 18;
				else if (corroborationScore >= 45) confidenceScore += 12;
				else if (corroborationScore >= 20) confidenceScore += 6;
				if (fpdsAlignmentScore >= 70) confidenceScore += 14;
				else if (fpdsAlignmentScore >= 45) confidenceScore += 8;
				else if (fpdsAlignmentScore > 0) confidenceScore += 4;
				if (fpdsCanonicalPiid) confidenceScore += 2;
				if (detailTextLength > 0) confidenceScore += 4;
				if (resourceCount > 0) confidenceScore += 4;
				if (row.noticeId && row.solicitationNumber) confidenceScore += 5;
				if (usaspendingAgeDays !== null && usaspendingAgeDays > 14) confidenceScore -= 8;
				else if (usaspendingAgeDays !== null && usaspendingAgeDays > 7) confidenceScore -= 4;
				if (usaspendingError) confidenceScore -= 22;
				confidenceScore = Math.max(0, Math.min(100, Math.round(confidenceScore)));
				const confidenceLevel = confidenceScore >= 70 ? 'High' : confidenceScore >= 45 ? 'Medium' : 'Low';
				let intelDepthScore = 0;
				if (detailTextLength > 0) intelDepthScore += Math.min(18, Math.max(2, Math.round(detailTextLength / 1400)));
				if (resourceCount > 0) intelDepthScore += Math.min(10, resourceCount * 2);
				if (detailTextLength >= 12000) intelDepthScore += 4;
				let gemScore = Number(row.weight || 0);

				if (dueDays === null) gemScore += 3;
				else if (dueDays < 0) gemScore -= 12;
				else if (dueDays <= 7) gemScore += 18;
				else if (dueDays <= 21) gemScore += 14;
				else if (dueDays <= 45) gemScore += 10;
				else if (dueDays <= 90) gemScore += 6;
				else gemScore += 2;

				if (type.includes('sources sought')) gemScore += 7;
				if (type.includes('pre') && type.includes('solicitation')) gemScore += 6;
				if (type.includes('special notice')) gemScore += 4;
				if (type.includes('combined synopsis')) gemScore += 4;
				if (focusMatches > 0) gemScore += Math.min(10, focusMatches * 2);
				gemScore += Math.min(8, Number(row.eventCount || 0) * 2);
				gemScore += Math.min(12, intelDepthScore);
				gemScore += Math.min(6, awardSignalCount);
				gemScore += Math.min(6, usaspendingMatchCount);
				gemScore += Math.min(8, Math.round(corroborationScore / 12));
				if (fpdsAlignmentScore >= 70) gemScore += 4;
				else if (fpdsAlignmentScore >= 45) gemScore += 2;
				else if (fpdsAlignmentScore > 0) gemScore += 1;
				if (usaspendingAgeDays !== null && usaspendingAgeDays > 14) gemScore -= 2;
				if (usaspendingError) gemScore -= 3;
				if (usaspendingAmount >= 5_000_000) gemScore += 2;
				if (row.uiLink) gemScore += 2;

				const freshnessSignal =
					usaspendingMatchCount <= 0
						? 35
						: usaspendingAgeDays === null
							? 55
							: usaspendingAgeDays <= 3
								? 100
								: usaspendingAgeDays <= 7
									? 75
									: usaspendingAgeDays <= 14
										? 50
										: 25;
				let eventLeverageScore = 0;
				eventLeverageScore += Math.min(34, eventCount * 10);
				eventLeverageScore += Math.min(36, governmentPocCount * 12);
				if (eventCount > 0 && dueDays !== null && dueDays >= 0 && dueDays <= 60) eventLeverageScore += 16;
				if (eventCount > 0 && dueDays !== null && dueDays < 0) eventLeverageScore -= 16;
				eventLeverageScore = Math.max(0, Math.min(100, Math.round(eventLeverageScore)));
				const eventPriority =
					eventLeverageScore >= 70
						? 'Attend'
						: eventLeverageScore >= 45
							? 'Selective'
							: eventLeverageScore > 0
								? 'Monitor'
								: 'None';

				let responseWorthinessScore = Math.round(
					Math.min(100, gemScore * 2) * 0.32 +
						confidenceScore * 0.28 +
						Math.min(100, Math.round(corroborationScore * 1.25)) * 0.2 +
						Math.min(100, fpdsAlignmentScore) * 0.12 +
						freshnessSignal * 0.08,
				);
				if (dueDays !== null && dueDays < 0) responseWorthinessScore -= 30;
				if (usaspendingError) responseWorthinessScore -= 8;
				if (eventLeverageScore >= 70) responseWorthinessScore += 5;
				responseWorthinessScore = Math.max(0, Math.min(100, Math.round(responseWorthinessScore)));
				const responseDecision =
					responseWorthinessScore >= 70
						? 'Pursue now'
						: responseWorthinessScore >= 45
							? 'Watch / qualify'
							: 'Skip for now';
				const decisionClass =
					responseWorthinessScore >= 70 ? 'pursue' : responseWorthinessScore >= 45 ? 'watch' : 'skip';
				const decisionReasons = [];
				if (confidenceScore >= 70) decisionReasons.push('High confidence corroboration');
				if (fpdsAlignmentScore >= 45) decisionReasons.push('Identifier continuity present');
				if (governmentPocCount > 0)
					decisionReasons.push(`${governmentPocCount} government POC${governmentPocCount === 1 ? '' : 's'} published`);
				if (dueDays !== null && dueDays >= 0 && dueDays <= 30) decisionReasons.push('Near-term response window');
				if (usaspendingError) decisionReasons.push('3P signal fetch error');
				if (usaspendingAgeDays !== null && usaspendingAgeDays > 14) decisionReasons.push('3P corroboration is stale');
				if (!decisionReasons.length) decisionReasons.push('Limited corroboration right now');

				return {
					...row,
					sourceType: String(row.sourceType || 'sam'),
					sbirProgram: String(row.sbirProgram || row.noticeType || '').trim() || null,
					sbirStatus: String(row.sbirStatus || '').trim() || null,
					sbirQuestionCount: Number(row.sbirQuestionCount ?? 0),
					sbirTechnologyAreas: Array.isArray(row.sbirTechnologyAreas) ? row.sbirTechnologyAreas : [],
					sbirFocusAreas: Array.isArray(row.sbirFocusAreas) ? row.sbirFocusAreas : [],
					sbirKeywords: String(row.sbirKeywords || '').trim(),
					dueDays,
					postedEpoch,
					dueEpoch,
					postedDays: postedEpoch === null ? null : Math.max(0, Math.round((todayDay - postedEpoch) / dayMs)),
					detailTextLength,
					resourceCount,
					awardSignalCount,
					usaspendingMatchCount,
					usaspendingAmount,
					usaspendingSignal,
					corroborationScore,
					corroborationLevel,
					crossDataSignal,
					fpdsSignal,
					fpdsAlignmentScore,
					fpdsAlignmentLevel,
					fpdsCanonicalPiid,
					confidenceScore,
					confidenceLevel,
					usaspendingQueryType,
					usaspendingQueryConfidence,
					usaspendingCheckedAt,
					usaspendingCheckedEpoch,
					usaspendingAgeDays,
					usaspendingError,
					intelDepthScore,
					governmentPocRefs,
					governmentPocCount,
					eventCount,
					eventLeverageScore,
					eventPriority,
					responseWorthinessScore,
					responseDecision,
					decisionClass,
					decisionReasons,
					searchBlob: `${blob} ${workTypes
						.map((key) => workTypeLabel[key] || key)
						.join(' ')
						.toLowerCase()}`,
					focusMatches,
					gemScore,
					agencyLabel: agencyLabelText,
					clientLabel: clientLabelText,
					workTypes,
					primaryWorkType,
					workTypeLabel: workTypeLabel[primaryWorkType] || workTypeLabel.general,
				};
			});

			const state = {
				source: activeSource,
				search: '',
				type: 'all',
				branch: 'all',
				client: 'all',
				work: 'all',
				due: 'all',
				minWeight: 0,
				intel: 'all',
				confidence: 'all',
				thirdParty: 'all',
				fpds: 'all',
				decision: 'all',
				sort: 'gem',
				focusOnly: false,
				fastMode: false,
				naicsFilter: '',
			};

			const tableState = {
				sortKey: 'gemScore',
				sortDir: 'desc',
				page: 1,
				pageSize: Number(el.pageSize?.value || 50),
				mode: el.tableDensity?.value === 'full' ? 'full' : 'compact',
			};

			const snapshotStorageKey = 'adamboas.opportunities.dataset-snapshot.v1';
			const safeNum = (value) => (Number.isFinite(Number(value)) ? Number(value) : 0);
			const buildDatasetSnapshot = (items) => ({
				total: items.length,
				highConfidence: items.filter((row) => safeNum(row.confidenceScore) >= 70).length,
				strongCorroboration: items.filter((row) => safeNum(row.corroborationScore) >= 70).length,
				fpdsMedium: items.filter((row) => safeNum(row.fpdsAlignmentScore) >= 45).length,
				pursueNow: items.filter((row) => String(row.decisionClass || '') === 'pursue').length,
				govPocRows: items.filter((row) => safeNum(row.governmentPocCount) > 0).length,
				thirdPartyErrors: items.filter((row) => String(row.usaspendingError || '').trim()).length,
				exactMatches: items.filter(
					(row) =>
						String(row.usaspendingQueryType || '').includes('solicitation') && safeNum(row.usaspendingMatchCount) > 0,
				).length,
				fallbackMatches: items.filter(
					(row) =>
						String(row.usaspendingQueryType || '').includes('fallback') && safeNum(row.usaspendingMatchCount) > 0,
				).length,
				freshChecks: items.filter(
					(row) => safeNum(row.usaspendingMatchCount) > 0 && safeNum(row.usaspendingAgeDays) <= 3,
				).length,
				staleChecks: items.filter(
					(row) => safeNum(row.usaspendingMatchCount) > 0 && safeNum(row.usaspendingAgeDays) > 14,
				).length,
				ts: Date.now(),
			});
			const readSnapshot = () => {
				try {
					const raw = localStorage.getItem(snapshotStorageKey);
					if (!raw) return null;
					const parsed = JSON.parse(raw);
					return parsed && typeof parsed === 'object' ? parsed : null;
				} catch {
					return null;
				}
			};
			const writeSnapshot = (snapshot) => {
				try {
					localStorage.setItem(snapshotStorageKey, JSON.stringify(snapshot));
				} catch {}
			};
			const datasetSnapshot = buildDatasetSnapshot(rows);
			const previousDatasetSnapshot = readSnapshot();
			writeSnapshot(datasetSnapshot);

			const incomingParams = new URLSearchParams(window.location.search);
			const incomingContext = {
				from: String(incomingParams.get('from') || '').trim(),
				eventId: String(incomingParams.get('event') || '').trim(),
				opp: String(incomingParams.get('opp') || '').trim(),
				q: String(incomingParams.get('q') || '').trim(),
				open: incomingParams.get('open') === '1',
			};
			let pendingAutoOpenNoticeId = incomingContext.open ? incomingContext.opp : '';

			const normalizeNoticeId = (value) =>
				String(value || '')
					.toLowerCase()
					.replace(/[^a-z0-9]/g, '');

			const findRowByNoticeId = (noticeId) => {
				const target = normalizeNoticeId(noticeId);
				if (!target) return null;
				return rows.find((row) => normalizeNoticeId(row.noticeId) === target) || null;
			};

			const applyIncomingContext = () => {
				if (el.search) {
					if (!el.search.value && incomingContext.q) el.search.value = incomingContext.q;
					if (!el.search.value && incomingContext.opp) el.search.value = incomingContext.opp;
				}
				if (incomingContext.from === 'events' && incomingContext.eventId && el.eventContext) {
					el.eventContext.removeAttribute('hidden');
					if (el.eventContextText) {
						const label = incomingContext.q
							? `From event ${incomingContext.eventId} · filtered by ${incomingContext.q}`
							: `From event ${incomingContext.eventId}`;
						el.eventContextText.textContent = label;
					}
					if (el.eventContextBack) {
						const baseHref =
							el.eventContextBack.dataset.baseHref || el.eventContextBack.getAttribute('href') || '/events/';
						if (!el.eventContextBack.dataset.baseHref) el.eventContextBack.dataset.baseHref = baseHref;
						const [basePath] = String(baseHref).split('#');
						el.eventContextBack.setAttribute('href', `${basePath}#${encodeURIComponent(incomingContext.eventId)}`);
					}
					el.eventContextClear?.addEventListener('click', () => {
						if (el.eventContext) el.eventContext.setAttribute('hidden', '');
						const params = new URLSearchParams(window.location.search);
						params.delete('from');
						params.delete('event');
						params.delete('opptitle');
						const next = params.toString();
						history.replaceState(null, '', next ? `${window.location.pathname}?${next}` : window.location.pathname);
					});
				}
			};

			const updateStateFromInputs = () => {
				state.source = el.source?.value === 'sbir' ? 'sbir' : 'sam';
				state.search = (el.search?.value || '').trim().toLowerCase();
				state.type = el.type?.value || 'all';
				state.branch = el.branch?.value || 'all';
				state.client = el.client?.value || 'all';
				state.work = el.work?.value || 'all';
				state.due = el.due?.value || 'all';
				state.minWeight = Number(el.weight?.value || 0);
				state.intel = el.intel?.value || 'all';
				state.confidence = el.confidenceFilter?.value || 'all';
				state.thirdParty = el.thirdParty?.value || 'all';
				state.fpds = el.fpds?.value || 'all';
				state.decision = el.decision?.value || 'all';
				state.sort = el.sort?.value || 'gem';
				state.focusOnly = Boolean(el.focus?.checked);
				state.fastMode = Boolean(el.fastMode?.checked);
				if (state.source === 'sbir') {
					state.due = 'all';
					state.minWeight = 0;
					state.confidence = 'all';
					state.thirdParty = 'all';
					state.fpds = 'all';
					state.decision = 'all';
					state.focusOnly = false;
					state.fastMode = false;
					if (
						state.sort === 'gem' ||
						state.sort === 'due' ||
						state.sort === 'awards' ||
						state.sort === 'corroboration' ||
						state.sort === 'confidence' ||
						state.sort === 'response' ||
						state.sort === 'event'
					) {
						state.sort = 'title';
						if (el.sort) el.sort.value = 'title';
					}
				}
				tableState.mode = el.tableDensity?.value === 'full' ? 'full' : 'compact';
			};

			const inDueWindow = (row) => {
				if (state.due === 'all') return true;
				if (state.due === 'future') return row.dueDays !== null && row.dueDays >= 0;
				if (state.due === 'past') return row.dueDays !== null && row.dueDays < 0;
				if (state.due === '0-30') return row.dueDays !== null && row.dueDays >= 0 && row.dueDays <= 30;
				if (state.due === '31-90') return row.dueDays !== null && row.dueDays >= 31 && row.dueDays <= 90;
				if (state.due === 'no-due') return row.dueDays === null;
				return true;
			};

			const intelFilterMatch = (row) => {
				if (state.intel === 'all') return true;
				if (state.intel === 'deep') return Number(row.detailTextLength || 0) > 0;
				if (state.intel === 'attachments') return Number(row.resourceCount || 0) > 0;
				if (state.intel === 'both') return Number(row.detailTextLength || 0) > 0 && Number(row.resourceCount || 0) > 0;
				return true;
			};

			const confidenceFilterMatch = (row) => {
				const score = Number(row.confidenceScore || 0);
				if (state.confidence === 'all') return true;
				if (state.confidence === 'high') return score >= 70;
				if (state.confidence === 'medium') return score >= 45 && score < 70;
				if (state.confidence === 'low') return score < 45;
				return true;
			};

			const thirdPartyFilterMatch = (row) => {
				const mode = String(state.thirdParty || 'all');
				if (mode === 'all') return true;
				const error = String(row.usaspendingError || '').trim();
				const usCount = Number(row.usaspendingMatchCount || 0);
				const queryType = String(row.usaspendingQueryType || '').toLowerCase();
				if (mode === 'ok') return usCount > 0 && !error;
				if (mode === 'error') return Boolean(error);
				if (mode === 'exact') return queryType.includes('solicitation') && usCount > 0;
				if (mode === 'fallback') return queryType.includes('fallback') && usCount > 0;
				if (mode === 'none') return usCount <= 0;
				return true;
			};

			const fpdsFilterMatch = (row) => {
				const mode = String(state.fpds || 'all');
				if (mode === 'all') return true;
				const score = Number(row.fpdsAlignmentScore || 0);
				if (mode === 'high') return score >= 70;
				if (mode === 'medium') return score >= 45;
				if (mode === 'none') return score <= 0;
				return true;
			};

			const decisionFilterMatch = (row) => {
				const mode = String(state.decision || 'all');
				if (mode === 'all') return true;
				const cls = String(row.decisionClass || '');
				if (mode === 'pursue') return cls === 'pursue';
				if (mode === 'watch') return cls === 'watch';
				if (mode === 'skip') return cls === 'skip';
				return true;
			};

			// rows are source-scoped at load time (SAM or SBIR/STTR)

			const compareRows = (a, b) => {
				if (state.sort === 'title') return a.title.localeCompare(b.title) || b.gemScore - a.gemScore;
				if (state.sort === 'weight') return b.weight - a.weight || b.gemScore - a.gemScore;
				if (state.sort === 'response')
					return (b.responseWorthinessScore || 0) - (a.responseWorthinessScore || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'event')
					return (b.eventLeverageScore || 0) - (a.eventLeverageScore || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'intel')
					return (b.intelDepthScore || 0) - (a.intelDepthScore || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'awards')
					return (b.awardSignalCount || 0) - (a.awardSignalCount || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'corroboration')
					return (b.corroborationScore || 0) - (a.corroborationScore || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'confidence')
					return (b.confidenceScore || 0) - (a.confidenceScore || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'client') return a.clientLabel.localeCompare(b.clientLabel) || b.gemScore - a.gemScore;
				if (state.sort === 'work') return a.workTypeLabel.localeCompare(b.workTypeLabel) || b.gemScore - a.gemScore;
				if (state.sort === 'posted') return (b.postedEpoch || 0) - (a.postedEpoch || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'due') {
					const aDue = a.dueDays === null ? Number.POSITIVE_INFINITY : a.dueDays;
					const bDue = b.dueDays === null ? Number.POSITIVE_INFINITY : b.dueDays;
					return aDue - bDue || b.gemScore - a.gemScore;
				}
				return b.gemScore - a.gemScore || b.weight - a.weight;
			};

			const filterRows = () =>
				rows
					.filter((row) => {
						if (state.search && !row.searchBlob.includes(state.search)) return false;
						if (state.type !== 'all' && row.noticeType !== state.type) return false;
						if (state.branch !== 'all' && !(row.branches || []).includes(state.branch)) return false;
						if (state.client !== 'all' && (state.source === 'sbir' ? (row.sbirStatus || 'Unknown') : row.clientLabel) !== state.client)
							return false;
						if (state.work !== 'all' && !(row.workTypes || []).includes(state.work)) return false;
						if (state.naicsFilter && String(row.naicsCode || '') !== String(state.naicsFilter || '')) return false;
						if (!inDueWindow(row)) return false;
						if (!intelFilterMatch(row)) return false;
						if (!confidenceFilterMatch(row)) return false;
						if (!thirdPartyFilterMatch(row)) return false;
						if (!fpdsFilterMatch(row)) return false;
						if (!decisionFilterMatch(row)) return false;
						if (Number(row.weight || 0) < state.minWeight) return false;
						if (state.focusOnly && row.focusMatches < 1) return false;
						if (state.fastMode) {
							if (Number(row.confidenceScore || 0) < 70) return false;
							if (row.dueDays === null || row.dueDays < 0) return false;
							if (row.focusMatches < 1) return false;
						}
						return true;
					})
					.sort(compareRows);

			const countBy = (items, getKey) => {
				const map = new Map();
				for (const item of items) {
					const key = getKey(item);
					if (!key) continue;
					map.set(key, (map.get(key) || 0) + 1);
				}
				return [...map.entries()].sort((a, b) => b[1] - a[1]);
			};

			const resetSelect = (node, placeholder = 'All') => {
				if (!node) return;
				node.innerHTML = '';
				const option = document.createElement('option');
				option.value = 'all';
				option.textContent = placeholder;
				node.appendChild(option);
			};

			const applySourceChrome = () => {
				if (el.source) el.source.value = state.source;
				if (el.statusRow) {
					if (state.source === 'sbir') el.statusRow.setAttribute('hidden', '');
					else el.statusRow.removeAttribute('hidden');
				}
				for (const node of document.querySelectorAll('[data-source-only]')) {
					const only = String(node.getAttribute('data-source-only') || '').trim();
					if (!only) continue;
					if (only === state.source) node.removeAttribute('hidden');
					else node.setAttribute('hidden', '');
				}
				if (el.tableWrap) {
					el.tableWrap.classList.toggle('opp-table-source-sbir', state.source === 'sbir');
					el.tableWrap.classList.toggle('opp-table-source-sam', state.source !== 'sbir');
				}
				if (el.labelType) el.labelType.textContent = state.source === 'sbir' ? 'Program' : 'Notice type';
				if (el.labelBranch) el.labelBranch.textContent = state.source === 'sbir' ? 'Component' : 'Branch';
				if (el.labelClient) el.labelClient.textContent = state.source === 'sbir' ? 'Topic status' : 'Who (client)';
				if (el.labelWork) el.labelWork.textContent = state.source === 'sbir' ? 'Capability lane' : 'What (work type)';
				if (el.tableTitle) el.tableTitle.textContent = state.source === 'sbir' ? 'SBIR/STTR Topic Table' : 'Opportunity Table';
				if (el.sourceLinkSam) el.sourceLinkSam.classList.toggle('ui-link-btn-active', state.source === 'sam');
				if (el.sourceLinkSbir) el.sourceLinkSbir.classList.toggle('ui-link-btn-active', state.source === 'sbir');
			};

			const hydrateDatasetFilterOptions = () => {
				resetSelect(el.type, 'All');
				resetSelect(el.branch, 'All');
				resetSelect(el.client, 'All');
				const typeCounts = countBy(rows, (row) =>
					state.source === 'sbir' ? row.sbirProgram || row.noticeType || 'Unknown' : row.noticeType || 'Unknown',
				);
				for (const [label, count] of typeCounts.slice(0, 80)) {
					const option = document.createElement('option');
					option.value = label;
					option.textContent = `${label} (${count})`;
					el.type?.appendChild(option);
				}
				const branchCounts = countBy(rows, (row) => (Array.isArray(row.branches) && row.branches.length ? row.branches[0] : 'Unknown'));
				for (const [label, count] of branchCounts.slice(0, 80)) {
					const option = document.createElement('option');
					option.value = label;
					option.textContent = `${label} (${count})`;
					el.branch?.appendChild(option);
				}
				const clientCounts = countBy(rows, (row) =>
					state.source === 'sbir' ? row.sbirStatus || 'Unknown' : row.clientLabel,
				);
				for (const [label, count] of clientCounts.slice(0, 80)) {
					const option = document.createElement('option');
					option.value = label;
					option.textContent = `${label} (${count})`;
					el.client?.appendChild(option);
				}
			};

			const renderBars = (container, entries, emptyLabel = 'No data', onClick = null) => {
				if (!container) return;
				if (!entries.length) {
					container.innerHTML = `<p class="opp-subcopy">${emptyLabel}</p>`;
					return;
				}
				const top = entries.slice(0, 12);
				const max = Math.max(...top.map(([, value]) => Number(value || 0)), 1);
				container.innerHTML = top
					.map(([label, value], idx) => {
						const pct = Math.max(4, Math.round((Number(value) / max) * 100));
						const interactiveClass = onClick ? ' is-clickable' : '';
						const interactiveAttrs = onClick ? ' role="button" tabindex="0"' : '';
						return `<div class="opp-bar-row${interactiveClass}" data-idx="${idx}"${interactiveAttrs}><span class="opp-bar-label" title="${escapeHtml(label)}">${escapeHtml(label)}</span><span class="opp-bar-track"><span class="opp-bar-fill" style="width:${pct}%"></span></span><span class="opp-bar-value">${value}</span></div>`;
					})
					.join('');

				if (onClick) {
					for (const row of container.querySelectorAll('.opp-bar-row.is-clickable')) {
						const trigger = () => {
							const idx = Number(row.dataset.idx || -1);
							if (idx < 0 || idx >= top.length) return;
							onClick(top[idx][0], top[idx][1]);
						};
						row.addEventListener('click', trigger);
						row.addEventListener('keydown', (event) => {
							if (event.key === 'Enter' || event.key === ' ') {
								event.preventDefault();
								trigger();
							}
						});
					}
				}
			};

			const renderVisuals = (items) => {
				const urgency = [
					['Past due', items.filter((r) => r.dueDays !== null && r.dueDays < 0).length],
					['Due 0-14d', items.filter((r) => r.dueDays !== null && r.dueDays >= 0 && r.dueDays <= 14).length],
					['Due 15-30d', items.filter((r) => r.dueDays !== null && r.dueDays >= 15 && r.dueDays <= 30).length],
					['Due 31-60d', items.filter((r) => r.dueDays !== null && r.dueDays >= 31 && r.dueDays <= 60).length],
					['Due 61-120d', items.filter((r) => r.dueDays !== null && r.dueDays >= 61 && r.dueDays <= 120).length],
					['No due date', items.filter((r) => r.dueDays === null).length],
				];

				const urgencyChart = initChart('urgency', el.urgency);
				if (urgencyChart) {
					urgencyChart.setOption({
						animationDuration: 220,
						grid: { top: 8, right: 12, bottom: 16, left: 74 },
						xAxis: {
							type: 'value',
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						yAxis: {
							type: 'category',
							data: urgency.map(([label]) => label),
							axisLabel: { color: '#cbd5e1', fontSize: 10 },
						},
						series: [
							{
								type: 'bar',
								data: urgency.map(([, value]) => value),
								itemStyle: { color: '#2dd4bf', borderRadius: [0, 2, 2, 0] },
								barWidth: '62%',
							},
						],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!urgencyChart.__boundClick) {
						urgencyChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							const map = {
								'Past due': 'past',
								'Due 0-14d': '0-30',
								'Due 15-30d': '0-30',
								'Due 31-60d': '31-90',
								'Due 61-120d': 'all',
								'No due date': 'no-due',
							};
							if (el.due) el.due.value = map[params.name] || 'all';
							tableState.page = 1;
							render();
						});
						urgencyChart.__boundClick = true;
					}
				} else {
					renderBars(el.urgency, urgency, 'No due data', (label, value) => {
						if (Number(value || 0) <= 0) return;
						const map = {
							'Past due': 'past',
							'Due 0-14d': '0-30',
							'Due 15-30d': '0-30',
							'Due 31-60d': '31-90',
							'Due 61-120d': 'all',
							'No due date': 'no-due',
						};
						if (el.due) el.due.value = map[label] || 'all';
						tableState.page = 1;
						render();
					});
				}

				const byType = countBy(items, (r) => (state.source === 'sbir' ? r.sbirProgram || r.noticeType : r.noticeType));
				const typesChart = initChart('types', el.types);
				if (typesChart) {
					const labels = byType.slice(0, 10).map(([label]) => label);
					const values = byType.slice(0, 10).map(([, value]) => value);
					typesChart.setOption({
						animationDuration: 220,
						grid: { top: 8, right: 12, bottom: 38, left: 36 },
						xAxis: { type: 'category', data: labels, axisLabel: { color: '#cbd5e1', fontSize: 9, rotate: 20 } },
						yAxis: {
							type: 'value',
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						series: [
							{
								type: 'bar',
								data: values,
								itemStyle: { color: '#14b8a6', borderRadius: [2, 2, 0, 0] },
								barMaxWidth: 28,
							},
						],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!typesChart.__boundClick) {
						typesChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							if (el.type) el.type.value = params.name || 'all';
							tableState.page = 1;
							render();
						});
						typesChart.__boundClick = true;
					}
				} else {
					renderBars(el.types, byType, 'No notice types', (label, value) => {
						if (Number(value || 0) <= 0) return;
						if (el.type) el.type.value = label || 'all';
						tableState.page = 1;
						render();
					});
				}

				const byClient = countBy(items, (r) => (state.source === 'sbir' ? r.sbirStatus || 'Unknown' : r.clientLabel)).slice(0, 12);
				const agencyChart = initChart('agencies', el.agencies);
				if (agencyChart) {
					agencyChart.setOption({
						animationDuration: 220,
						grid: { top: 8, right: 12, bottom: 12, left: 132 },
						xAxis: {
							type: 'value',
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						yAxis: {
							type: 'category',
							data: byClient.map(([label]) => label),
							axisLabel: { color: '#cbd5e1', fontSize: 9, overflow: 'truncate', width: 124 },
						},
						series: [
							{
								type: 'bar',
								data: byClient.map(([, value]) => value),
								itemStyle: { color: '#0ea5e9', borderRadius: [0, 2, 2, 0] },
								barWidth: '56%',
							},
						],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!agencyChart.__boundClick) {
						agencyChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							state.client = state.client === params.name ? 'all' : String(params.name || 'all');
							if (el.client) el.client.value = state.client;
							tableState.page = 1;
							render();
						});
						agencyChart.__boundClick = true;
					}
				} else {
					renderBars(el.agencies, byClient, 'No client orgs', (label, value) => {
						if (Number(value || 0) <= 0) return;
						state.client = state.client === label ? 'all' : String(label || 'all');
						if (el.client) el.client.value = state.client;
						tableState.page = 1;
						render();
					});
				}

				const byWork = countBy(items, (r) => r.primaryWorkType || 'general').slice(0, 12);
				const workChart = initChart('workmix', el.workmix);
				if (workChart) {
					workChart.setOption({
						animationDuration: 220,
						grid: { top: 10, right: 12, bottom: 44, left: 28 },
						xAxis: {
							type: 'category',
							data: byWork.map(([key]) => workTypeLabel[key] || key),
							axisLabel: { color: '#cbd5e1', fontSize: 9, rotate: 22 },
						},
						yAxis: {
							type: 'value',
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						series: [
							{
								type: 'bar',
								data: byWork.map(([, value]) => value),
								itemStyle: { color: '#38bdf8', borderRadius: [2, 2, 0, 0] },
								barMaxWidth: 28,
							},
						],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!workChart.__boundClick) {
						workChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							const key = byWork.find(([ruleKey]) => (workTypeLabel[ruleKey] || ruleKey) === params.name)?.[0] || 'all';
							state.work = state.work === key ? 'all' : key;
							if (el.work) el.work.value = state.work;
							tableState.page = 1;
							render();
						});
						workChart.__boundClick = true;
					}
				} else {
					renderBars(
						el.workmix,
						byWork.map(([key, count]) => [workTypeLabel[key] || key, count]),
						'No work profile data',
						(label, value) => {
							if (Number(value || 0) <= 0) return;
							const key = byWork.find(([ruleKey]) => (workTypeLabel[ruleKey] || ruleKey) === label)?.[0] || 'all';
							state.work = state.work === key ? 'all' : key;
							if (el.work) el.work.value = state.work;
							tableState.page = 1;
							render();
						},
					);
				}

				const byNaics = countBy(items, (r) => r.naicsCode || null).slice(0, 10);
				const naicsChart = initChart('naics', el.naics);
				if (naicsChart) {
					naicsChart.setOption({
						animationDuration: 220,
						grid: { top: 10, right: 10, bottom: 38, left: 28 },
						xAxis: {
							type: 'category',
							data: byNaics.map(([label]) => label),
							axisLabel: { color: '#cbd5e1', fontSize: 9, rotate: 18 },
						},
						yAxis: {
							type: 'value',
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						series: [
							{
								type: 'bar',
								data: byNaics.map(([, value]) => value),
								itemStyle: { color: '#a78bfa', borderRadius: [2, 2, 0, 0] },
								barMaxWidth: 26,
							},
						],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!naicsChart.__boundClick) {
						naicsChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							state.naicsFilter = state.naicsFilter === String(params.name || '') ? '' : String(params.name || '');
							tableState.page = 1;
							render();
						});
						naicsChart.__boundClick = true;
					}
				} else {
					renderBars(el.naics, byNaics, 'No NAICS tags', (label, value) => {
						if (Number(value || 0) <= 0) return;
						state.naicsFilter = state.naicsFilter === String(label || '') ? '' : String(label || '');
						tableState.page = 1;
						render();
					});
				}

				const sourceBuckets = [
					['Deep text', items.filter((r) => Number(r.detailTextLength || 0) > 0).length],
					['Attachments', items.filter((r) => Number(r.resourceCount || 0) > 0).length],
					['SAM awards', items.filter((r) => Number(r.awardSignalCount || 0) > 0).length],
					['USA matches', items.filter((r) => Number(r.usaspendingMatchCount || 0) > 0).length],
					['FPDS Med+', items.filter((r) => Number(r.fpdsAlignmentScore || 0) >= 45).length],
					['Gov POC rows', items.filter((r) => Number(r.governmentPocCount || 0) > 0).length],
					['3P errors', items.filter((r) => String(r.usaspendingError || '').trim()).length],
					[
						'Exact query',
						items.filter(
							(r) =>
								String(r.usaspendingQueryType || '').includes('solicitation') &&
								Number(r.usaspendingMatchCount || 0) > 0,
						).length,
					],
					[
						'Fallback query',
						items.filter(
							(r) =>
								String(r.usaspendingQueryType || '').includes('fallback') && Number(r.usaspendingMatchCount || 0) > 0,
						).length,
					],
				];
				const sourcesChart = initChart('sources', el.sources);
				if (sourcesChart) {
					sourcesChart.setOption({
						animationDuration: 220,
						grid: { top: 8, right: 10, bottom: 42, left: 28 },
						xAxis: {
							type: 'category',
							data: sourceBuckets.map(([label]) => label),
							axisLabel: { color: '#cbd5e1', fontSize: 9, rotate: 20 },
						},
						yAxis: {
							type: 'value',
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						series: [
							{
								type: 'bar',
								data: sourceBuckets.map(([, value]) => value),
								itemStyle: { color: '#0ea5e9', borderRadius: [2, 2, 0, 0] },
								barMaxWidth: 28,
							},
						],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!sourcesChart.__boundClick) {
						sourcesChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							const map = {
								'3P errors': 'error',
								'Exact query': 'exact',
								'Fallback query': 'fallback',
								'USA matches': 'ok',
							};
							if (params.name === 'FPDS Med+' && el.fpds) {
								el.fpds.value = 'medium';
							} else if (params.name === 'Gov POC rows' && el.decision) {
								el.decision.value = 'pursue';
							} else {
								const next = map[params.name];
								if (next && el.thirdParty) el.thirdParty.value = next;
							}
							tableState.page = 1;
							render();
						});
						sourcesChart.__boundClick = true;
					}
				} else {
					renderBars(el.sources, sourceBuckets, 'No source coverage data', (label, value) => {
						if (Number(value || 0) <= 0) return;
						const map = {
							'3P errors': 'error',
							'Exact query': 'exact',
							'Fallback query': 'fallback',
							'USA matches': 'ok',
						};
						if (label === 'FPDS Med+' && el.fpds) {
							el.fpds.value = 'medium';
						} else if (label === 'Gov POC rows' && el.decision) {
							el.decision.value = 'pursue';
						} else if (map[label] && el.thirdParty) {
							el.thirdParty.value = map[label];
						}
						tableState.page = 1;
						render();
					});
				}

				const freshnessBuckets = [
					[
						'0-1d',
						items.filter((r) => Number(r.usaspendingMatchCount || 0) > 0 && Number(r.usaspendingAgeDays || 9999) <= 1)
							.length,
					],
					[
						'2-3d',
						items.filter(
							(r) =>
								Number(r.usaspendingMatchCount || 0) > 0 &&
								Number(r.usaspendingAgeDays || 9999) >= 2 &&
								Number(r.usaspendingAgeDays || 9999) <= 3,
						).length,
					],
					[
						'4-7d',
						items.filter(
							(r) =>
								Number(r.usaspendingMatchCount || 0) > 0 &&
								Number(r.usaspendingAgeDays || 9999) >= 4 &&
								Number(r.usaspendingAgeDays || 9999) <= 7,
						).length,
					],
					[
						'8-14d',
						items.filter(
							(r) =>
								Number(r.usaspendingMatchCount || 0) > 0 &&
								Number(r.usaspendingAgeDays || 9999) >= 8 &&
								Number(r.usaspendingAgeDays || 9999) <= 14,
						).length,
					],
					[
						'15d+',
						items.filter((r) => Number(r.usaspendingMatchCount || 0) > 0 && Number(r.usaspendingAgeDays || 9999) > 14)
							.length,
					],
				];
				const freshnessChart = initChart('freshness', el.freshness);
				if (freshnessChart) {
					freshnessChart.setOption({
						animationDuration: 220,
						grid: { top: 10, right: 10, bottom: 38, left: 28 },
						xAxis: {
							type: 'category',
							data: freshnessBuckets.map(([label]) => label),
							axisLabel: { color: '#cbd5e1', fontSize: 9 },
						},
						yAxis: {
							type: 'value',
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						series: [
							{
								type: 'bar',
								data: freshnessBuckets.map(([, value]) => value),
								itemStyle: { color: '#14b8a6', borderRadius: [2, 2, 0, 0] },
								barMaxWidth: 28,
							},
						],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
				} else {
					renderBars(el.freshness, freshnessBuckets, 'No freshness data');
				}

				const confidenceBuckets = [
					['High', items.filter((r) => Number(r.confidenceScore || 0) >= 70).length],
					[
						'Medium',
						items.filter((r) => Number(r.confidenceScore || 0) >= 45 && Number(r.confidenceScore || 0) < 70).length,
					],
					['Low', items.filter((r) => Number(r.confidenceScore || 0) < 45).length],
				];
				const confidenceChart = initChart('confidence', el.confidenceViz);
				if (confidenceChart) {
					confidenceChart.setOption({
						animationDuration: 220,
						legend: { bottom: 2, textStyle: { color: '#94a3b8', fontSize: 10 } },
						series: [
							{
								type: 'pie',
								radius: ['44%', '72%'],
								center: ['50%', '44%'],
								label: { color: '#cbd5e1', fontSize: 10, formatter: '{b}: {c}' },
								data: confidenceBuckets.map(([name, value]) => ({ name, value })),
								itemStyle: {
									color: (params) => ({ High: '#22c55e', Medium: '#38bdf8', Low: '#94a3b8' })[params.name] || '#64748b',
								},
							},
						],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!confidenceChart.__boundClick) {
						confidenceChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							const map = { High: 'high', Medium: 'medium', Low: 'low' };
							if (el.confidenceFilter) el.confidenceFilter.value = map[params.name] || 'all';
							tableState.page = 1;
							render();
						});
						confidenceChart.__boundClick = true;
					}
				} else {
					renderBars(el.confidenceViz, confidenceBuckets, 'No confidence data', (label, value) => {
						if (Number(value || 0) <= 0) return;
						if (el.confidenceFilter)
							el.confidenceFilter.value = { High: 'high', Medium: 'medium', Low: 'low' }[label] || 'all';
						tableState.page = 1;
						render();
					});
				}

				const scatterRows = [...items].sort((a, b) => Number(b.gemScore || 0) - Number(a.gemScore || 0)).slice(0, 180);
				const scatterChart = initChart('scatter', el.scatter);
				if (scatterChart) {
					scatterChart.setOption({
						animationDuration: 220,
						grid: { top: 18, right: 14, bottom: 34, left: 42 },
						xAxis: {
							type: 'value',
							name: 'Cor',
							nameTextStyle: { color: '#94a3b8' },
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						yAxis: {
							type: 'value',
							name: 'Gem',
							nameTextStyle: { color: '#94a3b8' },
							axisLabel: { color: '#94a3b8', fontSize: 10 },
							splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } },
						},
						series: [
							{
								type: 'scatter',
								symbolSize: (val) => Math.max(7, Math.min(18, Math.round(Number(val[2] || 0) / 8) + 6)),
								data: scatterRows.map((row) => [
									Number(row.corroborationScore || 0),
									Number(row.gemScore || 0),
									Number(row.confidenceScore || 0),
									row.title,
									row.noticeId || row.solicitationNumber || '',
								]),
								itemStyle: {
									color: (params) => {
										const c = Number((params.value || [])[2] || 0);
										if (c >= 70) return '#22c55e';
										if (c >= 45) return '#38bdf8';
										return '#94a3b8';
									},
									opacity: 0.88,
								},
							},
						],
						tooltip: {
							trigger: 'item',
							formatter: (p) => {
								const val = p.value || [];
								return `${escapeHtml(String(val[3] || 'Opportunity'))}<br/>Cor: ${Math.round(Number(val[0] || 0))} · Gem: ${Math.round(Number(val[1] || 0))} · Cf: ${Math.round(Number(val[2] || 0))}`;
							},
						},
					});
					if (!scatterChart.__boundClick) {
						scatterChart.on('click', (params) => {
							const notice = String((params?.value || [])[4] || '').trim();
							if (!notice) return;
							if (el.search) el.search.value = notice;
							tableState.page = 1;
							render();
						});
						scatterChart.__boundClick = true;
					}
				} else {
					renderBars(
						el.scatter,
						scatterRows
							.slice(0, 10)
							.map((row) => [
								`${Math.round(row.corroborationScore || 0)}/${Math.round(row.gemScore || 0)} ${String(row.title || '').slice(0, 44)}`,
								Number(row.confidenceScore || 0),
							]),
						'No scatter data',
					);
				}

				const heatClients = countBy(items, (r) => r.clientLabel)
					.slice(0, 8)
					.map(([label]) => label);
				const heatWork = countBy(items, (r) => r.primaryWorkType || 'general')
					.slice(0, 6)
					.map(([label]) => label);
				const heatData = [];
				for (let x = 0; x < heatWork.length; x += 1) {
					for (let y = 0; y < heatClients.length; y += 1) {
						const workKey = heatWork[x];
						const clientKey = heatClients[y];
						const value = items.filter(
							(row) => row.primaryWorkType === workKey && row.clientLabel === clientKey,
						).length;
						heatData.push([x, y, value]);
					}
				}

				const clientWorkChart = initChart('clientWork', el.clientWork);
				if (clientWorkChart) {
					clientWorkChart.setOption({
						animationDuration: 220,
						grid: { top: 18, right: 12, bottom: 64, left: 132 },
						xAxis: {
							type: 'category',
							data: heatWork.map((key) => workTypeLabel[key] || key),
							axisLabel: { color: '#cbd5e1', fontSize: 9, rotate: 24 },
						},
						yAxis: {
							type: 'category',
							data: heatClients,
							axisLabel: { color: '#cbd5e1', fontSize: 9, width: 124, overflow: 'truncate' },
						},
						visualMap: {
							min: 0,
							max: Math.max(1, ...heatData.map((cell) => Number(cell[2] || 0))),
							calculable: false,
							show: false,
							inRange: { color: ['#0f172a', '#1d4ed8', '#22c55e'] },
						},
						series: [
							{
								type: 'heatmap',
								data: heatData,
								label: { show: true, fontSize: 9, color: '#e2e8f0' },
								itemStyle: { borderColor: 'rgba(100,116,139,0.4)', borderWidth: 1 },
							},
						],
						tooltip: {
							trigger: 'item',
							formatter: (p) =>
								`${heatClients[p.value[1]] || 'Client'} · ${workTypeLabel[heatWork[p.value[0]]] || heatWork[p.value[0]]}: ${p.value[2]}`,
						},
					});
					if (!clientWorkChart.__boundClick) {
						clientWorkChart.on('click', (params) => {
							if (!params || Number((params.value || [])[2] || 0) <= 0) return;
							const workKey = heatWork[Number((params.value || [])[0] || 0)] || 'all';
							const clientKey = heatClients[Number((params.value || [])[1] || 0)] || 'all';
							if (el.work) el.work.value = state.work === workKey ? 'all' : workKey;
							if (el.client) el.client.value = state.client === clientKey ? 'all' : clientKey;
							tableState.page = 1;
							render();
						});
						clientWorkChart.__boundClick = true;
					}
				} else if (el.clientWork) {
					if (!heatClients.length || !heatWork.length) {
						el.clientWork.innerHTML = '<p class="opp-subcopy">No matrix data for this filter.</p>';
					} else {
						const maxCell = Math.max(1, ...heatData.map((cell) => Number(cell[2] || 0)));
						const rowHead = `<div class="opp-matrix-row opp-matrix-row-head" style="--opp-matrix-cols:${heatWork.length}"><span></span>${heatWork.map((key) => `<span class="opp-matrix-head">${escapeHtml(workTypeLabel[key] || key)}</span>`).join('')}</div>`;
						const body = heatClients
							.map((client, y) => {
								const cells = heatWork
									.map((_, x) => {
										const value = heatData.find((cell) => cell[0] === x && cell[1] === y)?.[2] || 0;
										const alpha = value <= 0 ? 0.08 : Math.max(0.16, Math.min(0.78, value / maxCell));
										return `<button class="opp-matrix-cell" type="button" data-client="${escapeHtml(client)}" data-work="${escapeHtml(heatWork[x])}" style="background: rgba(34,197,94,${alpha});">${value || '·'}</button>`;
									})
									.join('');
								return `<div class="opp-matrix-row" style="--opp-matrix-cols:${heatWork.length}"><span class="opp-matrix-label" title="${escapeHtml(client)}">${escapeHtml(client)}</span>${cells}</div>`;
							})
							.join('');
						el.clientWork.innerHTML = `<div class="opp-matrix"><div class="opp-matrix-grid">${rowHead}${body}</div></div>`;
						for (const btn of el.clientWork.querySelectorAll('.opp-matrix-cell')) {
							btn.addEventListener('click', () => {
								const nextClient = String(btn.getAttribute('data-client') || 'all');
								const nextWork = String(btn.getAttribute('data-work') || 'all');
								if (el.client) el.client.value = state.client === nextClient ? 'all' : nextClient;
								if (el.work) el.work.value = state.work === nextWork ? 'all' : nextWork;
								tableState.page = 1;
								render();
							});
						}
					}
				}
			};

			const dueClass = (row) => {
				if (row.dueDays === null) return '';
				return row.dueDays < 0 ? 'opp-due-past' : 'opp-due-future';
			};

			const applyTableMode = () => {
				if (!el.tableWrap) return;
				el.tableWrap.classList.toggle('opp-table-mode-compact', tableState.mode === 'compact');
				el.tableWrap.classList.toggle('opp-table-mode-full', tableState.mode === 'full');
			};

			const renderInsights = (items) => {
				if (!el.insights) return;
				if (!items.length) {
					el.insights.innerHTML = '<li class="opp-subcopy">No rows under the current filter set.</li>';
					return;
				}
				const avgGem = Math.round(items.reduce((sum, row) => sum + Number(row.gemScore || 0), 0) / items.length);
				const avgCor = Math.round(
					items.reduce((sum, row) => sum + Number(row.corroborationScore || 0), 0) / items.length,
				);
				const highConf = items.filter((row) => Number(row.confidenceScore || 0) >= 70).length;
				const byClient = countBy(items, (row) => row.clientLabel);
				const topClient = byClient[0];
				const soon = [...items]
					.filter((row) => row.dueDays !== null && row.dueDays >= 0)
					.sort((a, b) => Number(a.dueDays || 9999) - Number(b.dueDays || 9999))[0];
				const strong = items.filter((row) => Number(row.corroborationScore || 0) >= 70).length;
				const moderate = items.filter(
					(row) => Number(row.corroborationScore || 0) >= 45 && Number(row.corroborationScore || 0) < 70,
				).length;
				const usErrors = items.filter((row) => String(row.usaspendingError || '').trim()).length;
				const exactMatches = items.filter(
					(row) =>
						String(row.usaspendingQueryType || '').includes('solicitation') &&
						Number(row.usaspendingMatchCount || 0) > 0,
				).length;
				const fallbackMatches = items.filter(
					(row) =>
						String(row.usaspendingQueryType || '').includes('fallback') && Number(row.usaspendingMatchCount || 0) > 0,
				).length;
				const staleChecks = items.filter(
					(row) => Number(row.usaspendingMatchCount || 0) > 0 && Number(row.usaspendingAgeDays || 0) > 14,
				).length;
				const fpdsMed = items.filter((row) => Number(row.fpdsAlignmentScore || 0) >= 45).length;
				const pursueNow = items.filter((row) => String(row.decisionClass || '') === 'pursue').length;
				const withGovPoc = items.filter((row) => Number(row.governmentPocCount || 0) > 0).length;
				const lines = [
					`Slice average: Gem ${avgGem} · Corroboration ${avgCor} · High-confidence ${highConf}/${items.length}.`,
					topClient
						? `Top buyer family: ${topClient[0]} (${topClient[1]} opportunities).`
						: 'Top buyer family: no data.',
					soon
						? `Nearest due: ${soon.title} (${soon.dueDays}d, ${soon.noticeType || 'notice'}).`
						: 'No upcoming due dates in this slice.',
					`Corroboration mix: ${strong} Strong · ${moderate} Moderate · ${Math.max(0, items.length - strong - moderate)} Weak/None.`,
					`Decision support: ${pursueNow} pursue-now candidates · ${withGovPoc} rows with published government POCs.`,
					`3P quality: ${exactMatches} exact matches · ${fallbackMatches} fallback matches · ${usErrors} upstream-error rows · ${staleChecks} stale checks (>14d).`,
					`FPDS continuity: ${fpdsMed} rows at Medium+ alignment.`,
				];
				el.insights.innerHTML = lines.map((line) => `<li>${escapeHtml(line)}</li>`).join('');
			};

			const deltaSigned = (current, previous) => {
				const delta = Number(current || 0) - Number(previous || 0);
				if (delta > 0) return `+${delta}`;
				if (delta < 0) return `${delta}`;
				return '0';
			};

			const renderDatasetDelta = () => {
				if (!el.delta) return;
				if (!previousDatasetSnapshot || typeof previousDatasetSnapshot !== 'object') {
					el.delta.innerHTML = '<li>No previous snapshot in this browser yet.</li>';
					return;
				}
				const previousTime = Number(previousDatasetSnapshot.ts || 0);
				const prevLabel =
					Number.isFinite(previousTime) && previousTime > 0 ? new Date(previousTime).toLocaleString() : 'unknown time';
				const lines = [
					`Compared to ${prevLabel}: total ${deltaSigned(datasetSnapshot.total, previousDatasetSnapshot.total)}.`,
					`High-confidence ${deltaSigned(datasetSnapshot.highConfidence, previousDatasetSnapshot.highConfidence)} · Strong corroboration ${deltaSigned(datasetSnapshot.strongCorroboration, previousDatasetSnapshot.strongCorroboration)}.`,
					`Pursue-now ${deltaSigned(datasetSnapshot.pursueNow, previousDatasetSnapshot.pursueNow)} · Rows with gov POCs ${deltaSigned(datasetSnapshot.govPocRows, previousDatasetSnapshot.govPocRows)}.`,
					`FPDS Medium+ ${deltaSigned(datasetSnapshot.fpdsMedium, previousDatasetSnapshot.fpdsMedium)} · 3P errors ${deltaSigned(datasetSnapshot.thirdPartyErrors, previousDatasetSnapshot.thirdPartyErrors)}.`,
					`Fresh checks ${deltaSigned(datasetSnapshot.freshChecks, previousDatasetSnapshot.freshChecks)} · Stale checks ${deltaSigned(datasetSnapshot.staleChecks, previousDatasetSnapshot.staleChecks)}.`,
					`Exact query matches ${deltaSigned(datasetSnapshot.exactMatches, previousDatasetSnapshot.exactMatches)} · Fallback matches ${deltaSigned(datasetSnapshot.fallbackMatches, previousDatasetSnapshot.fallbackMatches)}.`,
				];
				el.delta.innerHTML = lines.map((line) => `<li>${escapeHtml(line)}</li>`).join('');
			};

			let modalLastFocus = null;

			const closeIntelModal = () => {
				if (!el.modal) return;
				el.modal.setAttribute('hidden', '');
				el.modal.setAttribute('aria-hidden', 'true');
				document.body.classList.remove('opp-modal-open');
				if (modalLastFocus && typeof modalLastFocus.focus === 'function') modalLastFocus.focus();
				modalLastFocus = null;
			};

			const openIntelModal = (row, triggerNode = null) => {
				if (!el.modal) return;
				modalLastFocus = triggerNode;
				if (el.modalTitle) el.modalTitle.textContent = row.title || 'Opportunity intel';
				if (el.modalClient) el.modalClient.textContent = row.clientLabel || 'Unknown';
				if (el.modalWork) el.modalWork.textContent = row.workTypeLabel || 'General/Other';
				if (el.modalAgency) el.modalAgency.textContent = row.agencyLabel || 'Unknown';
				if (el.modalType) el.modalType.textContent = row.noticeType || '—';
				if (el.modalDue) el.modalDue.textContent = fmtDate(row.responseDueDate);
				if (el.modalIntel)
					el.modalIntel.textContent = `${Number(row.detailTextLength || 0).toLocaleString()} chars · ${Number(row.resourceCount || 0)} file links`;
				if (el.modalAwards)
					el.modalAwards.textContent =
						Number(row.awardSignalCount || 0) > 0
							? `${Number(row.awardSignalCount || 0).toLocaleString()} related awards`
							: 'No matched awards';
				if (el.modalUsaspending) {
					const usCount = Number(row.usaspendingMatchCount || 0);
					const usAmount = Number(row.usaspendingAmount || 0);
					el.modalUsaspending.textContent =
						usCount > 0
							? `${usCount.toLocaleString()} awards · $${Math.round(usAmount).toLocaleString()}`
							: 'No third-party matches';
				}
				if (el.modalCorroboration) {
					const level = String(row.corroborationLevel || 'None');
					const score = Number(row.corroborationScore || 0);
					el.modalCorroboration.textContent = `${level} (${Math.round(score)})`;
				}
				if (el.modalConfidence) {
					const level = String(row.confidenceLevel || 'Low');
					const score = Number(row.confidenceScore || 0);
					el.modalConfidence.textContent = `${level} (${Math.round(score)})`;
				}

				if (el.modalLink) {
					el.modalLink.textContent = state.source === 'sbir' ? 'Open SBIR topic ↗' : 'Open SAM notice ↗';
					if (row.uiLink) {
						el.modalLink.removeAttribute('hidden');
						el.modalLink.setAttribute('href', row.uiLink);
					} else {
						el.modalLink.setAttribute('hidden', '');
						el.modalLink.setAttribute('href', '#');
					}
				}
				if (el.modalDetailLink) {
					if (row.detailUrl && row.detailUrl !== row.uiLink) {
						el.modalDetailLink.removeAttribute('hidden');
						el.modalDetailLink.setAttribute('href', row.detailUrl);
					} else {
						el.modalDetailLink.setAttribute('hidden', '');
						el.modalDetailLink.setAttribute('href', '#');
					}
				}
				if (el.modalEventLink) {
					if (state.source === 'sam' && incomingContext.from === 'events' && incomingContext.eventId) {
						el.modalEventLink.removeAttribute('hidden');
						el.modalEventLink.setAttribute('href', `/events/#${encodeURIComponent(incomingContext.eventId)}`);
					} else {
						el.modalEventLink.setAttribute('hidden', '');
						el.modalEventLink.setAttribute('href', '#');
					}
				}
				const samModalNodes = [
					el.modalMetaAwards,
					el.modalMetaUsasp,
					el.modalMetaCorrob,
					el.modalMetaConfidence,
					el.modalEventsTitle,
					el.modalEvents,
					el.modalGovPocsTitle,
					el.modalGovPocs,
					el.modalEventDrillTitle,
					el.modalEventDetail,
					el.modalUsaspTitle,
					el.modalUsaspendingList,
					el.modalProvenanceTitle,
					el.modalProvenance,
				];
				for (const node of samModalNodes) {
					if (!node) continue;
					if (state.source === 'sam') node.removeAttribute('hidden');
					else node.setAttribute('hidden', '');
				}

				if (el.modalDetail) {
					const preview = String(row.detailPreview || '').trim();
					if (!preview) {
						el.modalDetail.innerHTML = '<p class="opp-subcopy">No deep text captured for this notice yet.</p>';
					} else {
						const truncated = Number(row.detailTextLength || 0) > preview.length;
						const formatted = formatDetailPreviewHtml(preview);
						el.modalDetail.innerHTML = truncated
							? `${formatted}<p class="opp-subcopy">Preview truncated. Open SAM notice for full text.</p>`
							: formatted;
					}
				}

				if (el.modalFiles) {
					const assets = Array.isArray(row.resourceAssets)
						? row.resourceAssets.filter((asset) => asset && asset.sourceUrl)
						: [];
					if (!assets.length) {
						el.modalFiles.innerHTML =
							'<li class="opp-subcopy">No attachments/resource links captured for this notice.</li>';
					} else {
						el.modalFiles.innerHTML = assets
							.slice(0, 60)
							.map((asset) => {
								const sourceUrl = String(asset.sourceUrl || '').trim();
								const mirrorUrl = String(asset.mirrorDownloadUrl || '').trim();
								const sourceMeta = attachmentLabel(sourceUrl);
								const mirrorMeta = mirrorUrl ? attachmentLabel(mirrorUrl) : null;
								const fileName = String(asset.fileName || '').trim() || sourceMeta.fileName;
								const hostMeta = sourceMeta.host
									? `<span class="opp-file-host">${escapeHtml(sourceMeta.host)}</span>`
									: '';
								const mirrorLink = mirrorUrl
									? `<a href="${escapeHtml(mirrorUrl)}" target="_blank" rel="noreferrer">Mirror download</a>`
									: '';
								const sourceLink = sourceUrl
									? `<a href="${escapeHtml(sourceUrl)}" target="_blank" rel="noreferrer">SAM.gov source</a>`
									: '';
								const links = [mirrorLink, sourceLink].filter(Boolean).join('<span aria-hidden="true"> · </span>');
								const size =
									Number(asset.sizeBytes || 0) > 0
										? `<span class="opp-file-size">${Number(asset.sizeBytes).toLocaleString()} bytes</span>`
										: '';
								const mirrorHost = mirrorMeta?.host
									? `<span class="opp-file-host">${escapeHtml(mirrorMeta.host)}</span>`
									: '';
								return `<li><span class="opp-file-name">${escapeHtml(fileName)}</span><span class="opp-file-links">${links}</span>${hostMeta}${mirrorHost}${size}</li>`;
							})
							.join('');
					}
				}

				if (el.modalUsaspendingList) {
					const signal = row.usaspendingSignal || {};
					const awards = Array.isArray(signal.top_awards)
						? signal.top_awards
						: Array.isArray(signal.topAwards)
							? signal.topAwards
							: [];
					if (!awards.length) {
						el.modalUsaspendingList.innerHTML =
							'<li class="opp-subcopy">No USAspending award rows captured for this solicitation yet.</li>';
					} else {
						el.modalUsaspendingList.innerHTML = awards
							.slice(0, 6)
							.map((award) => {
								const awardId = String(award.award_id || '').trim() || 'Award';
								const recipient = String(award.recipient_name || '').trim();
								const amount = Number(award.award_amount || 0);
								const agency = [award.awarding_agency, award.awarding_sub_agency].filter(Boolean).join(' · ');
								const meta = [recipient, agency, amount > 0 ? `$${Math.round(amount).toLocaleString()}` : '']
									.filter(Boolean)
									.join(' · ');
								return `<li><span class="opp-file-name">${escapeHtml(awardId)}</span>${meta ? `<span class="opp-file-host">${escapeHtml(meta)}</span>` : ''}</li>`;
							})
							.join('');
					}
				}

				if (el.modalProvenance) {
					const entries = [];
					entries.push({
						label: 'SAM detail capture',
						meta:
							Number(row.detailTextLength || 0) > 0
								? `${Number(row.detailTextLength || 0).toLocaleString()} chars`
								: 'No deep text',
					});
					entries.push({
						label: 'SAM attachments',
						meta: Number(row.resourceCount || 0) > 0 ? `${Number(row.resourceCount || 0)} resources` : 'No resources',
					});
					entries.push({
						label: 'SAM award continuity',
						meta:
							Number(row.awardSignalCount || 0) > 0
								? `${Number(row.awardSignalCount || 0)} related awards`
								: 'No SAM award links',
					});
					entries.push({
						label: 'USAspending query mode',
						meta: `${row.usaspendingQueryType || 'unknown'} · confidence ${row.usaspendingQueryConfidence || 'Low'}`,
					});
					entries.push({
						label: 'USAspending last checked',
						meta: row.usaspendingCheckedAt ? fmtDate(row.usaspendingCheckedAt) : 'Not recorded',
					});
					if (String(row.usaspendingError || '').trim()) {
						entries.push({
							label: 'USAspending error',
							meta: String(row.usaspendingError || '')
								.trim()
								.slice(0, 220),
						});
					}
					entries.push({
						label: 'Cross-data signal',
						meta: `${row.corroborationLevel || 'None'} (${Math.round(Number(row.corroborationScore || 0))})`,
					});
					entries.push({
						label: 'FPDS-aligned continuity',
						meta: `${row.fpdsAlignmentLevel || 'None'} (${Math.round(Number(row.fpdsAlignmentScore || 0))})${row.fpdsCanonicalPiid ? ` · ${row.fpdsCanonicalPiid}` : ''}`,
					});
					entries.push({
						label: 'Response recommendation',
						meta: `${row.responseDecision || 'Unrated'} (${Math.round(Number(row.responseWorthinessScore || 0))})`,
					});
					entries.push({
						label: 'Event leverage',
						meta: `${row.eventPriority || 'None'} (${Math.round(Number(row.eventLeverageScore || 0))}) · ${Math.round(Number(row.governmentPocCount || 0))} gov POCs`,
					});
					el.modalProvenance.innerHTML = entries
						.map(
							(entry) =>
								`<li><span class="opp-file-name">${escapeHtml(entry.label)}</span><span class="opp-file-host">${escapeHtml(entry.meta)}</span></li>`,
						)
						.join('');
				}

				if (el.modalEvents || el.modalGovPocs || el.modalEventDetail) {
					const refs = Array.isArray(row.eventRefs) ? row.eventRefs.filter((ref) => ref && ref.id) : [];
					const govPocs = Array.isArray(row.governmentPocRefs)
						? row.governmentPocRefs.filter((entry) => entry && (entry.name || entry.email || entry.phone))
						: refs.flatMap((ref) =>
								Array.isArray(ref.governmentContacts)
									? ref.governmentContacts.map((contact) => ({
											...contact,
											eventTitle: ref.title,
											eventHref: ref.href,
										}))
									: [],
							);

					const renderEventDetail = (ref) => {
						if (!el.modalEventDetail) return;
						if (!ref) {
							el.modalEventDetail.innerHTML =
								'Select a mapped event to inspect the event context without leaving this view.';
							return;
						}
						const href = contextualEventHref(
							String(ref.href || `/events/#${encodeURIComponent(String(ref.id || ''))}`),
							row,
						);
						const official = String(ref.officialLink || '').trim();
						const start = fmtDate(ref.startDate || null);
						const end = fmtDate(ref.endDate || null);
						const when = start === '—' ? '—' : end !== '—' && end !== start ? `${start} → ${end}` : start;
						const description = String(ref.description || '').trim();
						const shortDesc = description.length > 280 ? `${description.slice(0, 277)}...` : description;
						const govPocCount = Number(ref.governmentContactCount || 0);
						const meta = [ref.branch, ref.type, ref.status].filter(Boolean).join(' · ');
						el.modalEventDetail.innerHTML = `
							<div class="opp-event-detail-head">
								<strong>${escapeHtml(ref.title || ref.id)}</strong>
								<div class="opp-file-links"><a href="${escapeHtml(href)}">Open event page ↗</a>${official ? `<span aria-hidden="true"> · </span><a href="${escapeHtml(official)}" target="_blank" rel="noreferrer">Official link ↗</a>` : ''}</div>
							</div>
							${meta ? `<p class="opp-file-host">${escapeHtml(meta)}</p>` : ''}
							${when !== '—' ? `<p class="opp-file-host">When: ${escapeHtml(when)}</p>` : ''}
							${ref.location ? `<p class="opp-file-host">Where: ${escapeHtml(ref.location)}</p>` : ''}
							${govPocCount > 0 ? `<p class="opp-file-host">Published government POCs: ${govPocCount}</p>` : ''}
							${shortDesc ? `<p>${escapeHtml(shortDesc)}</p>` : ''}
						`;
					};

					if (el.modalGovPocs) {
						if (!govPocs.length) {
							el.modalGovPocs.innerHTML =
								'<li class="opp-subcopy">No published government POCs found for mapped events in this slice yet.</li>';
						} else {
							const unique = [];
							const seen = new Set();
							for (const entry of govPocs) {
								const key = String(
									entry.email || entry.name || `${entry.eventTitle || ''}:${entry.role || ''}`,
								).toLowerCase();
								if (!key || seen.has(key)) continue;
								seen.add(key);
								unique.push(entry);
								if (unique.length >= 12) break;
							}
							el.modalGovPocs.innerHTML = unique
								.map((entry) => {
									const eventHref = contextualEventHref(
										String(entry.eventHref || `/events/#${encodeURIComponent(String(entry.eventId || ''))}`),
										row,
									);
									const name = String(entry.name || 'Unnamed contact');
									const role = String(entry.role || '').trim();
									const org = String(entry.organization || '').trim();
									const mail = String(entry.email || '').trim();
									const phone = String(entry.phone || '').trim();
									const meta = [role, org, mail, phone].filter(Boolean).join(' · ');
									return `<li><span class="opp-file-name">${escapeHtml(name)}</span>${meta ? `<span class="opp-file-host">${escapeHtml(meta)}</span>` : ''}<div class="opp-file-links"><a href="${escapeHtml(eventHref)}">${escapeHtml(String(entry.eventTitle || 'Event'))} ↗</a></div></li>`;
								})
								.join('');
						}
					}

					if (!refs.length) {
						if (el.modalEvents)
							el.modalEvents.innerHTML = '<li class="opp-subcopy">No mapped events for this opportunity yet.</li>';
						renderEventDetail(null);
					} else {
						if (el.modalEvents) {
							el.modalEvents.innerHTML = refs
								.slice(0, 8)
								.map((ref, idx) => {
									const href = contextualEventHref(
										String(ref.href || `/events/#${encodeURIComponent(String(ref.id || ''))}`),
										row,
									);
									const start = fmtDate(ref.startDate || null);
									const govPocMeta =
										Number(ref.governmentContactCount || 0) > 0
											? `${Number(ref.governmentContactCount || 0)} gov POCs`
											: '';
									const meta = [ref.branch, ref.status, start !== '—' ? start : '', govPocMeta]
										.filter(Boolean)
										.join(' · ');
									return `<li><button class="opp-event-select ${idx === 0 ? 'is-active' : ''}" type="button" data-event-idx="${idx}">${escapeHtml(ref.title || ref.id)}</button><div class="opp-file-links"><a href="${escapeHtml(href)}">Open ↗</a></div>${meta ? `<span class="opp-file-host">${escapeHtml(meta)}</span>` : ''}</li>`;
								})
								.join('');

							for (const button of el.modalEvents.querySelectorAll('.opp-event-select')) {
								button.addEventListener('click', () => {
									const idx = Number(button.getAttribute('data-event-idx') || -1);
									if (idx < 0 || idx >= refs.length) return;
									for (const b of el.modalEvents.querySelectorAll('.opp-event-select')) b.classList.remove('is-active');
									button.classList.add('is-active');
									renderEventDetail(refs[idx]);
								});
							}
						}
						renderEventDetail(refs[0]);
					}
				}

				el.modal.removeAttribute('hidden');
				el.modal.setAttribute('aria-hidden', 'false');
				document.body.classList.add('opp-modal-open');
				if (el.modalClose) el.modalClose.focus();
			};

			const gemTier = (score) => {
				if (score >= 36) return 'High';
				if (score >= 26) return 'Medium';
				return 'Watch';
			};

			const renderGemList = (items) => {
				if (!el.gemList) return;
				const gems = items
					.filter((row) => row.gemScore >= 26 && (row.dueDays === null || row.dueDays >= 0))
					.slice(0, 12);
				if (!gems.length) {
					el.gemList.innerHTML = '<li class="opp-subcopy">No current gems under this filter set.</li>';
					return;
				}

				el.gemList.innerHTML = gems
					.map((row) => {
						const days = row.dueDays === null ? 'No due date' : row.dueDays < 0 ? 'Past due' : `${row.dueDays}d`;
						const link = row.uiLink
							? `<a href="${escapeHtml(row.uiLink)}" target="_blank" rel="noreferrer">${escapeHtml(row.title)}</a>`
							: escapeHtml(row.title);
						return `<li><span class="opp-gem-tier opp-gem-tier-${gemTier(row.gemScore).toLowerCase()}">${gemTier(row.gemScore)}</span>${link}<span class="opp-gem-meta">${escapeHtml(String(row.responseDecision || 'Watch / qualify'))} (${Math.round(Number(row.responseWorthinessScore || 0))}) · event ${Math.round(Number(row.eventLeverageScore || 0))} · gov POC ${Math.round(Number(row.governmentPocCount || 0))} · ${days}</span></li>`;
					})
					.join('');
			};

			const compareText = (a, b) => String(a ?? '').localeCompare(String(b ?? ''), undefined, { sensitivity: 'base' });
			const compareNum = (a, b, nullValue = Number.POSITIVE_INFINITY) => (a ?? nullValue) - (b ?? nullValue);

			const compareTableRows = (a, b) => {
				let base = 0;
				switch (tableState.sortKey) {
					case 'weight':
						base = compareNum(Number(a.weight || 0), Number(b.weight || 0), 0);
						break;
					case 'dueDate':
						base = compareNum(a.dueEpoch, b.dueEpoch, Number.POSITIVE_INFINITY);
						break;
					case 'dueDays':
						base = compareNum(a.dueDays, b.dueDays, Number.POSITIVE_INFINITY);
						break;
					case 'postedDays':
						base = compareNum(a.postedDays, b.postedDays, Number.POSITIVE_INFINITY);
						break;
					case 'detailLen':
						base = compareNum(Number(a.intelDepthScore || 0), Number(b.intelDepthScore || 0), 0);
						break;
					case 'files':
						base = compareNum(Number(a.resourceCount || 0), Number(b.resourceCount || 0), 0);
						break;
					case 'awardSignal':
						base = compareNum(Number(a.awardSignalCount || 0), Number(b.awardSignalCount || 0), 0);
						break;
					case 'crossData':
						base = compareNum(Number(a.corroborationScore || 0), Number(b.corroborationScore || 0), 0);
						break;
					case 'noticeType':
						base = compareText(a.noticeType, b.noticeType);
						break;
					case 'title':
						base = compareText(a.title, b.title);
						break;
					case 'solicitationNumber':
						base = compareText(a.solicitationNumber, b.solicitationNumber);
						break;
					case 'client':
						base = compareText(a.clientLabel, b.clientLabel);
						break;
					case 'agency':
						base = compareText(a.agencyLabel, b.agencyLabel);
						break;
					case 'workType':
						base = compareText(a.workTypeLabel, b.workTypeLabel);
						break;
					case 'naics':
						base = compareText(a.naicsCode, b.naicsCode);
						break;
					case 'mappedEvents':
						base = compareNum(Number(a.eventCount || 0), Number(b.eventCount || 0), 0);
						break;
					case 'gemScore':
					default:
						base = compareNum(Number(a.gemScore || 0), Number(b.gemScore || 0), 0);
						break;
				}
				if (base === 0) base = compareText(a.title, b.title);
				return tableState.sortDir === 'asc' ? base : -base;
			};

			const getPagedRows = (items) => {
				const sorted = [...items].sort(compareTableRows);
				const totalRows = sorted.length;
				const totalPages = Math.max(1, Math.ceil(totalRows / tableState.pageSize));
				tableState.page = Math.min(Math.max(1, tableState.page), totalPages);
				const start = (tableState.page - 1) * tableState.pageSize;
				return {
					rows: sorted.slice(start, start + tableState.pageSize),
					totalRows,
					totalPages,
				};
			};

			const updateTableSortIndicators = () => {
				for (const btn of el.sortButtons || []) {
					const active = btn.dataset.sort === tableState.sortKey;
					btn.classList.toggle('is-active', active);
					btn.dataset.dir = active ? tableState.sortDir : '';
				}
			};

			const activeFilterCount = () => {
				let count = 0;
				if (state.search) count += 1;
				if (state.type !== 'all') count += 1;
				if (state.branch !== 'all') count += 1;
				if (state.client !== 'all') count += 1;
				if (state.work !== 'all') count += 1;
				if (state.due !== 'all') count += 1;
				if (state.minWeight > 0) count += 1;
				if (state.intel !== 'all') count += 1;
				if (state.confidence !== 'all') count += 1;
				if (state.thirdParty !== 'all') count += 1;
				if (state.fpds !== 'all') count += 1;
				if (state.decision !== 'all') count += 1;
				if (state.sort !== 'gem') count += 1;
				if (state.focusOnly) count += 1;
				if (state.fastMode) count += 1;
				if (state.naicsFilter) count += 1;
				return count;
			};

			const renderTable = (items, activeCount = 0) => {
				if (!el.body) return;
				if (!items.length) {
					el.body.innerHTML = `<tr><td colspan="20" class="opp-empty">No opportunities match your current filters.<br><span class="opp-empty-sub">${activeCount > 0 ? `${activeCount} filter${activeCount === 1 ? '' : 's'} active.` : 'No additional filters are active.'} Try broadening filters or clearing all.</span><br><button type="button" class="opp-empty-reset" data-opp-empty-reset>Clear filters</button></td></tr>`;
					el.body.querySelector('[data-opp-empty-reset]')?.addEventListener('click', () => el.reset?.click());
					return;
				}

				if (state.source === 'sbir') {
					el.body.innerHTML = items
						.map((row, idx) => {
							const status = String(row.sbirStatus || row.noticeType || 'Unknown');
							const program = String(row.sbirProgram || row.noticeType || 'SBIR/STTR');
							const qaCount = Number(row.sbirQuestionCount ?? row.usaspendingMatchCount ?? 0);
							const tech = Array.isArray(row.sbirTechnologyAreas) ? row.sbirTechnologyAreas.slice(0, 4) : [];
							const focus = Array.isArray(row.sbirFocusAreas) ? row.sbirFocusAreas.slice(0, 4) : [];
							const tags = [
								`<span class="opp-pill">${escapeHtml(row.branches?.[0] || 'Component unknown')}</span>`,
								`<span class="opp-pill">${escapeHtml(program)}</span>`,
								`<span class="opp-pill">${escapeHtml(status)}</span>`,
								`<span class="opp-pill">Q&A ${qaCount}</span>`,
							].join('');
							const techLine = tech.length ? `<div class="opp-sbir-line"><strong>Tech:</strong> ${escapeHtml(tech.join(', '))}</div>` : '';
							const focusLine = focus.length ? `<div class="opp-sbir-line"><strong>Focus:</strong> ${escapeHtml(focus.join(', '))}</div>` : '';
							const kw = String(row.sbirKeywords || '').trim();
							const kwLine = kw ? `<div class="opp-sbir-line"><strong>Keywords:</strong> ${escapeHtml(kw)}</div>` : '';
							const title = row.uiLink
								? `<a class="opp-title-link" href="${escapeHtml(row.uiLink)}" target="_blank" rel="noreferrer">${escapeHtml(row.title)}</a>`
								: `<span class="opp-title-text">${escapeHtml(row.title)}</span>`;
							return `<tr class="opp-sbir-row"><td colspan="20"><div class="opp-sbir-card"><div class="opp-sbir-head"><button class="opp-intel-open" type="button" data-row-idx="${idx}">Open</button>${title}</div><div class="opp-pill-wrap">${tags}</div>${techLine}${focusLine}${kwLine}</div></td></tr>`;
						})
						.join('');
					for (const button of el.body.querySelectorAll('.opp-intel-open')) {
						button.addEventListener('click', () => {
							const idx = Number(button.getAttribute('data-row-idx') || -1);
							if (idx < 0 || idx >= items.length) return;
							openIntelModal(items[idx], button);
						});
					}
					return;
				}
				if (state.source === 'sbir') {
					el.body.innerHTML = items
						.map((row, idx) => {
							const qaCount = Number(row.sbirQuestionCount || 0);
							const tech = Array.isArray(row.sbirTechnologyAreas) ? row.sbirTechnologyAreas : [];
							const focus = Array.isArray(row.sbirFocusAreas) ? row.sbirFocusAreas : [];
							const tags = [
								row.clientLabel ? `<span class="opp-pill">${escapeHtml(String(row.clientLabel))}</span>` : '',
								row.sbirProgram ? `<span class="opp-pill">${escapeHtml(String(row.sbirProgram))}</span>` : '',
								row.sbirStatus ? `<span class="opp-pill">${escapeHtml(String(row.sbirStatus))}</span>` : '',
								`<span class="opp-pill">Q&A ${qaCount}</span>`,
							]
								.filter(Boolean)
								.join('');
							const meta = [
								tech.length ? `Tech: ${escapeHtml(tech.slice(0, 5).join(', '))}` : '',
								focus.length ? `Focus: ${escapeHtml(focus.slice(0, 5).join(', '))}` : '',
								row.sbirKeywords ? `Keywords: ${escapeHtml(String(row.sbirKeywords).slice(0, 220))}` : '',
							]
								.filter(Boolean)
								.join(' · ');
							const title = row.uiLink
								? `<a class="opp-title-link" href="${escapeHtml(row.uiLink)}" target="_blank" rel="noreferrer">${escapeHtml(row.title)}</a>`
								: `<span class="opp-title-text">${escapeHtml(row.title)}</span>`;
							return `<tr class="opp-sbir-row"><td colspan="20" data-col="sbir-card"><div class="opp-sbir-card"><div class="opp-sbir-card-head"><button class="opp-intel-open" type="button" data-row-idx="${idx}">Open</button><div>${title}<div class="opp-pill-wrap">${tags}</div></div></div><p class="opp-sbir-meta">${meta || 'No additional SBIR topic metadata captured.'}</p></div></td></tr>`;
						})
						.join('');
					for (const button of el.body.querySelectorAll('.opp-intel-open')) {
						button.addEventListener('click', () => {
							const idx = Number(button.getAttribute('data-row-idx') || -1);
							if (idx < 0 || idx >= items.length) return;
							openIntelModal(items[idx], button);
						});
					}
					return;
				}

				const metric = (value) => (Number(value || 0) > 0 ? String(Math.round(Number(value || 0))) : '·');
				el.body.innerHTML = items
					.map((row, idx) => {
						const days = row.dueDays === null ? '—' : String(row.dueDays);
						const daysSinceRelease = row.postedDays === null ? '—' : String(row.postedDays);
						const intelDepth = metric(row.intelDepthScore);
						const files = metric(row.resourceCount);
						const awards = metric(row.awardSignalCount);
						const usCount = metric(row.usaspendingMatchCount);
						const corrobScore = Number(row.corroborationScore || 0);
						const corrobLevel = String(row.corroborationLevel || 'None');
						const confidence = Number(row.confidenceScore || 0);
						const confidenceLevel = String(row.confidenceLevel || 'Low');
						const corrobClass =
							corrobLevel
								.toLowerCase()
								.replace(/[^a-z0-9]+/g, '-')
								.replace(/^-+|-+$/g, '') || 'none';
						const confidenceClass =
							confidenceLevel
								.toLowerCase()
								.replace(/[^a-z0-9]+/g, '-')
								.replace(/^-+|-+$/g, '') || 'low';
						const corrob = `<span class="opp-corroboration-chip opp-corroboration-${escapeHtml(corrobClass)}" title="Cross-data score ${Math.round(corrobScore)}">${escapeHtml(corrobLevel)} · ${Math.round(corrobScore)}</span>`;
						const due = fmtDate(row.responseDueDate);
						const timingDue = row.dueDays === null ? 'D:—' : row.dueDays < 0 ? `D:${row.dueDays}` : `D:+${row.dueDays}`;
						const timingPosted = row.postedDays === null ? 'P:—' : `P:+${row.postedDays}`;
						const timing = `<span class="opp-signal-stack"><span>${timingDue}</span><span>${timingPosted}</span></span>`;
						const signalBadges = [];
						if (row.decisionClass === 'pursue')
							signalBadges.push(
								'<span class="opp-signal-badge opp-signal-badge-pursue" title="Recommended immediate qualification and response path">Pursue</span>',
							);
						else if (row.decisionClass === 'watch')
							signalBadges.push(
								'<span class="opp-signal-badge opp-signal-badge-watch" title="Worth qualification or monitoring before bid/no-bid">Watch</span>',
							);
						else
							signalBadges.push(
								'<span class="opp-signal-badge opp-signal-badge-skip" title="Low current return signal">Skip</span>',
							);
						if (Number(row.governmentPocCount || 0) > 0)
							signalBadges.push(
								`<span class="opp-signal-badge opp-signal-badge-govpoc" title="Government points of contact published across mapped events">Gov POC ${Number(row.governmentPocCount || 0)}</span>`,
							);
						if (row.usaspendingError)
							signalBadges.push(
								'<span class="opp-signal-badge opp-signal-badge-error" title="USAspending fetch error on latest check">3P error</span>',
							);
						else if (Number(row.usaspendingMatchCount || 0) > 0 && row.usaspendingAgeDays !== null) {
							if (Number(row.usaspendingAgeDays || 0) <= 3)
								signalBadges.push(
									'<span class="opp-signal-badge opp-signal-badge-fresh" title="USAspending corroboration checked in last 3 days">Fresh</span>',
								);
							else if (Number(row.usaspendingAgeDays || 0) > 14)
								signalBadges.push(
									`<span class="opp-signal-badge opp-signal-badge-stale" title="USAspending corroboration older than 14 days">Stale ${Number(row.usaspendingAgeDays || 0)}d</span>`,
								);
						}
						if (Number(row.fpdsAlignmentScore || 0) >= 70)
							signalBadges.push(
								'<span class="opp-signal-badge opp-signal-badge-fpds-high" title="High identifier continuity (FPDS-aligned)">FPDS High</span>',
							);
						else if (Number(row.fpdsAlignmentScore || 0) >= 45)
							signalBadges.push(
								'<span class="opp-signal-badge opp-signal-badge-fpds" title="Medium identifier continuity (FPDS-aligned)">FPDS Med</span>',
							);
						if (
							String(row.usaspendingQueryType || '').includes('fallback') &&
							Number(row.usaspendingMatchCount || 0) > 0
						) {
							signalBadges.push(
								'<span class="opp-signal-badge opp-signal-badge-fallback" title="USAspending corroboration used fallback keyword path">Fallback</span>',
							);
						}
						const badgeLine = signalBadges.length
							? `<span class="opp-signal-badge-line">${signalBadges.join('')}</span>`
							: '';
						const signals = `<span class="opp-signal-stack"><span>I${intelDepth} F${files} A${awards} U${usCount}</span><span>C${Math.round(corrobScore)} Cf${confidence}</span><span>Resp${Math.round(Number(row.responseWorthinessScore || 0))} Ev${Math.round(Number(row.eventLeverageScore || 0))}</span>${badgeLine}</span>`;
						const title = row.uiLink
							? `<a class="opp-title-link" href="${escapeHtml(row.uiLink)}" target="_blank" rel="noreferrer">${escapeHtml(row.title)}</a>`
							: `<span class="opp-title-text">${escapeHtml(row.title)}</span>`;
						const mappedRefs = Array.isArray(row.eventRefs) ? row.eventRefs : [];
						const mapped =
							mappedRefs
								.slice(0, 2)
								.map((ref) => {
									const href = contextualEventHref(
										String(ref.href || `/events/#${encodeURIComponent(String(ref.id || ''))}`),
										row,
									);
									const branch = String(ref.branch || '').trim();
									const when = fmtDate(ref.startDate || null);
									const titleText = String(ref.title || 'Mapped event');
									const shortLabel = `${branch ? `${branch} · ` : ''}${titleText}`;
									const fullTitle = `${titleText}${branch ? `\nBranch: ${branch}` : ''}${when !== '—' ? `\nStarts: ${when}` : ''}${ref.status ? `\nStatus: ${ref.status}` : ''}`;
									return `<a class="opp-pill opp-pill-link" href="${escapeHtml(href)}" title="${escapeHtml(fullTitle)}">${escapeHtml(shortLabel)}</a>`;
								})
								.join('') + (mappedRefs.length > 2 ? `<span class="opp-pill">+${mappedRefs.length - 2}</span>` : '');
						return `<tr>
						<td data-col="view" class="opp-num"><button class="opp-intel-open" type="button" data-row-idx="${idx}">Open</button></td>
						<td data-col="gem" class="opp-num"><span class="opp-gem-chip">${Math.round(row.gemScore)}</span></td>
						<td data-col="weight" class="opp-num">${row.weight}</td>
						<td data-col="due" class="opp-date ${dueClass(row)}">${due}</td>
						<td data-col="timing" class="opp-num">${timing}</td>
						<td data-col="days" class="opp-num">${days}</td>
						<td data-col="posted" class="opp-num">${daysSinceRelease}</td>
						<td data-col="intel" class="opp-num">${intelDepth}</td>
						<td data-col="files" class="opp-num">${files}</td>
						<td data-col="awards" class="opp-num">${awards}</td>
						<td data-col="corrob" class="opp-num">${corrob}</td>
						<td data-col="signals" class="opp-num" title="Confidence ${confidenceLevel}"><span class="opp-confidence-chip opp-confidence-${escapeHtml(confidenceClass)}">${signals}</span></td>
						<td data-col="notice" class="opp-cell-truncate">${escapeHtml(row.noticeType || '—')}</td>
						<td data-col="title" class="opp-cell-title">${title}</td>
						<td data-col="sol" class="opp-cell-truncate">${escapeHtml(row.solicitationNumber || '—')}</td>
						<td data-col="client" class="opp-cell-truncate" title="${escapeHtml(row.clientLabel || '')}">${escapeHtml(row.clientLabel || 'Unknown')}</td>
						<td data-col="agency" class="opp-cell-truncate" title="${escapeHtml(row.agencyPath || '')}">${escapeHtml(row.agencyLabel)}</td>
						<td data-col="work" class="opp-cell-truncate" title="${escapeHtml((row.workTypes || []).map((key) => workTypeLabel[key] || key).join(', '))}">${escapeHtml(row.workTypeLabel || 'General/Other')}</td>
						<td data-col="naics" class="opp-num">${escapeHtml(row.naicsCode || '—')}</td>
						<td data-col="events"><div class="opp-pill-wrap">${mapped || '—'}</div></td>
					</tr>`;
					})
					.join('');

				for (const button of el.body.querySelectorAll('.opp-intel-open')) {
					button.addEventListener('click', () => {
						const idx = Number(button.getAttribute('data-row-idx') || -1);
						if (idx < 0 || idx >= items.length) return;
						openIntelModal(items[idx], button);
					});
				}
			};

			const render = () => {
				updateStateFromInputs();
				applySourceChrome();
				const filtered = filterRows();
				const gems = filtered.filter((row) => row.gemScore >= 26 && (row.dueDays === null || row.dueDays >= 0));
				const deepCount = filtered.filter((row) => Number(row.detailTextLength || 0) > 0).length;
				const fileCount = filtered.filter((row) => Number(row.resourceCount || 0) > 0).length;
				const awardCount = filtered.filter((row) => Number(row.awardSignalCount || 0) > 0).length;
				const corroboratedCount = filtered.filter((row) => Number(row.corroborationScore || 0) >= 70).length;
				const confidenceCount = filtered.filter((row) => Number(row.confidenceScore || 0) >= 70).length;
				const pursueCount = filtered.filter((row) => String(row.decisionClass || '') === 'pursue').length;
				const govPocCount = filtered.filter((row) => Number(row.governmentPocCount || 0) > 0).length;
				const thirdPartyErrorCount = filtered.filter((row) => String(row.usaspendingError || '').trim()).length;
				const exactCount = filtered.filter(
					(row) =>
						String(row.usaspendingQueryType || '').includes('solicitation') &&
						Number(row.usaspendingMatchCount || 0) > 0,
				).length;
				const fallbackCount = filtered.filter(
					(row) =>
						String(row.usaspendingQueryType || '').includes('fallback') && Number(row.usaspendingMatchCount || 0) > 0,
				).length;
				const freshCount = filtered.filter(
					(row) => Number(row.usaspendingMatchCount || 0) > 0 && Number(row.usaspendingAgeDays || 0) <= 3,
				).length;
				const fpdsCount = filtered.filter((row) => Number(row.fpdsAlignmentScore || 0) >= 45).length;
				const { rows: pagedRows, totalRows, totalPages } = getPagedRows(filtered);

				if (el.total) el.total.textContent = String(rows.length);
				if (el.displayed) el.displayed.textContent = String(filtered.length);
				if (el.gems) el.gems.textContent = String(gems.length);
				if (el.deep) el.deep.textContent = String(deepCount);
				if (el.files) el.files.textContent = String(fileCount);
				if (el.awards) el.awards.textContent = String(awardCount);
				if (el.corroborated) el.corroborated.textContent = String(corroboratedCount);
				if (el.confidenceKpi) el.confidenceKpi.textContent = String(confidenceCount);
				if (el.pursueKpi) el.pursueKpi.textContent = String(pursueCount);
				if (el.govPocKpi) el.govPocKpi.textContent = String(govPocCount);
				if (el.thirdPartyErrorsKpi) el.thirdPartyErrorsKpi.textContent = String(thirdPartyErrorCount);
				if (el.exactKpi) el.exactKpi.textContent = String(exactCount);
				if (el.fallbackKpi) el.fallbackKpi.textContent = String(fallbackCount);
				if (el.freshKpi) el.freshKpi.textContent = String(freshCount);
				if (el.fpdsKpi) el.fpdsKpi.textContent = String(fpdsCount);
				if (state.source === 'sbir') {
					const openCount = filtered.filter((row) => String(row.sbirStatus || '').toLowerCase().includes('open')).length;
					const withQaCount = filtered.filter((row) => Number(row.sbirQuestionCount || 0) > 0).length;
					const totalQa = filtered.reduce((acc, row) => acc + Number(row.sbirQuestionCount || 0), 0);
					const componentCount = new Set(filtered.map((row) => String(row.branches?.[0] || '').trim()).filter(Boolean)).size;
					const programCount = new Set(filtered.map((row) => String(row.sbirProgram || '').trim()).filter(Boolean)).size;
					const techAreas = filtered.reduce((acc, row) => acc + (Array.isArray(row.sbirTechnologyAreas) ? row.sbirTechnologyAreas.length : 0), 0);
					const focusAreas = filtered.reduce((acc, row) => acc + (Array.isArray(row.sbirFocusAreas) ? row.sbirFocusAreas.length : 0), 0);
					if (el.sbirTopicsKpi) el.sbirTopicsKpi.textContent = String(filtered.length);
					if (el.sbirOpenKpi) el.sbirOpenKpi.textContent = String(openCount);
					if (el.sbirWithQaKpi) el.sbirWithQaKpi.textContent = String(withQaCount);
					if (el.sbirTotalQaKpi) el.sbirTotalQaKpi.textContent = String(totalQa);
					if (el.sbirComponentsKpi) el.sbirComponentsKpi.textContent = String(componentCount);
					if (el.sbirProgramsKpi) el.sbirProgramsKpi.textContent = String(programCount);
					if (el.sbirTechAreasKpi) el.sbirTechAreasKpi.textContent = String(techAreas);
					if (el.sbirFocusAreasKpi) el.sbirFocusAreasKpi.textContent = String(focusAreas);
				}
				if (el.count)
					el.count.textContent = `${totalRows.toLocaleString()} ${state.source === 'sbir' ? 'topic' : 'row'}${totalRows === 1 ? '' : 's'}`;
				if (el.pageLabel) el.pageLabel.textContent = `Page ${tableState.page} / ${totalPages}`;
				if (el.pageFirst) el.pageFirst.disabled = tableState.page <= 1;
				if (el.pagePrev) el.pagePrev.disabled = tableState.page <= 1;
				if (el.pageNext) el.pageNext.disabled = tableState.page >= totalPages;
				if (el.pageLast) el.pageLast.disabled = tableState.page >= totalPages;
				if (el.chartFilterStatus) {
					const chips = [];
					if (state.client !== 'all') chips.push(state.source === 'sbir' ? `Status: ${state.client}` : `Who: ${state.client}`);
					if (state.work !== 'all') chips.push(`What: ${workTypeLabel[state.work] || state.work}`);
					if (state.source === 'sam') {
						if (state.confidence !== 'all') chips.push(`Confidence: ${state.confidence}`);
						if (state.thirdParty !== 'all') chips.push(`3P: ${state.thirdParty}`);
						if (state.fpds !== 'all') chips.push(`FPDS: ${state.fpds}`);
						if (state.decision !== 'all') chips.push(`Decision: ${state.decision}`);
						if (state.fastMode) chips.push('Fast mode: on');
						if (state.naicsFilter) chips.push(`NAICS: ${state.naicsFilter}`);
					} else {
						if (state.type !== 'all') chips.push(`Program: ${state.type}`);
						if (state.branch !== 'all') chips.push(`Component: ${state.branch}`);
					}
					el.chartFilterStatus.textContent = chips.length ? chips.join(' · ') : '';
				}

				applyTableMode();
				updateTableSortIndicators();
				renderGemList(filtered);
				renderVisuals(filtered);
				renderInsights(filtered);
				renderDatasetDelta();
				renderTable(pagedRows, activeFilterCount());
			};

			const renderFromFilterInput = () => {
				tableState.page = 1;
				render();
			};

			let searchRenderTimer = null;
			el.search?.addEventListener('input', () => {
				if (searchRenderTimer) clearTimeout(searchRenderTimer);
				searchRenderTimer = setTimeout(() => {
					searchRenderTimer = null;
					renderFromFilterInput();
				}, 120);
			});
			el.search?.addEventListener('change', renderFromFilterInput);

			[
				el.type,
				el.branch,
				el.client,
				el.work,
				el.due,
				el.intel,
				el.confidenceFilter,
				el.thirdParty,
				el.fpds,
				el.decision,
				el.sort,
			].forEach((node) => node?.addEventListener('change', renderFromFilterInput));
			el.weight?.addEventListener('input', renderFromFilterInput);
			[el.focus, el.fastMode].forEach((node) => node?.addEventListener('change', renderFromFilterInput));
			el.source?.addEventListener('change', () => {
				const next = el.source?.value === 'sbir' ? 'sbir' : 'sam';
				const params = new URLSearchParams(window.location.search);
				params.set('source', next);
				window.location.search = params.toString();
			});

			el.pageSize?.addEventListener('change', () => {
				tableState.pageSize = Number(el.pageSize?.value || 50);
				tableState.page = 1;
				render();
			});
			el.tableDensity?.addEventListener('change', () => {
				tableState.mode = el.tableDensity?.value === 'full' ? 'full' : 'compact';
				render();
			});

			el.pageFirst?.addEventListener('click', () => {
				tableState.page = 1;
				render();
			});
			el.pagePrev?.addEventListener('click', () => {
				tableState.page -= 1;
				render();
			});
			el.pageNext?.addEventListener('click', () => {
				tableState.page += 1;
				render();
			});
			el.pageLast?.addEventListener('click', () => {
				tableState.page = Number.MAX_SAFE_INTEGER;
				render();
			});

			for (const btn of el.sortButtons || []) {
				btn.addEventListener('click', () => {
					const key = btn.dataset.sort;
					if (!key) return;
					if (tableState.sortKey === key) {
						tableState.sortDir = tableState.sortDir === 'asc' ? 'desc' : 'asc';
					} else {
						tableState.sortKey = key;
						tableState.sortDir = [
							'noticeType',
							'title',
							'solicitationNumber',
							'client',
							'agency',
							'workType',
							'naics',
						].includes(key)
							? 'asc'
							: 'desc';
					}
					tableState.page = 1;
					render();
				});
			}

			el.reset?.addEventListener('click', () => {
				if (el.search) el.search.value = '';
				if (el.type) el.type.value = 'all';
				if (el.branch) el.branch.value = 'all';
				if (el.client) el.client.value = 'all';
				if (el.work) el.work.value = 'all';
				if (el.due) el.due.value = 'all';
				if (el.weight) el.weight.value = '0';
				if (el.intel) el.intel.value = 'all';
				if (el.confidenceFilter) el.confidenceFilter.value = 'all';
				if (el.thirdParty) el.thirdParty.value = 'all';
				if (el.fpds) el.fpds.value = 'all';
				if (el.decision) el.decision.value = 'all';
				if (el.sort) el.sort.value = 'gem';
				if (el.focus) el.focus.checked = false;
				if (el.fastMode) el.fastMode.checked = false;
				state.naicsFilter = '';
				tableState.page = 1;
				tableState.sortKey = 'gemScore';
				tableState.sortDir = 'desc';
				tableState.mode = 'compact';
				if (el.tableDensity) el.tableDensity.value = 'compact';
				render();
			});

			el.modalClose?.addEventListener('click', closeIntelModal);
			for (const node of el.modalCloseTargets || []) {
				node.addEventListener('click', closeIntelModal);
			}
			document.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape') return;
				if (!el.modal || el.modal.hasAttribute('hidden')) return;
				closeIntelModal();
			});

			const isTypingTarget = (target) => {
				if (!target) return false;
				const tag = String(target.tagName || '').toLowerCase();
				return tag === 'input' || tag === 'textarea' || tag === 'select' || Boolean(target.isContentEditable);
			};

			document.addEventListener('keydown', (event) => {
				if (event.defaultPrevented) return;
				const key = String(event.key || '').toLowerCase();
				const typing = isTypingTarget(event.target);

				if (event.key === '/' && !typing) {
					event.preventDefault();
					el.search?.focus();
					el.search?.select?.();
					return;
				}
				if (typing) return;
				if (el.modal && !el.modal.hasAttribute('hidden')) return;

				if (key === 'f') {
					event.preventDefault();
					if (el.fastMode) el.fastMode.checked = !el.fastMode.checked;
					tableState.page = 1;
					render();
					return;
				}
				if (key === 'g') {
					event.preventDefault();
					if (el.sort) el.sort.value = 'gem';
					tableState.page = 1;
					render();
					return;
				}
				if (key === 'c') {
					event.preventDefault();
					const cycle = ['all', 'high', 'medium', 'low'];
					const current = el.confidenceFilter?.value || 'all';
					const next = cycle[(cycle.indexOf(current) + 1 + cycle.length) % cycle.length];
					if (el.confidenceFilter) el.confidenceFilter.value = next;
					tableState.page = 1;
					render();
					return;
				}
				if (key === 't') {
					event.preventDefault();
					const cycle = ['all', 'ok', 'exact', 'fallback', 'error', 'none'];
					const current = el.thirdParty?.value || 'all';
					const next = cycle[(cycle.indexOf(current) + 1 + cycle.length) % cycle.length];
					if (el.thirdParty) el.thirdParty.value = next;
					tableState.page = 1;
					render();
					return;
				}
				if (key === 'p') {
					event.preventDefault();
					const cycle = ['all', 'medium', 'high', 'none'];
					const current = el.fpds?.value || 'all';
					const next = cycle[(cycle.indexOf(current) + 1 + cycle.length) % cycle.length];
					if (el.fpds) el.fpds.value = next;
					tableState.page = 1;
					render();
					return;
				}
				if (key === 'v') {
					event.preventDefault();
					const cycle = ['all', 'pursue', 'watch', 'skip'];
					const current = el.decision?.value || 'all';
					const next = cycle[(cycle.indexOf(current) + 1 + cycle.length) % cycle.length];
					if (el.decision) el.decision.value = next;
					tableState.page = 1;
					render();
				}
			});

			applyIncomingContext();
			hydrateDatasetFilterOptions();
			applySourceChrome();
			render();
			if (pendingAutoOpenNoticeId) {
				const match = findRowByNoticeId(pendingAutoOpenNoticeId);
				if (match) openIntelModal(match, null);
				pendingAutoOpenNoticeId = '';
			}
		})();
	</script>
</SiteLayout>

