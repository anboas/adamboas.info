---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { withBase } from '../../utils/withBase';
import { radarEventsSeed } from '../../data/radar/events';
import sofweekIntel from '../../data/radar/intel/sofweek-intel.json';
import samOpportunitiesFeed from '../../data/radar/events-candidates-sam-opportunities.json';

type OpportunityRow = {
	key: string;
	noticeId: string | null;
	title: string;
	noticeType: string;
	postedDate: string | null;
	responseDueDate: string | null;
	solicitationNumber: string | null;
	agencyPath: string | null;
	naicsCode: string | null;
	classificationCode: string | null;
	uiLink: string | null;
	detailTextLength: number;
	resourceLinks: Set<string>;
	resourceCount: number;
	weight: number;
	eventIds: Set<string>;
	eventTitles: Set<string>;
	branches: Set<string>;
	capabilityAreas: Set<string>;
	missionThreads: Set<string>;
};

const samIntelOverrides: Record<string, any> = {
	'radar-sofweek-2026': sofweekIntel,
};

function samIntel(event: (typeof radarEventsSeed)[number] | undefined | null) {
	if (!event) return null;
	return samIntelOverrides[event.id] ?? event.ontology.acquisition?.samIntelligence ?? null;
}

function noticeKey(notice: any) {
	const noticeId = String(notice.noticeId ?? '').trim();
	if (noticeId) return `notice:${noticeId.toLowerCase()}`;
	const solicitation = String(notice.solicitationNumber ?? '').trim();
	if (solicitation) return `sol:${solicitation.toLowerCase()}`;
	return `title:${String(notice.title ?? '').trim().toLowerCase()}::${String(notice.noticeType ?? '').trim().toLowerCase()}::${String(notice.postedDate ?? '').trim().toLowerCase()}`;
}

function toArray(set: Set<string>) {
	return [...set].filter(Boolean).sort((a, b) => a.localeCompare(b));
}

const opportunityMap = new Map<string, OpportunityRow>();
let totalRawNotices = 0;
let eventsWithSam = 0;
let samGlobalRawNotices = 0;

for (const event of radarEventsSeed) {
	const sam = samIntel(event);
	const notices = sam?.topNotices ?? [];
	if (!notices.length) continue;
	eventsWithSam += 1;
	totalRawNotices += notices.length;

	for (const notice of notices) {
		const key = noticeKey(notice);
		if (!opportunityMap.has(key)) {
			opportunityMap.set(key, {
				key,
				noticeId: notice.noticeId ?? null,
				title: notice.title ?? 'Untitled notice',
				noticeType: notice.noticeType ?? 'Unknown',
				postedDate: notice.postedDate ?? null,
				responseDueDate: notice.responseDueDate ?? null,
				solicitationNumber: notice.solicitationNumber ?? null,
				agencyPath: notice.agencyPath ?? null,
				naicsCode: notice.naicsCode ?? null,
				classificationCode: notice.classificationCode ?? null,
				uiLink: notice.uiLink ?? null,
				detailTextLength: Number(notice.detailTextLength ?? notice.detail_text_length ?? 0),
				resourceLinks: new Set<string>((notice.resourceLinks ?? notice.resource_links ?? []).filter(Boolean)),
				resourceCount: Number(notice.resourceCount ?? notice.resource_count ?? 0),
				weight: Number(notice.score ?? 0),
				eventIds: new Set<string>(),
				eventTitles: new Set<string>(),
				branches: new Set<string>(),
				capabilityAreas: new Set<string>(),
				missionThreads: new Set<string>(),
			});
		}

		const row = opportunityMap.get(key)!;
		row.weight = Math.max(row.weight, Number(notice.score ?? 0));
		row.noticeId = row.noticeId ?? notice.noticeId ?? null;
		row.postedDate = row.postedDate ?? notice.postedDate ?? null;
		row.responseDueDate = row.responseDueDate ?? notice.responseDueDate ?? null;
		row.solicitationNumber = row.solicitationNumber ?? notice.solicitationNumber ?? null;
		row.agencyPath = row.agencyPath ?? notice.agencyPath ?? null;
		row.naicsCode = row.naicsCode ?? notice.naicsCode ?? null;
		row.classificationCode = row.classificationCode ?? notice.classificationCode ?? null;
		row.uiLink = row.uiLink ?? notice.uiLink ?? null;
		row.detailTextLength = Math.max(row.detailTextLength, Number(notice.detailTextLength ?? notice.detail_text_length ?? 0));
		for (const link of (notice.resourceLinks ?? notice.resource_links ?? [])) {
			if (link) row.resourceLinks.add(String(link));
		}
		row.resourceCount = Math.max(row.resourceCount, Number(notice.resourceCount ?? notice.resource_count ?? row.resourceLinks.size ?? 0), row.resourceLinks.size);
		row.eventIds.add(event.id);
		row.eventTitles.add(event.title);
		row.branches.add(event.branch);
		for (const area of event.ontology.capabilityAreas ?? []) row.capabilityAreas.add(area);
		for (const thread of event.ontology.missionThreads ?? []) row.missionThreads.add(thread);
	}
}

for (const candidate of (samOpportunitiesFeed as any[])) {
	samGlobalRawNotices += 1;
	const notice = {
		noticeId: candidate.notice_id ?? null,
		title: candidate.title ?? 'Untitled notice',
		noticeType: candidate.notice_type ?? 'Unknown',
		postedDate: candidate.posted_date ?? null,
		responseDueDate: candidate.response_deadline ?? null,
		solicitationNumber: candidate.solicitation_number ?? null,
		agencyPath: candidate.agency_path ?? null,
		naicsCode: candidate.naics_code ?? null,
		classificationCode: candidate.classification_code ?? null,
		uiLink: candidate.ui_link ?? candidate.opportunity_url ?? null,
		score: Number(candidate.relevance_score ?? 0),
		detailTextLength: Number(candidate.detail_text_length ?? 0),
		resourceLinks: Array.isArray(candidate.resource_links) ? candidate.resource_links : [],
		resourceCount: Number(candidate.resource_count ?? 0),
	};
	const key = noticeKey(notice);
	if (!opportunityMap.has(key)) {
		opportunityMap.set(key, {
			key,
			noticeId: notice.noticeId,
			title: notice.title,
			noticeType: notice.noticeType,
			postedDate: notice.postedDate,
			responseDueDate: notice.responseDueDate,
			solicitationNumber: notice.solicitationNumber,
			agencyPath: notice.agencyPath,
			naicsCode: notice.naicsCode,
			classificationCode: notice.classificationCode,
			uiLink: notice.uiLink,
			detailTextLength: Number(notice.detailTextLength ?? 0),
			resourceLinks: new Set<string>((notice.resourceLinks ?? []).filter(Boolean)),
			resourceCount: Number(notice.resourceCount ?? 0),
			weight: Number(notice.score ?? 0),
			eventIds: new Set<string>(),
			eventTitles: new Set<string>(),
			branches: new Set<string>(),
			capabilityAreas: new Set<string>(),
			missionThreads: new Set<string>(),
		});
	}
	const row = opportunityMap.get(key)!;
	row.weight = Math.max(row.weight, Number(notice.score ?? 0));
	row.noticeId = row.noticeId ?? notice.noticeId;
	row.postedDate = row.postedDate ?? notice.postedDate;
	row.responseDueDate = row.responseDueDate ?? notice.responseDueDate;
	row.solicitationNumber = row.solicitationNumber ?? notice.solicitationNumber;
	row.agencyPath = row.agencyPath ?? notice.agencyPath;
	row.uiLink = row.uiLink ?? notice.uiLink;
	row.detailTextLength = Math.max(row.detailTextLength, Number(notice.detailTextLength ?? 0));
	for (const link of (notice.resourceLinks ?? [])) {
		if (link) row.resourceLinks.add(String(link));
	}
	row.resourceCount = Math.max(row.resourceCount, Number(notice.resourceCount ?? row.resourceLinks.size), row.resourceLinks.size);
	row.branches.add('SAM Global');
}

const opportunities = [...opportunityMap.values()]
	.map((row) => ({
		key: row.key,
		noticeId: row.noticeId,
		title: row.title,
		noticeType: row.noticeType,
		postedDate: row.postedDate,
		responseDueDate: row.responseDueDate,
		solicitationNumber: row.solicitationNumber,
		agencyPath: row.agencyPath,
		naicsCode: row.naicsCode,
		classificationCode: row.classificationCode,
		uiLink: row.uiLink,
		detailTextLength: row.detailTextLength,
		resourceCount: Math.max(row.resourceCount, row.resourceLinks.size),
		weight: row.weight,
		eventIds: toArray(row.eventIds),
		eventTitles: toArray(row.eventTitles),
		branches: toArray(row.branches),
		capabilityAreas: toArray(row.capabilityAreas),
		missionThreads: toArray(row.missionThreads),
		eventCount: row.eventIds.size,
	}))
	.sort((a, b) => b.weight - a.weight || (a.responseDueDate ?? '').localeCompare(b.responseDueDate ?? '') || a.title.localeCompare(b.title));

const noticeTypes = [...new Set(opportunities.map((o) => o.noticeType).filter(Boolean))].sort((a, b) => a.localeCompare(b));
const branches = [...new Set(opportunities.flatMap((o) => o.branches).filter(Boolean))].sort((a, b) => a.localeCompare(b));

const lastCollectedAt = radarEventsSeed
	.map((event) => samIntel(event)?.collectedAt as string | undefined)
	.filter(Boolean)
	.sort()
	.at(-1) ?? null;

const opportunitiesJson = JSON.stringify(opportunities);
---

<SiteLayout title="Opportunity Intelligence | Adam Boas" description="Opportunity intelligence mirror from cached SAM opportunity pulls and event-enrichment runs.">
	<StickyBrowseBar active="opportunities" />

	<section class="card control-shell p-5">
		<div class="opp-header-row">
			<div>
				<h1 class="section-title">Opportunity Intelligence</h1>
				<p class="mt-3 text-sm text-slate-300">A live mirror of SAM opportunity intelligence, including broad SAM feed ingestion plus event-linked enrichment.</p>
			</div>
			<div class="opp-header-actions">
				<a class="opp-link-btn" href={withBase('/events/')}>Open Events</a>
				{lastCollectedAt ? <span class="opp-fresh">Last collected: {new Date(lastCollectedAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}</span> : null}
			</div>
		</div>

		<div class="opp-kpis mt-4">
			<div class="opp-kpi"><span class="opp-kpi-label">Unique opportunities</span><strong id="opp-kpi-total">{opportunities.length}</strong></div>
			<div class="opp-kpi"><span class="opp-kpi-label">Displayed</span><strong id="opp-kpi-displayed">{opportunities.length}</strong></div>
			<div class="opp-kpi"><span class="opp-kpi-label">Gem candidates</span><strong id="opp-kpi-gems">0</strong></div>
			<div class="opp-kpi"><span class="opp-kpi-label">Events with SAM cache</span><strong>{eventsWithSam}</strong></div>
			<div class="opp-kpi"><span class="opp-kpi-label">With deep text</span><strong id="opp-kpi-deep">0</strong></div>
			<div class="opp-kpi"><span class="opp-kpi-label">With attachments</span><strong id="opp-kpi-files">0</strong></div>
			<div class="opp-kpi"><span class="opp-kpi-label">SAM global feed rows</span><strong>{samGlobalRawNotices}</strong></div>
			<div class="opp-kpi"><span class="opp-kpi-label">Raw notices ingested</span><strong>{totalRawNotices + samGlobalRawNotices}</strong></div>
		</div>
	</section>

	<section class="card control-shell mt-4 p-4">
		<div class="opp-controls-shell">
			<div class="opp-controls-head">
				<h2 class="opp-subtitle">Filter opportunity intelligence</h2>
				<p class="opp-subcopy">Use WHO + WHAT controls to target buyer organizations and capability lanes, then inspect gem candidates.</p>
			</div>
			<div class="opp-controls-grid">
				<label class="opp-field opp-field-search">
					<span>Search</span>
					<input id="opp-filter-search" data-global-search class="opp-input" type="search" placeholder="title, agency, notice id, NAICS, solicitation..." />
				</label>
				<label class="opp-field">
					<span>Notice type</span>
					<select id="opp-filter-type" class="opp-input">
						<option value="all">All</option>
						{noticeTypes.map((type) => <option value={type}>{type}</option>)}
					</select>
				</label>
				<label class="opp-field">
					<span>Branch</span>
					<select id="opp-filter-branch" class="opp-input">
						<option value="all">All</option>
						{branches.map((branch) => <option value={branch}>{branch}</option>)}
					</select>
				</label>
				<label class="opp-field">
					<span>Who (client)</span>
					<select id="opp-filter-client" class="opp-input">
						<option value="all">All</option>
					</select>
				</label>
				<label class="opp-field">
					<span>What (work type)</span>
					<select id="opp-filter-work" class="opp-input">
						<option value="all">All</option>
						<option value="software">Software Delivery</option>
						<option value="cloud">Cloud Infrastructure</option>
						<option value="ai">AI/ML & Autonomy</option>
						<option value="cyber">Cybersecurity</option>
						<option value="data">Data & Analytics</option>
						<option value="engineering">Engineering/SETA</option>
						<option value="hardware">Hardware/Platforms</option>
						<option value="logistics">Logistics/Sustainment</option>
						<option value="training">Training/Exercise</option>
						<option value="services">Professional Services</option>
						<option value="research">R&D/Prototype</option>
						<option value="general">General/Other</option>
					</select>
				</label>
				<label class="opp-field">
					<span>Due window</span>
					<select id="opp-filter-due" class="opp-input">
						<option value="all">All</option>
						<option value="future">Future/today</option>
						<option value="past">Past due</option>
						<option value="0-30">Due in 0-30 days</option>
						<option value="31-90">Due in 31-90 days</option>
						<option value="no-due">No due date</option>
					</select>
				</label>
				<label class="opp-field">
					<span>Min weight</span>
					<input id="opp-filter-weight" class="opp-input" type="number" min="0" max="100" step="1" value="0" />
				</label>
				<label class="opp-field">
					<span>Intel depth</span>
					<select id="opp-filter-intel" class="opp-input">
						<option value="all">All</option>
						<option value="deep">Deep text only</option>
						<option value="attachments">Attachments only</option>
						<option value="both">Deep + attachments</option>
					</select>
				</label>
				<label class="opp-field">
					<span>Sort</span>
					<select id="opp-filter-sort" class="opp-input">
						<option value="gem">Gem score</option>
						<option value="intel">Intel depth</option>
						<option value="client">Client org</option>
						<option value="work">Work type</option>
						<option value="due">Due soonest</option>
						<option value="weight">Highest weight</option>
						<option value="posted">Newest posted</option>
						<option value="title">Title A-Z</option>
					</select>
				</label>
			</div>
			<div class="opp-controls-actions">
				<label class="opp-check">
					<input id="opp-filter-focus" type="checkbox" />
					<span>My focus only (Software/Cloud/AI/Cyber/Data)</span>
				</label>
				<span id="opp-chart-filter-status" class="opp-chart-filter-status" aria-live="polite"></span>
				<button id="opp-filter-reset" class="opp-reset" type="button">Reset filters</button>
			</div>
		</div>
	</section>

	<section class="opp-grid mt-4">
		<article class="card p-4 opp-viz-card opp-viz-card-gems">
			<h2 class="opp-subtitle">Gem picks (ranked)</h2>
			<p class="opp-subcopy">Highest combined score from weight, due urgency, focus fit, and repeat signal across events.</p>
			<ol id="opp-gem-list" class="opp-gem-list"></ol>
		</article>

		<article class="card p-4 opp-viz-card">
			<h2 class="opp-subtitle">Urgency distribution</h2>
			<p class="opp-subcopy">Click a bar to filter by due window.</p>
			<div id="opp-viz-urgency" class="opp-chart"></div>
		</article>

		<article class="card p-4 opp-viz-card">
			<h2 class="opp-subtitle">Notice type mix</h2>
			<p class="opp-subcopy">Click a bar to filter by notice type.</p>
			<div id="opp-viz-types" class="opp-chart"></div>
		</article>

		<article class="card p-4 opp-viz-card">
			<h2 class="opp-subtitle">WHO: target clients</h2>
			<p class="opp-subcopy">Click a bar to focus a buyer organization/client family.</p>
			<div id="opp-viz-agencies" class="opp-chart"></div>
		</article>

		<article class="card p-4 opp-viz-card">
			<h2 class="opp-subtitle">WHAT: work profile mix</h2>
			<p class="opp-subcopy">Click a bar to focus a work type/capability lane.</p>
			<div id="opp-viz-workmix" class="opp-chart"></div>
		</article>

		<article class="card p-4 opp-viz-card">
			<h2 class="opp-subtitle">Top NAICS</h2>
			<p class="opp-subcopy">Click a bar to focus that NAICS code.</p>
			<div id="opp-viz-naics" class="opp-chart"></div>
		</article>

	</section>

	<section class="card control-shell mt-4 p-4">
		<div class="opp-table-head">
			<h2 class="opp-subtitle">Opportunity Table</h2>
			<span id="opp-table-count" class="opp-subcopy">0 rows</span>
		</div>
		<div class="opp-table-controls">
			<label class="opp-table-control">
				<span>Rows</span>
				<select id="opp-table-page-size" class="opp-input opp-input-sm">
					<option value="25">25</option>
					<option value="50" selected>50</option>
					<option value="100">100</option>
				</select>
			</label>
			<div class="opp-table-pager">
				<button id="opp-table-first" class="opp-page-btn" type="button" aria-label="First page">«</button>
				<button id="opp-table-prev" class="opp-page-btn" type="button" aria-label="Previous page">‹</button>
				<span id="opp-table-page" class="opp-page-indicator">Page 1 / 1</span>
				<button id="opp-table-next" class="opp-page-btn" type="button" aria-label="Next page">›</button>
				<button id="opp-table-last" class="opp-page-btn" type="button" aria-label="Last page">»</button>
			</div>
		</div>
		<div class="opp-table-wrap">
			<table class="opp-table">
				<thead>
					<tr>
						<th><button class="opp-sort-btn is-active" data-sort="gemScore" data-dir="desc" type="button">Gem</button></th>
						<th><button class="opp-sort-btn" data-sort="weight" type="button">Weight</button></th>
						<th><button class="opp-sort-btn" data-sort="dueDate" type="button">Due</button></th>
						<th><button class="opp-sort-btn" data-sort="dueDays" type="button">Days</button></th>
						<th><button class="opp-sort-btn" data-sort="postedDays" type="button">Days Since Release</button></th>
						<th><button class="opp-sort-btn" data-sort="detailLen" type="button">Intel depth</button></th>
						<th><button class="opp-sort-btn" data-sort="files" type="button">Files</button></th>
						<th><button class="opp-sort-btn" data-sort="noticeType" type="button">Notice type</button></th>
						<th><button class="opp-sort-btn" data-sort="title" type="button">Solicitation name</button></th>
						<th><button class="opp-sort-btn" data-sort="solicitationNumber" type="button">Solicitation #</button></th>
						<th><button class="opp-sort-btn" data-sort="client" type="button">Client</button></th>
						<th><button class="opp-sort-btn" data-sort="agency" type="button">Agency</button></th>
						<th><button class="opp-sort-btn" data-sort="workType" type="button">Work type</button></th>
						<th><button class="opp-sort-btn" data-sort="naics" type="button">NAICS</button></th>
						<th><button class="opp-sort-btn" data-sort="mappedEvents" type="button">Mapped events</button></th>
					</tr>
				</thead>
				<tbody id="opp-table-body"></tbody>
			</table>
		</div>
	</section>

	<script id="opp-data" type="application/json" set:html={opportunitiesJson}></script>
	<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
	<script is:inline>
		(() => {
			const raw = JSON.parse(document.getElementById('opp-data')?.textContent || '[]');
			const focusTerms = ['software', 'cloud', 'ai', 'machine learning', 'cyber', 'data', 'analytics', 'devsecops', 'zero trust'];

			const el = {
				search: document.getElementById('opp-filter-search'),
				type: document.getElementById('opp-filter-type'),
				branch: document.getElementById('opp-filter-branch'),
				client: document.getElementById('opp-filter-client'),
				work: document.getElementById('opp-filter-work'),
				due: document.getElementById('opp-filter-due'),
				weight: document.getElementById('opp-filter-weight'),
				intel: document.getElementById('opp-filter-intel'),
				sort: document.getElementById('opp-filter-sort'),
				focus: document.getElementById('opp-filter-focus'),
				reset: document.getElementById('opp-filter-reset'),
				chartFilterStatus: document.getElementById('opp-chart-filter-status'),
				total: document.getElementById('opp-kpi-total'),
				displayed: document.getElementById('opp-kpi-displayed'),
				gems: document.getElementById('opp-kpi-gems'),
				deep: document.getElementById('opp-kpi-deep'),
				files: document.getElementById('opp-kpi-files'),
				count: document.getElementById('opp-table-count'),
				body: document.getElementById('opp-table-body'),
				pageSize: document.getElementById('opp-table-page-size'),
				pageLabel: document.getElementById('opp-table-page'),
				pageFirst: document.getElementById('opp-table-first'),
				pagePrev: document.getElementById('opp-table-prev'),
				pageNext: document.getElementById('opp-table-next'),
				pageLast: document.getElementById('opp-table-last'),
				sortButtons: Array.from(document.querySelectorAll('.opp-sort-btn')),
				gemList: document.getElementById('opp-gem-list'),
				urgency: document.getElementById('opp-viz-urgency'),
				types: document.getElementById('opp-viz-types'),
				agencies: document.getElementById('opp-viz-agencies'),
				workmix: document.getElementById('opp-viz-workmix'),
				naics: document.getElementById('opp-viz-naics'),
			};

			const charts = {
				urgency: null,
				types: null,
				agencies: null,
				workmix: null,
				naics: null,
			};
			const chartMode = typeof window.echarts === 'undefined' ? 'fallback' : 'echarts';

			const initChart = (key, node) => {
				if (!node || chartMode !== 'echarts' || typeof window.echarts === 'undefined') return null;
				if (charts[key]) return charts[key];
				const chart = window.echarts.init(node, null, { renderer: 'canvas' });
				charts[key] = chart;
				window.addEventListener('resize', () => chart.resize());
				return chart;
			};

			const dayMs = 86_400_000;
			const now = new Date();
			const todayDay = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());

			const toDayEpoch = (value) => {
				if (!value) return null;
				const d = new Date(value);
				if (Number.isNaN(d.getTime())) return null;
				return Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());
			};

			const daysUntil = (value) => {
				const day = toDayEpoch(value);
				if (day === null) return null;
				return Math.round((day - todayDay) / dayMs);
			};

			const fmtDate = (value) => {
				if (!value) return '—';
				const d = new Date(value);
				if (Number.isNaN(d.getTime())) return '—';
				return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
			};

			const escapeHtml = (value) => String(value ?? '')
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;')
				.replaceAll("'", '&#39;');

			const agencyLabel = (path) => {
				if (!path) return 'Unknown';
				const parts = String(path).split('.').filter(Boolean);
				return parts.slice(0, 4).join(' / ') || path;
			};

			const clientLabel = (path) => {
				if (!path) return 'Unknown';
				const parts = String(path).split('.').filter(Boolean);
				if (parts.length <= 1) return parts[0] || 'Unknown';
				return parts.slice(0, 2).join(' / ');
			};

			const workTypeRules = [
				{ key: 'software', label: 'Software Delivery', terms: ['software', 'application', 'app dev', 'devsecops', 'code', 'platform engineering'] },
				{ key: 'cloud', label: 'Cloud Infrastructure', terms: ['cloud', 'aws', 'azure', 'kubernetes', 'container', 'hosting'] },
				{ key: 'ai', label: 'AI/ML & Autonomy', terms: ['artificial intelligence', 'machine learning', ' ai ', 'autonomy', 'autonomous', 'llm', 'model training'] },
				{ key: 'cyber', label: 'Cybersecurity', terms: ['cyber', 'zero trust', 'rmf', 'iam', 'security', 'soc', 'defensive cyber'] },
				{ key: 'data', label: 'Data & Analytics', terms: ['data', 'analytics', 'bi', 'etl', 'database', 'data lake'] },
				{ key: 'engineering', label: 'Engineering/SETA', terms: ['engineering', 'seta', 'technical assistance', 'systems engineering'] },
				{ key: 'hardware', label: 'Hardware/Platforms', terms: ['hardware', 'sensor', 'payload', 'platform', 'c5isr', 'integration'] },
				{ key: 'logistics', label: 'Logistics/Sustainment', terms: ['logistics', 'sustainment', 'maintenance', 'lifecycle support', 'fielding'] },
				{ key: 'training', label: 'Training/Exercise', terms: ['training', 'exercise', 'instruction', 'courseware', 'simulation'] },
				{ key: 'services', label: 'Professional Services', terms: ['advisory', 'consulting', 'program management', 'support services', 'staff augmentation'] },
				{ key: 'research', label: 'R&D/Prototype', terms: ['research', 'r&d', 'prototype', 'sbir', 'innovation', 'proof of concept'] },
			];
			const workTypeLabel = Object.fromEntries(workTypeRules.map((rule) => [rule.key, rule.label]));
			workTypeLabel.general = 'General/Other';

			const inferWorkTypes = (row, blob) => {
				const normalizedBlob = ` ${String(blob || '').toLowerCase()} `;
				const matched = [];
				for (const rule of workTypeRules) {
					if (rule.terms.some((term) => normalizedBlob.includes(` ${String(term).toLowerCase()} `) || normalizedBlob.includes(String(term).toLowerCase()))) {
						matched.push(rule.key);
					}
				}
				if (!matched.length) return ['general'];
				return [...new Set(matched)].slice(0, 3);
			};

			const rows = raw.map((row) => {
				const dueDays = daysUntil(row.responseDueDate);
				const postedEpoch = toDayEpoch(row.postedDate);
				const dueEpoch = toDayEpoch(row.responseDueDate);
				const agencyLabelText = agencyLabel(row.agencyPath);
				const clientLabelText = clientLabel(row.agencyPath);
				const blob = [
					row.title,
					row.noticeType,
					row.noticeId,
					row.solicitationNumber,
					row.agencyPath,
					agencyLabelText,
					clientLabelText,
					row.naicsCode,
					row.classificationCode,
					...(row.branches || []),
					...(row.capabilityAreas || []),
					...(row.missionThreads || []),
				].join(' ').toLowerCase();
				const workTypes = inferWorkTypes(row, blob);
				const primaryWorkType = workTypes[0] || 'general';

				const focusMatches = focusTerms.reduce((acc, term) => acc + (blob.includes(term) ? 1 : 0), 0);
				const type = String(row.noticeType || '').toLowerCase();
				const detailTextLength = Number(row.detailTextLength || 0);
				const resourceCount = Number(row.resourceCount || 0);
				let intelDepthScore = 0;
				if (detailTextLength > 0) intelDepthScore += Math.min(18, Math.max(2, Math.round(detailTextLength / 1400)));
				if (resourceCount > 0) intelDepthScore += Math.min(10, resourceCount * 2);
				if (detailTextLength >= 12000) intelDepthScore += 4;
				let gemScore = Number(row.weight || 0);

				if (dueDays === null) gemScore += 3;
				else if (dueDays < 0) gemScore -= 12;
				else if (dueDays <= 7) gemScore += 18;
				else if (dueDays <= 21) gemScore += 14;
				else if (dueDays <= 45) gemScore += 10;
				else if (dueDays <= 90) gemScore += 6;
				else gemScore += 2;

				if (type.includes('sources sought')) gemScore += 7;
				if (type.includes('pre') && type.includes('solicitation')) gemScore += 6;
				if (type.includes('special notice')) gemScore += 4;
				if (type.includes('combined synopsis')) gemScore += 4;
				if (focusMatches > 0) gemScore += Math.min(10, focusMatches * 2);
				gemScore += Math.min(8, Number(row.eventCount || 0) * 2);
				gemScore += Math.min(12, intelDepthScore);
				if (row.uiLink) gemScore += 2;

				return {
					...row,
					dueDays,
					postedEpoch,
					dueEpoch,
					postedDays: postedEpoch === null ? null : Math.max(0, Math.round((todayDay - postedEpoch) / dayMs)),
					detailTextLength,
					resourceCount,
					intelDepthScore,
					searchBlob: `${blob} ${workTypes.map((key) => workTypeLabel[key] || key).join(' ').toLowerCase()}`,
					focusMatches,
					gemScore,
					agencyLabel: agencyLabelText,
					clientLabel: clientLabelText,
					workTypes,
					primaryWorkType,
					workTypeLabel: workTypeLabel[primaryWorkType] || workTypeLabel.general,
				};
			});

			const state = {
				search: '',
				type: 'all',
				branch: 'all',
				client: 'all',
				work: 'all',
				due: 'all',
				minWeight: 0,
				intel: 'all',
				sort: 'gem',
				focusOnly: false,
				naicsFilter: '',
			};

			const tableState = {
				sortKey: 'gemScore',
				sortDir: 'desc',
				page: 1,
				pageSize: Number(el.pageSize?.value || 50),
			};

			const updateStateFromInputs = () => {
				state.search = (el.search?.value || '').trim().toLowerCase();
				state.type = el.type?.value || 'all';
				state.branch = el.branch?.value || 'all';
				state.client = el.client?.value || 'all';
				state.work = el.work?.value || 'all';
				state.due = el.due?.value || 'all';
				state.minWeight = Number(el.weight?.value || 0);
				state.intel = el.intel?.value || 'all';
				state.sort = el.sort?.value || 'gem';
				state.focusOnly = Boolean(el.focus?.checked);
			};

			const inDueWindow = (row) => {
				if (state.due === 'all') return true;
				if (state.due === 'future') return row.dueDays !== null && row.dueDays >= 0;
				if (state.due === 'past') return row.dueDays !== null && row.dueDays < 0;
				if (state.due === '0-30') return row.dueDays !== null && row.dueDays >= 0 && row.dueDays <= 30;
				if (state.due === '31-90') return row.dueDays !== null && row.dueDays >= 31 && row.dueDays <= 90;
				if (state.due === 'no-due') return row.dueDays === null;
				return true;
			};

			const intelFilterMatch = (row) => {
				if (state.intel === 'all') return true;
				if (state.intel === 'deep') return Number(row.detailTextLength || 0) > 0;
				if (state.intel === 'attachments') return Number(row.resourceCount || 0) > 0;
				if (state.intel === 'both') return Number(row.detailTextLength || 0) > 0 && Number(row.resourceCount || 0) > 0;
				return true;
			};

			const compareRows = (a, b) => {
				if (state.sort === 'title') return a.title.localeCompare(b.title) || b.gemScore - a.gemScore;
				if (state.sort === 'weight') return b.weight - a.weight || b.gemScore - a.gemScore;
				if (state.sort === 'intel') return (b.intelDepthScore || 0) - (a.intelDepthScore || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'client') return a.clientLabel.localeCompare(b.clientLabel) || b.gemScore - a.gemScore;
				if (state.sort === 'work') return a.workTypeLabel.localeCompare(b.workTypeLabel) || b.gemScore - a.gemScore;
				if (state.sort === 'posted') return (b.postedEpoch || 0) - (a.postedEpoch || 0) || b.gemScore - a.gemScore;
				if (state.sort === 'due') {
					const aDue = a.dueDays === null ? Number.POSITIVE_INFINITY : a.dueDays;
					const bDue = b.dueDays === null ? Number.POSITIVE_INFINITY : b.dueDays;
					return aDue - bDue || b.gemScore - a.gemScore;
				}
				return b.gemScore - a.gemScore || b.weight - a.weight;
			};

			const filterRows = () => rows
				.filter((row) => {
					if (state.search && !row.searchBlob.includes(state.search)) return false;
					if (state.type !== 'all' && row.noticeType !== state.type) return false;
					if (state.branch !== 'all' && !(row.branches || []).includes(state.branch)) return false;
					if (state.client !== 'all' && row.clientLabel !== state.client) return false;
					if (state.work !== 'all' && !(row.workTypes || []).includes(state.work)) return false;
					if (state.naicsFilter && String(row.naicsCode || '') !== String(state.naicsFilter || '')) return false;
					if (!inDueWindow(row)) return false;
					if (!intelFilterMatch(row)) return false;
					if (Number(row.weight || 0) < state.minWeight) return false;
					if (state.focusOnly && row.focusMatches < 1) return false;
					return true;
				})
				.sort(compareRows);

			const countBy = (items, getKey) => {
				const map = new Map();
				for (const item of items) {
					const key = getKey(item);
					if (!key) continue;
					map.set(key, (map.get(key) || 0) + 1);
				}
				return [...map.entries()].sort((a, b) => b[1] - a[1]);
			};

			const hydrateClientFilterOptions = () => {
				if (!el.client) return;
				const counts = countBy(rows, (row) => row.clientLabel);
				for (const [label, count] of counts.slice(0, 80)) {
					const option = document.createElement('option');
					option.value = label;
					option.textContent = `${label} (${count})`;
					el.client.appendChild(option);
				}
			};

			const renderBars = (container, entries, emptyLabel = 'No data', onClick = null) => {
				if (!container) return;
				if (!entries.length) {
					container.innerHTML = `<p class="opp-subcopy">${emptyLabel}</p>`;
					return;
				}
				const top = entries.slice(0, 12);
				const max = Math.max(...top.map(([, value]) => Number(value || 0)), 1);
				container.innerHTML = top.map(([label, value], idx) => {
					const pct = Math.max(4, Math.round((Number(value) / max) * 100));
					const interactiveClass = onClick ? ' is-clickable' : '';
					const interactiveAttrs = onClick ? ' role="button" tabindex="0"' : '';
					return `<div class="opp-bar-row${interactiveClass}" data-idx="${idx}"${interactiveAttrs}><span class="opp-bar-label" title="${escapeHtml(label)}">${escapeHtml(label)}</span><span class="opp-bar-track"><span class="opp-bar-fill" style="width:${pct}%"></span></span><span class="opp-bar-value">${value}</span></div>`;
				}).join('');

				if (onClick) {
					for (const row of container.querySelectorAll('.opp-bar-row.is-clickable')) {
						const trigger = () => {
							const idx = Number(row.dataset.idx || -1);
							if (idx < 0 || idx >= top.length) return;
							onClick(top[idx][0], top[idx][1]);
						};
						row.addEventListener('click', trigger);
						row.addEventListener('keydown', (event) => {
							if (event.key === 'Enter' || event.key === ' ') {
								event.preventDefault();
								trigger();
							}
						});
					}
				}
			};

			const renderVisuals = (items) => {
				const urgency = [
					['Past due', items.filter((r) => r.dueDays !== null && r.dueDays < 0).length],
					['Due 0-14d', items.filter((r) => r.dueDays !== null && r.dueDays >= 0 && r.dueDays <= 14).length],
					['Due 15-30d', items.filter((r) => r.dueDays !== null && r.dueDays >= 15 && r.dueDays <= 30).length],
					['Due 31-60d', items.filter((r) => r.dueDays !== null && r.dueDays >= 31 && r.dueDays <= 60).length],
					['Due 61-120d', items.filter((r) => r.dueDays !== null && r.dueDays >= 61 && r.dueDays <= 120).length],
					['No due date', items.filter((r) => r.dueDays === null).length],
				];

				const urgencyChart = initChart('urgency', el.urgency);
				if (urgencyChart) {
					urgencyChart.setOption({
						animationDuration: 220,
						grid: { top: 8, right: 12, bottom: 16, left: 74 },
						xAxis: { type: 'value', axisLabel: { color: '#94a3b8', fontSize: 10 }, splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } } },
						yAxis: { type: 'category', data: urgency.map(([label]) => label), axisLabel: { color: '#cbd5e1', fontSize: 10 } },
						series: [{ type: 'bar', data: urgency.map(([, value]) => value), itemStyle: { color: '#2dd4bf', borderRadius: [0, 2, 2, 0] }, barWidth: '62%' }],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!urgencyChart.__boundClick) {
						urgencyChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							const map = {
								'Past due': 'past',
								'Due 0-14d': '0-30',
								'Due 15-30d': '0-30',
								'Due 31-60d': '31-90',
								'Due 61-120d': 'all',
								'No due date': 'no-due',
							};
							if (el.due) el.due.value = map[params.name] || 'all';
							tableState.page = 1;
							render();
						});
						urgencyChart.__boundClick = true;
					}
				} else {
					renderBars(el.urgency, urgency, 'No due data', (label, value) => {
						if (Number(value || 0) <= 0) return;
						const map = {
							'Past due': 'past',
							'Due 0-14d': '0-30',
							'Due 15-30d': '0-30',
							'Due 31-60d': '31-90',
							'Due 61-120d': 'all',
							'No due date': 'no-due',
						};
						if (el.due) el.due.value = map[label] || 'all';
						tableState.page = 1;
						render();
					});
				}

				const byType = countBy(items, (r) => r.noticeType);
				const typesChart = initChart('types', el.types);
				if (typesChart) {
					const labels = byType.slice(0, 10).map(([label]) => label);
					const values = byType.slice(0, 10).map(([, value]) => value);
					typesChart.setOption({
						animationDuration: 220,
						grid: { top: 8, right: 12, bottom: 38, left: 36 },
						xAxis: { type: 'category', data: labels, axisLabel: { color: '#cbd5e1', fontSize: 9, rotate: 20 } },
						yAxis: { type: 'value', axisLabel: { color: '#94a3b8', fontSize: 10 }, splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } } },
						series: [{ type: 'bar', data: values, itemStyle: { color: '#14b8a6', borderRadius: [2, 2, 0, 0] }, barMaxWidth: 28 }],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!typesChart.__boundClick) {
						typesChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							if (el.type) el.type.value = params.name || 'all';
							tableState.page = 1;
							render();
						});
						typesChart.__boundClick = true;
					}
				} else {
					renderBars(el.types, byType, 'No notice types', (label, value) => {
						if (Number(value || 0) <= 0) return;
						if (el.type) el.type.value = label || 'all';
						tableState.page = 1;
						render();
					});
				}

				const byClient = countBy(items, (r) => r.clientLabel).slice(0, 12);
				const agencyChart = initChart('agencies', el.agencies);
				if (agencyChart) {
					agencyChart.setOption({
						animationDuration: 220,
						grid: { top: 8, right: 12, bottom: 12, left: 132 },
						xAxis: { type: 'value', axisLabel: { color: '#94a3b8', fontSize: 10 }, splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } } },
						yAxis: { type: 'category', data: byClient.map(([label]) => label), axisLabel: { color: '#cbd5e1', fontSize: 9, overflow: 'truncate', width: 124 } },
						series: [{ type: 'bar', data: byClient.map(([, value]) => value), itemStyle: { color: '#0ea5e9', borderRadius: [0, 2, 2, 0] }, barWidth: '56%' }],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!agencyChart.__boundClick) {
						agencyChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							state.client = state.client === params.name ? 'all' : String(params.name || 'all');
							if (el.client) el.client.value = state.client;
							tableState.page = 1;
							render();
						});
						agencyChart.__boundClick = true;
					}
				} else {
					renderBars(el.agencies, byClient, 'No client orgs', (label, value) => {
						if (Number(value || 0) <= 0) return;
						state.client = state.client === label ? 'all' : String(label || 'all');
						if (el.client) el.client.value = state.client;
						tableState.page = 1;
						render();
					});
				}

				const byWork = countBy(items, (r) => r.primaryWorkType || 'general').slice(0, 12);
				const workChart = initChart('workmix', el.workmix);
				if (workChart) {
					workChart.setOption({
						animationDuration: 220,
						grid: { top: 10, right: 12, bottom: 44, left: 28 },
						xAxis: { type: 'category', data: byWork.map(([key]) => workTypeLabel[key] || key), axisLabel: { color: '#cbd5e1', fontSize: 9, rotate: 22 } },
						yAxis: { type: 'value', axisLabel: { color: '#94a3b8', fontSize: 10 }, splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } } },
						series: [{ type: 'bar', data: byWork.map(([, value]) => value), itemStyle: { color: '#38bdf8', borderRadius: [2, 2, 0, 0] }, barMaxWidth: 28 }],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!workChart.__boundClick) {
						workChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							const key = byWork.find(([ruleKey]) => (workTypeLabel[ruleKey] || ruleKey) === params.name)?.[0] || 'all';
							state.work = state.work === key ? 'all' : key;
							if (el.work) el.work.value = state.work;
							tableState.page = 1;
							render();
						});
						workChart.__boundClick = true;
					}
				} else {
					renderBars(el.workmix, byWork.map(([key, count]) => [workTypeLabel[key] || key, count]), 'No work profile data', (label, value) => {
						if (Number(value || 0) <= 0) return;
						const key = byWork.find(([ruleKey]) => (workTypeLabel[ruleKey] || ruleKey) === label)?.[0] || 'all';
						state.work = state.work === key ? 'all' : key;
						if (el.work) el.work.value = state.work;
						tableState.page = 1;
						render();
					});
				}

				const byNaics = countBy(items, (r) => r.naicsCode || null).slice(0, 10);
				const naicsChart = initChart('naics', el.naics);
				if (naicsChart) {
					naicsChart.setOption({
						animationDuration: 220,
						grid: { top: 10, right: 10, bottom: 38, left: 28 },
						xAxis: { type: 'category', data: byNaics.map(([label]) => label), axisLabel: { color: '#cbd5e1', fontSize: 9, rotate: 18 } },
						yAxis: { type: 'value', axisLabel: { color: '#94a3b8', fontSize: 10 }, splitLine: { lineStyle: { color: 'rgba(71,85,105,0.3)' } } },
						series: [{ type: 'bar', data: byNaics.map(([, value]) => value), itemStyle: { color: '#a78bfa', borderRadius: [2, 2, 0, 0] }, barMaxWidth: 26 }],
						tooltip: { trigger: 'item', formatter: (p) => `${p.name}: ${p.value}` },
					});
					if (!naicsChart.__boundClick) {
						naicsChart.on('click', (params) => {
							if (!params || Number(params.value || 0) <= 0) return;
							state.naicsFilter = state.naicsFilter === String(params.name || '') ? '' : String(params.name || '');
							tableState.page = 1;
							render();
						});
						naicsChart.__boundClick = true;
					}
				} else {
					renderBars(el.naics, byNaics, 'No NAICS tags', (label, value) => {
						if (Number(value || 0) <= 0) return;
						state.naicsFilter = state.naicsFilter === String(label || '') ? '' : String(label || '');
						tableState.page = 1;
						render();
					});
				}
			};

			const dueClass = (row) => {
				if (row.dueDays === null) return '';
				return row.dueDays < 0 ? 'opp-due-past' : 'opp-due-future';
			};

			const gemTier = (score) => {
				if (score >= 36) return 'High';
				if (score >= 26) return 'Medium';
				return 'Watch';
			};

			const renderGemList = (items) => {
				if (!el.gemList) return;
				const gems = items
					.filter((row) => row.gemScore >= 26 && (row.dueDays === null || row.dueDays >= 0))
					.slice(0, 12);
				if (!gems.length) {
					el.gemList.innerHTML = '<li class="opp-subcopy">No current gems under this filter set.</li>';
					return;
				}

				el.gemList.innerHTML = gems.map((row) => {
					const days = row.dueDays === null ? 'No due date' : (row.dueDays < 0 ? 'Past due' : `${row.dueDays}d`);
					const link = row.uiLink ? `<a href="${escapeHtml(row.uiLink)}" target="_blank" rel="noreferrer">${escapeHtml(row.title)}</a>` : escapeHtml(row.title);
					return `<li><span class="opp-gem-tier opp-gem-tier-${gemTier(row.gemScore).toLowerCase()}">${gemTier(row.gemScore)}</span>${link}<span class="opp-gem-meta">gem ${Math.round(row.gemScore)} · weight ${row.weight} · ${days}</span></li>`;
				}).join('');
			};

			const compareText = (a, b) => String(a ?? '').localeCompare(String(b ?? ''), undefined, { sensitivity: 'base' });
			const compareNum = (a, b, nullValue = Number.POSITIVE_INFINITY) => (a ?? nullValue) - (b ?? nullValue);

			const compareTableRows = (a, b) => {
				let base = 0;
				switch (tableState.sortKey) {
					case 'weight':
						base = compareNum(Number(a.weight || 0), Number(b.weight || 0), 0);
						break;
					case 'dueDate':
						base = compareNum(a.dueEpoch, b.dueEpoch, Number.POSITIVE_INFINITY);
						break;
					case 'dueDays':
						base = compareNum(a.dueDays, b.dueDays, Number.POSITIVE_INFINITY);
						break;
					case 'postedDays':
						base = compareNum(a.postedDays, b.postedDays, Number.POSITIVE_INFINITY);
						break;
					case 'detailLen':
						base = compareNum(Number(a.intelDepthScore || 0), Number(b.intelDepthScore || 0), 0);
						break;
					case 'files':
						base = compareNum(Number(a.resourceCount || 0), Number(b.resourceCount || 0), 0);
						break;
					case 'noticeType':
						base = compareText(a.noticeType, b.noticeType);
						break;
					case 'title':
						base = compareText(a.title, b.title);
						break;
					case 'solicitationNumber':
						base = compareText(a.solicitationNumber, b.solicitationNumber);
						break;
					case 'client':
						base = compareText(a.clientLabel, b.clientLabel);
						break;
					case 'agency':
						base = compareText(a.agencyLabel, b.agencyLabel);
						break;
					case 'workType':
						base = compareText(a.workTypeLabel, b.workTypeLabel);
						break;
					case 'naics':
						base = compareText(a.naicsCode, b.naicsCode);
						break;
					case 'mappedEvents':
						base = compareNum(Number(a.eventCount || 0), Number(b.eventCount || 0), 0);
						break;
					case 'gemScore':
					default:
						base = compareNum(Number(a.gemScore || 0), Number(b.gemScore || 0), 0);
						break;
				}
				if (base === 0) base = compareText(a.title, b.title);
				return tableState.sortDir === 'asc' ? base : -base;
			};

			const getPagedRows = (items) => {
				const sorted = [...items].sort(compareTableRows);
				const totalRows = sorted.length;
				const totalPages = Math.max(1, Math.ceil(totalRows / tableState.pageSize));
				tableState.page = Math.min(Math.max(1, tableState.page), totalPages);
				const start = (tableState.page - 1) * tableState.pageSize;
				return {
					rows: sorted.slice(start, start + tableState.pageSize),
					totalRows,
					totalPages,
				};
			};

			const updateTableSortIndicators = () => {
				for (const btn of el.sortButtons || []) {
					const active = btn.dataset.sort === tableState.sortKey;
					btn.classList.toggle('is-active', active);
					btn.dataset.dir = active ? tableState.sortDir : '';
				}
			};

			const renderTable = (items) => {
				if (!el.body) return;
				if (!items.length) {
					el.body.innerHTML = '<tr><td colspan="15" class="opp-empty">No opportunities match your current filters.</td></tr>';
					return;
				}

				el.body.innerHTML = items.map((row) => {
					const days = row.dueDays === null ? '—' : (row.dueDays < 0 ? '-' : String(row.dueDays));
					const daysSinceRelease = row.postedDays === null ? '—' : String(row.postedDays);
					const intelDepth = row.intelDepthScore ? String(Math.round(row.intelDepthScore)) : '—';
					const files = row.resourceCount ? String(row.resourceCount) : '—';
					const due = fmtDate(row.responseDueDate);
					const title = row.uiLink
						? `<a href="${escapeHtml(row.uiLink)}" target="_blank" rel="noreferrer">${escapeHtml(row.title)}</a>`
						: escapeHtml(row.title);
					const mapped = (row.eventTitles || []).slice(0, 2).map((title) => `<span class="opp-pill" title="${escapeHtml(title)}">${escapeHtml(title)}</span>`).join('')
						+ ((row.eventTitles || []).length > 2 ? `<span class="opp-pill">+${(row.eventTitles || []).length - 2}</span>` : '');
					return `<tr>
						<td class="opp-num"><span class="opp-gem-chip">${Math.round(row.gemScore)}</span></td>
						<td class="opp-num">${row.weight}</td>
						<td class="opp-date ${dueClass(row)}">${due}</td>
						<td class="opp-num">${days}</td>
						<td class="opp-num">${daysSinceRelease}</td>
						<td class="opp-num">${intelDepth}</td>
						<td class="opp-num">${files}</td>
						<td>${escapeHtml(row.noticeType || '—')}</td>
						<td>${title}</td>
						<td>${escapeHtml(row.solicitationNumber || '—')}</td>
						<td title="${escapeHtml(row.clientLabel || '')}">${escapeHtml(row.clientLabel || 'Unknown')}</td>
						<td title="${escapeHtml(row.agencyPath || '')}">${escapeHtml(row.agencyLabel)}</td>
						<td title="${escapeHtml((row.workTypes || []).map((key) => workTypeLabel[key] || key).join(', '))}">${escapeHtml(row.workTypeLabel || 'General/Other')}</td>
						<td class="opp-num">${escapeHtml(row.naicsCode || '—')}</td>
						<td><div class="opp-pill-wrap">${mapped || '—'}</div></td>
					</tr>`;
				}).join('');
			};

			const render = () => {
				updateStateFromInputs();
				const filtered = filterRows();
				const gems = filtered.filter((row) => row.gemScore >= 26 && (row.dueDays === null || row.dueDays >= 0));
				const deepCount = filtered.filter((row) => Number(row.detailTextLength || 0) > 0).length;
				const fileCount = filtered.filter((row) => Number(row.resourceCount || 0) > 0).length;
				const { rows: pagedRows, totalRows, totalPages } = getPagedRows(filtered);

				if (el.total) el.total.textContent = String(rows.length);
				if (el.displayed) el.displayed.textContent = String(filtered.length);
				if (el.gems) el.gems.textContent = String(gems.length);
				if (el.deep) el.deep.textContent = String(deepCount);
				if (el.files) el.files.textContent = String(fileCount);
				if (el.count) el.count.textContent = `${totalRows.toLocaleString()} row${totalRows === 1 ? '' : 's'}`;
				if (el.pageLabel) el.pageLabel.textContent = `Page ${tableState.page} / ${totalPages}`;
				if (el.pageFirst) el.pageFirst.disabled = tableState.page <= 1;
				if (el.pagePrev) el.pagePrev.disabled = tableState.page <= 1;
				if (el.pageNext) el.pageNext.disabled = tableState.page >= totalPages;
				if (el.pageLast) el.pageLast.disabled = tableState.page >= totalPages;
				if (el.chartFilterStatus) {
					const chips = [];
					if (state.client !== 'all') chips.push(`Who: ${state.client}`);
					if (state.work !== 'all') chips.push(`What: ${workTypeLabel[state.work] || state.work}`);
					if (state.naicsFilter) chips.push(`NAICS: ${state.naicsFilter}`);
					el.chartFilterStatus.textContent = chips.length ? chips.join(' · ') : '';
				}

				updateTableSortIndicators();
				renderGemList(filtered);
				renderVisuals(filtered);
				renderTable(pagedRows);
			};

			[el.search, el.type, el.branch, el.client, el.work, el.due, el.weight, el.intel, el.sort, el.focus].forEach((node) => node?.addEventListener('input', () => {
				tableState.page = 1;
				render();
			}));

			el.pageSize?.addEventListener('change', () => {
				tableState.pageSize = Number(el.pageSize?.value || 50);
				tableState.page = 1;
				render();
			});

			el.pageFirst?.addEventListener('click', () => {
				tableState.page = 1;
				render();
			});
			el.pagePrev?.addEventListener('click', () => {
				tableState.page -= 1;
				render();
			});
			el.pageNext?.addEventListener('click', () => {
				tableState.page += 1;
				render();
			});
			el.pageLast?.addEventListener('click', () => {
				tableState.page = Number.MAX_SAFE_INTEGER;
				render();
			});

			for (const btn of el.sortButtons || []) {
				btn.addEventListener('click', () => {
					const key = btn.dataset.sort;
					if (!key) return;
					if (tableState.sortKey === key) {
						tableState.sortDir = tableState.sortDir === 'asc' ? 'desc' : 'asc';
					} else {
						tableState.sortKey = key;
						tableState.sortDir = ['noticeType', 'title', 'solicitationNumber', 'client', 'agency', 'workType', 'naics'].includes(key) ? 'asc' : 'desc';
					}
					tableState.page = 1;
					render();
				});
			}

			el.reset?.addEventListener('click', () => {
				if (el.search) el.search.value = '';
				if (el.type) el.type.value = 'all';
				if (el.branch) el.branch.value = 'all';
				if (el.client) el.client.value = 'all';
				if (el.work) el.work.value = 'all';
				if (el.due) el.due.value = 'all';
				if (el.weight) el.weight.value = '0';
				if (el.intel) el.intel.value = 'all';
				if (el.sort) el.sort.value = 'gem';
				if (el.focus) el.focus.checked = false;
				state.naicsFilter = '';
				tableState.page = 1;
				tableState.sortKey = 'gemScore';
				tableState.sortDir = 'desc';
				render();
			});

			hydrateClientFilterOptions();
			render();
		})();
	</script>
</SiteLayout>

