	<script id="opp-data" type="application/json" set:html={opportunitiesJson} />
	<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
	<script is:inline>
		(async () => {
			const rawSam = JSON.parse(document.getElementById('opp-data')?.textContent || '[]');
			const sbirTopicsUrl = 'https://raw.githubusercontent.com/anboas/adamboas-media/main/opportunities/sbir-sttr/latest/topics.json';
			const searchParams = new URLSearchParams(window.location.search);
			const requestedSource = String(searchParams.get('source') || 'sam').toLowerCase();
			let activeSource = requestedSource === 'sbir' ? 'sbir' : 'sam';
			let sbirRawCache = null;

			const normalizeComponent = (value) => {
				const key = String(value || '').trim().toLowerCase();
				if (!key) return 'Unknown';
				if (key.includes('air force') || key === 'daf') return 'Air Force';
				if (key.includes('army')) return 'Army';
				if (key.includes('navy') || key.includes('don')) return 'Navy';
				if (key.includes('space force')) return 'Space Force';
				if (key.includes('darpa')) return 'DARPA';
				if (key.includes('dla')) return 'DLA';
				if (key.includes('osd') || key.includes('osw')) return 'OSD';
				return String(value || 'Unknown').trim() || 'Unknown';
			};
			const stripHtml = (value) => {
				const d = document.createElement('div');
				d.innerHTML = String(value || '');
				return (d.textContent || d.innerText || '').trim();
			};
			const sbirTopicToRaw = (topic) => {
				const topicCode = String(topic?.topicCode || '').trim();
				const topicId = String(topic?.topicId || topicCode || '').trim();
				const title = String(topic?.topicTitle || topicCode || 'SBIR/STTR Topic').trim();
				const component = normalizeComponent(topic?.component);
				const program = String(topic?.program || 'SBIR/STTR').trim();
				const status = String(topic?.topicStatus || '').trim();
				const objective = String(topic?.objective || '').trim();
				const description = String(topic?.description || '').trim();
				const phase1 = String(topic?.phase1Description || '').trim();
				const phase2 = String(topic?.phase2Description || '').trim();
				const phase3 = String(topic?.phase3Description || '').trim();
				const keywords = String(topic?.keywords || '').trim();
				const technologyAreas = Array.isArray(topic?.technologyAreas) ? topic.technologyAreas : [];
				const focusAreas = Array.isArray(topic?.focusAreas) ? topic.focusAreas : [];
				const questions = Array.isArray(topic?.questions) ? topic.questions : [];
				const detailPreview = [
					`Program: ${program}${status ? ` · ${status}` : ''}`,
					objective ? `Objective:\n${stripHtml(objective)}` : '',
					description ? `Description:\n${stripHtml(description)}` : '',
					phase1 ? `Phase I:\n${stripHtml(phase1)}` : '',
					phase2 ? `Phase II:\n${stripHtml(phase2)}` : '',
					phase3 ? `Phase III:\n${stripHtml(phase3)}` : '',
					keywords ? `Keywords: ${keywords}` : '',
					technologyAreas.length ? `Tech areas: ${technologyAreas.join(', ')}` : '',
					focusAreas.length ? `Focus areas: ${focusAreas.join(', ')}` : '',
					questions.length ? `Q&A published: ${questions.length}` : '',
				]
					.filter(Boolean)
					.join('\n\n')
					.trim();
				const references = Array.isArray(topic?.referenceDocuments) ? topic.referenceDocuments : [];
				const resourceItems = references
					.map((ref) => String(ref?.referenceTitle || '').trim())
					.filter(Boolean)
					.map((titleText, idx) => ({
						sourceUrl: '',
						mirrorDownloadUrl: null,
						mirrorBlobPath: null,
						fileName: `${titleText}${references[idx]?.uploadId ? ` (${references[idx].uploadId})` : ''}`,
						fileId: references[idx]?.uploadId ? String(references[idx].uploadId) : null,
						contentType: null,
						sizeBytes: null,
					}));
				return {
					sourceType: 'sbir',
					sbirProgram: program,
					sbirStatus: status || 'Unknown',
					sbirQuestionCount: questions.length,
					sbirTechnologyAreas: technologyAreas,
					sbirFocusAreas: focusAreas,
					sbirKeywords: keywords,
					key: `sbir:${topicId || topicCode}`,
					noticeId: topicCode || topicId,
					title: `${topicCode ? `${topicCode} — ` : ''}${title}`,
					noticeType: `${program} Topic`,
					postedDate: null,
					responseDueDate: null,
					solicitationNumber: String(topic?.solicitationNumber || topic?.releaseNumber || '').trim() || null,
					agencyPath: `DoD.${component}`,
					naicsCode: null,
					classificationCode: null,
					uiLink: topicCode
						? `https://www.dodsbirsttr.mil/topics-app/#/topics/${encodeURIComponent(topicCode)}`
						: 'https://www.dodsbirsttr.mil/topics-app/',
					detailUrl: topic?.topicId
						? `https://www.dodsbirsttr.mil/topics/api/public/topics/${encodeURIComponent(String(topic.topicId))}/details`
						: null,
					detailPreview,
					detailTextLength: detailPreview.length,
					resourceAssets: resourceItems,
					resourceCount: resourceItems.length,
					awardSignalCount: 0,
					awardSignalSampleDate: null,
					usaspendingSignal: null,
					usaspendingMatchCount: 0,
					usaspendingAmount: 0,
					crossDataSignal: { score: 0, level: 'None' },
					corroborationScore: 0,
					corroborationLevel: 'None',
					weight: Math.max(8, Math.min(30, 10 + questions.length * 2 + (status.toLowerCase() === 'open' ? 8 : 0))),
					eventIds: [],
					eventTitles: [],
					eventRefs: [],
					governmentPocRefs: [],
					governmentPocCount: 0,
					branches: [component],
					capabilityAreas: technologyAreas,
					missionThreads: focusAreas,
					eventCount: 0,
				};
			};
			const loadSbirRaw = async () => {
				if (sbirRawCache) return sbirRawCache;
				const resp = await fetch(sbirTopicsUrl, { credentials: 'omit' });
				if (!resp.ok) throw new Error(`SBIR topics fetch failed (${resp.status})`);
				const topics = await resp.json();
				sbirRawCache = Array.isArray(topics) ? topics.map(sbirTopicToRaw) : [];
				return sbirRawCache;
			};
			let raw = rawSam;
			if (activeSource === 'sbir') {
				try {
					raw = await loadSbirRaw();
				} catch (error) {
					console.error(error);
					activeSource = 'sam';
					raw = rawSam;
				}
			}

			const focusTerms = [
				'software',
				'cloud',
				'ai',
				'machine learning',
				'cyber',
				'data',
				'analytics',
				'devsecops',
				'zero trust',
			];

			const el = {
				search: document.getElementById('opp-filter-search'),
				labelType: document.getElementById('opp-label-type'),
				labelBranch: document.getElementById('opp-label-branch'),
				labelClient: document.getElementById('opp-label-client'),
				labelWork: document.getElementById('opp-label-work'),
				source: document.getElementById('opp-filter-source'),
				sourceLinkSam: document.getElementById('opp-source-link-sam'),
				sourceLinkSbir: document.getElementById('opp-source-link-sbir'),
				type: document.getElementById('opp-filter-type'),
				branch: document.getElementById('opp-filter-branch'),
				client: document.getElementById('opp-filter-client'),
				work: document.getElementById('opp-filter-work'),
				due: document.getElementById('opp-filter-due'),
				weight: document.getElementById('opp-filter-weight'),
				intel: document.getElementById('opp-filter-intel'),
				confidenceFilter: document.getElementById('opp-filter-confidence'),
				thirdParty: document.getElementById('opp-filter-third-party'),
				fpds: document.getElementById('opp-filter-fpds'),
				decision: document.getElementById('opp-filter-decision'),
				sort: document.getElementById('opp-filter-sort'),
				focus: document.getElementById('opp-filter-focus'),
				fastMode: document.getElementById('opp-filter-fast'),
				reset: document.getElementById('opp-filter-reset'),
				chartFilterStatus: document.getElementById('opp-chart-filter-status'),
				statusRow: document.getElementById('opp-status-row'),
				total: document.getElementById('opp-kpi-total'),
				sbirTopicsKpi: document.getElementById('opp-kpi-sbir-topics'),
				sbirOpenKpi: document.getElementById('opp-kpi-sbir-open'),
				sbirWithQaKpi: document.getElementById('opp-kpi-sbir-withqa'),
				sbirTotalQaKpi: document.getElementById('opp-kpi-sbir-totalqa'),
				sbirComponentsKpi: document.getElementById('opp-kpi-sbir-components'),
				sbirProgramsKpi: document.getElementById('opp-kpi-sbir-programs'),
				sbirTechAreasKpi: document.getElementById('opp-kpi-sbir-techareas'),
				sbirFocusAreasKpi: document.getElementById('opp-kpi-sbir-focusareas'),
				displayed: document.getElementById('opp-kpi-displayed'),
				gems: document.getElementById('opp-kpi-gems'),
				deep: document.getElementById('opp-kpi-deep'),
				files: document.getElementById('opp-kpi-files'),
				awards: document.getElementById('opp-kpi-awards'),
				corroborated: document.getElementById('opp-kpi-corroborated'),
				confidenceKpi: document.getElementById('opp-kpi-confidence'),
				pursueKpi: document.getElementById('opp-kpi-pursue'),
				govPocKpi: document.getElementById('opp-kpi-govpoc'),
				thirdPartyErrorsKpi: document.getElementById('opp-kpi-third-party-errors'),
				exactKpi: document.getElementById('opp-kpi-exact'),
				fallbackKpi: document.getElementById('opp-kpi-fallback'),
				freshKpi: document.getElementById('opp-kpi-fresh'),
				fpdsKpi: document.getElementById('opp-kpi-fpds'),
				tableTitle: document.getElementById('opp-table-title'),
				count: document.getElementById('opp-table-count'),
				body: document.getElementById('opp-table-body'),
				tableWrap: document.getElementById('opp-table-wrap'),
				tableHead: document.querySelector('#opp-table-wrap thead'),
				pageSize: document.getElementById('opp-table-page-size'),
				tableDensity: document.getElementById('opp-table-density'),
				pageLabel: document.getElementById('opp-table-page'),
				pageFirst: document.getElementById('opp-table-first'),
				pagePrev: document.getElementById('opp-table-prev'),
				pageNext: document.getElementById('opp-table-next'),
				pageLast: document.getElementById('opp-table-last'),
				sortButtons: Array.from(document.querySelectorAll('.opp-sort-btn')),
				gemList: document.getElementById('opp-gem-list'),
				urgency: document.getElementById('opp-viz-urgency'),
				types: document.getElementById('opp-viz-types'),
