	<section class="opp-grid mt-4">
		<article class="card p-4 opp-viz-card opp-viz-card-gems" data-source-only="sam">
			<h2 class="opp-subtitle">Gem picks (ranked)</h2>
			<p class="opp-subcopy">
				Highest combined score from weight, due urgency, focus fit, and repeat signal across events.
			</p>
