---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { experience } from '../../data/resume';
import { withBase } from '../../utils/withBase';
---

<SiteLayout title="Experience | Adam Boas" description="Companies and roles.">
	<h1 class="text-2xl font-semibold text-slate-50">Experience</h1>
	<p class="mt-2 text-slate-300">Companies and roles (concise, no descriptions).</p>

	<div class="mt-8 overflow-hidden rounded-none border border-slate-800">
		<table class="w-full border-collapse text-sm">
			<thead class="bg-slate-950/60">
				<tr>
					<th class="px-4 py-3 text-left font-semibold text-slate-200">Company</th>
					<th class="px-4 py-3 text-left font-semibold text-slate-200">Role</th>
					<th class="px-4 py-3 text-right font-semibold text-slate-200">Period</th>
				</tr>
			</thead>
			<tbody>
				{experience.map((r) => (
					<tr class="border-t border-slate-800">
						<td class="px-4 py-3 text-slate-100">
							<a class="hover:underline" href={withBase(`/experience/${r.slug}/`)}>{r.company}</a>
						</td>
						<td class="px-4 py-3 text-slate-300">{r.title}</td>
						<td class="px-4 py-3 text-right text-slate-400">{r.period}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
</SiteLayout>
