---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StickyBrowseBar from '../../components/StickyBrowseBar.astro';
import { experience } from '../../data/resume';
import { withBase } from '../../utils/withBase';

export async function getStaticPaths() {
	return experience.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props;
---

<SiteLayout title={`Experience | ${r.company}`} description={`${r.title} (${r.period}).`}>
	<StickyBrowseBar active="experience" />
	<article class="card p-8">
		<header class="flex flex-col gap-3">
			<a class="text-sm text-slate-400 hover:text-slate-200" href={withBase('/experience/')}>← Experience</a>
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold text-slate-50">{r.company}</h1>
				<p class="mt-2 text-slate-300">{r.title}</p>
				<p class="mt-2 text-sm text-slate-400">{r.period}</p>
			</div>
		</header>

		<section class="mt-8 border-t border-slate-800 pt-6">
			<h2 class="text-sm font-semibold text-slate-50">Details</h2>
			<p class="mt-2 text-sm text-slate-300">
				This page is intentionally concise right now. If you want, we can add 2–5 bullets per role (scope, tech, outcomes)
				without turning it into a long resume.
			</p>
		</section>
	</article>
</SiteLayout>
