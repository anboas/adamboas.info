---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import globalShortcutsScriptUrl from '../scripts/global-shortcuts.js?url';

import { SITE_DESCRIPTION } from '../consts';

type Props = {
	title: string;
	description?: string;
	canonicalHref?: string;
	image?: string;
};

const { title } = Astro.props;
const description = Astro.props.description ?? SITE_DESCRIPTION;
const canonicalHref = Astro.props.canonicalHref;
const image = Astro.props.image;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} canonicalHref={canonicalHref} image={image} />
	</head>
	<body data-site-base={import.meta.env.BASE_URL || '/'}>
		<Header />
		<main class="site-main mx-auto w-full min-w-0 max-w-7xl flex-1 px-4 pt-3 pb-10 sm:px-6 sm:pt-4">
			<slot />
		</main>
		<Footer />

		<div id="global-shortcuts-overlay" class="shortcuts-overlay" hidden>
			<button type="button" class="shortcuts-backdrop" data-shortcuts-close aria-label="Close keyboard shortcuts"></button>
			<section class="shortcuts-panel card" role="dialog" aria-modal="true" aria-labelledby="shortcuts-title">
				<div class="flex items-start justify-between gap-3 border-b border-slate-800 px-4 py-3">
					<div>
						<h2 id="shortcuts-title" class="text-base font-semibold text-slate-50">Keyboard Shortcuts</h2>
						<p class="mt-1 text-xs text-slate-400">Fast nav and search across the site.</p>
					</div>
					<button type="button" class="shortcut-close-btn" data-shortcuts-close aria-label="Close keyboard shortcuts">×</button>
				</div>
				<div class="grid gap-4 px-4 py-4 text-sm text-slate-200 md:grid-cols-2">
					<section>
						<h3 class="shortcut-group-heading">Global</h3>
						<ul class="mt-2 space-y-2">
							<li><span class="kbd">/</span> focus page search</li>
							<li><span class="kbd">?</span> open/close this panel</li>
							<li><span class="kbd">Esc</span> close panel</li>
						</ul>
					</section>
					<section>
						<h3 class="shortcut-group-heading">Go to</h3>
						<ul class="mt-2 space-y-2">
							<li><span class="kbd">g</span> then <span class="kbd">h</span> Home</li>
							<li><span class="kbd">g</span> then <span class="kbd">w</span> Writing</li>
							<li><span class="kbd">g</span> then <span class="kbd">e</span> Events</li>
							<li><span class="kbd">g</span> then <span class="kbd">o</span> Opportunities</li>
							<li><span class="kbd">g</span> then <span class="kbd">c</span> Changes</li>
						</ul>
					</section>
				</div>
				<div class="border-t border-slate-800 px-4 py-3">
					<div class="flex flex-wrap gap-2 text-xs">
						<button type="button" class="shortcut-nav-btn" data-shortcut-nav="h">Home</button>
						<button type="button" class="shortcut-nav-btn" data-shortcut-nav="w">Writing</button>
						<button type="button" class="shortcut-nav-btn" data-shortcut-nav="e">Events</button>
						<button type="button" class="shortcut-nav-btn" data-shortcut-nav="o">Opportunities</button>
						<button type="button" class="shortcut-nav-btn" data-shortcut-nav="c">Changes</button>
					</div>
				</div>
			</section>
		</div>

		<div id="global-shortcut-leader" class="shortcut-leader-pill" aria-hidden="true">
			Go to: <span class="kbd">h</span> <span class="kbd">w</span> <span class="kbd">e</span> <span class="kbd">o</span> <span class="kbd">c</span>
		</div>
		<button id="global-shortcuts-fab" class="shortcut-fab" type="button" aria-label="Open keyboard shortcuts (?)" aria-controls="global-shortcuts-overlay" aria-haspopup="dialog">?</button>

		<script type="module" src={globalShortcutsScriptUrl}></script>
	</body>
</html>
