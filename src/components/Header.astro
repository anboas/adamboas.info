---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { withBase } from '../utils/withBase';
---

<header class="site-header border-b border-slate-800 bg-slate-950">
	<nav class="container flex items-center justify-between py-2 md:py-3.5" aria-label="Primary navigation">
		<div class="flex items-center gap-3">
			<a href={withBase('/')} class="site-brand text-base font-semibold tracking-tight text-slate-50 hover:text-slate-50">
				{SITE_TITLE}
			</a>
		</div>

		<div class="hidden items-center gap-4 md:flex">
			<div class="flex items-center gap-1.5">
				<span class="text-[10px] uppercase tracking-[0.14em] text-slate-500">Profile</span>
				<HeaderLink href={withBase('/writing/')} aria-keyshortcuts="g w">Writing</HeaderLink>
				<HeaderLink href={withBase('/profile/')} aria-keyshortcuts="g p">Profile</HeaderLink>
			</div>
			<span class="h-5 w-px bg-slate-800" aria-hidden="true"></span>
			<div class="flex items-center gap-1.5">
				<span class="text-[10px] uppercase tracking-[0.14em] text-slate-500">Capability</span>
				<HeaderLink href={withBase('/capabilities/')} aria-keyshortcuts="g c">Capabilities</HeaderLink>
				<HeaderLink href={withBase('/events/')} aria-keyshortcuts="g e">Events</HeaderLink>
				<HeaderLink href={withBase('/opportunities/')} aria-keyshortcuts="g o">Opportunities</HeaderLink>
			</div>
		</div>

		<!-- links moved to footer -->
	</nav>
</header>
