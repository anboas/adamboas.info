---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { withBase } from '../utils/withBase';
---

<header class="border-b border-slate-800 bg-slate-950">
	<nav class="container flex items-center justify-between py-4">
		<div class="flex items-center gap-3">
			<a href={withBase('/')} class="text-base font-semibold tracking-tight text-slate-50 hover:text-slate-50">
				{SITE_TITLE}
			</a>
		</div>

		<div class="hidden items-center gap-1 md:flex">
			<HeaderLink href={withBase('/writing/')}>Writing</HeaderLink>
			<HeaderLink href={withBase('/radar/')}>Radar</HeaderLink>
			<HeaderLink href={withBase('/experience/')}>Experience</HeaderLink>
			<HeaderLink href={withBase('/education/')}>Education</HeaderLink>
		</div>

		<!-- links moved to footer -->
	</nav>
</header>
