---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { withBase } from '../utils/withBase';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const isToolsActive = pathname.startsWith('/events') || pathname.startsWith('/opportunities');
---

<header class="site-header border-b border-slate-800 bg-slate-950">
	<nav class="container flex items-center justify-between py-2 md:py-3.5" aria-label="Primary navigation">
		<div class="flex items-center gap-3">
			<a
				href={withBase('/')}
				class="site-brand text-base font-semibold tracking-tight text-slate-50 hover:text-slate-50"
			>
				{SITE_TITLE}
			</a>
		</div>

		<div class="hidden items-center gap-1.5 md:flex">
			<HeaderLink href={withBase('/writing/')} aria-keyshortcuts="g w">Writing</HeaderLink>
			<HeaderLink href={withBase('/profile/')} aria-keyshortcuts="g p">Profile</HeaderLink>
			<HeaderLink href={withBase('/capabilities/')} aria-keyshortcuts="g c">Capabilities</HeaderLink>

			<details class="group relative">
				<summary
					class:list={[
						'inline-flex h-8 list-none items-center rounded-none border px-2.5 text-sm font-medium cursor-pointer',
						isToolsActive
							? 'border-slate-700 bg-slate-900/90 text-slate-50'
							: 'border-transparent text-slate-300 hover:border-slate-700 hover:bg-slate-900/60 hover:text-slate-50',
					]}
				>
					Tools
					<span class="ml-1 text-xs">▾</span>
				</summary>
				<div class="absolute right-0 z-40 mt-1 w-44 border border-slate-700 bg-slate-950/98 p-1 shadow-xl">
					<a
						class="block rounded-none px-2.5 py-1.5 text-sm text-slate-200 hover:bg-slate-900"
						href={withBase('/events/')}>Events</a
					>
					<a
						class="mt-0.5 block rounded-none px-2.5 py-1.5 text-sm text-slate-200 hover:bg-slate-900"
						href={withBase('/opportunities/')}>Opportunities</a
					>
				</div>
			</details>
		</div>

		<!-- links moved to footer -->
	</nav>
</header>
