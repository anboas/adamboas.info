---
import { withBase } from '../utils/withBase';

type Item = {
	slug?: string;
	type: string;
	title: string;
	description?: string;
	tags?: string[];
	hasAudio?: boolean;
	date?: Date;
};

const { item, showTopicCount = true } = Astro.props as { item: Item; showTopicCount?: boolean };
const href = withBase(`/writing/${item.slug}/`);
const tagCount = item.tags?.length ?? 0;
const dateLabel = item.date
	? item.date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
	: null;
---

<a data-writing-compact-card class="card block overflow-hidden p-4 hover:border-slate-700" href={href}>
	<div class="flex items-center justify-between gap-3">
		<div class="flex items-center gap-2">
			<span
				class={`writing-type-pill writing-type-${item.type} shrink-0 rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-wide`}
			>
				{item.type}
			</span>
			{
				item.hasAudio ? (
					<span
						class="shrink-0 rounded-full border border-emerald-700/70 bg-emerald-950/40 px-1.5 py-0 text-[10px] text-emerald-200"
						title="Audio or podcast available"
						aria-label="Audio available"
					>
						🎧
					</span>
				) : null
			}
		</div>
		{dateLabel ? <span class="shrink-0 text-[11px] text-slate-500">{dateLabel}</span> : null}
	</div>
	<h3 data-writing-card-title class="clamp-2 mt-2 break-words text-sm font-bold leading-snug text-slate-50">
		{item.title}
	</h3>
	{
		item.description ? (
			<p data-writing-card-description class="clamp-3 mt-1.5 break-words text-sm text-slate-300">
				{item.description}
			</p>
		) : null
	}
	{
		showTopicCount && tagCount > 0 ? (
			<p class="mt-1 text-[11px] text-slate-500">
				{tagCount} topic{tagCount === 1 ? '' : 's'}
			</p>
		) : null
	}
</a>
