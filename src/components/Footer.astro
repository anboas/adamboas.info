	<div class="container py-8 text-sm text-slate-400">
		<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
			<p>© {today.getFullYear()} Adam Boas</p>
			<ul class="flex flex-wrap gap-x-2 gap-y-2">
				<li><a class="inline-block px-2 py-1" href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a></li>
				<li><a class="inline-block px-2 py-1" href={`${import.meta.env.BASE_URL}writing/`}>Writing</a></li>
				<li><a class="inline-block px-2 py-1" href={`${import.meta.env.BASE_URL}experience/`}>Experience</a></li>
				<li><a class="inline-block px-2 py-1" href={`${import.meta.env.BASE_URL}education/`}>Education</a></li>
				<li><a class="inline-block px-2 py-1" href="https://github.com/anboas" target="_blank" rel="noreferrer">GitHub</a></li>
				<li><a class="inline-block px-2 py-1" href="mailto:anboas@gmail.com">Email</a></li>
			</ul>
		</div>
