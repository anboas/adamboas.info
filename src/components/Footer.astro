---
import { SITE_BUILD_LABEL, SITE_BUILD_TIME } from '../utils/buildMetadata';

const now = new Date(SITE_BUILD_TIME);
const lastUpdatedLabel = new Intl.DateTimeFormat('en-US', {
	weekday: 'short',
	year: 'numeric',
	month: 'short',
	day: '2-digit',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
	timeZone: 'America/New_York',
	timeZoneName: 'short',
}).format(now);
---

<footer class="site-footer border-t border-slate-800 bg-slate-950">
	<div class="container py-7 text-sm text-slate-400 md:py-8">
		<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
			<div class="space-y-1">
				<p>© {now.getFullYear()} Adam Boas</p>
				<p class="text-xs text-slate-500">
					Build {SITE_BUILD_LABEL} · Generated <time datetime={SITE_BUILD_TIME}>{lastUpdatedLabel}</time>
				</p>
			</div>
			<ul class="flex flex-wrap items-center gap-x-2 gap-y-2">
				<li>
					<a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}sitemap/`}
						>Sitemap</a
					>
				</li>
				<li>
					<a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}changes/`}
						>Changes</a
					>
				</li>
				<li>
					<a
						class="footer-link inline-flex h-8 items-center px-2.5"
						href={`${import.meta.env.BASE_URL}files/adam-boas-resume.pdf`}>Resume</a
					>
				</li>
				<li>
					<a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}contact/`}
						>Contact</a
					>
				</li>
			</ul>
		</div>
	</div>
</footer>
