---
import { SITE_RELEASE_VERSION } from '../consts';

const now = new Date();
const lastUpdatedLabel = new Intl.DateTimeFormat('en-US', {
	weekday: 'short',
	year: 'numeric',
	month: 'short',
	day: '2-digit',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
	timeZone: 'America/New_York',
	timeZoneName: 'short',
}).format(now);
---

<footer class="site-footer border-t border-slate-800 bg-slate-950">
	<div class="container py-7 text-sm text-slate-400 md:py-8">
		<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
			<div class="space-y-1">
				<p>© {now.getFullYear()} Adam Boas</p>
				<p class="text-xs text-slate-500">Version {SITE_RELEASE_VERSION} · Last updated {lastUpdatedLabel}</p>
			</div>
			<ul class="flex flex-wrap items-center gap-x-2 gap-y-2">
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}sitemap/`}>Sitemap</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}changes/`}>Changes</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}capabilities/`}>Capabilities</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}experience/`}>Experience</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}education/`}>Education</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}status/`}>Status</a></li>
				<li>
					<a
						class="footer-link inline-flex h-8 items-center gap-2 px-2.5"
						href="https://github.com/anboas/adamboas.info/actions/workflows/deploy-dev-pages.yml"
						target="_blank"
						rel="noreferrer"
						title="GitHub Actions deploy status"
					>
						<span class="text-xs text-slate-500">Deploy</span>
						<img
							src="https://github.com/anboas/adamboas.info/actions/workflows/deploy-dev-pages.yml/badge.svg?branch=main"
							alt="Deploy status"
							loading="lazy"
							decoding="async"
							class="h-4 w-auto opacity-90"
						/>
					</a>
				</li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}license/`}>License</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href={`${import.meta.env.BASE_URL}contact/`}>Contact</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href="mailto:anboas@gmail.com">Email</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href="https://github.com/anboas" target="_blank" rel="noreferrer">GitHub</a></li>
				<li><a class="footer-link inline-flex h-8 items-center px-2.5" href="https://www.linkedin.com/in/adamnboas/" target="_blank" rel="noreferrer">LinkedIn</a></li>
			</ul>
		</div>
	</div>
</footer>
