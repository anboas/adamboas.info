---
import { allSpeakingTopicTags, speakingEvents, sponsorLabel } from '../data/speaking';

type Props = {
	title?: string;
	showHeader?: boolean;
};

const { title = 'Speaking', showHeader = true } = Astro.props as Props;
---

<section class="card mt-4 p-4 md:mt-5" id="speaking-events" data-speaking-shell>
	{showHeader && (
		<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
			<h2 class="section-title">{title}</h2>
			<p class="text-xs uppercase tracking-wide text-slate-400">By event · topic-tagged</p>
		</div>
	)}

	<div class="mb-4 border border-slate-800 bg-slate-950/40 p-3">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Topic tags</h3>
			<button
				type="button"
				class="rounded-none border border-slate-700 bg-slate-950/60 px-2 py-1 text-[11px] text-slate-300 hover:bg-slate-900"
				data-speaking-clear
			>
				Clear
			</button>
		</div>
		<div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="Filter speaking engagements by topic tag">
			{allSpeakingTopicTags.map((tag) => (
				<button
					type="button"
					class="speaking-tag-btn rounded-full border border-slate-700 px-2 py-0.5 text-[11px] font-medium text-slate-200"
					data-speaking-tag={tag}
					aria-pressed="false"
				>
					{tag}
				</button>
			))}
		</div>
	</div>

	<div class="space-y-3" data-speaking-list>
		{speakingEvents.map((event) => (
			<article class="border border-slate-800 bg-slate-950/40 p-3.5" id={event.slug} data-speaking-item data-speaking-tags={event.topicTags.join('|')}>
				<div class="flex flex-wrap items-start justify-between gap-2">
					<div>
						<p class="text-xs uppercase tracking-wide text-slate-400">{event.eventDateRange}</p>
						<button
							type="button"
							class="mt-1 text-left text-base font-semibold text-slate-100 hover:text-slate-50"
							data-speaking-open
							data-speaking-slug={event.slug}
						>
							{event.title}
						</button>
					</div>
					<a class="text-xs font-semibold text-slate-300 hover:text-slate-100" href={event.eventUrl} target="_blank" rel="noreferrer">{event.eventName} ↗</a>
				</div>

				<p class="mt-2 text-sm text-slate-300">{event.summary}</p>

				<div class="mt-3 flex flex-wrap gap-1.5">
					{event.topicTags.map((tag) => (
						<button
							type="button"
							class="speaking-tag-btn rounded-full border border-slate-700 bg-slate-900/80 px-2 py-0.5 text-[11px] font-medium text-slate-200"
							data-speaking-tag={tag}
							aria-pressed="false"
						>
							{tag}
						</button>
					))}
				</div>
			</article>
		))}
	</div>

	<p class="mt-3 hidden text-xs text-slate-400" data-speaking-empty>No speaking engagements match the selected topic tags.</p>

	<div id="speaking-modal" class="speaking-modal" hidden>
		<button type="button" class="speaking-modal-overlay" data-speaking-close aria-label="Close speaking details"></button>
		<article class="speaking-modal-panel" role="dialog" aria-modal="true" aria-labelledby="speaking-modal-title">
			<div class="speaking-modal-head">
				<p id="speaking-modal-meta" class="speaking-modal-meta"></p>
				<h3 id="speaking-modal-title" class="speaking-modal-title"></h3>
				<button type="button" class="speaking-modal-close" data-speaking-close aria-label="Close">✕</button>
			</div>
			<p id="speaking-modal-summary" class="speaking-modal-summary"></p>
			<div id="speaking-modal-details" class="speaking-modal-details"></div>
		</article>
	</div>

	<script
		type="application/json"
		id="speaking-modal-data"
		set:html={JSON.stringify(
			Object.fromEntries(
				speakingEvents.map((event) => [
					event.slug,
					{
						title: event.title,
						meta: `${event.eventDateRange} · ${event.eventName}`,
						summary: event.summary,
						details: [
							{ label: 'When', value: event.sessionDateTime },
							{ label: 'Stage', value: event.stage },
							event.track ? { label: 'Track', value: event.track } : null,
							{ label: 'Role', value: event.role },
							(event.speakerTitle || event.speakerOrganization)
								? { label: 'Speaker profile', value: [event.speakerTitle, event.speakerOrganization].filter(Boolean).join(', ') }
								: null,
							{ label: 'Sponsorship', value: sponsorLabel(event) },
						].filter(Boolean),
					},
				]),
			),
		)}
	/>

	<script>
		(() => {
			const shell = document.querySelector('[data-speaking-shell]');
			if (!shell) return;

			const activeTags = new Set();
			const list = shell.querySelector('[data-speaking-list]');
			const cards = Array.from(shell.querySelectorAll('[data-speaking-item]'));
			const empty = shell.querySelector('[data-speaking-empty]');
			const clearBtn = shell.querySelector('[data-speaking-clear]');

			const applyFilter = () => {
				let visible = 0;
				cards.forEach((card) => {
					const tags = String(card.dataset.speakingTags || '').split('|').filter(Boolean);
					const show = activeTags.size === 0 || [...activeTags].every((tag) => tags.includes(tag));
					card.hidden = !show;
					if (show) visible += 1;
				});
				if (empty) empty.hidden = visible !== 0;
			};

			const updateTagButtons = () => {
				shell.querySelectorAll('[data-speaking-tag]').forEach((btn) => {
					const tag = btn.dataset.speakingTag || '';
					const on = activeTags.has(tag);
					btn.setAttribute('aria-pressed', on ? 'true' : 'false');
					btn.classList.toggle('speaking-tag-active', on);
				});
			};

			shell.querySelectorAll('[data-speaking-tag]').forEach((btn) => {
				btn.addEventListener('click', () => {
					const tag = btn.dataset.speakingTag || '';
					if (!tag) return;
					if (activeTags.has(tag)) activeTags.delete(tag);
					else activeTags.add(tag);
					updateTagButtons();
					applyFilter();
				});
			});

			clearBtn?.addEventListener('click', () => {
				activeTags.clear();
				updateTagButtons();
				applyFilter();
			});

			updateTagButtons();
			applyFilter();

			const modal = document.getElementById('speaking-modal');
			const panel = modal?.querySelector('.speaking-modal-panel');
			const closeNodes = modal?.querySelectorAll('[data-speaking-close]') || [];
			const openNodes = shell.querySelectorAll('[data-speaking-open]');
			const titleEl = document.getElementById('speaking-modal-title');
			const metaEl = document.getElementById('speaking-modal-meta');
			const summaryEl = document.getElementById('speaking-modal-summary');
			const detailsEl = document.getElementById('speaking-modal-details');
			const dataEl = document.getElementById('speaking-modal-data');
			const modalData = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
			let previousFocus = null;
			let scrollY = 0;

			if (!modal || !panel || !titleEl || !metaEl || !summaryEl || !detailsEl) return;

			const lockScroll = () => {
				scrollY = window.scrollY || window.pageYOffset || 0;
				document.body.style.position = 'fixed';
				document.body.style.top = `-${scrollY}px`;
				document.body.style.left = '0';
				document.body.style.right = '0';
				document.body.style.width = '100%';
			};
			const unlockScroll = () => {
				document.body.style.position = '';
				document.body.style.top = '';
				document.body.style.left = '';
				document.body.style.right = '';
				document.body.style.width = '';
				window.scrollTo(0, scrollY);
			};

			const focusables = () => Array.from(modal.querySelectorAll('a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'));
			const trapFocus = (event) => {
				if (event.key !== 'Tab' || modal.hidden) return;
				const nodes = focusables();
				if (!nodes.length) return;
				const first = nodes[0];
				const last = nodes[nodes.length - 1];
				if (event.shiftKey && document.activeElement === first) {
					event.preventDefault();
					last.focus();
				} else if (!event.shiftKey && document.activeElement === last) {
					event.preventDefault();
					first.focus();
				}
			};

			const closeModal = () => {
				if (modal.hidden) return;
				modal.classList.remove('is-open');
				window.setTimeout(() => {
					modal.hidden = true;
					unlockScroll();
					if (previousFocus && typeof previousFocus.focus === 'function') previousFocus.focus();
				}, 120);
			};

			const openModal = (slug, source) => {
				const entry = modalData?.[slug];
				if (!entry) return;
				titleEl.textContent = entry.title || '';
				metaEl.textContent = entry.meta || '';
				summaryEl.textContent = entry.summary || '';
				detailsEl.innerHTML = '';
				(entry.details || []).forEach((row) => {
					const p = document.createElement('p');
					p.className = 'speaking-modal-detail-row';
					const k = document.createElement('span');
					k.className = 'speaking-modal-detail-label';
					k.textContent = `${row.label}: `;
					const v = document.createElement('span');
					v.textContent = row.value || '';
					p.appendChild(k);
					p.appendChild(v);
					detailsEl.appendChild(p);
				});
				previousFocus = source;
				lockScroll();
				modal.hidden = false;
				window.requestAnimationFrame(() => modal.classList.add('is-open'));
				modal.querySelector('.speaking-modal-close')?.focus();
			};

			openNodes.forEach((node) => {
				node.addEventListener('click', () => {
					openModal(node.dataset.speakingSlug || '', node);
				});
			});
			closeNodes.forEach((node) => node.addEventListener('click', closeModal));
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && !modal.hidden) closeModal();
				trapFocus(event);
			});
		})();
	</script>
</section>

<style>
	.speaking-tag-btn {
		background: transparent;
		cursor: pointer;
	}
	.speaking-tag-btn:hover {
		background: rgba(15, 23, 42, 0.9);
	}
	.speaking-tag-btn.speaking-tag-active {
		border-color: rgba(45, 212, 191, 0.65);
		background: rgba(13, 148, 136, 0.14);
	}
	.speaking-modal {
		position: fixed;
		inset: 0;
		z-index: 70;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	.speaking-modal-overlay {
		position: absolute;
		inset: 0;
		border: 0;
		background: rgba(2, 6, 23, 0.78);
		opacity: 0;
		transition: opacity 140ms ease;
	}
	.speaking-modal-panel {
		position: relative;
		width: min(42rem, 100%);
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgb(2, 6, 23);
		padding: 1rem;
		box-shadow: 0 24px 80px rgba(2, 6, 23, 0.55);
		opacity: 0;
		transform: translateY(6px) scale(0.992);
		transition: opacity 140ms ease, transform 170ms ease;
	}
	.speaking-modal.is-open .speaking-modal-overlay {
		opacity: 1;
	}
	.speaking-modal.is-open .speaking-modal-panel {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	.speaking-modal-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.6rem;
	}
	.speaking-modal-meta {
		font-size: 0.68rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: rgba(148, 163, 184, 0.96);
		width: 100%;
	}
	.speaking-modal-title {
		font-size: 1.05rem;
		line-height: 1.35;
		font-weight: 600;
		color: rgba(248, 250, 252, 0.99);
		max-width: 90%;
	}
	.speaking-modal-close {
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgb(2, 6, 23);
		color: rgba(226, 232, 240, 0.98);
		width: 2rem;
		height: 2rem;
		cursor: pointer;
	}
	.speaking-modal-summary {
		margin-top: 0.75rem;
		font-size: 0.92rem;
		line-height: 1.62;
		color: rgba(203, 213, 225, 0.97);
	}
	.speaking-modal-details {
		margin-top: 0.75rem;
		display: grid;
		gap: 0.35rem;
		font-size: 0.82rem;
		color: rgba(203, 213, 225, 0.97);
	}
	.speaking-modal-detail-label {
		font-weight: 600;
		color: rgba(248, 250, 252, 0.99);
	}
</style>
