---
import { allSpeakingTopicTags, speakingEvents, sponsorLabel } from '../data/speaking';

type Props = {
	title?: string;
	showHeader?: boolean;
};

const { title = 'Speaking', showHeader = true } = Astro.props as Props;
---

<section class="card mt-4 p-4 md:mt-5" id="speaking-events">
	{showHeader && (
		<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
			<h2 class="section-title">{title}</h2>
			<p class="text-xs uppercase tracking-wide text-slate-400">By event · topic-tagged</p>
		</div>
	)}

	<div class="mb-4 border border-slate-800 bg-slate-950/40 p-3">
		<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Topic tags</h3>
		<div class="mt-2 flex flex-wrap gap-1.5">
			{allSpeakingTopicTags.map((tag) => (
				<span class="rounded-full border border-slate-700 px-2 py-0.5 text-[11px] font-medium text-slate-200">{tag}</span>
			))}
		</div>
	</div>

	<div class="space-y-3">
		{speakingEvents.map((event) => (
			<article class="border border-slate-800 bg-slate-950/40 p-3.5" id={event.slug}>
				<div class="flex flex-wrap items-start justify-between gap-2">
					<div>
						<p class="text-xs uppercase tracking-wide text-slate-400">{event.eventDateRange}</p>
						<h3 class="mt-1 text-base font-semibold text-slate-100">{event.title}</h3>
					</div>
					<a class="text-xs font-semibold text-slate-300 hover:text-slate-100" href={event.eventUrl} target="_blank" rel="noreferrer">{event.eventName} ↗</a>
				</div>

				<p class="mt-2 text-sm text-slate-300">{event.summary}</p>

				<div class="mt-3 grid gap-2 text-xs text-slate-300 md:grid-cols-2">
					<p><span class="font-semibold text-slate-100">When:</span> {event.sessionDateTime}</p>
					<p><span class="font-semibold text-slate-100">Stage:</span> {event.stage}</p>
					{event.track && <p><span class="font-semibold text-slate-100">Track:</span> {event.track}</p>}
					<p><span class="font-semibold text-slate-100">Role:</span> {event.role}</p>
					{(event.speakerTitle || event.speakerOrganization) && (
						<p><span class="font-semibold text-slate-100">Speaker profile:</span> {[event.speakerTitle, event.speakerOrganization].filter(Boolean).join(', ')}</p>
					)}
					<p><span class="font-semibold text-slate-100">Sponsorship:</span> {sponsorLabel(event)}</p>
				</div>

				<div class="mt-3 flex flex-wrap gap-1.5">
					{event.topicTags.map((tag) => (
						<span class="rounded-full border border-slate-700 bg-slate-900/80 px-2 py-0.5 text-[11px] font-medium text-slate-200">{tag}</span>
					))}
				</div>

				<p class="mt-3 text-[11px] text-slate-500">Source: <a class="hover:text-slate-300" href={event.sourceUrl} target="_blank" rel="noreferrer">{event.sourceUrl}</a></p>
			</article>
		))}
	</div>
</section>
