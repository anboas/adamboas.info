---
import { allSpeakingTopicTags, speakingEvents, sponsorLabel } from '../data/speaking';

type Props = {
	title?: string;
	showHeader?: boolean;
};

const { title = 'Speaking', showHeader = true } = Astro.props as Props;

const monthIndex: Record<string, number> = {
	jan: 0,
	feb: 1,
	mar: 2,
	apr: 3,
	may: 4,
	jun: 5,
	jul: 6,
	aug: 7,
	sep: 8,
	oct: 9,
	nov: 10,
	dec: 11,
};

function extractYear(value: string) {
	const matches = value.match(/(19|20)\d{2}/g);
	if (!matches?.length) return null;
	return Number(matches[matches.length - 1]);
}

function deriveSortDateMs(value: string) {
	const normalized = value.replace(/\s+/g, ' ').trim();
	const monthMatch = normalized.match(/([A-Za-z]{3,9})\s+(\d{1,2})/);
	const year = extractYear(normalized);
	if (!year) return 0;
	if (!monthMatch) return Date.UTC(year, 0, 1);
	const monthToken = monthMatch[1].slice(0, 3).toLowerCase();
	const month = monthIndex[monthToken] ?? 0;
	const day = Number(monthMatch[2]) || 1;
	return Date.UTC(year, month, day);
}

const speakingEventCards = speakingEvents
	.map((event) => {
		const year = extractYear(event.eventDateRange);
		return {
			...event,
			year,
			sortDateMs: deriveSortDateMs(event.eventDateRange),
		};
	})
	.sort((a, b) => b.sortDateMs - a.sortDateMs || a.title.localeCompare(b.title));

const speakingYears = Array.from(
	new Set(speakingEventCards.map((event) => event.year).filter((year): year is number => Number.isInteger(year))),
).sort((a, b) => b - a);
---

<section class="card mt-4 p-4 md:mt-5" id="speaking-events" data-speaking-shell>
	{
		showHeader && (
			<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
				<h2 class="section-title">{title}</h2>
				<p class="text-xs uppercase tracking-wide text-slate-400">By event · topic-tagged</p>
			</div>
		)
	}

	<div class="mb-4 border border-slate-800 bg-slate-950/40 p-3">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-200">Topic tags</h3>
			<button
				type="button"
				class="rounded-none border border-slate-700 bg-slate-950/60 px-2 py-1 text-[11px] text-slate-300 hover:bg-slate-900"
				data-speaking-clear
			>
				Clear
			</button>
		</div>
		<div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="Filter speaking engagements by topic tag">
			{
				allSpeakingTopicTags.map((tag) => (
					<button
						type="button"
						class="speaking-tag-btn rounded-full border border-slate-700 px-2 py-0.5 text-[11px] font-medium text-slate-200"
						data-speaking-tag={tag}
						aria-pressed="false"
					>
						{tag}
					</button>
				))
			}
		</div>
	</div>

	<div class="mb-4 border border-slate-800 bg-slate-950/40 p-3" aria-label="Speaking search and controls">
		<div class="grid gap-2 md:grid-cols-2 xl:grid-cols-[minmax(0,2fr)_repeat(3,minmax(0,1fr))]">
			<label class="speaking-control-field md:col-span-2 xl:col-span-1">
				<span>Search</span>
				<input
					type="search"
					class="speaking-control-input"
					data-speaking-search
					placeholder="Search title, event, summary, tags"
					autocomplete="off"
				/>
			</label>

			<label class="speaking-control-field">
				<span>Sponsorship</span>
				<select class="speaking-control-input" data-speaking-sponsor>
					<option value="all">All sponsorship</option>
					<option value="employer">Employer-sponsored</option>
					<option value="external">External-sponsored</option>
					<option value="self">Self-sponsored</option>
				</select>
			</label>

			<label class="speaking-control-field">
				<span>Year</span>
				<select class="speaking-control-input" data-speaking-year>
					<option value="all">All years</option>
					{speakingYears.map((year) => <option value={String(year)}>{year}</option>)}
				</select>
			</label>

			<label class="speaking-control-field">
				<span>Sort</span>
				<select class="speaking-control-input" data-speaking-sort>
					<option value="newest">Newest first</option>
					<option value="oldest">Oldest first</option>
					<option value="title">Title A-Z</option>
				</select>
			</label>
		</div>

		<p class="mt-2 text-xs text-slate-400" data-speaking-results aria-live="polite"></p>
	</div>

	<div class="space-y-3" data-speaking-list>
		{
			speakingEventCards.map((event) => (
				<article
					class="border border-slate-800 bg-slate-950/40 p-3.5"
					id={event.slug}
					data-speaking-item
					data-speaking-tags={event.topicTags.join('|')}
					data-speaking-search={`${event.title} ${event.eventName} ${event.summary} ${event.topicTags.join(' ')}`}
					data-speaking-sponsor={event.sponsorType}
					data-speaking-year={event.year ? String(event.year) : ''}
					data-speaking-date-ms={String(event.sortDateMs)}
				>
					<div class="flex flex-wrap items-start justify-between gap-2">
						<div>
							<p class="text-xs uppercase tracking-wide text-slate-400">{event.eventDateRange}</p>
							<button
								type="button"
								class="mt-1 inline-flex items-center gap-1 text-left text-base font-semibold text-sky-200 underline decoration-sky-700/70 underline-offset-4 hover:text-sky-100 hover:decoration-sky-500"
								data-speaking-open
								data-speaking-slug={event.slug}
							>
								<span>{event.title}</span>
								<span aria-hidden="true" class="text-[11px] text-sky-300">
									↗
								</span>
							</button>
						</div>
						<a
							class="text-xs font-semibold text-slate-300 hover:text-slate-100"
							href={event.eventUrl}
							target="_blank"
							rel="noreferrer"
						>
							{event.eventName} ↗
						</a>
					</div>

					<p class="mt-2 text-sm text-slate-300">{event.summary}</p>

					<div class="mt-3 flex flex-wrap gap-1.5">
						{event.topicTags.map((tag) => (
							<button
								type="button"
								class="speaking-tag-btn rounded-full border border-slate-700 bg-slate-900/80 px-2 py-0.5 text-[11px] font-medium text-slate-200"
								data-speaking-tag={tag}
								aria-pressed="false"
							>
								{tag}
							</button>
						))}
					</div>
				</article>
			))
		}
	</div>

	<p class="mt-3 hidden text-xs text-slate-400" data-speaking-empty>
		No speaking engagements match the selected filters.
	</p>

	<div id="speaking-modal" class="speaking-modal" hidden>
		<button type="button" class="speaking-modal-overlay" data-speaking-close aria-label="Close speaking details"
		></button>
		<article class="speaking-modal-panel" role="dialog" aria-modal="true" aria-labelledby="speaking-modal-title">
			<div class="speaking-modal-head">
				<p id="speaking-modal-meta" class="speaking-modal-meta"></p>
				<h3 id="speaking-modal-title" class="speaking-modal-title"></h3>
				<button type="button" class="speaking-modal-close" data-speaking-close aria-label="Close">✕</button>
			</div>
			<p id="speaking-modal-summary" class="speaking-modal-summary"></p>
			<div id="speaking-modal-details" class="speaking-modal-details"></div>
		</article>
	</div>

	<script
		type="application/json"
		id="speaking-modal-data"
		set:html={JSON.stringify(
			Object.fromEntries(
				speakingEventCards.map((event) => [
					event.slug,
					{
						title: event.title,
						meta: `${event.eventDateRange} · ${event.eventName}`,
						summary: event.summary,
						details: [
							{ label: 'When', value: event.sessionDateTime },
							{ label: 'Stage', value: event.stage },
							event.track ? { label: 'Track', value: event.track } : null,
							{ label: 'Role', value: event.role },
							event.speakerTitle || event.speakerOrganization
								? {
										label: 'Speaker profile',
										value: [event.speakerTitle, event.speakerOrganization].filter(Boolean).join(', '),
									}
								: null,
							{ label: 'Sponsorship', value: sponsorLabel(event) },
						].filter(Boolean),
					},
				]),
			),
		)}
	/>

	<script>
		import { createModalController } from '../scripts/ui/modal-controller';

		(() => {
			const shell = document.querySelector('[data-speaking-shell]');
			if (!shell) return;

			const activeTags = new Set();
			const list = shell.querySelector('[data-speaking-list]');
			const cards = Array.from(shell.querySelectorAll('[data-speaking-item]'));
			const empty = shell.querySelector('[data-speaking-empty]');
			const clearBtn = shell.querySelector('[data-speaking-clear]');
			const searchInput = shell.querySelector('[data-speaking-search]');
			const sponsorSelect = shell.querySelector('[data-speaking-sponsor]');
			const yearSelect = shell.querySelector('[data-speaking-year]');
			const sortSelect = shell.querySelector('[data-speaking-sort]');
			const results = shell.querySelector('[data-speaking-results]');

			const totalCount = cards.length;

			const normalize = (value) =>
				String(value || '')
					.toLowerCase()
					.trim();

			const getSortValue = (card) => {
				const value = Number(card.dataset.speakingDateMs || 0);
				return Number.isFinite(value) ? value : 0;
			};

			const applyFilter = () => {
				const query = normalize(searchInput?.value || '');
				const sponsor = sponsorSelect?.value || 'all';
				const year = yearSelect?.value || 'all';
				const sortMode = sortSelect?.value || 'newest';

				const visibleCards = [];
				cards.forEach((card) => {
					const tags = String(card.dataset.speakingTags || '')
						.split('|')
						.filter(Boolean);
					const hasTagMatch = activeTags.size === 0 || [...activeTags].every((tag) => tags.includes(tag));
					const searchable = normalize(card.dataset.speakingSearch || '');
					const hasQueryMatch = !query || searchable.includes(query);
					const hasSponsorMatch = sponsor === 'all' || card.dataset.speakingSponsor === sponsor;
					const hasYearMatch = year === 'all' || card.dataset.speakingYear === year;
					const show = hasTagMatch && hasQueryMatch && hasSponsorMatch && hasYearMatch;
					card.hidden = !show;
					if (show) visibleCards.push(card);
				});

				const byTitle = (a, b) => {
					const aTitle = String(a.querySelector('[data-speaking-open]')?.textContent || '').trim();
					const bTitle = String(b.querySelector('[data-speaking-open]')?.textContent || '').trim();
					return aTitle.localeCompare(bTitle);
				};
				if (sortMode === 'oldest') visibleCards.sort((a, b) => getSortValue(a) - getSortValue(b) || byTitle(a, b));
				else if (sortMode === 'title') visibleCards.sort(byTitle);
				else visibleCards.sort((a, b) => getSortValue(b) - getSortValue(a) || byTitle(a, b));

				for (const card of visibleCards) list?.appendChild(card);

				if (empty) empty.hidden = visibleCards.length !== 0;
				if (results) {
					results.textContent =
						visibleCards.length === totalCount
							? `Showing all ${totalCount} speaking engagements.`
							: `Showing ${visibleCards.length} of ${totalCount} speaking engagements.`;
				}
			};

			const updateTagButtons = () => {
				shell.querySelectorAll('[data-speaking-tag]').forEach((btn) => {
					const tag = btn.dataset.speakingTag || '';
					const on = activeTags.has(tag);
					btn.setAttribute('aria-pressed', on ? 'true' : 'false');
					btn.classList.toggle('speaking-tag-active', on);
				});
			};

			shell.querySelectorAll('[data-speaking-tag]').forEach((btn) => {
				btn.addEventListener('click', () => {
					const tag = btn.dataset.speakingTag || '';
					if (!tag) return;
					if (activeTags.has(tag)) activeTags.delete(tag);
					else activeTags.add(tag);
					updateTagButtons();
					applyFilter();
				});
			});

			searchInput?.addEventListener('input', applyFilter);
			sponsorSelect?.addEventListener('change', applyFilter);
			yearSelect?.addEventListener('change', applyFilter);
			sortSelect?.addEventListener('change', applyFilter);

			clearBtn?.addEventListener('click', () => {
				activeTags.clear();
				if (searchInput) searchInput.value = '';
				if (sponsorSelect) sponsorSelect.value = 'all';
				if (yearSelect) yearSelect.value = 'all';
				if (sortSelect) sortSelect.value = 'newest';
				updateTagButtons();
				applyFilter();
			});

			updateTagButtons();
			applyFilter();

			const modal = document.getElementById('speaking-modal');
			const panel = modal?.querySelector('.speaking-modal-panel');
			const closeNodes = modal?.querySelectorAll('[data-speaking-close]') || [];
			const openNodes = shell.querySelectorAll('[data-speaking-open]');
			const titleEl = document.getElementById('speaking-modal-title');
			const metaEl = document.getElementById('speaking-modal-meta');
			const summaryEl = document.getElementById('speaking-modal-summary');
			const detailsEl = document.getElementById('speaking-modal-details');
			const dataEl = document.getElementById('speaking-modal-data');
			const modalData = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
			if (!modal || !panel || !titleEl || !metaEl || !summaryEl || !detailsEl) return;

			const modalController = createModalController({
				root: modal,
				panel,
				closeNodes,
			});

			const openModal = (slug, source) => {
				const entry = modalData?.[slug];
				if (!entry) return;
				titleEl.textContent = entry.title || '';
				metaEl.textContent = entry.meta || '';
				summaryEl.textContent = entry.summary || '';
				detailsEl.innerHTML = '';
				(entry.details || []).forEach((row) => {
					const p = document.createElement('p');
					p.className = 'speaking-modal-detail-row';
					const k = document.createElement('span');
					k.className = 'speaking-modal-detail-label';
					k.textContent = `${row.label}: `;
					const v = document.createElement('span');
					v.textContent = row.value || '';
					p.appendChild(k);
					p.appendChild(v);
					detailsEl.appendChild(p);
				});
				modalController.open(source, modal.querySelector('.speaking-modal-close'));
			};

			openNodes.forEach((node) => {
				node.addEventListener('click', () => {
					openModal(node.dataset.speakingSlug || '', node);
				});
			});
		})();
	</script>
</section>

<style>
	.speaking-control-field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.64rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(148, 163, 184, 0.95);
	}
	.speaking-control-input {
		height: 2.1rem;
		border: 1px solid rgba(71, 85, 105, 0.9);
		background: rgba(2, 6, 23, 0.9);
		color: rgba(241, 245, 249, 0.98);
		padding: 0 0.6rem;
		font-size: 0.84rem;
		text-transform: none;
		letter-spacing: normal;
	}
	.speaking-control-input::placeholder {
		color: rgba(148, 163, 184, 0.78);
	}
	.speaking-tag-btn {
		background: transparent;
		cursor: pointer;
	}
	.speaking-tag-btn:hover {
		background: rgba(15, 23, 42, 0.9);
	}
	.speaking-tag-btn.speaking-tag-active {
		border-color: rgba(45, 212, 191, 0.65);
		background: rgba(13, 148, 136, 0.14);
	}
	.speaking-modal {
		position: fixed;
		inset: 0;
		z-index: 70;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	.speaking-modal-overlay {
		position: absolute;
		inset: 0;
		border: 0;
		background: rgba(2, 6, 23, 0.78);
		opacity: 0;
		transition: opacity 140ms ease;
	}
	.speaking-modal-panel {
		position: relative;
		width: min(42rem, 100%);
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgb(2, 6, 23);
		padding: 1rem;
		box-shadow: 0 24px 80px rgba(2, 6, 23, 0.55);
		opacity: 0;
		transform: translateY(6px) scale(0.992);
		transition:
			opacity 140ms ease,
			transform 170ms ease;
	}
	.speaking-modal.is-open .speaking-modal-overlay {
		opacity: 1;
	}
	.speaking-modal.is-open .speaking-modal-panel {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	.speaking-modal-head {
		position: relative;
		padding-right: 2.45rem;
	}
	.speaking-modal-meta {
		font-size: 0.68rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: rgba(148, 163, 184, 0.96);
	}
	.speaking-modal-title {
		margin-top: 0.45rem;
		font-size: 1.05rem;
		line-height: 1.35;
		font-weight: 600;
		color: rgba(248, 250, 252, 0.99);
	}
	.speaking-modal-close {
		position: absolute;
		top: 0;
		right: 0;
		border: 1px solid rgba(71, 85, 105, 0.88);
		background: rgb(2, 6, 23);
		color: rgba(226, 232, 240, 0.98);
		width: 2rem;
		height: 2rem;
		cursor: pointer;
	}
	.speaking-modal-summary {
		margin-top: 0.75rem;
		font-size: 0.92rem;
		line-height: 1.62;
		color: rgba(203, 213, 225, 0.97);
	}
	.speaking-modal-details {
		margin-top: 0.75rem;
		display: grid;
		gap: 0.35rem;
		font-size: 0.82rem;
		color: rgba(203, 213, 225, 0.97);
	}
	.speaking-modal-detail-label {
		font-weight: 600;
		color: rgba(248, 250, 252, 0.99);
	}
</style>
