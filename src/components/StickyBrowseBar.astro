---
import { withBase } from '../utils/withBase';

const { active = 'writing' } = Astro.props as { active?: 'writing' | 'experience' | 'education' };

function cls(key) {
	return key === active
		? 'rounded-none border border-slate-600 bg-slate-900/60 px-3 py-1 text-sm font-semibold text-slate-50'
		: 'rounded-none border border-slate-800 bg-slate-950/40 px-3 py-1 text-sm text-slate-200 hover:bg-slate-900';
}
---

<div class="sticky-browse">
	<div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-3">
		<div class="flex flex-wrap gap-2">
			<a class={cls('writing')} href={withBase('/writing/')}>Writing</a>
			<a class={cls('experience')} href={withBase('/experience/')}>Experience</a>
			<a class={cls('education')} href={withBase('/education/')}>Education</a>
		</div>
		<div class="flex flex-wrap items-center gap-2">
			<a class="rounded-none border border-slate-800 bg-slate-950/40 px-3 py-1 text-sm text-slate-200 hover:bg-slate-900" data-track="Contact: Email Click" href="mailto:anboas@gmail.com">Email</a>
			<a class="rounded-none border border-slate-800 bg-slate-950/40 px-3 py-1 text-sm text-slate-200 hover:bg-slate-900" href={withBase('/writing/')}>All writing →</a>
		</div>
	</div>
</div>
