---
import { withBase } from '../utils/withBase';

const { active = 'writing' } = Astro.props as { active?: 'home' | 'writing' | 'events' | 'opportunities' | 'capabilities' | 'experience' | 'education' };

function cls(key) {
	return key === active
		? 'inline-flex h-8 items-center justify-center rounded-none border px-2 text-[11px] font-semibold text-slate-50 sm:px-3 sm:text-sm sticky-tab-active'
		: 'inline-flex h-8 items-center justify-center rounded-none border border-slate-800 bg-slate-950 px-2 text-[11px] text-slate-200 hover:bg-slate-900 sm:px-3 sm:text-sm';
}
---

<div class="sticky-browse md:hidden">
	<div class="mx-auto w-full max-w-6xl px-4 py-1.5">
		<div class="-mx-1 flex flex-nowrap gap-1.5 overflow-x-auto px-1 pb-0.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
			<a class={cls('home')} href={withBase('/')}>Home</a>
			<a class={cls('writing')} href={withBase('/writing/')}>Writing</a>
			<a class={cls('capabilities')} href={withBase('/capabilities/')}>Capabilities</a>
			<a class={cls('events')} href={withBase('/events/')}>Events</a>
			<a class={cls('opportunities')} href={withBase('/opportunities/')}>Opportunities</a>
		</div>
	</div>
</div>
