---
import { withBase } from '../utils/withBase';

const { active = 'writing' } = Astro.props as { active?: 'home' | 'writing' | 'experience' | 'education' };

function cls(key) {
	return key === active
		? 'rounded-none border px-2 py-1 text-xs font-semibold text-slate-50 sm:px-3 sm:text-sm sticky-tab-active'
		: 'rounded-none border border-slate-800 bg-slate-950/40 px-2 py-1 text-xs text-slate-200 hover:bg-slate-900 sm:px-3 sm:text-sm';
}
---

<div class="sticky-browse md:hidden">
	<div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-2">
		<div class="-mx-1 flex flex-nowrap gap-2 overflow-x-auto px-1 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
			<a class={cls('home')} href={withBase('/')}>Home</a>
			<a class={cls('writing')} href={withBase('/writing/')}>Writing</a>
			<a class={cls('experience')} href={withBase('/experience/')}>Experience</a>
			<a class={cls('education')} href={withBase('/education/')}>Education</a>
		</div>
		<div class="flex flex-nowrap items-center gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
			<a class="shrink-0 rounded-none border border-slate-800 bg-slate-950/40 px-2 py-1 text-xs text-slate-200 hover:bg-slate-900 sm:px-3 sm:text-sm" data-track="Contact: Email Click" href="mailto:anboas@gmail.com">Email</a>
			<a class="shrink-0 rounded-none border border-slate-800 bg-slate-950/40 px-2 py-1 text-xs text-slate-200 hover:bg-slate-900 sm:px-3 sm:text-sm" href={withBase('/writing/')}>All writing →</a>
		</div>
	</div>
</div>
