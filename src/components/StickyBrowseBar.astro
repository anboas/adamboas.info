---
import { withBase } from '../utils/withBase';

const { active = 'writing' } = Astro.props as { active?: 'home' | 'writing' | 'speaking' | 'profile' | 'events' | 'opportunities' | 'capabilities' | 'experience' | 'education' };

function cls(key) {
	return key === active
		? 'inline-flex h-8 items-center justify-center rounded-none border px-2 text-[11px] font-semibold text-slate-50 sm:px-3 sm:text-sm sticky-tab-active'
		: 'inline-flex h-8 items-center justify-center rounded-none border border-slate-800 bg-slate-950 px-2 text-[11px] text-slate-200 hover:bg-slate-900 sm:px-3 sm:text-sm';
}

function ariaCurrent(key) {
	return key === active ? 'page' : undefined;
}
---

<div class="sticky-browse md:hidden">
	<nav class="mx-auto w-full max-w-6xl px-4 py-1.5" aria-label="Primary mobile navigation">
		<div class="space-y-1.5">
			<div>
				<p class="mb-1 text-[10px] uppercase tracking-[0.14em] text-slate-500">Profile</p>
				<div class="flex flex-nowrap gap-1.5 overflow-x-auto pb-0.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
					<a class={cls('writing')} href={withBase('/writing/')} aria-current={ariaCurrent('writing')}>Writing</a>
					<a class={cls('speaking')} href={withBase('/speaking/')} aria-current={ariaCurrent('speaking')}>Speaking</a>
					<a class={cls('profile')} href={withBase('/profile/')} aria-current={ariaCurrent('profile')}>Profile</a>
				</div>
			</div>
			<div>
				<p class="mb-1 text-[10px] uppercase tracking-[0.14em] text-slate-500">Capability</p>
				<div class="flex flex-nowrap gap-1.5 overflow-x-auto pb-0.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
					<a class={cls('capabilities')} href={withBase('/capabilities/')} aria-current={ariaCurrent('capabilities')}>Capabilities</a>
					<a class={cls('events')} href={withBase('/events/')} aria-current={ariaCurrent('events')}>Events</a>
					<a class={cls('opportunities')} href={withBase('/opportunities/')} aria-current={ariaCurrent('opportunities')}>Opportunities</a>
				</div>
			</div>
		</div>
	</nav>
</div>
