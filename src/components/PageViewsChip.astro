---
import plausible from '../generated/plausible-pageviews.json';

const { pathname } = Astro.props as { pathname: string };

function normalizePath(p: string) {
	let s = (p || '').trim();
	if (!s.startsWith('/')) s = '/' + s;
	if (s.length > 1 && s.endsWith('/')) s = s.slice(0, -1);
	return s;
}

const key = normalizePath(pathname);
const pv = (plausible as any)?.pageviewsByPath?.[key];

// Try path normalization in both directions during domain/base migrations.
const altNoBase = key.replace(/^\/adamboas\.info\b/, '') || '/';
const pvAltNoBase = (plausible as any)?.pageviewsByPath?.[altNoBase];

const altWithBase = key.startsWith('/adamboas.info') ? key : `/adamboas.info${key === '/' ? '' : key}`;
const pvAltWithBase = (plausible as any)?.pageviewsByPath?.[altWithBase];

const pageviews =
	typeof pv === 'number'
		? pv
		: typeof pvAltNoBase === 'number'
			? pvAltNoBase
			: typeof pvAltWithBase === 'number'
				? pvAltWithBase
				: null;
const dateRange = (plausible as any)?.meta?.dateRange || '30d';
const note = String((plausible as any)?.meta?.note || '');
const unavailable = /(api error|api errors|missing|unexpected|no successful)/i.test(note);
const hasPlausibleSnapshot = !!(plausible as any)?.meta;
const missing = !unavailable && pageviews === null;
const label = unavailable
	? `views unavailable (${dateRange})`
	: missing
		? `views pending (${dateRange})`
		: `${pageviews.toLocaleString()} views (${dateRange})`;
const title = missing
	? 'No page-specific row was returned in the latest Plausible snapshot; this is not a verified zero.'
	: undefined;
---

{
	hasPlausibleSnapshot ? (
		<span
			class="pageviews-chip rounded-full border px-2 py-1 text-xs"
			data-pageviews-state={unavailable ? 'unavailable' : missing ? 'pending' : 'counted'}
			title={title}
		>
			{label}
		</span>
	) : null
}
