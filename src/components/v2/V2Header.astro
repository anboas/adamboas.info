---
import { withBase } from '../../utils/withBase';

const { active = 'home' } = Astro.props as { active?: string };

const links = [
	{ key: 'home', label: 'Home', href: withBase('/v2/') },
	{ key: 'writing', label: 'Writing', href: withBase('/v2/writing/') },
	{ key: 'events', label: 'Events', href: withBase('/v2/events/') },
	{ key: 'opportunities', label: 'Opportunities', href: withBase('/v2/opportunities/') },
	{ key: 'capabilities', label: 'Capabilities', href: withBase('/v2/capabilities/') },
	{ key: 'experience', label: 'Experience', href: withBase('/v2/experience/') },
	{ key: 'education', label: 'Education', href: withBase('/v2/education/') },
];
---

<header class="site-header border-b border-slate-800 bg-slate-950">
	<nav class="container flex items-center justify-between py-2 md:py-3.5">
		<div class="flex items-center gap-3">
			<a href={withBase('/v2/')} class="site-brand text-base font-semibold tracking-tight text-slate-50 hover:text-slate-50">
				Adam Boas <span class="ml-1 text-xs uppercase tracking-[0.12em] text-cyan-300">UI v2</span>
			</a>
		</div>
		<div class="hidden items-center gap-1 md:flex">
			{links.map((link) => (
				<a class:list={[
					'inline-flex h-8 items-center rounded-none border px-2.5 text-sm',
					active === link.key
						? 'border-cyan-700 bg-cyan-950/40 text-cyan-200'
						: 'border-slate-800 bg-slate-950 text-slate-200 hover:bg-slate-900',
				]} href={link.href}>{link.label}</a>
			))}
		</div>
		<a href={withBase('/')} class="inline-flex h-8 items-center rounded-none border border-slate-700 px-2.5 text-xs font-semibold uppercase tracking-[0.08em] text-slate-200 hover:bg-slate-900">Production</a>
	</nav>
</header>
