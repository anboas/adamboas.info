---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	class?: string;
}

const { eyebrow, title, description, class: className = '' } = Astro.props;
const hasActions = Astro.slots.has('actions');
const hasExtra = Astro.slots.has('default');
---

<section class={`surface-header ${className}`.trim()}>
	<div class="surface-header-row">
		<div class="surface-header-main">
			{eyebrow ? <p class="surface-header-eyebrow">{eyebrow}</p> : null}
			<h1 class="surface-header-title">{title}</h1>
			{description ? <p class="surface-header-description">{description}</p> : null}
		</div>
		{
			hasActions ? (
				<div class="surface-header-actions">
					<slot name="actions" />
				</div>
			) : null
		}
	</div>
	{
		hasExtra ? (
			<div class="surface-header-extra">
				<slot />
			</div>
		) : null
	}
</section>

<style>
	.surface-header {
		padding-top: var(--surface-header-pt, 0.25rem);
		padding-bottom: var(--surface-header-pb, 0.75rem);
	}
	.surface-header-row {
		display: flex;
		flex-direction: column;
		gap: var(--surface-header-gap, 0.5rem);
		padding-bottom: var(--surface-header-row-pb, 0.75rem);
		border-bottom: 1px solid var(--surface-header-border, rgb(30 41 59));
		min-height: var(--surface-header-row-min-height-mobile, auto);
	}
	.surface-header-main {
		max-width: 60rem;
	}
	.surface-header-eyebrow {
		font-size: 11px;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: rgb(100 116 139);
	}
	.surface-header-title {
		margin-top: 0.25rem;
		font-size: 1.5rem;
		line-height: 1.25;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: rgb(248 250 252);
		text-wrap: balance;
	}
	.surface-header-description {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: rgb(203 213 225);
		max-width: 66ch;
	}
	.surface-header-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: rgb(148 163 184);
		min-height: var(--surface-header-actions-min-height-mobile, auto);
	}
	.surface-header-extra {
		margin-top: 0.65rem;
	}
	@media (min-width: 768px) {
		.surface-header {
			padding-bottom: 1rem;
		}
		.surface-header-row {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-end;
			gap: 1rem;
			padding-bottom: 1rem;
			min-height: var(--surface-header-row-min-height, 5.25rem);
		}
		.surface-header-title {
			font-size: 1.875rem;
		}
		.surface-header-actions {
			justify-content: flex-end;
			align-items: flex-end;
			min-height: var(--surface-header-actions-min-height, 2.25rem);
		}
	}
</style>
