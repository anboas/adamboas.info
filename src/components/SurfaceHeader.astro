---
interface Props {
	eyebrow?: string;
	eyebrowLinks?: { label: string; href?: string }[];
	title: string;
	description?: string;
	class?: string;
}

const { eyebrow, eyebrowLinks = [], title, description, class: className = '' } = Astro.props;
const hasActions = Astro.slots.has('actions');
const hasExtra = Astro.slots.has('default');
const descriptionText = typeof description === 'string' ? description.trim() : '';
const hasDescription = Boolean(descriptionText);
const hasBreadcrumb = eyebrowLinks.length > 0;
---

<section class={`surface-header ${className}`.trim()}>
	<div class="surface-header-row">
		<div class="surface-header-main">
			{
				hasBreadcrumb ? (
					<nav class="surface-header-eyebrow surface-header-breadcrumb" aria-label="Breadcrumb">
						{eyebrowLinks.map((item, index) => (
							<>
								{index > 0 ? <span aria-hidden="true">/</span> : null}
								{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
							</>
						))}
					</nav>
				) : eyebrow ? (
					<p class="surface-header-eyebrow">{eyebrow}</p>
				) : null
			}
			<h1 class="surface-header-title">{title}</h1>
			<p class:list={['surface-header-description', !hasDescription && 'surface-header-description-placeholder']}>
				{hasDescription ? descriptionText : '\u00A0'}
			</p>
		</div>
		{
			hasActions ? (
				<div class="surface-header-actions">
					<slot name="actions" />
				</div>
			) : null
		}
	</div>
	{
		hasExtra ? (
			<div class="surface-header-extra">
				<slot />
			</div>
		) : null
	}
</section>

<style>
	.surface-header {
		padding-top: var(--surface-header-pt, 0.25rem);
		padding-bottom: var(--surface-header-pb, 0.55rem);
	}
	.surface-header-row {
		display: flex;
		flex-direction: column;
		gap: var(--surface-header-gap, 0.5rem);
		padding-bottom: var(--surface-header-row-pb, 0.55rem);
		border-bottom: 1px solid var(--surface-header-border, rgb(30 41 59));
		min-height: var(--surface-header-row-min-height-mobile, auto);
	}
	.surface-header-main {
		max-width: var(--surface-header-main-max-width, 72rem);
		min-width: 0;
	}
	.surface-header-eyebrow {
		font-size: 11px;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: rgb(100 116 139);
	}
	.surface-header-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
	}
	.surface-header-breadcrumb a {
		color: rgb(125 211 252);
		text-decoration: none;
		text-underline-offset: 0.2em;
	}
	.surface-header-breadcrumb a:hover,
	.surface-header-breadcrumb a:focus-visible {
		color: rgb(204 251 241);
		text-decoration: underline;
	}
	.surface-header-title {
		margin-top: 0.25rem;
		font-size: 1.5rem;
		line-height: 1.25;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: rgb(248 250 252);
	}
	.surface-header-description {
		margin-top: 0.4rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: rgb(203 213 225);
		max-width: var(--surface-header-description-max-width, 120ch);
		min-height: var(--surface-header-description-min-height-mobile, 0);
	}
	.surface-header-description-placeholder {
		visibility: hidden;
	}
	.surface-header-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: rgb(148 163 184);
		min-height: var(--surface-header-actions-min-height-mobile, auto);
	}
	.surface-header-extra {
		margin-top: 0.65rem;
	}
	@media (min-width: 768px) {
		.surface-header {
			padding-bottom: 0.75rem;
		}
		.surface-header-row {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
			gap: 0.85rem;
			padding-bottom: 0.7rem;
			min-height: var(--surface-header-row-min-height, auto);
		}
		.surface-header-title {
			font-size: 1.875rem;
		}
		.surface-header-description {
			min-height: var(--surface-header-description-min-height, 0);
		}
		.surface-header-actions {
			justify-content: flex-end;
			align-items: flex-start;
			align-self: flex-start;
			min-height: var(--surface-header-actions-min-height, 0);
		}
	}
</style>
