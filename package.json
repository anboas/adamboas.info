{
	"name": "adamboas-site",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "npm run og:generate && astro build",
		"preview": "astro preview",
		"format": "prettier \"src/components/**/*.{astro,ts,js}\" \"src/layouts/**/*.{astro,ts,js}\" \"src/utils/**/*.{ts,js}\" \"src/pages/404.astro\" \"src/pages/blog/**/*.astro\" \"src/pages/contact.astro\" \"src/pages/sitemap.astro\" \"src/pages/status*.astro\" \"src/pages/status/**/*.astro\" \"src/pages/speaking/**/*.astro\" \"src/pages/capabilities/**/*.astro\" \"src/pages/writing/tags/**/*.astro\" \"src/pages/events/sources.astro\" \"tests/**/*.{ts,js}\" \"scripts/**/*.{js,mjs,ts}\" \"*.{json,md,yml,yaml}\" --write",
		"format:check": "prettier \"src/components/**/*.{astro,ts,js}\" \"src/layouts/**/*.{astro,ts,js}\" \"src/utils/**/*.{ts,js}\" \"src/pages/404.astro\" \"src/pages/blog/**/*.astro\" \"src/pages/contact.astro\" \"src/pages/sitemap.astro\" \"src/pages/status*.astro\" \"src/pages/status/**/*.astro\" \"src/pages/speaking/**/*.astro\" \"src/pages/capabilities/**/*.astro\" \"src/pages/writing/tags/**/*.astro\" \"src/pages/events/sources.astro\" \"tests/**/*.{ts,js}\" \"scripts/**/*.{js,mjs,ts}\" \"*.{json,md,yml,yaml}\" --check",
		"astro": "astro",
		"lint:content": "node scripts/lint-frontmatter.mjs",
		"lint:seo": "node scripts/lint-seo-guards.mjs",
		"lint:config": "node scripts/lint-config-env.mjs",
		"lint:papers": "node scripts/verify-papers.mjs",
		"lint:memos": "node scripts/verify-memos.mjs",
		"og:generate": "node scripts/generate-og-images.mjs",
		"events:sam-import": "python3 scripts/import-radar-events-from-sam-opportunities.py",
		"events:sam-import:deep": "python3 scripts/import-radar-events-from-sam-opportunities.py --enrich-detail-text",
		"events:sam-import:mirror": "python3 scripts/import-radar-events-from-sam-opportunities.py --enrich-detail-text --detail-max-chars 0 --detail-cache-ttl-hours -1 --mirror-forever --mirror-download-resources",
		"events:opps-award-enrich": "python3 scripts/enrich-opportunities-from-contract-awards.py",
		"events:opps-usaspending-enrich": "python3 scripts/enrich-opportunities-from-usaspending.py",
		"events:opps-fpds-align": "python3 scripts/enrich-opportunities-fpds-alignment.py",
		"events:opps-drift-report": "python3 scripts/generate-opportunities-drift-report.py",
		"events:navy-sam-import": "python3 scripts/import-radar-events-from-sam-opportunities.py --profile navy --output-prefix sam-opportunities-navy",
		"events:nswc-sam-import": "python3 scripts/import-radar-events-from-sam-opportunities.py --profile nswc --output-prefix sam-opportunities-nswc",
		"events:army-sam-import": "python3 scripts/import-radar-events-from-sam-opportunities.py --profile army --output-prefix sam-opportunities-army",
		"events:air-sam-import": "python3 scripts/import-radar-events-from-sam-opportunities.py --profile air --output-prefix sam-opportunities-air",
		"events:marine-sam-import": "python3 scripts/import-radar-events-from-sam-opportunities.py --profile marine --output-prefix sam-opportunities-marine",
		"events:joint-sam-import": "python3 scripts/import-radar-events-from-sam-opportunities.py --profile joint --output-prefix sam-opportunities-joint",
		"events:navy-pages-import": "python3 scripts/import-radar-events-from-navy-nswc-pages.py",
		"test": "playwright test",
		"test:smoke": "SITE_BASE=http://127.0.0.1:4321 playwright test tests/smoke.spec.ts",
		"test:overflow": "SITE_BASE=https://www.adamboas.com playwright test tests/overflow.spec.ts",
		"test:a11y": "SITE_BASE=http://localhost:4321 playwright test tests/a11y.spec.ts",
		"test:site": "SITE_BASE=http://127.0.0.1:4321 playwright test tests/smoke.spec.ts tests/overflow.spec.ts tests/a11y.spec.ts tests/opportunities-events-regression.spec.ts tests/writing-regression.spec.ts",
		"lhci": "npm run build && lhci autorun",
		"events:feed-crawl": "python3 scripts/crawl-radar-feed-registry.py",
		"linkcheck:prepare": "node scripts/linkcheck-prepare.mjs",
		"linkcheck:warn": "node scripts/linkcheck-warn.mjs",
		"linkcheck:suggest": "node scripts/linkcheck-stale-suggestions.mjs",
		"analytics:plausible:sitemap": "node scripts/fetch-plausible-sitemap-analytics.mjs"
	},
	"dependencies": {
		"@astrojs/mdx": "^4.3.13",
		"@astrojs/rss": "^4.0.15",
		"@astrojs/sitemap": "^3.7.2",
		"@tailwindcss/vite": "^4.1.18",
		"astro": "^5.17.1",
		"sharp": "^0.34.3",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.58.2",
		"@tailwindcss/typography": "^0.5.19",
		"gray-matter": "^4.0.3",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1"
	}
}
