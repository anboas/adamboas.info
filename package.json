{
  "name": "adamboas-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run og:generate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:content": "node scripts/lint-frontmatter.mjs",
    "lint:papers": "node scripts/verify-papers.mjs",
    "og:generate": "node scripts/generate-og-images.mjs",
    "test": "playwright test",
    "test:overflow": "SITE_BASE=https://www.adamboas.com playwright test tests/overflow.spec.ts",
    "test:a11y": "SITE_BASE=http://localhost:4321 playwright test tests/a11y.spec.ts",
    "lhci": "npm run build && lhci autorun"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.17.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "gray-matter": "^4.0.3"
  }
}
